{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.associations": {
			"*.run": "lua",
			"*.xms": "xml",
			"*.workspace": "xml"
		},
		"task.autoDetect": "off"
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"type": "shell",
				"label": "Zombie - DebugShared",
				"group": "build",
				"options": {
					"cwd": "${workspaceFolder}"
				},

				"linux": {
					"command": "../traktor/bin/linux/releasestatic/Traktor.SolutionBuilder.App -f=direct -target=DebugShared ZombieLinux.xms",
					"problemMatcher": [
						"$gcc"
					]
				},

				"windows": {
					"options": {
						"cwd": "${workspaceFolder}",
						"shell": { "executable": "cmd.exe", "args": [ "/d", "/c" ] }
					},
					"command": "call ..\\traktor\\scripts\\config-vs-x64.bat && ..\\traktor\\bin\\win64\\releasestatic\\Traktor.SolutionBuilder.App.exe -f=direct -target=DebugShared ZombieWin64.xms",
					"problemMatcher": [
						"$msCompile"
					]
				}
			},

			{
				"type": "shell",
				"label": "Zombie - ReleaseShared",
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"options": {
					"cwd": "${workspaceFolder}"
				},

				"linux": {
					"command": "../traktor/bin/linux/releasestatic/Traktor.SolutionBuilder.App -f=direct -target=ReleaseShared ZombieLinux.xms",
					"problemMatcher": [
						"$gcc"
					]
				},

				"windows": {
					"options": {
						"cwd": "${workspaceFolder}",
						"shell": { "executable": "cmd.exe", "args": [ "/d", "/c" ] }
					},
					"command": "call ..\\traktor\\scripts\\config-vs-x64.bat && ..\\traktor\\bin\\win64\\releasestatic\\Traktor.SolutionBuilder.App.exe -f=direct -target=ReleaseShared ZombieWin64.xms",
					"problemMatcher": [
						"$msCompile"
					]
				}
			}
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Editor - ReleaseShared",
				"request": "launch",

				"type": "cppdbg",
				"program": "${workspaceFolder}/../traktor/bin/latest/linux/releaseshared/Traktor.Editor.App",
				"args": [ "${workspaceFolder}/Zombie.workspace" ],
				"stopAtEntry": false,
				"cwd": "${workspaceFolder}/../traktor",
				"environment": [
					{ "name": "TRAKTOR_HOME", "value": "${workspaceFolder}/../traktor" },
					{ "name": "LD_LIBRARY_PATH", "value": "${workspaceFolder}/../traktor/bin/latest/linux/releaseshared" },
					{ "name": "GSETTINGS_SCHEMA_DIR", "value": "/usr/share/glib-2.0/schemas" },
					{ "name": "XDG_DATA_DIRS", "value": "/usr/share/ubuntu:/usr/share/gnome:/usr/local/share/:/usr/share/:/var/lib/snapd/desktop" },
					{ "name": "GTK_PATH", "value": "" },
					{ "name": "GTK_EXE_PREFIX", "value": "/usr" },
					{ "name": "GIO_MODULE_DIR", "value": "/usr/lib/x86_64-linux-gnu/gio/modules" },
					{ "name": "GDK_PIXBUF_MODULE_FILE", "value": "/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache" },
					{ "name": "GDK_PIXBUF_MODULEDIR", "value": "" },
					{ "name": "GTK_IM_MODULE_FILE", "value": "" }
				],
				"externalConsole": false,
				"MIMode": "gdb",
				"setupCommands": [
					{
						"description": "Enable pretty-printing for gdb",
						"text": "-enable-pretty-printing",
						"ignoreFailures": true
					}
				],

				"windows": {
					"type": "cppvsdbg",
					"program": "${workspaceFolder}/../traktor/bin/latest/win64/releaseshared/Traktor.Editor.App.exe",
					"args": [ "${workspaceFolder}/Zombie.workspace" ],
					"stopAtEntry": false,
					"cwd": "${workspaceFolder}/../traktor",
					"environment": [ { "name": "TRAKTOR_HOME", "value": "${workspaceFolder}/../traktor" } ],
					"externalConsole": false
				}
			}
		]
	}
}
