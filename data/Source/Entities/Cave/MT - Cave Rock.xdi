		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{F7C55B46-0C39-471B-BE55-2EDE366111DE}</id>
			<comment/>
			<position>
				<first>1751</first>
				<second>193</second>
			</position>
			<name>Reorient</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{08BD014D-3EFE-4DAB-8F5E-5691C9C0E3C3}</id>
					<name>Albedo</name>
				</item>
				<item>
					<id>{A9D7FDBE-7A8E-454E-959E-988C3C29D493}</id>
					<name>Normal</name>
				</item>
				<item>
					<id>{5AAAC6C6-0DBC-4F8A-BDD6-8A6F1E8EC220}</id>
					<name>Roughness</name>
				</item>
				<item>
					<id>{FA746863-E306-4A5F-94F7-A8E24E96613A}</id>
					<name>Macro</name>
				</item>
				<item>
					<id>{CF578121-0E36-481F-9BE3-9C3654FF9D3B}</id>
					<name>WorldNormal</name>
				</item>
				<item>
					<id>{3527EA2F-69E6-4C9D-8822-C6B81077A6C3}</id>
					<name>ViewNormal</name>
				</item>
				<item>
					<id>{22680F1F-E1D9-40AF-AC95-10F5677B299C}</id>
					<name>ViewTangent</name>
				</item>
				<item>
					<id>{661A7CE5-08E2-4504-B620-5F171B20B23F}</id>
					<name>ViewBinormal</name>
				</item>
				<item>
					<id>{4B6DF631-9A83-451C-AC51-62B088AD7C10}</id>
					<name>View</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{5D8054B6-1270-4A6B-B348-47DCC5AC6CC8}</id>
					<name>OutAlbedo</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{D2C5F725-CAC8-405C-BD1A-7B4F27DCDC0E}</id>
					<name>OutNormal</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{820FF772-3226-4629-8091-A25F00F89598}</id>
					<name>OutRoughness</name>
					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[
// The blended Normal is in tangent space of whichever projections it came from
// (FreezeSurfaceAttributes leaves it unrotated). Rebuild the projections'
// frames with the same weights, blended, and take it to world space with that.
// Exact where one projection dominates; an approximation only in the narrow
// bands between them.
const vec3 gn = normalize($WorldNormal.xyz);
vec3 w = pow(abs(gn), vec3(4.0f));
w /= (w.x + w.y + w.z);
const vec3 s = step(vec3(0.0f), gn) * 2.0f - 1.0f;

vec3 T = vec3(0.0f, 0.0f, s.x) * w.x + vec3(s.y, 0.0f, 0.0f) * w.y + vec3(-s.z, 0.0f, 0.0f) * w.z;
vec3 B = vec3(0.0f, 1.0f, 0.0f) * (w.x + w.z) + vec3(0.0f, 0.0f, 1.0f) * w.y;
T -= gn * dot(gn, T);
B -= gn * dot(gn, B);

const vec3 t = $Normal.xyz;
const vec3 n = normalize(T * t.x + B * t.y + gn * max(t.z, 0.05f));

// The mesh template rebuilds the normal as normalize(x*T + y*B + z*N) from the
// interpolated *view space* frame, so rotate n into view space and hand over its
// coordinates in that (non-orthogonal) frame. Where the frame degenerates, fall
// back to the geometric normal.
const vec3 nv = mat3($View) * n;
const mat3 tbn = mat3($ViewTangent.xyz, $ViewBinormal.xyz, $ViewNormal.xyz);
const float det = determinant(mat3(normalize($ViewTangent.xyz), normalize($ViewBinormal.xyz), normalize($ViewNormal.xyz)));
vec3 ts = vec3(0.0f, 0.0f, 1.0f);
if (abs(det) > 0.08f)
	ts = mix(ts, inverse(tbn) * nv, clamp((abs(det) - 0.08f) * 8.0f, 0.0f, 1.0f));

vec3 albedo = $Albedo.rgb;
albedo *= mix(vec3(0.70f, 0.66f, 0.62f), vec3(1.15f, 1.08f, 1.0f), clamp($Macro * 2.2f - 0.4f, 0.0f, 1.0f));

$OutAlbedo = vec4(albedo, 1.0f);
$OutNormal = vec4(ts, 0.0f);
$OutRoughness = clamp($Roughness * 1.05f, 0.35f, 1.0f);
]]></script>
		</item>
