		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{1CF82D95-8F5D-4D67-A73A-D7987134F2E4}</id>
			<comment/>
			<position>
				<first>479</first>
				<second>-142</second>
			</position>
			<name>Projections</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{6024DD0B-2F67-45CC-9C43-CDE925C41735}</id>
					<name>WorldPosition</name>
				</item>
				<item>
					<id>{0A558F36-EEB4-49DD-9C93-205723A62FCC}</id>
					<name>WorldNormal</name>
				</item>
				<item>
					<id>{A9EA04F8-02A0-4EE7-9915-597C8A79A32F}</id>
					<name>AlbedoMap</name>
				</item>
				<item>
					<id>{1A641460-9BA1-4766-90F7-7698218BBD88}</id>
					<name>State</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{DE53E55B-B71F-4394-AECC-738208F7847E}</id>
					<name>UvX</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{DE8281C3-9D91-4960-890F-6ADA348349B4}</id>
					<name>UvY</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{817F715F-E524-415F-845E-BD86E477CAB3}</id>
					<name>UvZ</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{59E5FC86-15D1-4BD6-8CED-ED52AE6D9337}</id>
					<name>UvMud</name>
					<type>Vector</type>
				</item>
				<item>
					<id>{4C684DB5-3E74-4698-AD7B-611FC9279937}</id>
					<name>WallBlend</name>
					<type>Scalar</type>
				</item>
				<item>
					<id>{91F7BED4-F26F-46FB-862B-57FF909DB00F}</id>
					<name>FlatBlend</name>
					<type>Scalar</type>
				</item>
				<item>
					<id>{23F7B864-E604-4171-A609-B133359859C3}</id>
					<name>FloorBlend</name>
					<type>Scalar</type>
				</item>
				<item>
					<id>{D3E05054-3572-4943-97D0-D92E8DA49B6E}</id>
					<name>Macro</name>
					<type>Scalar</type>
				</item>
			</outputPins>
			<script><![CDATA[
// World space triplanar projections for the modular cave kit: the pieces are
// yawed in quarter turns and snapped together, so a mesh parameterisation could
// never line up across a seam. This node only works out where each projection
// samples and how much of it shows; the sampling itself is done by the
// BlendSurfaceAttributes nodes through their TexCoord overrides.
//
// Walls    = Rock(X) / Rock(Z) by WallBlend
// Flat     = Rock(Y) / Mud(Y) by FloorBlend (mud only on upward facing)
// Surface  = Walls / Flat by FlatBlend
const vec3 wp = $WorldPosition.xyz;
const vec3 gn = normalize($WorldNormal.xyz);
vec3 w = pow(abs(gn), vec3(4.0f));
w /= (w.x + w.y + w.z);
const vec3 s = step(vec3(0.0f), gn) * 2.0f - 1.0f;

const float rockScale = 0.3f; // 1 / metres per texture repeat
const float mudScale = 0.4f;

// U is flipped on the back facing side of each axis so the texture is not
// mirrored; Reorient flips the tangent to match.
const vec2 uvX = vec2(wp.z * s.x, wp.y) * rockScale;
const vec2 uvY = vec2(wp.x * s.y, wp.z) * rockScale;
const vec2 uvZ = vec2(-wp.x * s.z, wp.y) * rockScale;
// The mud normal map is DirectX style (green down). Mirroring V turns it into
// an OpenGL style map in the same tangent frame as the rock Y projection.
const vec2 uvMud = vec2(wp.x * s.y, -wp.z) * mudScale;

// Large scale variation so the repeat does not read: a very low frequency
// sample of the rock albedo, used for brightness and to break up the mud edge.
const vec3 mX = texture(sampler2D($AlbedoMap, $State), uvX * 0.071f + 0.37f).rgb;
const vec3 mY = texture(sampler2D($AlbedoMap, $State), uvY * 0.071f + 0.37f).rgb;
const vec3 mZ = texture(sampler2D($AlbedoMap, $State), uvZ * 0.071f + 0.37f).rgb;
const float macro = dot(mX * w.x + mY * w.y + mZ * w.z, vec3(0.333f));

$UvX = vec4(uvX, 0.0f, 0.0f);
$UvY = vec4(uvY, 0.0f, 0.0f);
$UvZ = vec4(uvZ, 0.0f, 0.0f);
$UvMud = vec4(uvMud, 0.0f, 0.0f);
$WallBlend = w.z / max(w.x + w.z, 1e-5f);
$FlatBlend = w.y;
$FloorBlend = smoothstep(0.55f, 0.85f, gn.y + (macro - 0.4f) * 0.6f);
$Macro = macro;
]]></script>
		</item>
