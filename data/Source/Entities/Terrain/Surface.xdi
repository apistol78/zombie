		</item>
		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{4B955F6B-CBD1-D04B-BFE7-D055D078F684}</id>
			<comment/>
			<position>
				<first>-1110</first>
				<second>-981</second>
			</position>
			<name>POM</name>
			<technique/>
			<domain>Pixel</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include>
				<item>{1F66B96D-C144-D142-B094-2541510CDFAD}</item>
			</include>
			<inputPins>
				<item>
					<id>{E1F2AE34-8747-EC45-B28A-FC70F93F3135}</id>
					<name>ViewPosition</name>
				</item>
				<item>
					<id>{9923E5FA-FFC7-2D47-B1E0-2547D5086398}</id>
					<name>ViewNormal</name>
				</item>
				<item>
					<id>{D3A78607-FC1C-4F46-8C56-DBD78534F6FC}</id>
					<name>TexCoord</name>
				</item>
				<item>
					<id>{308E04FC-AC6C-7B4B-8BC1-14C31778DA44}</id>
					<name>ViewTangent</name>
				</item>
				<item>
					<id>{3C1A7E52-9D41-4F08-B6C3-71E5A0D42B19}</id>
					<name>HeightMap</name>
				</item>
				<item>
					<id>{6B8F2D14-05AC-4E7B-9F20-C48D31A65E77}</id>
					<name>HeightState</name>
				</item>
				<item>
					<id>{A7E4C61D-2B98-4D53-AF07-5E9C3814B6A2}</id>
					<name>HeightScale</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{A2DDA335-48B8-0B41-AB94-18DD465713FC}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[
// Parallax occlusion mapping for the terrain detail materials.
//
// The terrain has no vertex tangents and its detail UVs are a planar world
// mapping (TexCoordTile = TexCoordWorld * 64, so one tile is 16m across a
// 1024m terrain). Both the tangent frame and the UV-to-metre ratio are
// therefore taken from screen space derivatives, which lets the relief depth
// be given in metres instead of in tile UV units - at this tiling a depth of
// "0.02 UV" would be 32cm of relief and just smears the texture.

// Relief depth in metres, driven by the HeightScale pin. Metres rather
// than UV units because one detail tile is 16m across this terrain.
const float c_depthMetres = $HeightScale;
const float c_fadeNear = 12.0f;
const float c_fadeFar = 30.0f;
const float c_minNdotV = 0.35f;
const int c_stepsMin = 16;
const int c_stepsMax = 32;

const vec3 position = $ViewPosition.xyz;
const vec2 baseTexCoord = $TexCoord.xy;
const vec3 N = normalize($ViewNormal.xyz);

const vec3 dPdx = dFdx(position);
const vec3 dPdy = dFdy(position);
const vec2 dTdx = dFdx(baseTexCoord);
const vec2 dTdy = dFdy(baseTexCoord);

vec2 texCoord = baseTexCoord;

// Cotangent frame. Both axes are solved for rather than taking one from a
// cross product, so the handedness follows the UV layout instead of guessing.
const float det = dTdx.x * dTdy.y - dTdy.x * dTdx.y;
if (abs(det) > 1e-12f)
{
	const float rdet = 1.0f / det;
	const vec3 Traw = ( dTdy.y * dPdx - dTdx.y * dPdy) * rdet;
	const vec3 Braw = (-dTdy.x * dPdx + dTdx.x * dPdy) * rdet;

	// |Traw| is metres per UV unit, which is what converts the depth.
	const float metresPerUV = length(Traw);

	const vec3 T = normalize(Traw - N * dot(N, Traw));
	const vec3 B = normalize(Braw - N * dot(N, Braw));

	const vec3 V = normalize(-position);
	const float NdotV = dot(V, N);

	// Relief is only readable up close, and the step loop is the expensive
	// part; fading it out also keeps the offset sane at the grazing angles
	// that cover most of a terrain.
	const float fade = (1.0f - smoothstep(c_fadeNear, c_fadeFar, length(position))) * smoothstep(0.0f, 0.2f, NdotV);
	if (fade > 0.0f && metresPerUV > 0.0f)
	{
		const float depthUV = (c_depthMetres / metresPerUV) * fade;

		// Offset limiting; without the clamp the divide explodes near the
		// horizon and the texture swims.
		const vec2 maxOffset = -vec2(dot(V, T), dot(V, B)) * depthUV / max(NdotV, c_minNdotV);

		const int steps = int(mix(float(c_stepsMax), float(c_stepsMin), clamp(NdotV, 0.0f, 1.0f)));
		const float stepDepth = 1.0f / float(steps);
		const vec2 stepTexCoord = maxOffset * stepDepth;

		// Height map is 1 at the peaks, so march against (1 - height).
		float rayDepth = 0.0f;
		float surfaceDepth = 1.0f; // - textureGrad(sampler2D($HeightMap, $HeightState), texCoord, dTdx, dTdy).x;
		vec2 prevTexCoord = texCoord;
		float prevRayDepth = 0.0f;
		float prevSurfaceDepth = surfaceDepth;

		for (int i = 0; i < steps; ++i)
		{
			if (rayDepth >= surfaceDepth)
				break;

			prevTexCoord = texCoord;
			prevRayDepth = rayDepth;
			prevSurfaceDepth = surfaceDepth;

			texCoord += stepTexCoord;
			rayDepth += stepDepth;

			// Explicit gradients; the loop is non-uniform control flow so
			// implicit mip selection would be undefined here.
			surfaceDepth = 1.0f - textureGrad(sampler2D($HeightMap, $HeightState), texCoord, dTdx, dTdy).x;
		}

		// Interpolate across the last step so the hit isn't quantised.
		const float after = surfaceDepth - rayDepth;
		const float before = prevSurfaceDepth - prevRayDepth;
		const float w = clamp(after / min(after - before, -1e-6f), 0.0f, 1.0f);
		texCoord = mix(texCoord, prevTexCoord, w);
	}
}

$Output = vec4(texCoord.x, texCoord.y, 0.0f, 0.0f);

]]></script>
		</item>
