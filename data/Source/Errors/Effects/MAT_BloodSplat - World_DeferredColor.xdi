				<first>356</first>
				<second>-291</second>
			</position>
			<parameterDeclaration>{C1FFA687-8FE7-C54E-AA46-23305604D4F5}</parameterDeclaration>
		</item>
		<item type="traktor.render.Swizzle" version="traktor.render.Node:1">
			<id>{54859C6E-0584-4D2B-8DAA-184D08C8F730}</id>
			<comment/>
