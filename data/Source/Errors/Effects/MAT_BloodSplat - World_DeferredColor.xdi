			<parameterDeclaration>{00000000-0000-0000-0000-000000000000}</parameterDeclaration>
			<parameterName>linkage_texRef1</parameterName>
			<declaration>
				<type>Texture2D</type>
				<length>0</length>
				<frequency>Once</frequency>
				<structDeclaration>{00000000-0000-0000-0000-000000000000}</structDeclaration>
