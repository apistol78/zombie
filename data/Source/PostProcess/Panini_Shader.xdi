		<item type="traktor.render.Scalar" version="traktor.render.Node:1">
			<id>{3F0A21D7-5C64-4B18-9E52-6D1A70C4B813}</id>
			<comment><![CDATA[

Panini distance; 0 is plain perspective, 1 the classic "Pannini" look.

			]]></comment>
			<position>
				<first>-40</first>
				<second>400</second>
			</position>
			<value>0.25</value>
		</item>
		<item type="traktor.render.Script" version="8,traktor.render.Node:1">
			<id>{3F0A21D7-5C64-4B18-9E52-6D1A70C4B814}</id>
			<comment/>
			<position>
				<first>240</first>
				<second>310</second>
			</position>
			<name>Panini</name>
			<technique/>
			<domain>Undefined</domain>
			<localSize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</localSize>
			<useRayTracing>false</useRayTracing>
			<include/>
			<inputPins>
				<item>
					<id>{5B2C7E10-4A31-4D96-8F27-91C6E3A50001}</id>
					<name>TexCoord</name>
				</item>
				<item>
					<id>{5B2C7E10-4A31-4D96-8F27-91C6E3A50002}</id>
					<name>MagicCoeffs</name>
				</item>
				<item>
					<id>{5B2C7E10-4A31-4D96-8F27-91C6E3A50003}</id>
					<name>Distance</name>
				</item>
			</inputPins>
			<outputPins>
				<item>
					<id>{5B2C7E10-4A31-4D96-8F27-91C6E3A50011}</id>
					<name>Output</name>
					<type>Vector</type>
				</item>
			</outputPins>
			<script><![CDATA[

// Inverse Panini projection; where in the source image does this pixel come from?
//
// A view ray is described by its horizontal angle t and its vertical slope h, and
// crosses the unit cylinder at (sin t, h, cos t). Projecting that point onto the
// tangent plane from an eye placed d behind the cylinder axis gives the Panini
// image
//
//   U = (d + 1) * sin t / (d + cos t)
//   V = (d + 1) * h     / (d + cos t)
//
// where d = 0 degenerates to ordinary perspective. Since the source is already a
// perspective render we run this backwards; the pixel gives us U and V, and what
// we want are the perspective coordinates (tan t, h / cos t) to sample at.

const vec2 tanHalfFov = $MagicCoeffs.xy;
const float d = max($Distance, 0.0f);

// Pixel in [-1,1]; y flips as we come in as a texture coordinate.
const vec2 ndc = vec2($TexCoord.x, 1.0f - $TexCoord.y) * 2.0f - 1.0f;

// Scaled by the Panini image of the frustum edge, so the left and right edges of
// the screen stay put instead of pulling content in from outside the source.
const float tEdge = atan(tanHalfFov.x);
const float cEdge = cos(tEdge);
const float u = ndc.x * (d + 1.0f) * sin(tEdge) / (d + cEdge);
const float v = ndc.y * tanHalfFov.y;

// Invert U for t, i.e. solve sin t - k * cos t = k * d with k = U / (d + 1).
const float k = u / (d + 1.0f);
const float r = sqrt(1.0f + k * k);
const float t = atan(k) + asin(clamp(k * d / r, -1.0f, 1.0f));

const float c = cos(t);
const float h = v * (d + c) / (d + 1.0f);

// Vertically the corners are the ones reaching furthest outside the source
// frustum; crop by exactly that much, uniformly to keep the aspect, so that no
// pixel ends up sampling past the edge.
const float fit = (d + 1.0f) / (d / cEdge + 1.0f);

const vec2 p = fit * vec2(tan(t), h / c) / tanHalfFov;

$Output = vec4(p.x * 0.5f + 0.5f, 0.5f - p.y * 0.5f, 0.0f, 0.0f);

]]></script>
		</item>
