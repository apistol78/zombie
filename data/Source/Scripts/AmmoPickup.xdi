<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{8ED12B6C-86D0-4AD1-AC4A-7B5B60AB4AF0}
#using {6E9AD100-0000-4000-8000-000000000010}

import(traktor)

-- AmmoPickup
--
-- A pickup that tops up the rifle's reserve. Only taken while there is room for
-- it, so a full player leaves the crate on the ground for the trip back. Grabbed
-- with an empty rifle, it also kicks off a reload so the player does not have to
-- ask. The collect-and-remove machinery lives in Pickup; this only decides when
-- it may be taken and what taking it does.

AmmoPickup = AmmoPickup or class("AmmoPickup", Pickup)

local AMMO_PER_PICKUP < const > = Config.pickup.ammoRounds   -- rounds in one crate

-- How long a looted crate takes to be worth walking back to.
--
-- The night is long enough that a fixed 144 rounds across twelve crates would run the
-- map dry well before the last relic, and starving the rifle does not make the night
-- tense -- it makes it unplayable, since nothing else kills a zombie. Coming back turns
-- the map into a renewable supply that has to be *travelled* to instead: the crates are
-- where they were, so running dry means committing to a route you already know, through
-- a forest that has got worse since you last walked it.
--
-- Camping a crate is prevented by where the refill happens rather than by when: the
-- Stage holds a pickup back until the player is RESPAWN_CLEARANCE (12 m) away from the
-- spot, so this can be short without a crate becoming a chair to sit on.

-- This pickup's own entity data: what Main builds when the crate comes back (see
-- Pickup:entityData). The escaped form is what makes it a tracked dependency as well
-- as a guid, exactly as Scripts/Spawner references the zombie.
local ENTITY < const > = Guid("\{D12BE6FD-2795-4991-BAF1-076C03B2AB21}")

local RESPAWN_DELAY < const > = Config.pickup.ammoRespawn

function AmmoPickup:canTake(context)
	return context._reserve < context._reserveMax
end

function AmmoPickup:respawnDelay()
	return RESPAWN_DELAY
end

function AmmoPickup:entityData()
	return ENTITY
end

function AmmoPickup:take(context)
	context._reserve = math.min(context._reserveMax, context._reserve + AMMO_PER_PICKUP)
	context._ammo:setAmmo(context._mag, context._reserve)
	-- Picked up standing over it with an empty rifle: start loading without
	-- making the player ask for it.
	if context._mag <= 0 then
		context:_beginReload()
	end
end
]]></text>
</object>
