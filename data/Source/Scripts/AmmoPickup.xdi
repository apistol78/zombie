<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{8ED12B6C-86D0-4AD1-AC4A-7B5B60AB4AF0}
#using {6E9AD100-0000-4000-8000-000000000010}

import(traktor)

-- AmmoPickup
--
-- A crate of rounds, for the pack. Walked over like it always was, and taken only while the pack
-- has room for it; a nearly full pack takes what fits and leaves the rest in the crate. The
-- collect-and-remove machinery lives in Pickup; this only says what is in the crate and how long
-- a looted one takes to come back.
--
-- It knows nothing about the weapons. "rounds" is an item like any other (Scripts/Items/Items),
-- and both firearms load from whatever rounds the pack holds -- so a crate feeds the rifle and
-- the machine gun alike without naming either.

AmmoPickup = AmmoPickup or class("AmmoPickup", Pickup)

local AMMO_PER_PICKUP < const > = Config.pickup.ammoRounds   -- rounds in one crate

-- How long a looted crate takes to be worth walking back to.
--
-- The night is long enough that a fixed supply across the map would run dry well before the
-- last relic, and starving the rifle does not make the night tense -- it makes it unplayable,
-- since nothing else kills a zombie reliably. Coming back turns the map into a renewable supply
-- that has to be *travelled* to instead: the crates are where they were, so running dry means
-- committing to a route you already know, through a forest that has got worse since you last
-- walked it.
--
-- Camping a crate is prevented by where the refill happens rather than by when: the Stage holds
-- a pickup back until the player is RESPAWN_CLEARANCE away from the spot, so this can be short
-- without a crate becoming a chair to sit on.
local RESPAWN_DELAY < const > = Config.pickup.ammoRespawn

function AmmoPickup:itemKind()
	return "rounds"
end

function AmmoPickup:itemCount()
	return self._count or AMMO_PER_PICKUP
end

function AmmoPickup:respawnDelay()
	return RESPAWN_DELAY
end
]]></text>
</object>
