<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{8ED12B6C-86D0-4AD1-AC4A-7B5B60AB4AF0}

import(traktor)

-- AmmoPickup
--
-- A pickup that tops up the rifle's reserve. Only taken while there is room for
-- it, so a full player leaves the crate on the ground for the trip back. Grabbed
-- with an empty rifle, it also kicks off a reload so the player does not have to
-- ask. The collect-and-remove machinery lives in Pickup; this only decides when
-- it may be taken and what taking it does.

AmmoPickup = AmmoPickup or class("AmmoPickup", Pickup)

local AMMO_PER_PICKUP < const > = 12   -- rounds in one crate

function AmmoPickup:canTake(context)
	return context._reserve < context._reserveMax
end

function AmmoPickup:take(context)
	context._reserve = math.min(context._reserveMax, context._reserve + AMMO_PER_PICKUP)
	context._ammo:setAmmo(context._mag, context._reserve)
	-- Picked up standing over it with an empty rifle: start loading without
	-- making the player ask for it.
	if context._mag <= 0 then
		context:_beginReload()
	end
end
]]></text>
</object>
