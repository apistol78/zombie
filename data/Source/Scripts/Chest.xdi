<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{17E40000-0000-4000-8000-000000000001}
import(traktor)

-- Chest
--
-- An iron-strapped strongbox the player opens with E. The lid swings up about its hinge and
-- the hinges creak -- both the entity's theater act ACT, not this script -- and what is inside
-- is not put into the world at all. It is shown -- Main puts up the chest window
-- (Scripts/Views/ChestView) with the box's contents in it -- and the player takes what they
-- want straight into the pack. Whatever is left stays in the chest,
-- to be come back for.
--
-- This component owns the lid and what the level put in the box; which chests stand open and
-- what is left in each is the Stage's (Main:_openChest), as plain data, so it survives a script
-- hot reload the way the wards and the gates do.
--
-- What a chest holds is the level designer's: a zombie.ItemContainerComponentData on the
-- placed chest, so each chest in a scene can hold something different -- the scene's
-- ExternalEntityData wrapper carries it. No container, or an empty one: the chest is empty,
-- which is a thing worth placing too. A relic cannot go in a chest -- relics are their own
-- entities out in the world (Items: `keep`), and the build refuses a container holding one --
-- and anything that is no item is left out with a warning.
--
-- What E says at it, and a line of its own shown under the chest window's title -- "THE
-- SEXTON'S KEY", say -- are its zombie.InteractableComponentData (prompt, notice); a wrapper
-- with a line of its own carries its own. E calls interact() (Main:_interact).
--
-- Attach to an entity named "Chest" (the name is what Main keeps its books by, as for wards and
-- gates) carrying a TheaterEntityComponent with an act named ACT. In Entities/Chest/Chest that
-- act pitches the GroupComponent's "Lid" child (the lid mesh, origin on the hinge, extending
-- +Z) back about the hinge, and carries the creak as an event key at its start, so the swing
-- and its sound are timed together in the theater editor. The act runs on whether or not
-- the chest window has the game paused (that pause is only the scripts' _paused flag), so the
-- lid is seen coming up behind it. Models: tools/gen_chest.py.
--
-- open() is idempotent and takes instant=true -- the restore path, the same contract as
-- Gate:unlock -- which plays OPENED instead: a silent act that only holds the lid open. Open is
-- kept by the world (the entity's zombie.FixtureComponent): a script hot reload finds the lid
-- already there, but a chest streamed back in, or a stage come back to later in the night, is
-- built shut, opens itself again from what the world says, and must not creak doing it.

Chest = Chest or class("Chest", traktor.world.ScriptComponent)

local ACT < const > = "Open"       -- the act that swings the lid up and creaks the hinges
local OPENED < const > = "Opened"  -- ...and the silent one that only holds it open

-- What the level put in the box (its ItemContainerComponent), as a fresh list of { kind, count }
-- in the order it was written. A new list every call: the Stage takes one when the chest is first
-- opened and keeps track of what is left in it from there, so nothing here is ever spent.
function Chest:contents()
	return Chest.listOf(self.owner, "Chest")
end

-- An entity's ItemContainerComponent as a list of { kind, count }: what a chest holds, and what a
-- character carries (zombie.NpcComponent). `who` names the owner in a warning.
--
-- Only the keys are read (Items.keyOf), never the items themselves: a character reads what it
-- carries as the world is built, before the stage has bound Scripts/Items/Items to the database.
function Chest.listOf(entity, who)
	local list = {}
	local box < const > = entity:getComponent(zombie.ItemContainerComponent)
	if box == nil then
		return list
	end
	for i = 0, box.entryCount - 1 do
		local item < const > = box:getItem(i)
		local key < const > = Items.keyOf(item)
		if key == nil then
			print(who .. ": " .. ((item ~= nil) and item:format() or "nothing") .. " is no item; left out.")
		elseif box:getCount(i) > 0 then
			table.insert(list, { kind = key, count = box:getCount(i) })
		end
	end
	return list
end

-- Play the act, which is the whole of opening: the lid and the creak are both on it. A chest
-- without the act (Performance:play logs which) or without a theater component at all stays
-- shut and silent, but it still opens to the player -- Main shows its contents regardless.
function Chest:open(instant)
	if self._opened then
		return
	end
	self._opened = true

	local fixture < const > = self.owner:getComponent(zombie.FixtureComponent)
	if fixture ~= nil then
		fixture.done = true
	end

	-- Opened once, it is searched from then on.
	local interactable < const > = self.owner:getComponent(zombie.InteractableComponent)
	if interactable ~= nil then
		interactable.prompt = "SEARCH THE CHEST"
	end

	local performance < const > = self.owner:getComponent(traktor.theater.TheaterEntityComponent)
	if performance ~= nil then
		performance:play(instant and OPENED or ACT)
	end
end

function Chest:isOpen()
	return self._opened == true
end

-- E at the chest: the stage opens it and puts up the window (Main:_openChest).
function Chest:interact(context)
	context:_openChest(self.owner)
end

-- Offered to E while there is anything to do here: shut, or opened with something still in it
-- (Main:chestContents, which leaves out what a quest has not asked for yet).
function Chest:update(context, totalTime, deltaTime)
	-- Opened already as far as the world is concerned.
	if not self._opened then
		local fixture < const > = self.owner:getComponent(zombie.FixtureComponent)
		if fixture ~= nil and fixture.done then
			self:open(true)
		end
	end
	if context == nil or context.chestContents == nil or not self._opened then
		return
	end
	local interactable < const > = self.owner:getComponent(zombie.InteractableComponent)
	if interactable ~= nil then
		interactable.enabled = #context:chestContents(self.owner.id:format()) > 0
	end
end
]]></text>
</object>
