<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{17E40000-0000-4000-8000-000000000001}
import(traktor)

-- Chest
--
-- An iron-strapped strongbox the player opens with E. The lid swings up about its hinge and
-- the hinges creak -- both the entity's theater act ACT, not this script -- and what is inside
-- is not put into the world at all. It is shown -- Main puts up the chest window
-- (Scripts/Views/ChestView) with the box's contents in it -- and the player takes what they
-- want straight into the pack. Whatever is left stays in the chest,
-- to be come back for.
--
-- This component owns the lid and what the level put in the box; which chests stand open and
-- what is left in each is the Stage's (Main:_openChest), as plain data, so it survives a script
-- hot reload the way the wards and the gates do.
--
-- What a chest holds is the level designer's. It is read from the ScriptComponentData's
-- properties, so each chest placed in a scene can hold something different -- give the scene's
-- ExternalEntityData wrapper its own ScriptComponentData (class Scripts/Chest, with
-- properties); ResolveExternal swaps it in for this entity's own, which holds nothing.
--
--   item    (string) what is inside: a comma separated list of item kinds out of
--           Scripts/Items/Items, each with an optional count after a colon --
--           "rounds:24, flask, grenade:2". Two older names still mean a kind ("ammo",
--           "health"). Empty or absent: the chest is empty, which is a thing worth placing
--           too. A relic cannot go in a chest -- relics are their own entities out in the
--           world (Items: `keep`) -- and is left out with a warning, as is a kind the
--           catalogue does not know.
--   count   (string, optional) how many, for a chest holding a single kind written without
--           one of its own -- the form the older chests were written in.
--   notice  (string, optional) a line of its own, shown under the chest window's title --
--           "THE SEXTON'S KEY", say.
--
-- Attach to an entity named "Chest" (the name is what Main collects them by, as for wards and
-- gates) carrying a TheaterEntityComponent with an act named ACT. In Entities/Chest/Chest that
-- act pitches the GroupComponent's "Lid" child (the lid mesh, origin on the hinge, extending
-- +Z) back about the hinge, and carries the creak as an event key at its start, so the swing
-- and its sound are timed together in the theater editor. The act runs on whether or not
-- the chest window has the game paused (that pause is only the scripts' _paused flag), so the
-- lid is seen coming up behind it. Models: tools/gen_chest.py.
--
-- open() is idempotent and takes instant=true -- the reload-restore path, the same contract as
-- Hive:activate -- which only re-marks the chest: the lid is C++ state that survived the reload
-- standing exactly where the act left it, and replaying the act would creak it again.

Chest = Chest or class("Chest", traktor.world.ScriptComponent)

local ACT < const > = "Open"   -- the act that swings the lid up and creaks the hinges

-- The names chests in the scenes were given before there were item kinds.
local ALIASES < const > = {
	ammo = "rounds",
	health = "flask"
}

-- A string property off this component's ScriptComponentData, or nil.
function Chest:_property(name)
	local props < const > = self.properties
	if props == nil then
		return nil
	end
	local v < const > = props:getProperty(name)
	if type(v) ~= "string" or v == "" then
		return nil
	end
	return v
end

-- What the level put in the box, as a fresh list of { kind, count } in the order it was
-- written. A new list every call: the Stage takes one when the chest is first opened and keeps
-- track of what is left in it from there, so nothing here is ever spent.
function Chest:contents()
	local list = {}
	local spec < const > = self:_property("item")
	if spec == nil then
		return list
	end

	local entries < const > = Items.parseList(spec, "Chest")

	-- The older form: one kind, and its count in a property of its own.
	if #entries == 1 and entries[1].count == nil then
		entries[1].count = tonumber(self:_property("count") or "")
	end

	for _, entry in ipairs(entries) do
		local kind < const > = ALIASES[entry.name] or entry.name
		local def < const > = Items[kind]
		if def == nil then
			print('Chest: unknown item "' .. entry.name .. '"; left out.')
		elseif def.keep then
			print('Chest: a ' .. kind .. ' cannot be kept in a chest; left out.')
		elseif (entry.count or 1) > 0 then
			table.insert(list, { kind = kind, count = entry.count or 1 })
		end
	end
	return list
end

-- The level's own line for this chest, or nil.
function Chest:notice()
	return self:_property("notice")
end

-- Play the act, which is the whole of opening: the lid and the creak are both on it. A chest
-- without the act (Performance:play logs which) or without a theater component at all stays
-- shut and silent, but it still opens to the player -- Main shows its contents regardless.
function Chest:open(instant)
	if self._opened then
		return
	end
	self._opened = true
	if instant then
		return
	end

	local performance < const > = self.owner:getComponent(traktor.theater.TheaterEntityComponent)
	if performance ~= nil then
		performance:play(ACT)
	end
end

function Chest:isOpen()
	return self._opened == true
end
]]></text>
</object>
