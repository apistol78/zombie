<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using {6E9AD100-0000-4000-8000-000000000010}
#using \{17E40000-0000-4000-8000-000000000001}
import(traktor)

-- Chest
--
-- An iron-strapped strongbox the player opens with E. The lid swings up about its hinge and
-- the hinges creak; what is inside is not put into the world at all. It is shown -- Main puts
-- up the chest window (Scripts/Views/ChestView) with the box's contents in it -- and the
-- player takes what they want straight into the pack. Whatever is left stays in the chest,
-- to be come back for.
--
-- This component owns the lid and what the level put in the box; which chests stand open and
-- what is left in each is the Stage's (Main:_openChest), as plain data, so it survives a script
-- hot reload the way the wards and the gates do.
--
-- What a chest holds is the level designer's. It is read from the ScriptComponentData's
-- properties, so each chest placed in a scene can hold something different -- give the scene's
-- ExternalEntityData wrapper its own ScriptComponentData (class Scripts/Chest, with
-- properties); ResolveExternal swaps it in for this entity's own, which holds nothing.
--
--   item    (string) what is inside: a comma separated list of item kinds out of
--           Scripts/Items/Items, each with an optional count after a colon --
--           "rounds:24, flask, grenade:2". Two older names still mean a kind ("ammo",
--           "health"). Empty or absent: the chest is empty, which is a thing worth placing
--           too. A relic cannot go in a chest -- relics are their own entities out in the
--           world (Items: `keep`) -- and is left out with a warning, as is a kind the
--           catalogue does not know.
--   count   (string, optional) how many, for a chest holding a single kind written without
--           one of its own -- the form the older chests were written in.
--   notice  (string, optional) a line of its own, shown under the chest window's title --
--           "THE SEXTON'S KEY", say.
--
-- Attach to an entity named "Chest" (the name is what Main collects them by, as for wards and
-- gates) whose GroupComponent holds a child named "Lid": the lid mesh with its origin on the
-- hinge and the lid extending +Z, authored at HINGE in the chest's frame. The swing rebuilds
-- exactly that transform with the opening pitch added, so a closed chest stands precisely as it
-- was authored. Models: tools/gen_chest.py.
--
-- open() is idempotent and takes instant=true -- the reload-restore path, the same contract as
-- Gate:unlock -- to snap the lid open without the creak.

Chest = Chest or class("Chest", traktor.world.ScriptComponent)

local SWING_ANGLE < const > = Config.chest.swingAngle   -- how far the lid swings back (rad)
local SWING_TIME < const > = Config.chest.swingTime     -- ...and how long it takes (s)

-- Where the hinge runs in the chest's own frame: the top of the back wall. Must match the Lid
-- child's translation in Entities/Chest/Chest and BODY_H/DEPTH in tools/gen_chest.py.
local HINGE < const > = Vector4(0.0, 0.42, -0.26, 0.0)

-- The names chests in the scenes were given before there were item kinds.
local ALIASES < const > = {
	ammo = "rounds",
	health = "flask"
}

-- A string property off this component's ScriptComponentData, or nil.
function Chest:_property(name)
	local props < const > = self.properties
	if props == nil then
		return nil
	end
	local v < const > = props:getProperty(name)
	if type(v) ~= "string" or v == "" then
		return nil
	end
	return v
end

-- What the level put in the box, as a fresh list of { kind, count } in the order it was
-- written. A new list every call: the Stage takes one when the chest is first opened and keeps
-- track of what is left in it from there, so nothing here is ever spent.
function Chest:contents()
	local list = {}
	local spec < const > = self:_property("item")
	if spec == nil then
		return list
	end

	local entries = {}
	for entry in string.gmatch(spec, "[^,]+") do
		local name < const >, n < const > = string.match(entry, "^%s*([%a_]+)%s*:?%s*(%d*)%s*$")
		if name == nil then
			print('Chest: cannot read "' .. entry .. '" in "' .. spec .. '"; left out.')
		else
			table.insert(entries, { name = string.lower(name), count = tonumber(n) })
		end
	end

	-- The older form: one kind, and its count in a property of its own.
	if #entries == 1 and entries[1].count == nil then
		entries[1].count = tonumber(self:_property("count") or "")
	end

	for _, entry in ipairs(entries) do
		local kind < const > = ALIASES[entry.name] or entry.name
		local def < const > = Items[kind]
		if def == nil then
			print('Chest: unknown item "' .. entry.name .. '"; left out.')
		elseif def.keep then
			print('Chest: a ' .. kind .. ' cannot be kept in a chest; left out.')
		elseif (entry.count or 1) > 0 then
			table.insert(list, { kind = kind, count = entry.count or 1 })
		end
	end
	return list
end

-- The level's own line for this chest, or nil.
function Chest:notice()
	return self:_property("notice")
end

function Chest:open(instant)
	if self._opened then
		return
	end
	self._opened = true
	self._openT = instant and 1.0 or 0.0
	self._posed = false

	-- The creak is skipped on the restore path: the chest was already opened in an earlier
	-- life of this script, and putting it back the way it was is not an event.
	if not instant then
		local fx < const > = self.owner:getComponent(traktor.world.EventSetComponent)
		if fx ~= nil then
			fx:raise("open")
		end
	end
end

function Chest:isOpen()
	return self._opened == true
end

function Chest:_lid()
	if self._lidEntity == nil then
		local group < const > = self.owner:getComponent(traktor.world.GroupComponent)
		if group ~= nil then
			self._lidEntity = group:getEntity("Lid", 0)
		end
	end
	return self._lidEntity
end

-- The swing. Runs whether or not the chest window has the game paused, so the lid is seen
-- coming up behind it.
function Chest:update(context, totalTime, deltaTime)
	-- A closed chest's lid stands exactly where it was authored: nothing to do. _posed stops an
	-- open one being re-written every frame forever.
	if not self._opened or self._posed then
		return
	end
	local lid < const > = self:_lid()
	if lid == nil then
		return
	end

	local t = math.min(1.0, (self._openT or 0.0) + deltaTime / SWING_TIME)
	self._openT = t
	if t >= 1.0 then
		self._posed = true
	end

	-- Out of the latch quickly, then easing back against the hinge stops.
	local k < const > = 1.0 - (1.0 - t) * (1.0 - t)
	local a < const > = k * SWING_ANGLE

	-- Negative pitch: a pitch about +X carries the lid's +Z (its front edge) downward, so
	-- lifting it is the other way.
	local base < const > = self.owner.transform
	local br < const > = base.rotation
	lid.transform = Transform(base.translation + br * HINGE, br * Quaternion.fromEulerAngles(0.0, -a, 0.0))
end
]]></text>
</object>
