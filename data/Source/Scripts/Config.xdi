<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
import(traktor)

-- Config
--
-- Every number that decides how the game *plays*, read from the "Zombie - Settings" property group
-- -- the same instance the native characters (zombie.NpcComponent and its brains) are tuned by, so
-- the night is retuned in one place for both.
--
-- Config.<group>.<name> reads as it always has. A group is looked up the first time something in it
-- is read, then kept, so a script may take Config.enemy at load and read from it later. Integers stay
-- integers, and lists come back as Lua arrays.
--
-- The settings come from the runtime's database. The editor's Scaffolding previews have no runtime,
-- and bind the database they are given instead (GameScaffolding:setup).

local SETTINGS < const > = Guid("\{6E9AD100-0000-4000-8000-000000000020}")

-- Kept on the table, as this chunk is run again whenever another script that uses it is loaded.
local database = (Config ~= nil) and rawget(Config, "_database") or nil
local settings = nil

-- The settings' root group, nil while there is no database to read it from.
local function rootGroup()
	if settings == nil then
		local db < const > = database or ((environment ~= nil) and environment.database or nil)
		if db ~= nil then
			settings = db:getObjectReadOnly(SETTINGS)
			if settings == nil then
				print("Config: no settings " .. SETTINGS:format())
			end
		end
	end
	return settings
end

local group

-- A value as script reads it: a group of the settings, a list, or a plain value.
local function valueOf(g, name, groupOf)
	local raw < const > = g:getPropertyRaw(name)
	if raw == nil then
		return nil
	elseif isa(raw, PropertyGroup) then
		return group(groupOf, name)
	elseif isa(raw, PropertyArray) then
		local list = {}
		for i = 0, raw:getPropertyCount() - 1 do
			local item < const > = raw:getProperty(i)
			if isa(item, PropertyGroup) then
				list[i + 1] = group(function() return item end, nil)
			else
				list[i + 1] = item:get()
			end
		end
		return list
	end
	return g:getProperty(name)
end

-- The group `name` of the group parentOf() finds; the root when name is nil.
group = function(parentOf, name)
	local resolved = nil
	local function groupOf()
		if resolved == nil then
			local parent < const > = parentOf()
			if parent ~= nil then
				resolved = (name ~= nil) and parent:getPropertyRaw(name) or parent
			end
		end
		return resolved
	end
	return setmetatable({}, {
		__index = function(t, key)
			local g < const > = groupOf()
			local value
			if g == nil then
				-- Nothing to read from yet: handed out as a group, looked up once it is read from.
				value = group(groupOf, key)
			else
				value = valueOf(g, key, groupOf)
			end
			if value ~= nil then
				rawset(t, key, value)
			end
			return value
		end
	})
end

Config = group(rootGroup, nil)
rawset(Config, "_database", database)

-- Read the settings out of `db` rather than the runtime's database.
rawset(Config, "bind", function(db)
	database = db
	settings = nil
	rawset(Config, "_database", db)
end)
]]></text>
</object>
