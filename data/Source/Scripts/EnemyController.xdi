<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{6E9AD100-0000-4000-8000-000000000010}

import(traktor)

-- EnemyController: a ScriptComponent state machine that drives the owner entity's
-- character controller across the scene nav mesh.
--
--   * PATROL - wander between random nav-mesh points (slow), on a leash: past a certain
--              distance the wander is biased back towards the player. See :_wanderPoint.
--   * INVESTIGATE - walk to where the player was heard firing (medium). See :investigate
--              and the hearing block in update.
--   * ATTACK - chase the player (fast). Entered the moment the player is "spotted":
--              within sight range AND with a clear physics line of sight.
--
-- Losing sight does not drop ATTACK instantly; the enemy keeps chasing for a short
-- memory window first. That feels natural ("I just saw you go that way") and also
-- damps mode flicker when another agent briefly crosses the view ray. A zombie put
-- into ATTACK by :hunt rather than :alertTo never comes out of it at all -- see there.
--
-- Both modes are held off for the first _spawnDelay seconds of a zombie's life: it
-- stands still and its "moving" parameter is left alone, so it reads as getting up
-- instead of sliding off the instant it appears.
--
-- Biting is separate from the ATTACK mode above (which is only "chase"): the "attack"
-- animation parameter tracks whether this zombie is close enough to actually drain the
-- player's health, i.e. it mirrors the Stage's contact-damage test.
--
-- Which mode a zombie is in can be seen while playing from the editor: when the stage
-- carries a DebugLayer, every live zombie gets a dot over its head coloured by what it
-- knows about the player. See the awareness block in update.
--
-- Attach to an entity that has a AiCharacterComponent and an (animated/skinned) mesh.
-- Inherits the native ScriptComponent (self.owner/.world).

EnemyController = EnemyController or class("EnemyController", traktor.world.ScriptComponent)

local COLLISION_DEFAULT = 0x00000001
local COLLISION_INTERACTABLE = 0x00000002

-- Lit wards are nothing to this controller. A ward's light kills what is standing on its
-- ground the moment it catches (Main:_purgeWard) and the Spawner will not place anything
-- inside one afterwards, but the horde neither steers out of one nor arcs around it: it
-- walks through consecrated ground like any other ground.
--
-- That is a deliberate removal, not an omission. Every version of "the horde avoids a
-- ward" ended up costing more than it bought -- zombies piling against a rim, circling
-- inside overlapping discs, chase targets shoved onto ground they could not reach -- and
-- all of it in service of ground the player is only standing on for a few seconds. The
-- flare that clears the ward is the mechanic; the rest was upkeep.

-- Tuning. Every number below is Scripts/Config's, aliased into a local so the code reads
-- the same as it always did and the lookup happens once at load rather than per frame.
-- What each one is *for* is documented where it is used; why it is the value it is, is
-- documented in Config next to the value.
local CFG < const > = Config.enemy
local CFG_MELEE < const > = Config.melee

-- How long a freshly spawned zombie hunts the player without having seen them. NOTE these
-- are not seconds: _lostTimer is only decremented inside the one-in-four perception
-- sample, so it burns down at roughly a quarter of real time.
local SPAWN_HUNT < const > = CFG.spawnHunt

-- Inside this range of the player, a chasing zombie faces the player rather than facing
-- the way it is steering (see the facing block in update, which is also the story of why
-- it exists).
local CLOSE_QUARTERS < const > = CFG.closeQuarters

-- Being shoved (see :hit and :_stagger, and Main:_meleeAttack, which swings the rifle
-- butt). How far the shove carries, how long it takes to deliver, and how long the zombie
-- is out of the fight altogether. The distance is delivered exactly, by metres owed rather
-- than by a speed held for a time -- see :_stagger.
local HIT_KNOCKBACK < const > = CFG_MELEE.knockback
local HIT_PUSH_TIME < const > = CFG_MELEE.pushTime
local HIT_STUN < const > = CFG_MELEE.stun

-- Hearing (see the hearing block in update, and :investigate). Patrol wanders to a random
-- nav point within two metres and repeats, which is a random walk: half the horde drifts
-- *away* from the player and stays drifted. The rifle is the pull that biases that walk
-- back inwards.
local HEAR_RANGE < const > = CFG.hearRange

-- ...and a rough idea of where it came from, not a fix. The guess is scattered inside a
-- square of this half-width, which grows with range.
local HEAR_SPREAD < const > = CFG.hearSpread
local HEAR_SPREAD_PER_M < const > = CFG.hearSpreadPerM

-- Close enough to the guess to count as having got there and gone back to patrolling.
local INVESTIGATE_ARRIVE < const > = CFG.investigateArrive

-- ...and the most time spent on one guess before giving it up (s). A zombie that spends
-- twenty seconds walking towards the shooting and then goes back to wandering has done its
-- job -- it is now wandering somewhere that matters.
local INVESTIGATE_TIME < const > = CFG.investigateTime

-- The patrol leash (see :_wanderPoint). Hearing fixes the drift only while the player is
-- shooting; this is the half of it that works in silence. Inside PATROL_LEASH nothing
-- changes at all -- the near horde mills about in the dark exactly as it did. Beyond it the
-- shift towards the player ramps in over the next PATROL_PULL metres, so there is no line
-- in the forest that zombies visibly bounce off.
--
-- What it does is hand them off rather than chase: a zombie walked back to the fence is
-- inside HEAR_RANGE, where the next shot fired takes over and brings it the rest of the way.
local PATROL_LEASH < const > = CFG.patrolLeash
local PATROL_PULL < const > = CFG.patrolPull

-- How far a patrol leg reaches (m), and how far towards the player its search disc is
-- shifted at full strength. The shift is most of the radius, so the disc then lies mostly
-- inward and the walk home is direct without being a straight line -- roughly a leg in five
-- still goes sideways or back, which is what keeps it a shamble rather than a march.
local PATROL_STEP < const > = CFG.patrolStep
local PATROL_BIAS < const > = CFG.patrolBias

-- Voices (see EnemyController:_voice). Past VOICE_RANGE a zombie is silent, and each one
-- waits a randomised interval drawn per zombie rather than shared, so they never fall into
-- step. A zombie that is actually on the player gets to be more insistent.
local VOICE_RANGE < const > = CFG.voiceRange
local VOICE_CLOSE_RANGE < const > = CFG.voiceCloseRange
local VOICE_INTERVAL_MIN < const > = CFG.voiceIntervalMin
local VOICE_INTERVAL_MAX < const > = CFG.voiceIntervalMax
local VOICE_INTERVAL_CLOSE < const > = CFG.voiceIntervalClose

-- Awareness dot (see the debug block in update). Height is measured from the entity
-- origin, which sits at the zombie's feet, so this clears the head with a little air.
--
-- Size is a screen-space figure, not metres: the primitive renderer divides it by 500 to
-- get a radius in normalised device coordinates, which works out around six pixels across
-- at 1080p. Constant with distance, deliberately -- a zombie on the far ridge is exactly
-- the case worth being able to read, and one that scaled would have vanished.
local DEBUG_DOT_HEIGHT < const > = 2.1
local DEBUG_DOT_SIZE < const > = 5.0
local DEBUG_C_SIGHTED < const > = Color4f(1.0, 0.12, 0.06, 1.0) -- chasing, can see the player now
local DEBUG_C_MEMORY < const > = Color4f(1.0, 0.62, 0.05, 1.0)  -- chasing on memory, or sent by :hunt
local DEBUG_C_UNAWARE < const > = Color4f(0.18, 0.34, 0.62, 1.0) -- patrolling, has not noticed anything
local DEBUG_C_HEARD < const > = Color4f(0.30, 0.82, 0.36, 1.0)   -- walking to where a shot was heard

function EnemyController:new()
	self._repathTimer = 0.0
	self._heading = nil       -- current facing (radians)
	self._turnRate = CFG.turnRate      -- max turn speed (rad/s); reversals happen gradually
	self._avoidRadius = CFG.avoidRadius -- start avoiding other zombies within this distance (m)
	self._separation = CFG.separation  -- how strongly avoidance overrides path following

	-- How much room a zombie leaves the *player*, as opposed to the two and a half metres it
	-- leaves another zombie. It is not there to keep its distance -- it is there to stop it
	-- standing inside the man it is eating. The push ramps from nothing at this distance to
	-- _separation at the player's own position, so the two cancel at exactly half of it,
	-- which is where a zombie comes to rest.
	self._playerSpace = CFG.playerSpace

	-- State machine.
	self._state = "patrol"    -- "patrol" | "investigate" | "attack"
	self._lostTimer = 0.0     -- remaining ATTACK memory after losing sight (s)
	self._spotted = false     -- last perception sample: clear line of sight to the player
	self._relentless = false  -- set by :hunt; ATTACK is then never given up
	self._patrolTarget = nil  -- current wander destination (Vector4)
	self._sightRange = CFG.sightRange     -- furthest the player can be spotted (m)
	self._attackMemory = CFG.attackMemory -- keep chasing this long after losing sight (s)

	-- Hearing. _heardShot bookmarks the sequence number of the last shot this zombie is
	-- aware of, whether or not it was in any position to act on it -- see the hearing
	-- block in update for why that bookmark is what makes stale gunfire a non-problem.
	self._heardShot = nil
	self._investigateTarget = nil -- where it believes the shot came from (Vector4)
	self._investigateTimer = 0.0  -- time left on the current guess (s)
	-- Per-instance pace, drawn once here and kept for this zombie's lifetime so an individual
	-- has a consistent gait rather than jittering frame to frame. The walk animation takes
	-- its time from distance travelled (TimeFromLocomotion on the Walk state), so the cycle
	-- rate follows the pace on its own and the feet do not slide.
	local pace = CFG.paceMin + math.random() * CFG.paceRange
	self._patrolSpeed = CFG.patrolSpeed * pace
	self._attackSpeed = CFG.attackSpeed * pace
	self._investigateSpeed = CFG.investigateSpeed * pace

	self._dead = false   -- set once shot by the player; switches the body to rag doll

	-- Shoved by the player (see :hit). _hitTimer is the whole reel, _pushTimer the part of
	-- it the shove is still being carried over, and _pushLeft the metres of it still owed.
	-- All three at rest, so a zombie nobody has hit costs one compare a frame.
	self._hitTimer = 0.0
	self._pushTimer = 0.0
	self._pushLeft = 0.0
	self._hitX = 0.0     -- ...and the way out, on the ground plane (unit length)
	self._hitZ = 0.0

	-- Zombies rise before they walk: stay put this long after spawning, and leave
	-- "moving" untouched meanwhile so the graph holds its stand-up state. Perception
	-- and path finding keep running, so the first step lands the moment it expires.
	self._spawnDelay = CFG.spawnDelay   -- (s) counted from the controller's first live update
end

-- Arrive with intent. Called by Scripts/Spawner on a zombie it has just placed.
--
-- The spawner only ever puts one down where the player cannot see it -- and cover
-- works both ways, so left to itself the new zombie cannot see the player either. It
-- fails its perception check, stays on patrol, and patrol wanders to a random point
-- within *two metres* at 0.55 m/s. So it loiters in the bush it rose behind while the
-- player walks past at three metres a second, and only starts chasing once they are
-- well beyond it and the sight line finally opens -- from behind. That is the whole
-- reason the horde was only ever met from the back.
--
-- Being told the player is out there lets it walk out of that cover towards them,
-- which is where they meet it. Expressed as the existing chase-from-memory state
-- rather than a new one: attack already re-paths to the player's live position twice
-- a second, and the first real sighting simply refreshes the timer and takes over. If
-- it never gets that sighting it drops back to patrol none the wiser.
function EnemyController:alertTo(hunt)
	self._state = "attack"
	self._lostTimer = hunt or SPAWN_HUNT
	self._patrolTarget = nil
	self._repathTimer = 0.0   -- path on the very first update rather than in half a second
end

-- Hunt without end. Called by Scripts/Hive on a zombie it has just sent up out of a
-- hive: this one was summoned rather than stumbled upon, so it knows where the player
-- is from the moment it rises and never loses interest.
--
-- alertTo's memory window is wrong for it in both directions. A hive can be the far
-- side of the map, which is minutes of walking -- far longer than any window worth
-- calling a memory -- and a brood that timed out would drop to patrol and mill about
-- wherever it happened to have got to, which is the one thing a hive must not produce.
-- So the attack -> patrol transition is suppressed outright rather than given a very
-- large number: a real sighting refreshes _lostTimer to _attackMemory, which would
-- quietly hand any such number back.
function EnemyController:hunt()
	self:alertTo()
	self._relentless = true
end

-- Take a shove. Called by Main:_meleeAttack on the zombie the player has just swung the
-- rifle butt at, with the direction to go -- which is out from the player, and so
-- backwards, since anything close enough to be hit is facing the man it is trying to eat.
--
-- Deliberately not a death and deliberately not damage: there is no health on a zombie to
-- take and nothing here counts towards the night. What the swing buys is room and a couple
-- of seconds -- enough to finish a reload, or to get a relic out of a crowd -- and the
-- whole cost of it is that those are seconds not spent shooting.
--
-- Shoving one that is already reeling simply restarts it, which is what a second swing
-- ought to do; the limit on chaining that is the melee's own cooldown over in Main, which
-- is the only place it belongs. Returns false for a corpse, so the caller can tell a swing
-- that landed on something living from one that hit a body already on its way down.
function EnemyController:hit(dirX, dirZ)
	if self._dead then
		return false
	end

	local len < const > = math.sqrt(dirX * dirX + dirZ * dirZ)
	if len < 0.001 then
		return false
	end

	self._hitX = dirX / len
	self._hitZ = dirZ / len
	self._hitTimer = HIT_STUN
	self._pushTimer = HIT_PUSH_TIME
	self._pushLeft = HIT_KNOCKBACK
	return true
end

-- One frame of being shoved (see :hit). Replaces everything the controller would normally
-- do with the shove itself, and only for the first HIT_PUSH_TIME of the window -- the rest
-- of it is the zombie finding its feet again, standing where the shove left it.
function EnemyController:_stagger(deltaTime)
	self._hitTimer = self._hitTimer - deltaTime

	-- "hit" is a pulse rather than a state: SG - Zombie leaves its Hit state on its own
	-- when the animation ends, and would walk straight back into it if the parameter were
	-- still set -- a zombie reeling for ever off one swing. Held for the length of the
	-- shove, which is many frames (so a graph that happens to be mid-blend on the frame the
	-- swing landed still sees it) and well short of the two seconds the animation runs (so
	-- it is long gone by the time the graph comes back to look).
	--
	-- "moving" and "attack" are pointedly left alone while it is held, and cleared only
	-- after. The graph takes the first transition out of a state whose condition holds, in
	-- the order they are listed, and every state's own exit -- Walk on !moving, Attack on
	-- !attack -- is listed above its jump to Hit. So clearing them here would answer the
	-- swing by walking out of Walk into Idle and only reaching the reaction a blend later,
	-- with the zombie sliding backwards in its walk pose meanwhile. Left true, those exits
	-- simply do not fire and the reaction wins outright.
	--
	-- They do have to be cleared eventually, and the frames after the shove are exactly
	-- when: the graph is parked in Hit by then, where neither means anything, and if they
	-- were still latched when it came back to Idle the zombie would walk or bite its way
	-- out of the reaction rather than waiting for its controller.
	--
	-- (A zombie shoved while it is still standing up gets the two metres but no reaction:
	-- there is no Hit transition out of the stand-up state, and interrupting a zombie
	-- getting to its feet is not obviously worth having one.)
	local pushing < const > = self._pushTimer > 0.0 and self._pushLeft > 0.0
	if self._pose ~= nil then
		self._pose:setParameterValue("hit", pushing)
		if not pushing then
			self._pose:setParameterValue("moving", false)
			self._pose:setParameterValue("attack", false)
		end
	end
	if not pushing then
		return
	end

	-- Eased out: a speed falling linearly to nothing over the time still left covers the
	-- distance still owed when it starts at twice the average, which is all this is. So the
	-- shove lands hard and the body coasts to a stop, instead of being carried off at a
	-- constant rate and stopping dead.
	--
	-- Taken from what remains rather than from a curve fixed at the moment of the hit,
	-- which is what makes the two metres two metres: sampling a fixed ramp once a frame
	-- always undershoots it, and undershoots it by more the coarser the frames get. This
	-- form spends whatever the last frame left over on the next one, so the distance is
	-- exact and does not depend on the frame rate.
	local speed = 2.0 * self._pushLeft / self._pushTimer

	-- ...and never more than the metres still owed, which is also what holds the last frame
	-- -- where the time left goes to nothing and the expression above runs away with it --
	-- to a step rather than a launch.
	local step = speed * deltaTime
	if step > self._pushLeft then
		step = self._pushLeft
		speed = step / deltaTime
	end
	self._pushLeft = self._pushLeft - step
	self._pushTimer = self._pushTimer - deltaTime

	-- maxVelocity is the controller's clamp on the impulse below -- not the impulse itself --
	-- so it has to be raised to the shove's speed or the zombie would be knocked back at
	-- walking pace and travel a quarter of the distance. Nothing has to put it back: the
	-- normal path sets it from _attackSpeed every frame, so it repairs itself on recovery.
	--
	-- Physics owns the rest. The shove is a velocity, not a teleport, so a zombie put through
	-- a tree stops at the tree with its metres unspent -- which is the right answer, and one
	-- no amount of arithmetic here could have got to.
	self._character.maxVelocity = speed
	self._character:move(Vector4(self._hitX * speed, 0.0, self._hitZ * speed, 0.0), false)
end

-- Go and have a look. Called from the hearing block in update with an already-scattered
-- guess at where the rifle went off, which is a place rather than a person: this state
-- walks to a fixed point and knows nothing about where the player has got to since.
--
-- Kept a state of its own rather than expressed as "patrol, but to that point over there"
-- because the two differ in every part that matters -- pace, how the destination is chosen,
-- when it is abandoned -- and because the debug dots are worth being able to tell apart. A
-- field of green dots converging is the horde acting on a shot; the same field in blue is
-- the horde ignoring it, and confusing the two would hide the only failure mode this has.
--
-- Deliberately does not clear _pathQuery. The route in flight is a patrol leg of at most
-- two metres, and _repathTimer = 0.0 puts a fresh query out on the very next update, so
-- the worst it can do is a frame or two of walking the old way -- the same trade alertTo
-- makes, for the same reason.
function EnemyController:investigate(x, z)
	self._state = "investigate"
	self._investigateTarget = Vector4(x, 0.0, z, 1.0)
	self._investigateTimer = INVESTIGATE_TIME
	self._patrolTarget = nil
	self._repathTimer = 0.0
end

-- Draw the next patrol destination: a random *reachable* nav point a couple of metres off
-- -- findRandomPoint walks the mesh outward from its centre, so what comes back is always
-- somewhere this zombie can get to -- from a disc shifted towards the player by however
-- hard the leash is pulling. See PATROL_LEASH for why it pulls at all, and when.
--
-- Returns nil rather than a bad point when the mesh has nothing to offer, which matters
-- more than it looks: findRandomPoint reports failure by handing back a zero vector, and a
-- zero vector taken at face value is a patrol target at the world origin -- a zombie
-- quietly setting off across the map for the corner of the terrain, one leg at a time. The
-- w component is the tell, since the engine only builds a positional (w = 1) vector on its
-- success path and leaves w at zero otherwise.
function EnemyController:_wanderPoint(enemyPos, playerPos)
	local cx, cz = enemyPos.x, enemyPos.z

	local dx < const > = playerPos.x - enemyPos.x
	local dz < const > = playerPos.z - enemyPos.z
	local d < const > = math.sqrt(dx * dx + dz * dz)
	if d > PATROL_LEASH then
		local pull = (d - PATROL_LEASH) / PATROL_PULL
		if pull > 1.0 then
			pull = 1.0
		end
		local bias < const > = PATROL_BIAS * pull
		cx = cx + (dx / d) * bias
		cz = cz + (dz / d) * bias
	end

	-- Height stays the zombie's own: there is no cheap way to ask what the ground does a
	-- metre and a half away, and its own feet are the best guess available.
	local point = self._navMesh:findRandomPoint(Vector4(cx, enemyPos.y, cz, 1.0), PATROL_STEP)
	if point ~= nil and point.w >= 0.5 then
		return point
	end

	-- ...and where that guess is wrong the draw fails outright, since findRandomPoint snaps
	-- its centre to the mesh through a search box only a metre tall -- so on ground steep
	-- enough it misses the mesh entirely. Fall back to the plain unbiased draw from the
	-- feet, which are on the mesh by construction. A leg that forgets the leash is a much
	-- smaller thing than a zombie standing still on a hillside because its draw kept
	-- failing, and the next leg gets to try again anyway.
	point = self._navMesh:findRandomPoint(enemyPos, PATROL_STEP)
	if point ~= nil and point.w >= 0.5 then
		return point
	end
	return nil
end

-- Drive the enemy's animation graph into its "dead" rag doll state by setting the
-- "dead" parameter on its pose controller (SG - Enemy handles the transition).
function EnemyController:_enterRagDoll()
	local pose = self._pose
	if pose == nil then
		local skeleton = self.owner:getComponent(traktor.animation.SkeletonComponent)
		if skeleton ~= nil then
			pose = skeleton.poseController
		end
	end
	if pose ~= nil then
		pose:setParameterValue("dead", true)
		-- Stop biting, and stop reeling; update() returns early from now on, so either
		-- would otherwise stay latched and fire straight into that state if the corpse
		-- ever revived. Neither is load-bearing for the rag doll itself -- every state
		-- reaches Dead ahead of Attack or Hit, including Hit, so a zombie shot mid-shove
		-- goes down out of the reaction -- they are cleared because a parameter nobody
		-- will ever set false again is a trap left lying for whoever adds the next state.
		pose:setParameterValue("attack", false)
		pose:setParameterValue("hit", false)
	end

	-- Hand the body over to the rag doll: disable the character controller so it
	-- stops driving (and fighting over) the entity transform and removes its
	-- collision capsule. Without this the controller keeps re-positioning the
	-- entity for a frame or two after death, and because the rag doll pose is
	-- expressed relative to that transform the limbs visibly pop before settling.
	local character = self._character
	if character == nil then
		character = self.owner:getComponent(traktor.physics.AiCharacterComponent)
	end
	if character ~= nil then
		character.enabled = false
	end
end

function EnemyController:update(context, totalTime, deltaTime)
	local enemy = self.owner
	local world = self.world
	if context == nil or enemy == nil or world == nil then
		return
	end

	-- Freeze all enemy logic once the game is over or paused (context is the Stage).
	if context._gameOver or context._paused then
		return
	end

	-- Shot by the player? Switch to rag doll once, then stop all behaviour so the
	-- corpse is driven purely by physics (Main despawns it after a delay).
	if not self._dead and context._deadEnemies ~= nil and context._deadEnemies[enemy] ~= nil then
		self:_enterRagDoll()
		self._dead = true
	end
	if self._dead then
		return
	end

	-- A hive is opening somewhere and the camera is watching it (Main:_beginCutscene).
	-- Everything holds still for that except the zombies inside the hive -- its own
	-- brood, rising and walking out, which is the whole subject of the shot.
	--
	-- Tested by distance from the hive rather than by asking who spawned whom: the
	-- Stage publishes the focus and its squared radius, so this costs a subtraction and
	-- a compare, needs no bookkeeping to stay in step with what the hive has actually
	-- sent up, and reads the way the rule is meant ("the zombies at the hive are awake")
	-- rather than as a list of exceptions.
	--
	-- Below the rag doll switch above, deliberately: a zombie the player shot on the way
	-- in still has to be allowed to hand itself over to physics, or the purge that lit
	-- this hive leaves a field of bodies standing to attention until the shot ends. Same
	-- reasoning as the dawn, which does not freeze them either.
	local cutscene < const > = context._cutscene
	if cutscene ~= nil then
		local p < const > = enemy.transform.translation
		local dx < const > = p.x - cutscene.x
		local dz < const > = p.z - cutscene.z
		if dx * dx + dz * dz > cutscene.r2 then
			return
		end
	end

	-- Resolve and cache dependencies.
	if self._character == nil then
		self._character = enemy:getComponent(traktor.physics.AiCharacterComponent)
		if self._character ~= nil then
			-- move() only feeds impulses, which the controller accumulates until this
			-- clamp stops them - a couple of frames of walking - so maxVelocity, not the
			-- impulse magnitude, is what the enemy actually travels at. It carries this
			-- zombie's randomised pace (see :new()). Re-applied every frame further
			-- down, scaled by the Stage's ward escalation.
			self._character.maxVelocity = self._attackSpeed
		end
	end
	if self._pose == nil then
		local skeleton = enemy:getComponent(traktor.animation.SkeletonComponent)
		if skeleton ~= nil then
			self._pose = skeleton.poseController
		end
	end
	if self._navMesh == nil then
		local navComponent = world:getComponent(traktor.ai.NavMeshComponent)
		if navComponent ~= nil then
			self._navMesh = navComponent:get()
		end
	end
	if self._player == nil then
		self._player = world:getEntity("Humanoid")
	end
	if self._character == nil or self._navMesh == nil or self._player == nil then
		return
	end
	if self._heading == nil then
		self._heading = self._character.headAngle
	end

	local enemyPos = enemy.transform.translation
	local playerPos = self._player.transform.translation
	local dp = playerPos - enemyPos
	local pdist = dp.length

	-- Do not check perception every update since it involves ray queries.
	if math.random() < 0.25 then
		-- ---- Perception: is the player spotted? (in range + clear line of sight) ----
		local spotted = false
		if pdist < self._sightRange then
			local pm < const > = context.environment.physics.physicsManager
	
			-- Ray from the enemy's eye to the player's chest. The player's own capsule
			-- sits at ~pdist, so a hit well before that means a wall blocks the view.
			local e = enemyPos + Vector4(0.0, 1.6, 0.0)
			local t = playerPos + Vector4(0.0, 1.2, 0.0)
			local r = t - e
			local rl = r.length
			if rl > 0.01 then
				local hit = pm:queryRay(e, r / rl, rl, physics.QueryFilter(COLLISION_DEFAULT), true)
				if hit == nil or hit.distance >= rl - 0.8 then
					spotted = true
				end
			end
		end
	
		-- Latched for the awareness dot below, which is drawn every frame while this is
		-- only sampled one frame in four.
		self._spotted = spotted

		-- ---- State transitions ----
		if spotted then
			self._lostTimer = self._attackMemory
			if self._state ~= "attack" then
				self._state = "attack"
			end
		elseif self._state == "attack" and not self._relentless then
			-- ...unless it is hunting (see :hunt), in which case losing sight of the
			-- player never means giving up on them.
			self._lostTimer = self._lostTimer - deltaTime
			if self._lostTimer <= 0.0 then
				self._state = "patrol"
				self._patrolTarget = nil
				self._repathTimer = 0.0
			end
		end

		-- ---- Hearing: has the player fired? ----
		--
		-- Published by the Stage as a single record with a sequence number (Main:_fireWeapon)
		-- rather than pushed at the zombies shot by shot. The state machine lives here, so
		-- the decision about whether a zombie is in any position to care belongs here too --
		-- and a stage that only writes three numbers per shot does not care how many zombies
		-- are listening.
		--
		-- Note the bookmark is taken whatever this zombie is doing, and whether or not the
		-- shot was even audible from here. That is what keeps old gunfire from mattering
		-- without anyone having to timestamp it: a zombie that spent a firefight chasing has
		-- already read every one of those shots off the counter by the time it loses the
		-- player, so it drops back to patrol instead of setting off for a clearing the player
		-- left a minute ago. Sampling runs about fifteen times a second, so what the bookmark
		-- says is never more than a frame or two behind the trigger.
		--
		-- Below the transitions above on purpose: a zombie that can see the player this
		-- sample chases them, and does not go to look at a noise it has an answer to.
		local shot < const > = context._gunshot
		if shot ~= nil and shot.seq ~= self._heardShot then
			self._heardShot = shot.seq
			-- Patrol and investigate both listen -- a second shot is a better fix than the
			-- one already being walked to, and re-aiming at it is free. Attack does not:
			-- it is following the player themselves, which beats any guess, and a hunting
			-- zombie (:hunt) must never be diverted at all.
			if self._state ~= "attack" then
				local hx < const > = shot.x - enemyPos.x
				local hz < const > = shot.z - enemyPos.z
				local hd < const > = math.sqrt(hx * hx + hz * hz)
				if hd < HEAR_RANGE then
					local spread < const > = HEAR_SPREAD + hd * HEAR_SPREAD_PER_M
					self:investigate(
						shot.x + (math.random() * 2.0 - 1.0) * spread,
						shot.z + (math.random() * 2.0 - 1.0) * spread
					)
				end
			end
		end
	end

	-- ---- Debug: does this one have the player? ----
	--
	-- A dot over the head of every live zombie: red once it is chasing and can see the
	-- player right now, amber when it is chasing without a current sighting -- burning
	-- down _lostTimer, or sent out by :hunt, which never had a sighting to begin with --
	-- green while it is on its way to a shot it heard, and blue while it is still
	-- patrolling and has noticed nothing. So the amber ones are the horde converging on
	-- where the player was, and turn red as they come round the rock and find them.
	--
	-- The green is worth watching for its own sake, since it is the one thing here that
	-- answers a question about the *shape* of the night rather than about one zombie: fire
	-- a round and the blue dots within earshot should turn green and start closing. A field
	-- that stays blue means nothing is being pulled inwards, and the horde is back to
	-- wandering off to be simulated somewhere the player will never go.
	--
	-- The layer draws with depth testing off, which is most of what makes this worth
	-- having: the dots read through the terrain, so the whole horde's state is legible at
	-- once rather than only the part with a clear line to the camera.
	--
	-- Placed here rather than at the end of update on purpose -- a zombie still standing
	-- up through its _spawnDelay returns before then, and one rising out of a hive with a
	-- :hunt already on it is exactly a thing worth seeing. Nothing above this point draws:
	-- a corpse, a stage that is over or paused, and a zombie frozen outside a cutscene all
	-- return earlier, and none of them is thinking about anything.
	--
	-- context.debug is the runtime's DebugLayer, cached as a member by the base Stage
	-- class. It exists only when the stage was started from the editor with the "Debug
	-- Layer" tweak on -- StageData appends it when Runtime.DebugLayer is set -- so nil is
	-- the normal shipped case, and simply means no dots.
	local dbg < const > = context.debug
	if dbg ~= nil then
		local colour < const > = (self._state == "investigate" and DEBUG_C_HEARD)
			or (self._state ~= "attack" and DEBUG_C_UNAWARE)
			or (self._spotted and DEBUG_C_SIGHTED)
			or DEBUG_C_MEMORY
		dbg:point(enemyPos + Vector4(0.0, DEBUG_DOT_HEIGHT, 0.0, 0.0), DEBUG_DOT_SIZE, colour)
	end

	-- ---- Shoved: everything below is suspended for the reel (see :hit) ----
	--
	-- No route, no steering, no bite; the body is driven by the shove instead. The path
	-- query in flight is left alone and _repathTimer is left unticked, so it is already due
	-- when the zombie comes back and the first update after the reel puts a fresh one out.
	--
	-- Below the perception sample and the dot rather than at the top of update, and that is
	-- the whole reason it sits here: a zombie shoved off the player goes on watching them
	-- through the reel, so it sets off again the moment it recovers instead of spending a
	-- sample rediscovering where they went -- and it still reports what it knows to the
	-- debug layer while it is reeling, which is when one most wants to see it.
	if self._hitTimer > 0.0 then
		self:_stagger(deltaTime)
		return
	end

	-- Pace multiplier from the Stage: every ward the player lights makes the forest
	-- outside it faster (see Main:_publishWards). Read per frame and applied to
	-- maxVelocity as well, so already-spawned zombies speed up too -- setting it
	-- once at resolve would leave the existing horde ambling at the old rate.
	-- Defaults to 1.0, so this controller still behaves standalone.
	local pace < const > = context._enemyPace or 1.0

	local speed = self._patrolSpeed * pace
	if self._state == "attack" then
		speed = self._attackSpeed * pace
	elseif self._state == "investigate" then
		speed = self._investigateSpeed * pace
	end
	if self._character ~= nil then
		self._character.maxVelocity = self._attackSpeed * pace
	end

	-- ---- Collect the finished path query, then choose a destination and issue the next ----

	-- Adopt the async result once it is ready (get() blocks on wait()). Clear the slot
	-- either way: a query that found no route also reports ready, and the code below
	-- skips while a query is in flight, so a failed one parked here would stop this
	-- zombie from ever re-pathing again.
	if self._pathResult ~= nil and self._pathResult.ready then
		local query = self._pathResult:get()
		if query ~= nil then
			self._pathQuery = query
		end
		self._pathResult = nil
	end

	-- Never let path queries stack up: each createMoveQuery posts a job that allocates
	-- its own 2048-node Detour query and runs a full A*, so with a hundred zombies
	-- asking twice a second, issuing another while the previous is still in flight lets
	-- the job queue grow faster than the workers drain it -- and the backlog only ever
	-- gets worse. The timer is deliberately not reset when we skip, so the query goes
	-- out the moment the slot frees.
	self._repathTimer = self._repathTimer - deltaTime
	if self._state == "attack" then
		if self._repathTimer <= 0.0 and self._pathResult == nil then
			self._repathTimer = 0.5
			-- Where to chase to: the player, wherever they are standing. A lit ward used
			-- to divert this to the ring outside it, on the grounds that consecrated
			-- ground could not be entered -- it can now, so there is nothing to divert
			-- for and a player standing in the light is chased like any other player.
			--
			-- Jittered so the horde does not stack every one of its paths on one point.
			local jitter = 1.5
			local aimX = playerPos.x + (math.random() * 2.0 - 1.0) * jitter
			local aimZ = playerPos.z + (math.random() * 2.0 - 1.0) * jitter
			-- Snap onto the ground beneath the aim. findClosestPointXZ ignores height, so
			-- it still resolves to the terrain when the player has climbed a tower or a
			-- roof -- where the old height-limited findClosestPoint failed (handing back the
			-- mid-air point) or snapped to a roof polygon off to the side, sending the horde
			-- the wrong way. Searched from the zombie's own ground level, so a genuinely
			-- stacked surface resolves to the reachable one.
			local target = self._navMesh:findClosestPointXZ(Vector4(aimX, enemyPos.y, aimZ, 1.0), 4.0)
			self._pathResult = self._navMesh:createMoveQuery(enemyPos, target)
		end
	elseif self._state == "investigate" then
		-- Walking to a place, not after a person: the destination was fixed when the shot
		-- was heard and is not re-aimed as the player moves. Re-pathing to it on the same
		-- 1.5 s beat as patrol is only there to unstick a zombie whose route has gone stale
		-- against the crowd, not to refresh the target -- there is nothing fresher to know.
		--
		-- Two ways out, and the state above is a third: arriving, and running out of time.
		-- Neither is a failure. Both hand back to patrol from wherever it has got to, which
		-- is the entire point of the exercise -- it is now wandering near the shooting
		-- instead of a minute's walk the other way.
		self._investigateTimer = self._investigateTimer - deltaTime
		local goal < const > = self._investigateTarget
		local done = goal == nil or self._investigateTimer <= 0.0
		if not done then
			local gx < const > = goal.x - enemyPos.x
			local gz < const > = goal.z - enemyPos.z
			done = gx * gx + gz * gz < INVESTIGATE_ARRIVE * INVESTIGATE_ARRIVE
		end
		if done then
			self._state = "patrol"
			self._investigateTarget = nil
			self._patrolTarget = nil
			self._repathTimer = 0.0
		elseif self._repathTimer <= 0.0 and self._pathResult == nil then
			self._repathTimer = 1.5
			-- Snapped the same way a chase target is, and for the same reasons: the guess is
			-- a scattered point on open ground that may well have landed inside a rock or on
			-- a roof, and searching from the zombie's own height resolves stacked surfaces to
			-- the one it can actually walk on.
			local target = self._navMesh:findClosestPointXZ(Vector4(goal.x, enemyPos.y, goal.z, 1.0), 4.0)
			self._pathResult = self._navMesh:createMoveQuery(enemyPos, target)
		end
	else
		-- Patrol: take a fresh random nav point when we have none, on arrival, or
		-- every few seconds (so an enemy that gets stuck re-routes).
		local needNew = self._patrolTarget == nil
		if not needNew then
			local ax = self._patrolTarget.x - enemyPos.x
			local az = self._patrolTarget.z - enemyPos.z
			if ax * ax + az * az < 1.2 * 1.2 then
				needNew = true
			end
		end
		if (needNew or self._repathTimer <= 0.0) and self._pathResult == nil then
			self._repathTimer = 1.5
			if needNew then
				self._patrolTarget = self:_wanderPoint(enemyPos, playerPos)
			end
			-- Guarded because _wanderPoint can come back empty-handed: a move query to a nil
			-- destination is not a question the nav mesh can be asked. Nothing else is needed
			-- to recover -- a nil target is exactly what needNew tests for, so the next update
			-- draws again, and _repathTimer having been spent does not hold that up.
			if self._patrolTarget ~= nil then
				self._pathResult = self._navMesh:createMoveQuery(enemyPos, self._patrolTarget)
			end
		end
	end

	-- Desired direction toward the next waypoint (zero when there is no path / arrived).
	local targetX, targetZ = 0.0, 0.0
	if self._pathQuery ~= nil then
		local moveTo = self._pathQuery:update(enemyPos, 0.5)
		if moveTo ~= nil then
			local dx = moveTo.x - enemyPos.x
			local dz = moveTo.z - enemyPos.z
			local len = math.sqrt(dx * dx + dz * dz)
			if len > 0.01 then
				targetX = dx / len
				targetZ = dz / len
			end
		end
	end

	-- Collision avoidance: accumulate a push away from nearby agents (other enemies
	-- and the player). This enemy is in the "Enemy" list too, but its own delta is zero.
	local sepX, sepZ = 0.0, 0.0
	local function avoid(px, pz, radius)
		local ax = enemyPos.x - px
		local az = enemyPos.z - pz
		local d = math.sqrt(ax * ax + az * az)
		if d > 0.001 and d < radius then
			local w = (radius - d) / radius
			sepX = sepX + (ax / d) * w
			sepZ = sepZ + (az / d) * w
		end
	end

	-- Avoid close enemies.
	local enemies = world:getEntitiesWithinRange("Enemy", enemyPos, 4)
	for i = 0, enemies.size - 1 do
		local other = enemies:get(i)
		local p = other.transform.translation
		avoid(p.x, p.z, self._avoidRadius)
	end

	-- Keep out of the player, but only just -- see _playerSpace. Giving the player the
	-- same berth as another zombie is what used to hold the horde at arm's length: the
	-- push started two and a half metres out and had beaten the approach by 1.25 m, so
	-- they never closed to their own biting range.
	avoid(playerPos.x, playerPos.z, self._playerSpace)

	-- Blend separation from other agents into the path direction, then renormalise to
	-- a unit heading.
	targetX = targetX + sepX * self._separation
	targetZ = targetZ + sepZ * self._separation
	local tl = math.sqrt(targetX * targetX + targetZ * targetZ)
	if tl > 0.001 then
		targetX = targetX / tl
		targetZ = targetZ / tl
	else
		targetX = 0.0
		targetZ = 0.0
	end

	-- What to face. Normally the way it is steering -- but a zombie within reach of the
	-- player faces the player, whatever the steering says.
	--
	-- This is where they used to be found looking away from the man they were eating. The
	-- steered direction is the path blended with the push away from everything nearby,
	-- the player included; at contact that push is the larger term, so the sum pointed
	-- backwards, the facing followed it, and -- since the step below is taken along the
	-- facing -- the zombie turned round and walked off, only to turn back the moment it
	-- was clear again. A horde shuffling to and fro at arm's length with its back to you.
	--
	-- Facing the player fixes both halves at once. It looks the right way, and the align
	-- gate below turns a backwards push into "stop advancing" rather than "walk away",
	-- since the step is scaled by how well the facing agrees with the steering: pressed
	-- right up against the player it holds still and claws instead of retreating.
	--
	-- Deliberately kept to CLOSE_QUARTERS, and to a zombie that has actually noticed the
	-- player, precisely because the step follows the facing: over any real distance the
	-- steering has to be what drives it, since that is what carries it around rocks and
	-- boulders instead of straight into them.
	local faceX, faceZ = targetX, targetZ
	if self._state == "attack" and pdist < CLOSE_QUARTERS then
		local ax < const > = playerPos.x - enemyPos.x
		local az < const > = playerPos.z - enemyPos.z
		local al < const > = math.sqrt(ax * ax + az * az)
		if al > 0.001 then
			faceX, faceZ = ax / al, az / al
		end
	end
	local fl < const > = math.sqrt(faceX * faceX + faceZ * faceZ)

	-- Rotate facing toward the desired direction at a limited angular rate (shortest
	-- way around), so turns - including reversals - happen gradually, never instantly.
	if fl > 0.001 then
		local desired = (math.atan2 or math.atan)(faceX, faceZ)
		local delta = desired - self._heading
		while delta > math.pi do delta = delta - 2.0 * math.pi end
		while delta < -math.pi do delta = delta + 2.0 * math.pi end
		local maxStep = self._turnRate * deltaTime
		if delta > maxStep then delta = maxStep end
		if delta < -maxStep then delta = -maxStep end
		self._heading = self._heading + delta
	end

	-- Move forward along the current facing, scaled by how well it points at the
	-- target, so the enemy pivots toward a target behind it before advancing.
	local fx = math.sin(self._heading)
	local fz = math.cos(self._heading)
	self._character.headAngle = self._heading

	-- Freshly spawned: keep turning toward the target but take no step, and do not
	-- set "moving" yet, so the animation graph is left in its stand-up state.
	if self._spawnDelay > 0.0 then
		self._spawnDelay = self._spawnDelay - deltaTime
		return
	end

	local moving = false
	if tl > 0.001 then
		local align = fx * targetX + fz * targetZ
		if align > 0.05 then
			self._character:move(Vector4(fx * speed * align, 0.0, fz * speed * align, 0.0), false)
			moving = true
		end
	end

	-- Biting: the Stage applies the contact damage and owns the range, so read it from
	-- there instead of keeping a second copy - the attack animation then runs exactly
	-- while this zombie is draining the player's health. Distance is measured the same
	-- way Main does it (origin to origin, all three axes), and deliberately ignores
	-- line of sight and the patrol/attack mode, because the damage ignores them too.
	local hurtRange = context._hurtRange or 1.0
	local attacking = pdist < hurtRange

	if self._pose ~= nil then
		self._pose:setParameterValue("moving", moving)
		self._pose:setParameterValue("attack", attacking)
	end

	self:_voice(context, deltaTime, pdist)
end

-- Groan, now and then. The "groan" event on the Zombie entity is a positional,
-- following SoundEventData over the SB - Groan bank, so each one comes from where that
-- zombie is and is picked at random from three utterances at a wandering pitch -- the
-- horde never repeats itself exactly, and where it is coming from is information the
-- player can act on before anything is in sight.
--
-- Two things keep this from becoming a wall of noise with thirty of them alive. Only
-- zombies within VOICE_RANGE speak at all, which is a little past the fog and well past
-- what the mix can hold; and each one waits a randomised VOICE_INTERVAL between
-- utterances, drawn per zombie rather than shared, so they never fall into step. A
-- zombie that is actually on the player gets to be more insistent -- that is the sound
-- of being caught, and it arrives just before the damage does.
function EnemyController:_voice(context, deltaTime, pdist)
	if self._voiceTimer == nil then
		-- Staggered on the first update rather than at zero, or every zombie a wave
		-- spawns would speak on the same frame.
		self._voiceTimer = VOICE_INTERVAL_MIN + math.random() * VOICE_INTERVAL_MAX
	end

	self._voiceTimer = self._voiceTimer - deltaTime
	if self._voiceTimer > 0.0 then
		return
	end

	local close < const > = self._state == "attack" and pdist < VOICE_CLOSE_RANGE
	self._voiceTimer = (close and VOICE_INTERVAL_CLOSE or VOICE_INTERVAL_MIN)
		+ math.random() * VOICE_INTERVAL_MAX

	if pdist > VOICE_RANGE then
		return
	end

	local fx < const > = self.owner:getComponent(traktor.world.EventSetComponent)
	if fx ~= nil then
		fx:raise("groan")
	end
end
]]></text>
</object>
