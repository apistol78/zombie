<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
import(traktor)

-- Gate
--
-- A gate that stands shut until something opens it: the cemetery gate, locked until the
-- player turns the key in it, and the cave's doors and portcullises (Entities/Cave/Gates),
-- opened by a key or thrown open by a Scripts/Lever. The Stage keeps only which gates are
-- unlocked (across a hot reload).
--
-- What E does at one is the entity's zombie.InteractableComponentData: a door's lock
-- (zombie.LockComponentData) names the key it spends, and E calls interact() once the key is
-- out of the pack (Main:_interact). A lever's gate has no lock and no prompt, only the line
-- saying it won't budge; the lever names it (zombie.LeverComponentData). Either way the
-- interactable's notice is the line shown as it opens.
--
-- Attach to an entity carrying a TheaterEntityComponent with an act named ACT, which is
-- the whole of opening: it moves the gate's moving parts -- the "LeafL"/"LeafR" pair
-- swung about their hinges, or a portcullis's "Grate" raised into the rock -- and carries
-- the grind as an event key at its start, so the motion and its sound are timed together
-- in the theater editor. Each moving part is its own collider, a kinematic box on that
-- child entity, so the act moves the barring with the iron and there is nothing for
-- unlock() to take out of the world.
--
-- unlock() is idempotent and takes instant=true -- the restore path, the same contract as
-- Ward:turnOn -- which plays OPENED instead: a silent act that only holds the gate open.
-- Open is kept by the world (the entity's zombie.FixtureComponent): a script hot reload
-- finds the iron already there, but a stage come back to later in the night is a fresh
-- world whose gates are built shut, and each opens itself again from what the world says.

Gate = Gate or class("Gate", traktor.world.ScriptComponent)

local ACT < const > = "Open"       -- the act that swings or lifts the gate open, and grinds
local OPENED < const > = "Opened"  -- ...and the silent one that only holds it open

-- Play the act. A gate without it (Performance:play logs which) or without a theater
-- component at all stays shut -- and, since its iron is what bars the way, barred.
function Gate:unlock(instant)
	if self._unlocked then
		return
	end
	self._unlocked = true

	local fixture < const > = self.owner:getComponent(zombie.FixtureComponent)
	if fixture ~= nil then
		fixture.done = true
	end

	-- An open gate has nothing more to say to E.
	local interactable < const > = self.owner:getComponent(zombie.InteractableComponent)
	if interactable ~= nil then
		interactable.enabled = false
	end

	local performance < const > = self.owner:getComponent(traktor.theater.TheaterEntityComponent)
	if performance ~= nil then
		performance:play(instant and OPENED or ACT)
	end
end

function Gate:isLocked()
	return self._unlocked ~= true
end

-- E at a locked door, its key already spent: the stage opens it (Main:_unlockGate).
function Gate:interact(context)
	context:_unlockGate(self.owner)
end

-- Open already as far as the world is concerned: open again, silently.
function Gate:update(context, totalTime, deltaTime)
	if self._unlocked then
		return
	end
	local fixture < const > = self.owner:getComponent(zombie.FixtureComponent)
	if fixture ~= nil and fixture.done then
		self:unlock(true)
	end
end
]]></text>
</object>
