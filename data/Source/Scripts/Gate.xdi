<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
import(traktor)

-- Gate
--
-- A gate that stands shut until something opens it: the cemetery gate, locked until the
-- player turns the key in it (Main:_interact calls unlock()), and the cave's doors and
-- portcullises (Entities/Cave/Gates), opened by a key or thrown open by a Scripts/Lever.
-- The Stage keeps only what is around the gate: which gates are locked (across a hot
-- reload), and the key that is spent on one.
--
-- Attach to an entity carrying a TheaterEntityComponent with an act named ACT, which is
-- the whole of opening: it moves the gate's moving parts -- the "LeafL"/"LeafR" pair
-- swung about their hinges, or a portcullis's "Grate" raised into the rock -- and carries
-- the grind as an event key at its start, so the motion and its sound are timed together
-- in the theater editor. Each moving part is its own collider, a kinematic box on that
-- child entity, so the act moves the barring with the iron and there is nothing for
-- unlock() to take out of the world.
--
-- unlock() is idempotent and takes instant=true -- the reload-restore path, the same
-- contract as Ward:turnOn -- which plays OPENED instead: a silent act that only holds the
-- gate open. A script hot reload finds the iron already there, but a stage come back to
-- later in the night is a fresh world whose gates are built shut.
--
-- String properties on the ScriptComponentData, both optional:
--
--   id      a name a Scripts/Lever can open this gate by
--   notice  the line shown when it opens (Main falls back to the cemetery's)

Gate = Gate or class("Gate", traktor.world.ScriptComponent)

local ACT < const > = "Open"       -- the act that swings or lifts the gate open, and grinds
local OPENED < const > = "Opened"  -- ...and the silent one that only holds it open

-- A string property off this component's ScriptComponentData, or nil.
function Gate:_property(name)
	local props < const > = self.properties
	if props == nil then
		return nil
	end
	local v < const > = props:getProperty(name)
	if type(v) ~= "string" or v == "" then
		return nil
	end
	return v
end

function Gate:gateId()
	return self:_property("id")
end

function Gate:notice()
	return self:_property("notice")
end

-- Play the act. A gate without it (Performance:play logs which) or without a theater
-- component at all stays shut -- and, since its iron is what bars the way, barred.
function Gate:unlock(instant)
	if self._unlocked then
		return
	end
	self._unlocked = true

	local performance < const > = self.owner:getComponent(traktor.theater.TheaterEntityComponent)
	if performance ~= nil then
		performance:play(instant and OPENED or ACT)
	end
end

function Gate:isLocked()
	return self._unlocked ~= true
end
]]></text>
</object>
