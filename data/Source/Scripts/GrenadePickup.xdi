<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{8ED12B6C-86D0-4AD1-AC4A-7B5B60AB4AF0}
#using {6E9AD100-0000-4000-8000-000000000010}

import(traktor)

-- GrenadePickup
--
-- A grenade, for the pack. Walked over and taken while there is room for it, exactly as the ammo
-- crates are. Grenades stack (Config.items.grenade) and are drawn from the pack like any weapon,
-- so picking one up with none left is also what puts the grenades back on the mouse wheel.

GrenadePickup = GrenadePickup or class("GrenadePickup", Pickup)

local GRENADES_PER_PICKUP < const > = Config.pickup.grenades

-- How long a taken one stays gone. Longer than an ammo crate's and shorter than a flask's,
-- which is about where a grenade sits between the two: a crate only lets you keep doing what you
-- were already doing, while a grenade is a way out of a situation the rifle cannot answer -- but
-- unlike health it cannot undo a mistake already made.
local RESPAWN_DELAY < const > = Config.pickup.grenadeRespawn

function GrenadePickup:itemKind()
	return "grenade"
end

function GrenadePickup:itemCount()
	return self._count or GRENADES_PER_PICKUP
end

function GrenadePickup:respawnDelay()
	return RESPAWN_DELAY
end
]]></text>
</object>
