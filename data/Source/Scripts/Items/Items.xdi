<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
import(traktor)

-- Items
--
-- How the code asks about an item. The items themselves are zombie.ItemData instances in
-- data/Source/Story/Items (tools/gen_story_items.py), named by the guid of their instance, and the
-- story (Story/Story) lists every one there is. The pack is a native zombie.Inventory (the story's,
-- Scripts/Quests/Questing), which reads the same instances.
--
-- Lua keeps an item by its key -- the guid as upper-case text, "{D1A10000-...-000000000200}" for
-- the rifle -- wherever it is plain data or a table key: a chest's contents, what a character
-- carries, the books a save is made of. A Guid is neither (two Guids of the same value are equal,
-- ==, but they are not the same table key). The native side takes an item either way.
--
--   Items.bind(resourceManager)    once per stage, before anything is looked up
--   Items.keyOf(item)              a Guid or a key -> the key; nil for something that is no item
--   Items.get(item)                the item's entry (below), or nil
--   Items.is(a, b)                 whether a and b are the same item, however each was named
--   Items.all()                    every item, ordered by name
--   Items.describe(item, count)    "RIFLE", "12 ROUNDS"
--
-- Only what the story lists is an item, so asking about anything else is a plain nil rather than
-- a failed look-up in the database. A new item is an instance in data/Source/Story/Items and a line
-- in the story's list; what the scripts do with one is its traits', not a constant here.
--
-- An entry is a plain table made once out of the ItemData -- what the scripts read, with the
-- traits flattened:
--
--   name, plural, info, icon   the text and the picture (Scripts/Widgets/ItemSlot)
--   stack                      how many share one slot (maxStack)
--   heal                       HealTrait: health one restores, eaten or drunk from the pack
--   use                        HealTrait: what doing so is called, "EAT" or "DRINK"
--   armor                      ArmorTrait: the share of contact damage taken while worn
--   equip                      EquipTrait: the key of its slot, Items.WEAPON, Items.HAND or Items.BODY
--   ammo                       WeaponTrait: the key of what it loads from the pack, or nil
--   event                      EventTrait: what one coming into the pack is called to the
--                              SpawnOrchestrator (Items.EVENTS)
--   drop                       the EntityData a dropped one is rebuilt from, or nil
--   keep                       the item is its entity (the relic; Scripts/Pickup)
--   id, key, data              its Guid, its key and the ItemData itself

Items = Items or {}

-- The story whose list says what the items are. Escaped: that is what takes every item into the
-- build, those only ever handed over in a dialog included.
local STORY < const > = Guid("\{D1A20000-0000-4000-8000-000000000001}")

-- ---- Slots and events ----
--
-- Key assets: the slots in data/Source/Story/Items/Slots, the events in data/Source/Story/Events. An
-- EquipTrait names its slot, and an EventTrait or a dialog's EventAction its event, by the guid
-- of the asset; the code keeps them as keys, and the native side takes a key wherever it takes a
-- slot or an event.

Items.WEAPON = "{D1A10000-0000-4000-8000-000000000600}"   -- Slots/Weapon: drawn
Items.HAND = "{D1A10000-0000-4000-8000-000000000601}"     -- Slots/Hand: the off hand
Items.BODY = "{D1A10000-0000-4000-8000-000000000602}"     -- Slots/Body: worn

-- Events of items coming into the pack, by what the SpawnOrchestrator calls them (Config.events).
Items.EVENTS = {
	["{D1A20000-0000-4000-8000-000000000501}"] = "relicTaken",   -- Events/Relic Taken
	["{D1A20000-0000-4000-8000-000000000502}"] = "keyTaken"      -- Events/Key Taken
}

-- The binding, the story's list and the entries are kept on Items itself, not in locals of this
-- chunk: the chunk is run again whenever another script that uses it is loaded, and that would
-- start them over -- the stage's binding lost to the next pickup whose script comes in.
Items._entries = Items._entries or {}   -- key -> entry, made on first look-up

local function textOf(guid)
	return string.upper(guid:format())
end

-- key -> true for every item the story lists, read once per binding.
local function knownKeys()
	if Items._known ~= nil then
		return Items._known
	end
	local resourceManager < const > = Items._resourceManager
	if resourceManager == nil then
		return {}
	end
	local known = {}
	local handle < const > = resourceManager:bind(zombie.StoryData, STORY)
	local story < const > = (handle ~= nil) and handle:get() or nil
	if story == nil then
		print("Items: no story to say what the items are")
	else
		for i = 0, story.itemCount - 1 do
			known[textOf(story:getItem(i))] = true
		end
	end
	Items._known = known
	return known
end

local function entryOf(key)
	local e = Items._entries[key]
	if e ~= nil then
		return e
	end
	local resourceManager < const > = Items._resourceManager
	if resourceManager == nil then
		print("Items: " .. key .. " looked up before Items.bind")
		return nil
	end
	local id < const > = Guid(key)
	local handle < const > = resourceManager:bind(zombie.ItemData, id)
	local data < const > = (handle ~= nil) and handle:get() or nil
	if data == nil then
		print("Items: no item instance " .. key)
		return nil
	end
	local equip < const > = data:getTrait(zombie.EquipTrait)
	local heal < const > = data:getTrait(zombie.HealTrait)
	local armor < const > = data:getTrait(zombie.ArmorTrait)
	local weapon < const > = data:getTrait(zombie.WeaponTrait)
	local event < const > = data:getTrait(zombie.EventTrait)
	e = {
		id = id,
		key = key,
		data = data,
		name = data.name,
		plural = data.pluralName,
		info = data.info,
		icon = data.icon,
		stack = data.maxStack,
		heal = (heal ~= nil) and heal.amount or nil,
		use = (heal ~= nil and heal.verb ~= "") and heal.verb or nil,
		armor = (armor ~= nil) and armor.fraction or nil,
		equip = (equip ~= nil and equip.slot ~= nil) and textOf(equip.slot) or nil,
		ammo = (weapon ~= nil and weapon.ammo ~= nil) and textOf(weapon.ammo) or nil,
		event = (event ~= nil and event.event ~= nil) and Items.EVENTS[textOf(event.event)] or nil,
		drop = data.dropEntity,
		keep = data.keep
	}
	Items._entries[key] = e
	return e
end

function Items.bind(resourceManager)
	if resourceManager ~= Items._resourceManager then
		Items._resourceManager = resourceManager
		Items._entries = {}
		Items._known = nil
	end
end

function Items.keyOf(item)
	if item == nil then
		return nil
	end
	local key = nil
	if type(item) == "string" then
		if string.sub(item, 1, 1) ~= "{" then
			return nil
		end
		key = string.upper(item)
	elseif type(item) == "table" and getmetatable(item) == nil then
		return nil
	else
		key = textOf(item)
	end
	return knownKeys()[key] and key or nil
end

function Items.get(item)
	local key < const > = Items.keyOf(item)
	return (key ~= nil) and entryOf(key) or nil
end

function Items.is(a, b)
	local key < const > = Items.keyOf(a)
	return key ~= nil and key == Items.keyOf(b)
end

function Items.all()
	local out = {}
	for key, _ in pairs(knownKeys()) do
		local e < const > = entryOf(key)
		if e ~= nil then
			table.insert(out, e)
		end
	end
	table.sort(out, function(a, b) return a.name < b.name end)
	return out
end

-- What a count of an item is called: "RIFLE", "12 ROUNDS". Something that is no item answers
-- with what it was called rather than nothing.
function Items.describe(item, count)
	local def < const > = Items.get(item)
	if def == nil then
		return string.upper(tostring(item))
	end
	if count == nil or count == 1 then
		return def.name
	end
	return tostring(count) .. " " .. def.plural
end
]]></text>
</object>
