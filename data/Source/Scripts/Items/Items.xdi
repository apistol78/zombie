<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{6E9AD100-0000-4000-8000-000000000010}
#using \{D1A10000-0000-4000-8000-00000000000B}
#using \{D1A10000-0000-4000-8000-00000000000C}

import(traktor)

-- Items
--
-- How the code looks an item up. What the items *are* is Scripts/Items/VirtualItems, the level
-- designer's table, keyed by guid (Names.RIFLE); this is the one place that turns whatever an item
-- is called by -- that guid, its key, or its name as a scene's text property writes it -- into its
-- entry, so nothing else has to care which of them it was handed.
--
-- An item's key is its guid as text, upper case: "{D1A10000-...-000000000200}" for the rifle. It
-- is what everything keeps an item by -- the pack's stacks, a chest's contents, what a character
-- carries, the books a save is made of -- because those are plain data and table keys, and a Guid
-- is neither (two Guids of the same value are equal, ==, but they are not the same table key).
-- Nothing chooses a key or types one: it is only ever got from here.
--
--   Items.get(item)        the item's entry in VirtualItems, or nil; `item` is a Guid, a key or
--                          a name ("rounds", "ROUNDS" -- Names.ROUNDS)
--   Items.keyOf(item)      ...its key, or nil for something that is no item
--   Items.is(a, b)         whether a and b are the same item, however each was named
--   Items.all()            every entry, ordered by name
--   Items.describe(item, count)   "RIFLE", "12 ROUNDS"
--   Items.parseList(spec, who)    a scene's "rounds:24, bread" as { { name, key, count }, ... }
--
-- Every entry gets these filled in, besides what the designer wrote: `id` (its Guid), `key`, and
-- `stack`, `heal` and `armor` out of its `tune` (Config.items), `stack` 1 without one.

Items = {}

-- The entries by key, made once per VirtualItems table: a hot reload that rebuilds VirtualItems
-- rebuilds this too.
local index = nil
local indexOf = nil

local function textOf(guid)
	return string.upper(guid:format())
end

local function build()
	if indexOf == VirtualItems then
		return
	end
	indexOf = VirtualItems
	index = {}
	for id, def in pairs(VirtualItems) do
		-- The keys are Guids, which are objects with a metatable of their own.
		if type(def) == "table" and getmetatable(id) ~= nil then
			local key < const > = textOf(id)
			local tune < const > = def.tune or {}
			def.id = id
			def.key = key
			def.stack = tune.stack or 1
			def.heal = tune.heal
			def.armor = tune.armor
			index[key] = def
		end
	end
end

function Items.keyOf(item)
	if item == nil then
		return nil
	end
	build()
	if type(item) == "string" then
		if string.sub(item, 1, 1) == "{" then
			local key < const > = string.upper(item)
			return (index[key] ~= nil) and key or nil
		end
		local guid < const > = Names[string.upper(item)]
		return (guid ~= nil) and Items.keyOf(guid) or nil
	end
	if type(item) == "table" and getmetatable(item) == nil then
		return nil
	end
	local key < const > = textOf(item)
	return (index[key] ~= nil) and key or nil
end

function Items.get(item)
	local key < const > = Items.keyOf(item)
	return (key ~= nil) and index[key] or nil
end

function Items.is(a, b)
	local key < const > = Items.keyOf(a)
	return key ~= nil and key == Items.keyOf(b)
end

function Items.all()
	build()
	local out = {}
	for _, def in pairs(index) do
		table.insert(out, def)
	end
	table.sort(out, function(a, b) return a.name < b.name end)
	return out
end

-- What a count of an item is called: "RIFLE", "12 ROUNDS". Something that is no item answers
-- with what it was called, upper cased, rather than nothing -- a typo in a chest's property
-- should still say what it was.
function Items.describe(item, count)
	local def < const > = Items.get(item)
	if def == nil then
		return string.upper(tostring(item))
	end
	if count == nil or count == 1 then
		return def.name
	end
	return tostring(count) .. " " .. (def.plural or def.name)
end

-- Read a list of items as a level designer writes one in a scene's text property -- "rounds:24,
-- bread, grenade:2" -- into { { name, key, count }, ... } in the order written: `name` lower cased
-- as written, `key` the item it names (nil for no item -- the caller says so, knowing who it is),
-- `count` nil where none was given. `who` names the property's owner in the warning for an entry
-- that cannot be read at all, which is left out. Scripts/Chest and Scripts/Npc/Npc both hold their
-- contents in this form.
function Items.parseList(spec, who)
	local entries = {}
	if spec == nil then
		return entries
	end
	for entry in string.gmatch(spec, "[^,]+") do
		local name < const >, n < const > = string.match(entry, "^%s*([%a_]+)%s*:?%s*(%d*)%s*$")
		if name == nil then
			print(who .. ': cannot read "' .. entry .. '" in "' .. spec .. '"; left out.')
		else
			table.insert(entries, { name = string.lower(name), key = Items.keyOf(name), count = tonumber(n) })
		end
	end
	return entries
end
]]></text>
</object>
