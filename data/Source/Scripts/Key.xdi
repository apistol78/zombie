<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using {6E9AD100-0000-4000-8000-000000000010}
#using \{8ED12B6C-86D0-4AD1-AC4A-7B5B60AB4AF0}
import(traktor)

-- Key
--
-- An iron key, lying in a chest or wherever it was dropped. Taken with E into the pack, where
-- keys stack, and turned in a lock straight out of it: E at a locked gate with a key in the pack
-- opens the gate and spends the key (Main:_unlockGate). There is nothing to equip and nothing to
-- carry in hand -- what used to make a key a key, the off hand it filled, is gone with the off
-- hand's carrying.
--
-- So this is a Pickup that only says which item it is and how it is taken. A key put down from
-- the pack is rebuilt from this same entity (Items: `entity`), which is why it keeps its script.

Key = Key or class("Key", Pickup)

local REACH < const > = Config.key.reachRange   -- how close to the key to take it (m)

function Key:itemKind()
	return "key"
end

function Key:itemCount()
	return self._count or 1
end

function Key:pressToTake()
	return true
end

function Key:reach()
	return REACH
end

function Key:takeEvent()
	return "keyTaken"
end

function Key:promptTake()
	local count < const > = self:itemCount()
	if count > 1 then
		return "TAKE " .. tostring(count) .. " KEYS"
	end
	return "TAKE THE KEY"
end
]]></text>
</object>
