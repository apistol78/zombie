<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using {6E9AD100-0000-4000-8000-000000000010}
#using {1F58C1CA-F879-41CF-A107-D2EA6A75F8EB}
import(traktor)

-- Key
--
-- The iron key to the cemetery gate. A Carryable like the relic (see
-- Scripts/Carryable), and lighter in both senses: it does not slow the walk or bar
-- the sprint -- walkSpeed stays the base's nil -- and it has exactly one place to
-- go. What is written here is only what makes the key a key --
--
--   * it is spent on a still-locked gate in reach (findTarget), and spending it is
--     what opens the gate (onSpend); the swing, the grind, and the invisible box
--     that did the actual barring going out of the world are all Gate:unlock's
--   * the compass simply points at that gate (objective)
--
-- Everything around it stays with the Stage: what is in hand, which gates are open,
-- and the two ward posts behind this one that make the gate worth opening.

Key = Key or class("Key", Carryable)

local GATE_RANGE < const > = Config.key.gateRange   -- how close to a gate to turn it in the lock (m)
local DROP_AHEAD < const > = Config.key.dropAhead   -- how far in front of the player a put-down key lands (m)

function Key:findTarget(context)
	return (context:_nearestLockedGate(GATE_RANGE))
end

-- Turn it in the lock. The key is spent for good -- the base has already parked it
-- on the gate and hidden it -- and the gate opens itself; what is written here is
-- the Stage's bookkeeping of which gates still stand locked, kept as plain data so
-- it survives a hot reload (Main:resolve re-asserts it).
function Key:onSpend(context, gate)
	gate.unlocked = true
	context._unlockedGateIndex[gate.index] = true
	local gsc < const > = gate.entity:getComponent(traktor.world.ScriptComponent)
	if gsc ~= nil then
		gsc:unlock()
	end
	context:_showNotice("THE CEMETERY GATE GRINDS OPEN")
	-- Ground the night was keeping opens up, and the night notices.
	context._orchestrator:notify("gateOpened")
end

-- A key in hand has exactly one place to go, so the needle points there.
function Key:objective(context)
	local gate < const > = context:_nearestLockedGate()
	return gate ~= nil and gate.entity or nil
end

function Key:takeEvent()
	return "keyTaken"
end

function Key:promptTake()
	return "TAKE THE KEY"
end

function Key:promptSpend()
	return "UNLOCK THE GATE"
end

function Key:promptDrop()
	return "PUT DOWN THE KEY"
end

function Key:dropAhead()
	return DROP_AHEAD
end

-- Where it rides: the same left hand as the relic, a touch nearer and lower -- it
-- is a small thing -- and turned a little across the view (the extra yaw, with a
-- hair of pitch) so the bow and the teeth read in profile rather than shaft-on,
-- which from behind is just a dot. The mesh's pivot is at the teeth's tip, which is
-- also why the base's drop(), grounding the origin, stands it on end.
function Key:carryOffset()
	return Vector4(-0.30, -0.40, 0.55, 0.0)
end

function Key:carryRotation()
	return Quaternion.fromEulerAngles(-0.55, 0.1, 0.0)
end
]]></text>
</object>
