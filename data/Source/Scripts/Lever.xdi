<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
import(traktor)

-- Lever
--
-- A lever on a post that opens a gate somewhere else: the player pulls it with E
-- (Main:_interact calls interact()), the handle swings over from leaning forward to
-- leaning back, and the gate it names opens itself (Scripts/Gate -- the cave's lever gates
-- are portcullises that lift).
--
-- Which gate is the entity's zombie.LeverComponentData, a reference to the gate entity
-- picked in the scene editor, so each placed lever names its own. What E says at it, and
-- the line shown when it is pulled, is its zombie.InteractableComponentData (else the
-- gate's line, else a generic one).
--
-- Attach to an entity whose GroupComponent holds a child named "Handle": the handle
-- mesh with its pivot on its own origin, extending +Y, authored PIVOT_Y above the
-- lever's origin. The post's front, where the player stands, is +Z.
--
-- pull() is idempotent and takes instant=true -- the restore path, the same contract as
-- Gate:unlock -- to snap straight to pulled, opening the gate instantly and silently. It
-- returns the gate entity it opened, or nil. Pulled is kept by the world (the entity's
-- zombie.FixtureComponent), and a lever pulled before puts itself back that way.

Lever = Lever or class("Lever", traktor.world.ScriptComponent)

local SWING < const > = 0.75      -- handle pitch either side of upright (rad)
local PULL_TIME < const > = 0.55  -- how long the throw takes (s)
local PIVOT_Y < const > = 0.9     -- the pivot's height above the lever's origin (m)

function Lever:isPulled()
	return self._pulled == true
end

-- The gate this lever opens, and its Gate component; nil while it is not in the world.
function Lever:target()
	local lever < const > = self.owner:getComponent(zombie.LeverComponent)
	local e < const > = (lever ~= nil) and self.world:getEntityById(lever.target) or nil
	if e == nil then
		return nil, nil
	end
	return e, e:getComponent(traktor.world.ScriptComponent)
end

function Lever:pull(instant)
	if self._pulled then
		return nil
	end
	self._pulled = true
	self._t = instant and 1.0 or 0.0
	self._posed = false

	local fixture < const > = self.owner:getComponent(zombie.FixtureComponent)
	if fixture ~= nil then
		fixture.done = true
	end
	if not instant then
		local fx < const > = self.owner:getComponent(traktor.world.EventSetComponent)
		if fx ~= nil then
			fx:raise("pull")
		end
	end

	-- Pulled is pulled: E has nothing more to do here.
	local interactable < const > = self.owner:getComponent(zombie.InteractableComponent)
	if interactable ~= nil then
		interactable.enabled = false
	end

	local gate < const >, gsc < const > = self:target()
	if gsc ~= nil then
		gsc:unlock(instant)
	end
	return gate
end

-- E at the lever: the stage pulls it and keeps the book (Main:_pullLever).
function Lever:interact(context)
	context:_pullLever(self.owner)
end

function Lever:update(context, totalTime, deltaTime)
	-- Pulled already as far as the world is concerned.
	if not self._pulled then
		local fixture < const > = self.owner:getComponent(zombie.FixtureComponent)
		if fixture ~= nil and fixture.done then
			self:pull(true)
		end
	end
	if self._posed then
		return
	end
	if self._handle == nil then
		local group < const > = self.owner:getComponent(traktor.world.GroupComponent)
		self._handle = group ~= nil and group:getEntity("Handle", 0) or nil
		if self._handle == nil then
			return
		end
	end
	-- At rest the handle leans forward, towards the player; pulled, it leans back. A
	-- positive pitch carries +Y over towards +Z, so the throw runs +SWING -> -SWING,
	-- eased so it snaps over rather than sliding.
	local k = 0.0
	if self._pulled then
		local t = math.min(1.0, (self._t or 0.0) + deltaTime / PULL_TIME)
		self._t = t
		k = t * t * (3.0 - 2.0 * t)
		self._posed = t >= 1.0
	else
		self._posed = true   -- the rest pose is written once
	end
	local base < const > = self.owner.transform
	self._handle.transform = Transform(
		base.translation + base.rotation * Vector4(0.0, PIVOT_Y, 0.0, 0.0),
		base.rotation * Quaternion.fromEulerAngles(0.0, SWING - 2.0 * SWING * k, 0.0)
	)
end
]]></text>
</object>
