<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{720C0A68-B608-2F40-8EBA-F7E42EB27F61}
#using \{FC4400A2-BDB6-BA45-9A22-12B9676E71FA}
#using \{EDC0B8AE-497C-4963-A2F1-5B3A6937790C}
#using \{8DF61FC9-C1FD-48B2-B12B-806D60830E91}
#using \{B7E4C1A9-3D62-4F08-9A15-6C2E8B0D4F73}
#using \{5E1A4C77-2B90-4D36-9F41-7C8A2D0E6B15}
#using \{355F68E1-93F8-3A48-BA4D-90185A04F57C}
#using \{A47C0E92-3B15-4D68-9E24-5F80C6B1D739}
#using \{6E9AD100-0000-4000-8000-000000000010}
#using \{3E8A5D21-6C47-4B9F-8E12-A47D0C93F5B6}

-- Scripts/Weapons/Loadout, which owns what the player has in their hands. Everything
-- about the weapons themselves is behind it -- see Scripts/Weapons/Weapon for the
-- interface, and "what a weapon is given" further down for the part of this stage a
-- weapon is allowed to use.
#using \{7EA9C000-0000-4000-8000-000000000005}

-- Scripts/SpawnOrchestrator, which owns the night's tempo: it turns the gameplay
-- events this stage detects (a relic taken, a ward lit, the gate opened) into bursts
-- and lulls, and publishes the verdict to the Spawner as _spawnDrive on this stage.
#using \{9F2C606F-BD26-43E1-9A3F-B108C688FB02}

-- Scripts/Items/Items and Scripts/Items/Inventory: what every kind of item is, and the
-- pack the player carries them in. The pack is the stage's own (_inventory) and the one
-- record of what the player has -- the weapons, the food, the armour, the keys and the
-- relics are all read out of it.
#using \{17E40000-0000-4000-8000-000000000001}
#using \{17E40000-0000-4000-8000-000000000002}

-- Scripts/Views/InventoryView, the pack on screen (Tab), and Scripts/Views/ChestView, a chest's
-- contents on screen (E at one).
#using \{17E40000-0000-4000-8000-000000000004}
#using \{17E40000-0000-4000-8000-000000000005}

-- Scripts/Pickup, the base of everything lying in the world that goes into the pack. Not
-- named in this file -- the stage only ever talks to whichever component an item holds --
-- but the E scan below (TAKE_NAMES) and the drop are the other half of its contract.
#using \{8ED12B6C-86D0-4AD1-AC4A-7B5B60AB4AF0}

import(traktor)

-- Main
--
-- Every gameplay number this stage runs on comes from Scripts/Config. The fields below are
-- still the stage's own -- other scripts read them off the context (EnemyController takes
-- _hurtRange and _enemyPace), and several are state that moves during the night -- but
-- their starting values are Config's, and the ones that never move are Config's outright.
-- Retune the night there, not here.
--
-- The weapons' own numbers are not among them any more: each weapon reads its section of
-- Config for itself (Config.rifle, Config.melee, Config.grenade), which is the same split
-- as the rest of this refactor -- the stage does not hold a magazine size it never looks at.

-- The dawn shot. Neither the framing nor the light is written down here: both halves of
-- the sunrise -- the camera flying out over the forest and the Sky entity's directional
-- light coming up under it -- are keyed in the scene as a theater act on the *world*
-- (Scene 2's TheaterWorldComponent), so all Main does is play it by name and ask the layer
-- to render through the camera it flies. Re-timing or re-framing the payoff is a scene
-- edit, exactly as re-timing a hive's opening is.
--
-- DAWN_CAMERA is a second camera entity, standing apart from the first-person "Camera0"
-- the rest of this script drives off the player's eye: the act owns one and Main owns the
-- other, so there is no pose to save and restore across the cut.
local DAWN_ACT < const > = "Dawn"
local DAWN_CAMERA < const > = "Camera"

-- Two-argument atan; math.atan2 was folded into math.atan.
local atan2 < const > = math.atan2 or math.atan

-- How high the player's eye rides above the Humanoid's origin. What the first person
-- camera looks out of, and -- through Main:eye -- what every shot, swing and throw leaves
-- from, so the weapons and the view agree by construction rather than by both spelling it
-- out.
local EYE_OFFSET < const > = Vector4(0.0, 1.6, 0.0, 0.0)

-- How the eye's *height* follows the body. The character controller snaps up a stair or a
-- kerb in a single frame, and a camera welded to it jolts with every step; so the eye
-- chases the body's height instead (exponentially, EYE_HEIGHT_RATE per second -- about
-- 80 ms to close two thirds of a step) while staying rigid in the horizontal, where the
-- controller is already smooth. EYE_HEIGHT_MAX_LAG caps how far behind it may fall, so a
-- drop off a ledge or a long flight still reads as moving rather than the view sinking
-- into the floor, and anything past EYE_HEIGHT_SNAP is a teleport and is not eased at all.
local EYE_HEIGHT_RATE < const > = 14.0
local EYE_HEIGHT_MAX_LAG < const > = 0.3
local EYE_HEIGHT_SNAP < const > = 2.0


-- What E can take into the pack, by entity name, in priority order: standing where two
-- are in reach, E takes the earlier one -- the relic is the night's objective, the key a
-- detour, and anything else (a weapon, a helmet: entities named "Item") comes after.
-- That is all the *scan* needs; how close is close enough, what the E line says and
-- what taking it does are asked of the item's own Pickup component (Scripts/Pickup).
--
-- The walk-over items -- rounds, food, grenades, coins -- are not on it: those notice the
-- player standing on them by themselves.
local TAKE_NAMES < const > = { "Relic", "Key", "Item" }

-- How much nearer a rival ward post has to be before the objective compass gives up the
-- one it is already pointing at; see Main:_wardObjective.
local MARKER_SWITCH_MARGIN < const > = Config.relic.markerSwitchMargin

-- Where the minimap sits: its own corner, clear of the prompt line in the middle and
-- the HUD row along the bottom. The frame lays out at 1280x720 whatever
-- it is constructed with, so these are that space's pixels (see the Frame gotcha in
-- Main:new), and they match the frame's own 24/20 layout margins.
local MAP_X < const > = 24
local MAP_Y < const > = 20

-- Slack around the scene's points of interest when fitting the map to them, so
-- nothing ends up drawn on the bezel.
local MAP_PAD < const > = 1.14

-- The hive cutscene (Main:_beginCutscene): where the camera stands while a hive opens
-- and how long it is held there.
--
-- Both eye positions are in the hive's own frame, so they work for any hive anywhere on
-- the map: +Z is out of the mouth (the pen is behind the origin and the boulder plugs
-- the front of it), +X is to its right, and the origin sits on the ground at the mouth.
-- The shot is a slow push-in from wide to close, dropping as it comes, which reads as
-- leaning in to look rather than as a camera being teleported. It is held off to one
-- side rather than square on so the pen behind the boulder is visible in the same
-- frame -- the point of the shot is what is coming out, not the rock.
--
-- The look-at is fixed at chest height on the boulder (which stands 2.84 m and sinks
-- 2.92 m), so the frame stays on the mouth as the rock drops out of it.
local CUTSCENE_EYE_FROM < const > = Vector4(2.6, 4.2, 10.5, 1.0)
local CUTSCENE_EYE_TO < const > = Vector4(1.4, 2.5, 6.2, 1.0)
local CUTSCENE_LOOK_AT < const > = Vector4(0.0, 1.2, -1.2, 1.0)

-- How long the push-in takes. Deliberately longer than the shot usually lasts (the act
-- is 5 s, which is what ends it), so the camera is still moving when it cuts away: a
-- camera that arrives early and then sits still for the last second reads as the game
-- having frozen, which is precisely the impression to avoid while everything *is*
-- frozen.
local CUTSCENE_PUSH_TIME < const > = Config.cutscene.pushTime

-- Keeping the eye out of the ground. Traced from CUTSCENE_GROUND_REACH above the eye to
-- the same distance below it, and the eye lifted to CUTSCENE_GROUND_CLEAR above anything
-- found. A miss means there is nothing within reach underneath and the authored pose
-- stands -- which is the common case, since the shot is composed several metres up.
local CUTSCENE_GROUND_REACH < const > = 4.0
local CUTSCENE_GROUND_CLEAR < const > = 1.5

-- Held at least this long, so a hive whose act is missing or whose brood cannot rise
-- still reads as a deliberate beat rather than a one-frame camera glitch...
local CUTSCENE_MIN < const > = Config.cutscene.min
-- ...and never longer than this, whatever the hive says, so nothing can strand the
-- player behind a cutscene that will not end.
local CUTSCENE_MAX < const > = Config.cutscene.max

-- How long a lit ward gets to itself before the hive it wakes opens and the camera
-- leaves for it. Lighting a post is three things at once -- the flame catches, the light
-- takes whatever was standing on the ground, and a hive answers it -- and cutting away
-- on the same frame threw the first two away: the flare and the bodies going down happen
-- in first person, where the player is standing, and they are the part they paid for.
--
-- Two lengths, because the wait is only worth having if there is something in it. A
-- purge that took nobody leaves an empty pause, so the quiet one is just long enough for
-- the flame to catch (Ward ignites over about a second) before the night answers back.
local HIVE_WAKE_DELAY < const > = Config.hive.wakeDelay        -- ...when the light took zombies with it
local HIVE_WAKE_DELAY_QUIET < const > = Config.hive.wakeDelayQuiet  -- ...and when it took none

-- How much of the world stays awake around the hive: zombies inside this radius of it
-- keep running (its brood, rising and walking out -- the whole subject of the shot),
-- everything beyond it holds still. Comfortably clear of the pen, which is about 7 m
-- deep, so the brood is still driving itself while it walks out of frame.
local CUTSCENE_RADIUS < const > = Config.cutscene.radius

-- Metres of travel per footstep (see the movement block in Main:update). A stride, near
-- enough: at the 3 m/s walk that is a step every two thirds of a second, and sprinting
-- doubles the rate on its own without a second number to tune.
local STEP_STRIDE < const > = Config.player.stepStride

-- The landmarks the map marks, in the order they are drawn. Looked up by entity
-- name and quietly skipped when a scene has none of them, which is what keeps this
-- working in Scene 1 -- and is why the Altar can stay on the list: it lost its
-- gameplay role when relics moved to the ward posts, but it is still the biggest
-- monument in the cemetery and so still the thing to navigate by.
--
-- glyph names the drawing the map gives it -- a pictogram with the name lettered
-- underneath, one child sprite of MC_MapLandmark each (tools/gen_hud_svg.py). A
-- landmark without one of its own is drawn as a plain mark with no name.
local LANDMARKS < const > = {
	{ entity = "Chapel", glyph = "chapel" },
	{ entity = "Tower", glyph = "tower" },
	{ entity = "Altar", glyph = "altar" },
}

Main = Main or class("Main", Stage)

function Main:new(params, environment)
	Stage.new(self, params, environment)

	-- Which stage this is, and what the player brought into it. Both gameplay stages run this
	-- class, so each learns which it is from the name it was loaded by -- the Loading stage's
	-- transition, handed on as params.target -- and a Restart, which passes nothing, is always
	-- the forest (every gameplay stage's RESTART leads to Stages/STG - Terrain).
	--
	-- params.carry is what a trip from another stage brought along (see leaveStage): the
	-- player -- pack, hands, health -- and the books of every world already visited, this one
	-- among them if the player has been here before tonight. Absent, the night is new.
	self._stageKey = (params ~= nil and params.target) or "TERRAIN"
	local carry < const > = (params ~= nil) and params.carry or nil
	self._worlds = (carry ~= nil and carry.worlds) or {}
	-- The entity to stand the player on once the world is there (resolve), or nil to leave
	-- them wherever the scene puts its Humanoid.
	self._arrival = (carry ~= nil) and carry.spawn or nil

	-- Initialize UiKit. Two resource kits: the HUD widgets' own art (UI/Hud,
	-- imported from data/Assets/UI/Hud.svg) and UiKit's own movie, which the
	-- menus and every Static come from. HealthBar/WeaponCarousel look their
	-- movie clips up by name across both, so the HUD one has to be listed here
	-- or they cannot build themselves.
	Widget.initialize(
		environment.resource.resourceManager,
		{
			"\{B11AC173-A951-4180-B16B-36F57D2603C8}",
			"\{6FC8E464-F249-674E-8FA9-1CD2547A0494}",
			"\{B45977D0-3D89-4FA7-BE4C-FAA9ED63A942}"
		}
	)

	-- Create UI frame with virtual size of 1280x720. Two rows, both taking half
	-- the height: the status line hangs off the top of the first, the HUD off
	-- the bottom of the second, which puts it along the bottom edge no matter
	-- what aspect the window has.
	local root = self.ui.root
	self._frame = Frame(
		root,
		1280 / 2, 720 / 2,
		TableLayout({ 100 }, { 100 }, 24, 20, 0, 0)
	)

	setupUiKitStyles()

	-- Blank unless a cheat is on, and one label for all of them rather than one each: they
	-- would otherwise want the same spot at the top of the screen. The text is composed by
	-- _updateCheatLabel from the flags, and written by the toggles rather than each frame.
	self._lblCheats = Static(self._frame, "")
	self._lblCheats:setTextColor(Color4f(1.0, 0.85, 0.1, 1.0))
	self._lblCheats:setHorizontalAlign(Widget.ALIGN_CENTER)
	self._lblCheats:setVerticalAlign(Widget.ALIGN_TOP)

	-- The pack: everything the player is carrying, and the one record of it. Filled with the
	-- night's starting kit (Config.inventory.start) before anything reads it -- the loadout
	-- below draws the first weapon in it as it is built.
	--
	-- Plain data throughout (but for the relics riding in it, which are their own entities),
	-- so it survives a script hot reload as the rest of this stage's plain data does.
	--
	-- Or, arriving from another stage, with what the player had when they left it. The relics
	-- in it come without their entities -- those belong to the world they were found in -- and
	-- are handed back by that world on the way into it (_restorePickups).
	self._inventory = Inventory(Config.inventory.slots)
	if carry ~= nil and carry.player ~= nil then
		self._inventory:restoreState(carry.player.inventory)
	else
		for _, entry in ipairs(Config.inventory.start) do
			self._inventory:add(entry[1], entry[2])
		end
	end

	-- What the player has in their hands. Built before the HUD row below, because the row
	-- reserves a column per weapon tile -- so the arsenal decides how wide the row is rather
	-- than the row deciding how many weapons there can be.
	--
	-- This is the only handle this stage has on the weapons, and it is deliberately the only
	-- one: Main routes buttons and frames at it (update, place, attack, altAttack, reload,
	-- cycle) and never asks what is in it. Which weapons there are to route at is the pack's,
	-- and the loadout reads it there. See Scripts/Weapons/Loadout.
	self._loadout = Loadout(self)

	-- HUD: one row along the bottom, reading left to right as where to go, how alive
	-- you are, and what you have to fight with. The compass and the health bar are the
	-- stage's own -- they are about the night and the player, not about a weapon -- and
	-- what follows them is the arsenal's own tile, a carousel carrying every weapon at
	-- once with whichever has the trigger at the front of it.
	--
	-- Ammunition sits next to health because those two are what the player is actually
	-- spending. All of them want a per-frame :update to run their animations, which is what
	-- the loadout's updateHud does for the weapon tile.
	local hudColumns = { 0, 0 }   -- the compass and the health bar...
	for _ = 1, self._loadout:hudColumns() do
		table.insert(hudColumns, 0)   -- ...then whatever the arsenal asks for, which is one
	end
	self._hud = Container(self._frame, TableLayout(hudColumns, { 0 }, 0, 0, 18, 0))
	self._hud:setHorizontalAlign(Widget.ALIGN_CENTER)
	self._hud:setVerticalAlign(Widget.ALIGN_BOTTOM)
	self._marker = ObjectiveMarker(self._hud)
	self._healthBar = HealthBar(self._hud)
	self._loadout:createHud(self._hud)

	-- Aiming crosshair: a Crosshair widget (Scripts/Widgets/Crosshair) whose art is the
	-- MC_Crosshair export of the same UI/Hud movie the other HUD widgets use. It is not
	-- part of the HUD row -- it is floated (ILayout.FLOAT) over the centre of the screen
	-- and placed by hand each frame in _updateCrosshair, since the centre moves with the
	-- window size. Parented to the frame after the HUD but before the dialogs and the
	-- dawn wash, so those cover it; it hides itself whenever the game is not being played,
	-- and whenever the weapon in hand has nothing to aim (Weapon:wantsCrosshair). A relic in
	-- the off hand has no say in it any more.
	self._crosshair = Crosshair(self._frame)
	self._crosshair.__layout = ILayout.FLOAT
	self._crosshairShown = nil   -- nil so the first _updateCrosshair forces the state

	-- Minimap, top left. FLOAT for the same reason as the crosshair -- it belongs in
	-- a corner, not in either of the frame's two rows -- but unlike the crosshair its
	-- place never moves, so it is set here once rather than every frame: a FLOAT child
	-- is skipped by TableLayout, so nothing else will disturb it. Built empty; it gets
	-- its markers in resolve, once the world is there to count them off.
	self._minimap = Minimap(self._frame)
	self._minimap.__layout = ILayout.FLOAT
	local mapSize < const > = self._minimap:getPreferredSize()
	self._minimap:place(MAP_X, MAP_Y, mapSize.width, mapSize.height)
	-- Hidden until it has been fitted to a scene, so a stage with nothing to map
	-- (Scene 1 has no relics, no wards and none of the landmarks) never shows an
	-- empty plate, and Scene 2 never flashes one on the frame before resolve runs.
	self._minimap:setVisible(false)
	self._minimapBuilt = false   -- resolve has dealt with it
	self._minimapMapped = false  -- ...and found something worth drawing

	-- Game Over menu (hidden until death): the "GAME OVER" banner plus Restart / Exit
	-- buttons, as a modal Dialog auto-centered over the HUD (one column: title, then
	-- two buttons). Dialog is ILayout.FLOAT, so it is excluded from the frame's layout
	-- and does not disturb the HUD row.
	--
	-- It MUST be parented to self._frame -- this stage's one and only Frame -- and not
	-- to a second full-screen Frame of its own. Each Frame is a separate widget tree
	-- (Frame is built with parent = nil), but UiKit's "event masks are stale" flag,
	-- Widget._eventMaskDirty, is global: Widget:_dispatchEvent refreshes only
	-- self:getAncestor()'s subtree and then clears that shared flag. With two sibling
	-- Frames the always-visible HUD dispatches first, refreshes itself and clears the
	-- flag, so the other tree's _eventFilter stays at its initial 0x00000000 and every
	-- event fails the mask test -- its buttons silently never receive a click.
	self._gameOverDialog = Dialog(self._frame, TableLayout({ 0 }, { 0, 0, 0 }, 24, 24, 0, 16))
	self._lblGameOver = Static(self._gameOverDialog, "GAME OVER")
	self._lblGameOver:setHorizontalAlign(Widget.ALIGN_CENTER)
	self._lblGameOver:setTextSize(60)
	self._lblGameOver:setTextColor(Color4f(0.9, 0.05, 0.05, 1.0))
	-- Restart: reload this stage from scratch via its "RESTART" self-transition.
	self._restartButton = PushButton(self._gameOverDialog, "Restart")
	self._restartButton:setMinimumWidth(220)
	self._restartButton:setOnClick(function() self:_restart() end)
	-- Exit: back to the Startup menu, via the loading screen (see _exitToStartup).
	self._gameOverExitButton = PushButton(self._gameOverDialog, "Exit")
	self._gameOverExitButton:setMinimumWidth(220)
	self._gameOverExitButton:setOnClick(function() self:_exitToStartup() end)
	-- No explicit hide needed: Dialog starts hidden (Dialog:_initialize ends in
	-- setVisible(false)), exactly as the pause dialog below relies on.

	-- Contextual prompt and transient notice, both centred near the top.
	--
	-- These are ILayout.FLOAT (the same escape hatch Dialog uses), so they sit
	-- outside the frame's two-row layout and leave the cheat label and the HUD
	-- row exactly where they were. They have to be placed by hand anyway: Static
	-- clamps its text bounds to the width it was placed at, so a label whose text
	-- changes -- and the prompt changes constantly -- gets the longer string cut
	-- off unless it is re-placed. See _setLabel.
	--
	-- There was a standing objective banner above these ("WARDS 1 / 7", and "THE
	-- WARDS ARE LIT" once the circle closed). It is gone: the count is on the minimap
	-- as lit and unlit posts, and lighting one already reads out on the notice line
	-- below, so the banner was saying a third time what the screen said twice.
	self._prompt = { widget = Static(self._frame, ""), y = 66 }
	self._prompt.widget.__layout = ILayout.FLOAT
	self._prompt.widget:setTextSize(22)
	self._prompt.widget:setTextColor(Color4f(0.92, 0.94, 0.9, 1.0))

	-- Transient line for things that happen rather than things that are true --
	-- currently only a ward catching light.
	self._notice = { widget = Static(self._frame, ""), y = 102 }
	self._notice.widget.__layout = ILayout.FLOAT
	self._notice.widget:setTextSize(24)
	self._notice.widget:setTextColor(Color4f(1.0, 0.72, 0.34, 1.0))

	-- ...and, smaller and quieter under it, what went into the pack or would not fit: "+ 12
	-- ROUNDS", "THE PACK IS FULL". Its own line, because pickups happen all night and would
	-- otherwise talk over the notices that matter -- a ward catching, a gate grinding open.
	-- See _feed.
	self._feedLine = { widget = Static(self._frame, ""), y = 136 }
	self._feedLine.widget.__layout = ILayout.FLOAT
	self._feedLine.widget:setTextSize(18)
	self._feedLine.widget:setTextColor(Color4f(0.82, 0.84, 0.78, 1.0))
	self._feedText = ""
	self._feedTimer = 0.0
	self._feedKind = nil      -- what the line is counting up, so two crates read as one
	self._feedCount = 0

	-- Ensure layouts are updated.
	self._frame:update()

	-- Player health / game-over.
	self._maxHealth = Config.player.maxHealth
	self._health = self._maxHealth
	self._gameOver = false
	self._hurtRange = Config.player.hurtRange   -- enemies within this distance (m) deal damage
	self._enemyDps = Config.player.enemyDps   -- health drained per second per touching enemy
	self._biteTimer = 0.0   -- re-trigger countdown for the blood splatter while eaten
	self._godMode = false   -- G: skip contact damage entirely (zombies still bite, visibly)
	-- H: every weapon's ammunition refills itself. Kept here only so the label can read it
	-- back and so the toggle has something to flip -- what it *means* is each weapon's own
	-- business, and it is pushed down to them through the loadout rather than asked for.
	self._infiniteAmmo = false

	-- Movement: WASD to move; hold Shift (STATE_SPRINT) to sprint -- always, whatever is in
	-- the pack or the hands. maxVelocity is set to the current speed each frame so the
	-- character controller's velocity clamp permits it.
	self._walkSpeed = Config.player.walkSpeed
	self._sprintSpeed = Config.player.sprintSpeed
	self._running = false   -- true while sprinting and moving; hides the crosshair, lowers the rifle

	-- The dead. Whatever killed them -- a round, a blast, a ward taking light -- every zombie
	-- goes through Main:killEnemy and lands in here, so there is one corpse timer and one kill
	-- tally however many weapons the player ends up carrying.
	self._deadEnemies = {}       -- live set: enemy entity -> remaining corpse lifetime (s)
	self._kills = 0
	self._corpseLifetime = Config.corpse.lifetime   -- how long a ragdoll corpse lingers before it despawns

	-- The last round fired, published to Scripts/EnemyController: { x, z, seq }. A
	-- patrolling zombie near enough to hear it walks over to have a look -- see the
	-- hearing block there for what "near enough" and "have a look" mean.
	--
	-- One table for the whole night, rewritten per shot rather than replaced, and nil
	-- only until the first round leaves the barrel. seq is what the controllers actually
	-- read: it counts up forever and each zombie bookmarks the last value it saw, so a
	-- shot is heard exactly once by each of them and no clock has to be shared between
	-- the stage and thirty controllers to decide whether it is still news.
	self._gunshot = nil

	-- The off hand. What is in it is the pack's to say -- a relic equipped there (Inventory:
	-- equipped("hand")) -- and this is only the entity being shown in it: the first relic in
	-- the pack, posed in the left hand every frame (postUpdate) while one is equipped. The
	-- weapon stays up beside it, and nothing else changes: a relic in hand used to slow the
	-- walk, bar the sprint and take the crosshair away, and none of that is left.
	self._handRelic = nil        -- the relic entity shown in the off hand, or nil

	-- The ward the compass is holding on while there are relics in the pack; see
	-- _wardObjective. A live record, so it is dropped in reload().
	self._wardHold = nil

	-- The cemetery gates. One stands locked in the wall around the graveyard, and two
	-- of the ward posts stand behind it, so what it locks away is ground the night can
	-- be won on. The gate owns itself entirely -- the pair of leaves and their swing,
	-- the grind, and the invisible "GateBlocker" box that does the actual barring,
	-- which its own unlock() takes out of the world (see Scripts/Gate) -- and a key is
	-- an item in the pack (_unlockGate spends one). This stage keeps only what is
	-- *around* the gates: where they stand, which are still locked, and how close the
	-- player has to be for the "locked" prompt to bother saying so.
	self._gateRange = Config.key.gateRange        -- how close to a locked gate the prompt reaches
	self._gates = nil             -- resolved off the world; index order is stable, see resolve
	self._unlockedGateIndex = {}  -- gate index -> true; plain data, so it survives a hot reload

	-- Chests. Each one owns its lid and its creak (its "Open" act, Scripts/Chest), and what it
	-- held when the night began is the level's, a property on each placed chest. What this
	-- stage keeps is what the gates keep -- where they stand, which are open, how close E
	-- reaches -- and one thing more: what is still in each chest once it has been opened. The
	-- player takes from that through the chest window (Scripts/Views/ChestView, see
	-- _setChestOpen), and what they leave is there to come back for. Plain data, keyed by chest
	-- index, so it survives a hot reload with the rest.
	self._chestRange = Config.chest.reachRange
	self._chests = nil            -- resolved off the world; index order is stable, see resolve
	self._openedChestIndex = {}   -- chest index -> true; plain data, so it survives a hot reload
	self._chestContents = {}      -- chest index -> { { kind, count }, ... } still inside it
	self._chestOpen = nil         -- the index of the chest whose window is up, or nil

	-- Levers, and the gates only a lever opens (the cave's portcullises). A lever owns
	-- its throw and finds its own gate by id (Scripts/Lever); a lever gate is a Gate
	-- component on an entity named "LeverGate", so no key ever fits it. The books here
	-- are the chests' again: which levers are pulled, as plain data -- a pulled lever
	-- reopens its gate on the restore path, so the gates need no index of their own.
	self._leverRange = Config.lever.reachRange
	self._levers = nil
	self._leverGates = nil
	self._pulledLeverIndex = {}

	-- Wards. A relic is spent by carrying it to a ward post and setting it down there,
	-- which lights that ward: the light kills whatever is standing on its ground at that
	-- moment (_purgeWard) and the Spawner will not place anything inside it afterwards.
	-- It does *not* hold the horde off -- zombies walk over consecrated ground like any
	-- other ground, so a lit ward is a place nothing rises, not a place nothing reaches.
	-- (The steering that used to keep them out was removed on 2026-08-11; the note at the
	-- top of Scripts/EnemyController says why.)
	--
	-- *Which* post is the player's call: there is no fixed order and no altar to return
	-- to, so every relic picked up is also a decision about where the next patch of
	-- cleared ground should be, and the posts are close enough together that lighting two
	-- neighbours wastes most of the second one's radius.
	--
	-- The trade is that each one also winds the rest of the night up (see
	-- _publishWards and Scripts/Spawner): you are buying an island and paying for it
	-- with a worse forest, so the last relic run is the bad one.
	self._wards = nil            -- resolved off the world; index order is stable, see resolve
	self._wardsLit = 0
	self._wardsNeeded = nil      -- how many have to burn to win; counted in resolve
	self._litWardIndex = {}      -- ward index -> true; plain data, so it survives a hot reload
	self._litWards = {}          -- published to the Spawner
	self._enemyPace = 1.0        -- published to EnemyController
	-- The disc the Spawner is barred from and the minimap draws, and -- a separate quantity
	-- that only used to share its number -- how far the flare reaches when a post takes
	-- light (Main:_purgeWard). Config notes the constraint between the two.
	self._wardRadius = Config.ward.radius            -- no-spawn radius of a lit ward (m)
	self._purgeRadius = Config.ward.purgeRadius      -- radius of the kill when a ward takes light (m)
	self._enemyPacePerWard = Config.ward.pacePerWard -- zombie speed added per lit ward
	self._noticeText = ""
	self._noticeTimer = 0.0

	-- Hives. The other half of the ward trade: every post that takes light wakes the
	-- nearest still-dormant hive, which opens (a theater act sinking the boulder that
	-- plugs it) and sends a brood of zombies out into the forest for good. The hive
	-- itself owns all of that -- see Scripts/Hive -- so this only tracks where the
	-- hives are and which have been woken, and wakes one by calling activate() on its
	-- ScriptComponent, exactly as it lights a ward.
	--
	-- Consecrating ground therefore costs something the player can see coming: the
	-- safe island is bought with a hive opening somewhere else on the map, and with
	-- more hives than wards it is also a choice about which of them stays shut.
	self._hives = nil            -- resolved off the world; index order is stable, see resolve
	self._awakeHiveIndex = {}    -- hive index -> true; plain data, so it survives a hot reload

	-- The night's tempo, owned here the way the loadout is: the event sites in
	-- _interact and _lightWard poke it (notify), update ticks it below the freeze
	-- returns, and the Spawner reads its verdict off this stage as _spawnDrive --
	-- which its constructor publishes. Constructing it also fires the night's first
	-- event, nightfall: a small opening surge, so the forest is not standing empty
	-- until the player first touches something.
	self._orchestrator = SpawnOrchestrator(self)

	-- The hive cutscene: the night holds its breath while one opens. See
	-- _beginCutscene for what freezes and what does not, and CUTSCENE_* for the shot.
	-- _pendingHive is the beat before it -- a hive chosen and counting down, with the
	-- game still running, so the ward the player just lit gets its own moment first.
	self._cutscene = nil         -- the record while one is running, nil otherwise
	self._pendingHive = nil      -- { hive, delay }: chosen, not yet open

	-- The night director. There is exactly one way to win -- every ward burning -- and it
	-- fires a sequence rather than an instant cut, so the payoff has room to land: the
	-- horde drops where it stands, the DAWN_ACT shot plays, and the screen floods warm
	-- into the victory card.
	--
	-- Only the directional light on the Sky entity carries the sunrise. SkyComponent has
	-- no script bindings at all (nothing in Weather is registered), and the theater cannot
	-- animate what is not bound either, so its intensity and horizon colours are out of
	-- reach for the act as much as for this script -- hence the wash, which covers the sky
	-- staying night-dark underneath.
	self._nightOver = false      -- true from the moment the last relic is placed
	self._victoryShown = false
	-- What is left of the sequence now that the act carries the sunrise: how long the light
	-- is held once the shot has played out, and how long the wash then takes to flood up.
	-- The shot's own length is not among them -- it is the act's, read off the theater
	-- component rather than copied out of it (see _updateDawn), so re-timing the act in the
	-- editor re-times everything after it too.
	self._dawn = 0.0             -- seconds since the last ward took light
	self._dawnHold = Config.dawn.hold         -- standing in the light, looking at the bodies
	self._dawnWashTime = Config.dawn.washTime    -- ...then the warm flood up to the victory card
	self._dawnMax = Config.dawn.max           -- never wait on the act longer than this
	self._dawnPlaying = false    -- true while the act is running, and so owns the camera
	self._dawnEnd = nil          -- _dawn when it let go; the two timings above run from there
	self._dawnCamera = nil       -- the entity the act flies; the layer renders through it

	-- The eye's eased height above the world (see EYE_HEIGHT_RATE and Main:_followEyeHeight).
	-- nil until the first frame with a player, which then takes the body's height outright.
	self._eyeY = nil

	-- Aiming: mouse Y pitches the view/weapon up and down (mouse X yaws, in update).
	-- Sign is worth reading twice: pitch turns about +X, so the forward vector it builds is
	-- (0, -sin(pitch), cos(pitch)) -- positive pitch aims *down*. Everything that only ever
	-- passes _pitch straight through to fromEulerAngles is indifferent to that; anything
	-- that offsets it gets it backwards if it assumes otherwise -- which is why the bias
	-- Main:aim takes is documented as negative-is-upward, and why the grenade's lift passes
	-- one (Grenades:attack).
	self._pitch = 0.0            -- current aim pitch (radians; + = down)
	self._pitchMin = Config.player.pitchMin       -- clamp low (~ -66 deg)
	self._pitchMax = Config.player.pitchMax        -- clamp high (~ +66 deg)
	self._invertPitch = Config.player.invertPitch    -- set true for inverted (flight-style) vertical look

	-- Knockback: impulse imparted to a zombie's rag doll when shot. Distributed across
	-- the limbs by RagDollPoseController:addImpulse, so this is total momentum: with ~11
	-- unit-mass limbs an impulse of 18 is roughly a 1.6 m/s whole-body shove.
	self._knockback = Config.corpse.knockback       -- impulse magnitude along the shot direction
	self._knockbackLift = Config.corpse.knockbackLift    -- extra upward impulse so the corpse flops back, not just slides
	self._bulletImpulse = Config.props.bulletImpulse     -- shove a round hands a loose body (door, table)
	self._pendingImpulse = {}    -- enemy -> list of impulses, applied once its rag doll turns active

	-- Pause menu: a modal dialog (hidden until Escape) floating centered over the HUD,
	-- holding a "PAUSED" title and Resume / Options / Exit. Dialog/PushButton come via
	-- UiKit.
	self._paused = false
	self._pauseDialog = Dialog(self._frame, TableLayout({ 0 }, { 0, 0, 0, 0 }, 24, 24, 0, 16))
	local pauseTitle = Static(self._pauseDialog, "PAUSED")
	pauseTitle:setTextSize(40)
	pauseTitle:setHorizontalAlign(Widget.ALIGN_CENTER)
	-- Explicitly white. UiKit's Static styles its text black, which was legible
	-- against the opaque grey panel this dialog used to have and is not against the
	-- night showing through the one it has now.
	pauseTitle:setTextColor(Color4f(1.0, 1.0, 1.0, 1.0))
	self._resumeButton = PushButton(self._pauseDialog, "Resume")
	self._resumeButton:setOnClick(function() self:_setPaused(false) end)
	self._optionsButton = PushButton(self._pauseDialog, "Options")
	self._optionsButton:setOnClick(function() self:_showOptions() end)
	-- Exit back to the startup stage, via the loading screen (see _exitToStartup).
	self._exitButton = PushButton(self._pauseDialog, "Exit")
	self._exitButton:setOnClick(function() self:_exitToStartup() end)

	-- The options, in a dialog of their own behind the pause menu: the same
	-- Scripts/Views/OptionsView the Startup menu shows, and the reason it is a view
	-- rather than a menu of its own. Worth having here rather than only on the way in,
	-- because everything it changes is applied to the world already being rendered --
	-- the forest is right there behind the dialog to judge a setting against.
	--
	-- On this Frame, like every other dialog here; see the one-Frame rule above the
	-- Game Over menu, which is what it cost to learn.
	self._optionsDialog = Dialog(self._frame, TableLayout({ 0 }, { 0 }, 24, 24, 0, 0))
	self._options = OptionsView(self._optionsDialog, environment)
	self._options:setOnClose(function() self:_hideOptions() end)

	-- The pack (Tab): Scripts/Views/InventoryView in a dialog of its own, on this Frame like
	-- every other dialog here. Opening it pauses the night exactly as the pause menu does --
	-- it sets the same _paused every frozen thing already reads -- so the pack is managed
	-- with nothing moving, and the cursor is handed back to click it. See _setInventoryOpen.
	self._inventoryOpen = false
	self._inventoryDialog = Dialog(self._frame, TableLayout({ 0 }, { 0 }, 24, 24, 0, 0))
	self._inventoryView = InventoryView(self._inventoryDialog, self)
	self._inventoryView:setOnClose(function() self:_setInventoryOpen(false) end)

	-- A chest's contents (E at a chest): Scripts/Views/ChestView, in its dialog, held the same way
	-- as the pack's. See _openChest and _setChestOpen.
	self._chestDialog = Dialog(self._frame, TableLayout({ 0 }, { 0 }, 24, 24, 0, 0))
	self._chestView = ChestView(self._chestDialog, self)
	self._chestView:setOnClose(function() self:_setChestOpen(nil) end)

	-- Dawn wash: a full-screen warm panel, hidden through the night and flooded up
	-- to opaque once it is won. FLOAT so it stays out of the frame's row layout, and
	-- created after the HUD and the other dialogs so it covers them -- but before the
	-- victory card below, which has to sit on top of it. Hidden rather than merely
	-- transparent: Panel listens for mouse presses and would otherwise swallow clicks
	-- meant for the pause menu.
	self._flash = Panel(self._frame, FloodLayout())
	self._flash.__layout = ILayout.FLOAT
	self._flash:setColor(Color4f(1.0, 0.94, 0.8, 0.0))
	self._flash:setVisible(false)

	-- Victory card, raised at the end of the sunrise.
	self._victoryDialog = Dialog(self._frame, TableLayout({ 0 }, { 0, 0, 0, 0 }, 24, 24, 0, 16))
	local victoryTitle = Static(self._victoryDialog, "DAWN")
	victoryTitle:setTextSize(60)
	victoryTitle:setHorizontalAlign(Widget.ALIGN_CENTER)
	victoryTitle:setTextColor(Color4f(0.85, 0.5, 0.08, 1.0))
	local victorySub = Static(self._victoryDialog, "THE NIGHT IS OVER")
	victorySub:setTextSize(22)
	victorySub:setHorizontalAlign(Widget.ALIGN_CENTER)
	self._victoryRestart = PushButton(self._victoryDialog, "Again")
	self._victoryRestart:setMinimumWidth(220)
	self._victoryRestart:setOnClick(function() self:_restart() end)
	self._victoryExit = PushButton(self._victoryDialog, "Exit")
	self._victoryExit:setMinimumWidth(220)
	self._victoryExit:setOnClick(function() self:_exitToStartup() end)

	-- Frame rate, top right. The very last thing on the Frame, so it draws over every
	-- dialog and the dawn wash: it is meant to be on screen whatever else is.
	self._fps = FpsCounter(self._frame, environment)

	-- The ways out of this stage that are taken with E (the cave mouth's): the StageExit
	-- components that offer a prompt, resolved off the world. See _exitInReach.
	self._exits = nil

	-- Every pickup this world laid out, by where it was first found (_collectPickups), and the
	-- stacks the player has put down in it since (dropSlot): the books that let a world left
	-- for another stage be laid out again as the player left it.
	self._pickups = nil
	self._pickupKeyOf = nil
	self._dropped = {}

	-- Arriving from another stage: the player as they left it...
	if carry ~= nil and carry.player ~= nil then
		local p < const > = carry.player
		self._health = math.max(1.0, math.min(self._maxHealth, p.health or self._maxHealth))
		self._healthBar:setValue(self._health / self._maxHealth)
		self._kills = p.kills or 0
		self._loadout:restore(p.weapons)
		self._godMode = p.godMode == true
		self._infiniteAmmo = p.infiniteAmmo == true
		if self._infiniteAmmo then
			self._loadout:setInfiniteAmmo(true)
		end
		self:_updateCheatLabel()
	end
	if carry ~= nil then
		self._orchestrator:restoreState(carry.orchestrator)
	end

	-- ...and this world as they left it, if they have been here before tonight. The index
	-- tables are the same plain data a script hot reload keeps, so resolve() puts the wards,
	-- hives, gates, chests and levers back exactly as it does after one; the pickups are
	-- _collectPickups' to lay out again.
	local here < const > = self._worlds[self._stageKey]
	if here ~= nil then
		self._litWardIndex = here.litWards or {}
		self._awakeHiveIndex = here.awakeHives or {}
		self._unlockedGateIndex = here.unlockedGates or {}
		self._openedChestIndex = here.openedChests or {}
		self._chestContents = here.chestContents or {}
		self._pulledLeverIndex = here.pulledLevers or {}
		self._pickupState = here.pickups
		self._droppedState = here.dropped
	end

	environment.input.inputSystem:setExclusive(true)
	environment.render.renderView:hideCursor()
end

-- Write the cheat line: one row naming whatever is currently on, and blank when nothing is.
--
-- Composed from the flags rather than each toggle setting its own string, so two cheats at
-- once cannot leave the label saying only the last one that was pressed. Called from the
-- toggles, never per frame -- there is nothing here a frame could change.
--
-- Joined with a plain "+" on purpose: every string in this stage is ASCII, and the HUD font
-- is not worth betting a separator glyph on.
function Main:_updateCheatLabel()
	local on = {}
	if self._godMode then
		table.insert(on, "GOD MODE")
	end
	if self._infiniteAmmo then
		table.insert(on, "INFINITE AMMO")
	end
	self._lblCheats:setText(table.concat(on, " + "))
end

-- Show or hide the HUD as a whole.
--
-- Two of it are missing from here on purpose, and both because they already decide
-- for themselves on every frame -- including the frames of a paused game, since both
-- run above Main:update's freeze returns. The crosshair reads _paused in
-- _updateCrosshair, and the minimap in _updateMinimap; hiding either from here would
-- last exactly one frame.
--
-- Hiding the row hides everything in it: the compass, the health bar and the weapon
-- carousel are children of that container, and Spark visibility is inherited.
function Main:_showHud(show)
	self._hud:setVisible(show)
	self._prompt.widget:setVisible(show)
	self._notice.widget:setVisible(show)
	self._feedLine.widget:setVisible(show)
	self._lblCheats:setVisible(show)
end

-- Hold the night still for one of the game's own windows -- the pack or a chest -- or let it
-- go again. It is a pause in everything but name: _paused is what every frozen thing in this
-- game already reads -- the zombies, the spawner, the pickups, the corpse timers, this stage's
-- own update below the freeze -- so setting it is the whole of holding the night still while
-- the player looks through their things. The HUD goes, as it does for the pause menu, and the
-- cursor is handed back to click with.
--
-- Refused over a cutscene or the dawn, which own the camera, and on top of the pause menu,
-- another window, or either of the night's ending screens.
function Main:_canOpenPanel()
	return not (self._gameOver or self._nightOver or self._paused or self._cutscene ~= nil)
end

function Main:_holdForPanel(hold)
	self._paused = hold
	self:_showHud(not hold)
	self.environment.input.inputSystem:setExclusive(not hold)
	if hold then
		self.environment.render.renderView:showCursor()
	else
		self.environment.render.renderView:hideCursor()
	end
end

-- Open or close the pack (Tab).
function Main:_setInventoryOpen(open)
	if open == self._inventoryOpen then
		return
	end
	if open and not self:_canOpenPanel() then
		return
	end
	self._inventoryOpen = open
	self:_holdForPanel(open)
	if open then
		-- Shown first and filled second: show() lays the dialog out, and the view re-places its
		-- labels in the cells that layout gives them (InventoryView:refresh).
		self._inventoryDialog:show()
		self._inventoryView:refresh()
	else
		self._inventoryDialog:hide()
	end
end

-- Put up the window for chest `index` (the chest's own `notice` line under its title), or with
-- nil take it down. Only the player takes it down -- E, Escape, the CLOSE button, or Tab, which
-- goes on to the pack -- even once the chest is empty.
function Main:_setChestOpen(index, notice)
	if index == self._chestOpen then
		return
	end
	if index ~= nil and (self._chestOpen ~= nil or not self:_canOpenPanel()) then
		return
	end
	self._chestOpen = index
	self:_holdForPanel(index ~= nil)
	if index ~= nil then
		self._chestDialog:show()
		self._chestView:showChest(index, notice)
	else
		self._chestDialog:hide()
	end
end

-- Enter/leave pause. Toggles the menu, takes the HUD off screen with it, frees or
-- recaptures the mouse cursor (so it can click the menu, then return to mouse-look),
-- and flips the freeze flag that Main:update and every EnemyController honour.
--
-- The HUD goes because the menu is the one time the player is looking at the game
-- rather than playing it -- the dialogs are panes now, so what is behind them is
-- meant to be seen. Nothing here needs undoing on the way out: the labels keep their
-- text and placement while hidden, and _updateHudText carries on writing them.
function Main:_setPaused(paused)
	if self._gameOver or self._nightOver then
		return
	end
	self._paused = paused
	self:_showHud(not paused)
	if paused then
		self._pauseDialog:show()
		self.environment.input.inputSystem:setExclusive(false)
		self.environment.render.renderView:showCursor()
	else
		-- Both, and in this order: leaving the pause while the options are up has to
		-- put the options away too, or the dialog would be left over a running game
		-- holding the modal -- and with the cursor taken back, nothing could close it.
		self._optionsDialog:hide()
		self._pauseDialog:hide()
		self.environment.input.inputSystem:setExclusive(true)
		self.environment.render.renderView:hideCursor()
	end
end

-- Swap the pause menu for the options and back. Hidden first and shown second in
-- both directions: Dialog:show takes the modal and Dialog:hide releases it, so doing
-- it the other way round would leave the one being put away holding it.
--
-- The game stays paused throughout -- this is a page of the pause menu, not a state
-- of its own -- which is why neither of these touches the cursor or _paused.
function Main:_showOptions()
	self._pauseDialog:hide()
	self._options:refresh()
	self._optionsDialog:show()
end

function Main:_hideOptions()
	self._optionsDialog:hide()
	self._pauseDialog:show()
end

-- Leave the level and go back to the Startup menu. Triggered from the pause and
-- Game Over menus' Exit buttons.
--
-- Routed through the Loading stage rather than straight at Startup: tearing this
-- world down and building the menu takes long enough to look like a hang, so the
-- Loading stage puts its panel up first and does the real load behind it. It is
-- the one named in the params table ("STARTUP", one of Stages/Loading's own
-- transitions); this stage only ever transitions to LOADING.
--
-- The load itself is async and the goto happens in Main:update, which polls the
-- loader before its paused/game-over early-returns.
-- Count what the night has accumulated, and print it.
--
-- An instrument, not a feature: leaving a long session takes noticeably longer than
-- leaving a short one, and teardown cost is a function of what is still standing --
-- Stage::destroy walks every layer, and World::destroy every entity in the world, tearing
-- down each one's components (a zombie alone carries thirteen physics bodies). So the way
-- to find a leak is to watch these numbers across a short session and a long one: whatever
-- grows with playing time is the thing paying for the wait.
--
-- `allocatedMemory()` is a Lua global the script manager registers (ScriptManagerLua) and
-- returns the script heap in bytes -- the direct answer to whether *script* objects are
-- the ones accumulating. The entity total comes from a range query wide enough to catch
-- the whole map, which is the only way to count entities the world was not asked to name.
--
-- Delete the two call sites and this function once the question is answered.
function Main:_census(when)
	local world = self.world.world
	if world == nil then
		return
	end

	local function n(t)
		local c = 0
		for _ in pairs(t) do
			c = c + 1
		end
		return c
	end

	local all < const > = world:getEntitiesWithinRange(Vector4(0.0, 0.0, 0.0, 1.0), 1.0e6).size
	print(string.format(
		"census (%s): entities %d | enemies %d effects? %d | dead %d pendingImpulse %d " ..
		"| lua heap %.1f KiB",
		when,
		all,
		world:getEntities("Enemy").size,
		all - world:getEntities("Enemy").size,
		n(self._deadEnemies),
		-- Careful if a length is ever added here: the length operator must not start a
		-- line. The script preprocessor trims each line and treats a leading '#' as a
		-- directive, so "#self._list" on its own line is an unknown keyword and the whole
		-- script fails to build -- before it is ever compiled, so Lua's own syntax check
		-- says nothing.
		n(self._pendingImpulse),
		allocatedMemory() / 1024.0
	))
end

function Main:_exitToStartup()
	if self._loader ~= nil then
		return
	end
	self:_census("exit")
	self._loader = self:loadStageAsync("LOADING", { target = "STARTUP" })
end

-- Restart: reload this gameplay stage from scratch via its "RESTART" self-transition
-- (declared on this Stage's StageData, pointing back at itself). Loaded async and
-- switched to in Main:update, exactly like _exitToStartup -- a brand-new stage/scene/
-- world is created, so all game state (health, kills, enemies, ...) resets.
function Main:_restart()
	if self._loader ~= nil then
		return
	end
	self:_census("restart")
	self._loader = self:loadStageAsync("RESTART", nil)
end

-- Leave for another stage through the loading screen. "target" names one of the Loading
-- stage's transitions (TERRAIN, CAVE, STARTUP; Loading falls back to STARTUP on anything
-- else), "notice" is an optional line flashed on the way out, and "spawn" the entity in the
-- destination's world to stand the player on (nil: wherever its scene puts the Humanoid).
-- Scripts/StageExit calls this when the player walks into its volume -- or presses E in one that
-- offers itself (_interact) -- and it is the one hook for anything else that should take the player
-- somewhere. Returns whether the trip started: false while another load (restart, the menus'
-- exit) is already in flight, or once the night is decided.
--
-- The player goes as they are. What they carry -- the pack, the rounds in each weapon, their
-- health, the cheats they had on -- rides through the Loading stage to the next one (_carry),
-- and so do the books of this world: which wards burn, which chests stand open and what is left
-- in them, what has been taken off the ground and where the relics are. Coming back here later
-- tonight therefore finds it as it was left, rather than laid out afresh to be looted twice.
-- The horde is not kept: the dead stay dead and the living are the spawner's to raise again.
function Main:leaveStage(target, notice, spawn)
	if self._loader ~= nil or target == nil or self._gameOver or self._nightOver then
		return false
	end
	if notice ~= nil then
		self:_showNotice(notice)
	end
	self:_census("leave")
	self._loader = self:loadStageAsync("LOADING", { target = target, carry = self:_carry(spawn) })
	return self._loader ~= nil
end

-- Everything that goes to the next stage, as plain data (but for the Transforms of things
-- put down, which are values). The world books are keyed by stage, so the cave's and the
-- forest's travel side by side for as long as the night lasts.
function Main:_carry(spawn)
	self._worlds[self._stageKey] = self:_saveWorld()
	return {
		spawn = spawn,
		worlds = self._worlds,
		orchestrator = self._orchestrator:saveState(),
		player = {
			inventory = self._inventory:saveState(),
			weapons = self._loadout:snapshot(),
			health = self._health,
			kills = self._kills,
			godMode = self._godMode,
			infiniteAmmo = self._infiniteAmmo,
		},
	}
end

-- This world's books. The index tables are the ones resolve() restores from; the pickups are
-- written out per home key (see _collectPickups) and only where something has changed: taken
-- for good, a pile partly taken, or a keepsake -- a relic -- carried, put down or spent.
function Main:_saveWorld()
	local pickups = {}
	for key, rec in pairs(self._pickups or {}) do
		local sc < const > = rec.sc
		if rec.taken then
			pickups[key] = { taken = true }
		elseif sc:isKeepsake() then
			pickups[key] = {
				carried = self._inventory:holds(rec.entity),
				visible = rec.entity.visible,
				at = rec.entity.transform
			}
		elseif sc._count ~= nil then
			pickups[key] = { count = sc:itemCount() }
		end
	end
	local dropped = {}
	for e, _ in pairs(self._dropped) do
		local sc < const > = e:getComponent(traktor.world.ScriptComponent)
		if sc ~= nil and sc.itemKind ~= nil then
			table.insert(dropped, { kind = sc:itemKind(), count = sc:itemCount(), at = e.transform })
		end
	end
	return {
		litWards = self._litWardIndex,
		awakeHives = self._awakeHiveIndex,
		unlockedGates = self._unlockedGateIndex,
		openedChests = self._openedChestIndex,
		chestContents = self._chestContents,
		pulledLevers = self._pulledLeverIndex,
		pickups = pickups,
		dropped = dropped
	}
end

-- Called by Stage::destroy on the way out, *before* the layers -- and so before the
-- world -- are torn down. Which makes it the only place some of this can be done.
function Main:finalize()
	-- Nothing to do about the wind here: it is the stage's own "ambience" AudioLayer, torn
	-- down with every other layer by Stage::destroy. It was briefly a looping sound event
	-- raised on the player instead, which is a trap worth remembering -- SoundEventInstance
	-- holds a Ref to whatever raised it and the event manager only ever drops an instance
	-- whose sound has stopped, which a loop never does, so the bed kept the player entity
	-- and its physics alive past the stage that owned them.
	if self._optionsDialog ~= nil then
		self._optionsDialog:remove()
		self._optionsDialog = nil
		self._options = nil
	end
	if self._inventoryDialog ~= nil then
		self._inventoryDialog:remove()
		self._inventoryDialog = nil
		self._inventoryView = nil
	end
	if self._chestDialog ~= nil then
		self._chestDialog:remove()
		self._chestDialog = nil
		self._chestView = nil
	end
	if self._pauseDialog ~= nil then
		self._pauseDialog:remove()
		self._pauseDialog = nil
	end
	if self._gameOverDialog ~= nil then
		self._gameOverDialog:remove()
		self._gameOverDialog = nil
	end
	if self._victoryDialog ~= nil then
		self._victoryDialog:remove()
		self._victoryDialog = nil
	end
	self._frame:remove()
	self._frame = nil
end

-- Collect every entity named `name` into one record per instance -- { entity, x, z,
-- index, [flag] } -- and restore the ones `restoredIndex` names by calling `restore`
-- on their ScriptComponents. One function because the wards, the hives and the gates
-- all keep their books the same way, and the way has two load-bearing rules:
--
--   * The order is not a sequence, but it must be *stable*: a record's index in the
--     list is the key its plain-data index table remembers it by across a script hot
--     reload (the records themselves hold live entity handles and do not survive
--     one). Sorted on position rather than left in world order, so re-parenting or
--     re-adding one in the scene editor cannot renumber the ones already turned.
--
--   * Restoring is re-asserting state that already happened, not replaying it, so
--     the component's method is called with `true` -- instantly: a mid-game reload
--     must not replay every flare, send up a second brood, or grind the gate open
--     again. A fresh night has an empty index table and restores nothing.
function Main:_collectRecords(world, name, flag, restoredIndex, restore)
	local list = {}
	local i = 0
	while true do
		local e = world:getEntity(name, i)
		if e == nil then
			break
		end
		i = i + 1
		local p < const > = e.transform.translation
		local rec = { entity = e, x = p.x, z = p.z }
		rec[flag] = false
		table.insert(list, rec)
	end
	table.sort(list, function (l, r)
		if l.x ~= r.x then
			return l.x < r.x
		end
		return l.z < r.z
	end)
	for k, rec in ipairs(list) do
		rec.index = k
		if restoredIndex[k] then
			rec[flag] = true
			local sc < const > = rec.entity:getComponent(traktor.world.ScriptComponent)
			if sc ~= nil then
				sc[restore](sc, true)
			end
		end
	end
	return list
end

-- Resolve (and cache) the humanoid entity, its character controller and the camera.
function Main:resolve()
	if self._heading == nil then
		self._heading = 0.0
	end
	local world = self.world.world
	if world == nil then
		return
	end
	-- ...and not until the world has been through one update of its own. This stage's script
	-- is updated *before* its layers are (Stage::update), and a ScriptComponent only builds its
	-- script object on its first update or setTransform after joining the world -- so on the
	-- very first frame every ward, chest and pickup is still a bare component with none of its
	-- methods, and restoring one (turnOn, open, show) or asking what a pickup is would find
	-- nothing to call. postUpdate, which runs after the world, says when it has.
	if not self._worldUpdated then
		return
	end
	-- Collect the night's fixtures once: the wards, the hives and the gates, all
	-- through _collectRecords above -- the stable ordering and the replay-free restore
	-- are its two rules, and the same two for all three. Each list ends up empty
	-- (non-nil) in a scene with none of that kind, which is what stops these
	-- re-running every frame in Scene 1.
	--
	-- The records only know where each fixture stands and which have turned: each
	-- ward's flame is owned by its own Ward ScriptComponent (Scripts/Ward), each
	-- hive's opening and brood by Scripts/Hive, and everything a gate *is* -- the
	-- leaves, the swing, the grind, the invisible blocker that does the actual
	-- barring -- by Scripts/Gate. Gate:unlock is idempotent about the blocker, so
	-- re-asserting one whose bar is already gone is safe.
	if self._wards == nil then
		self._wards = self:_collectRecords(world, "Ward", "lit", self._litWardIndex, "turnOn")

		local lit = 0
		for _, w in ipairs(self._wards) do
			if w.lit then
				lit = lit + 1
			end
		end
		self._wardsLit = lit

		-- How many have to burn. Deliberately *not* "all of them": a relic is spent
		-- for good on the post it lights, so the night can only ask for as many wards
		-- as there are relics in the world to pay for them. Authoring more posts than
		-- relics is therefore what turns this into a real decision -- the player picks
		-- which ground is worth consecrating and leaves the rest of the posts dark --
		-- while an equal count leaves only the order to choose. Either way the scene
		-- cannot be made unwinnable by adding a post to it.
		self._wardsNeeded = math.min(#self._wards, world:getEntities("Relic").size)

		self:_publishWards()
	end
	if self._hives == nil then
		self._hives = self:_collectRecords(world, "Hive", "awake", self._awakeHiveIndex, "activate")
	end
	if self._gates == nil then
		self._gates = self:_collectRecords(world, "Gate", "unlocked", self._unlockedGateIndex, "unlock")
	end
	if self._chests == nil then
		self._chests = self:_collectRecords(world, "Chest", "opened", self._openedChestIndex, "open")
	end
	if self._leverGates == nil then
		self._leverGates = self:_collectRecords(world, "LeverGate", "unlocked", {}, "unlock")
	end
	if self._levers == nil then
		self._levers = self:_collectRecords(world, "Lever", "pulled", self._pulledLeverIndex, "pull")
	end
	-- The ways out taken with E: every StageExit whose component offers a prompt. The ones that
	-- are walked through (the cave's) see to themselves and are not listed.
	if self._exits == nil then
		self._exits = {}
		local i = 0
		while true do
			local e < const > = world:getEntity("StageExit", i)
			if e == nil then
				break
			end
			i = i + 1
			local sc < const > = e:getComponent(traktor.world.ScriptComponent)
			if sc ~= nil and sc.offers ~= nil and sc:prompt() ~= nil then
				table.insert(self._exits, sc)
			end
		end
	end
	-- Every pickup lying in the world, and -- for a world the player has been in before tonight
	-- -- laid out again as they left it. Before the humanoid is resolved below, which is what
	-- the pickups wait on before anything can be walked over: so nothing has left the ground,
	-- or moved off its first spot, when they are counted.
	if self._pickups == nil then
		self:_collectPickups(world)
	end
	if self._humanoid == nil then
		self._humanoid = world:getEntity("Humanoid")
	end
	if self._camera == nil then
		self._camera = world:getEntity("Camera0")
		-- Bind the WorldLayer's render camera explicitly, rather than relying on the
		-- layer to find "Camera0" by itself. It only does that inside its
		-- m_scene.changed() branch, and a *same-scene* stage transition -- exactly our
		-- Game Over -> Restart, which re-enters Main via the RESTART self-transition --
		-- consumes that flag in WorldLayer::transition to keep the world renderer it
		-- inherits from the outgoing layer. So the fresh layer never resolves a camera:
		-- postUpdate stops sampling one, preSetup stops updating the view, and the
		-- inherited render view stays frozen wherever the old camera died, while this
		-- script still happily moves the Camera0 entity nobody is looking through.
		-- Assigning it here is authoritative and survives any transition.
		if self._camera ~= nil then
			self.world.camera = self._camera
		end
	end
	-- The camera the DAWN_ACT flies. Held like the first-person one above -- a live handle,
	-- so it is dropped in reload() and found again here -- and re-asserted as the layer's
	-- camera if the shot was already running when the script was reloaded, since the block
	-- above will just have bound the first-person one back over it.
	if self._dawnCamera == nil then
		self._dawnCamera = world:getEntity(DAWN_CAMERA)
		if self._dawnCamera ~= nil and self._dawnPlaying then
			self.world.camera = self._dawnCamera
		end
	end
	if self._character == nil and self._humanoid ~= nil then
		self._character = self._humanoid:getComponent(traktor.physics.CharacterComponent)
		if self._character ~= nil then
			self._heading = self._character.headAngle
		end
	end
	-- Arriving from another stage at a named spot -- out of the cave, in front of its mouth:
	-- stand the player on it, facing the way it faces. Assigning the entity's transform is what
	-- moves the character controller's body and turns its head (CharacterComponent::setTransform),
	-- so the heading is read back from it afterwards. A scene without the spot leaves the player
	-- where the Humanoid stands.
	if self._arrival ~= nil and self._character ~= nil then
		local spot < const > = self._arrival
		local mark < const > = world:getEntity(spot)
		self._arrival = nil
		if mark ~= nil then
			self._humanoid.transform = mark.transform
			self._heading = self._character.headAngle
			self._pitch = 0.0
			self._eyeY = nil
		else
			print("Main: no arrival spot named '" .. tostring(spot) .. "' in this scene")
		end
	end
	if self._poseController == nil and self._humanoid ~= nil then
		local skeleton = self._humanoid:getComponent(traktor.animation.SkeletonComponent)
		if skeleton ~= nil then
			self._poseController = skeleton.poseController
		end
	end
	if self._bloodEvents == nil and self._humanoid ~= nil then
		self._bloodEvents = self._humanoid:getComponent(traktor.world.EventSetComponent)
	end
	-- The weapons. What each one needs off the world it finds for itself -- the rifle's own
	-- child entity, its event set and its tracer trail; the grenade kept aside as a view
	-- model -- so a new weapon adds nothing here. Called every frame, exactly as the rest of
	-- this function is, and cheap once each of them has what it wants (Weapon:resolve).
	self._loadout:resolve()

	-- Last, because it fits itself to the wards resolved above *and* to where the
	-- player is standing. Survives a hot reload untouched: _minimapBuilt is plain
	-- data on the stage and the widget keeps the marker clips it already made, so
	-- this must not run a second time and double them up.
	if not self._minimapBuilt and self._wards ~= nil and self._humanoid ~= nil then
		self._minimapBuilt = true
		self._minimapMapped = self:_buildMinimap(world)
	end
end

-- ---- What a weapon is given ----
--
-- The whole of this stage that a Scripts/Weapons/Weapon may use. It is written out in one
-- place because it is an interface, not an accident: the weapons are ignorant of Main (they
-- are handed a context and ask it questions) and Main is ignorant of the weapons (it hands
-- the loadout buttons and frames and never asks what is in it). What a second or third
-- weapon turns out to need belongs here, next to these, rather than reached for off a field.

-- Where the player is looking from, and along. Every shot, swing and throw starts at these,
-- so changing how the player aims moves all of them together -- and the first person camera
-- with them, since postUpdate places it from the same two.
--
-- aim() takes an optional pitch bias in radians for a weapon that does not leave the hand
-- along the sightline -- the grenade's lift. Mind the sign: pitch grows *downward* (see
-- _pitch in :new), so leaving above the crosshair means a negative bias.
function Main:eye()
	if self._humanoid == nil then
		-- Asked before resolve found the player, which nothing has fired through yet. xyz1
		-- because EYE_OFFSET is an offset (w = 0) and this is a position.
		return EYE_OFFSET.xyz1
	end
	local eye < const > = self._humanoid.transform.translation + EYE_OFFSET
	if self._eyeY == nil then
		return eye
	end
	return Vector4(eye.x, self._eyeY, eye.z, 1.0)
end

-- Ease the eye's height towards the body's, once a simulation step from postUpdate -- before the
-- camera, the view models and the carried item are placed from Main:eye(), so all of them
-- ride the same eased height and a rifle never bobs against a view that does not.
function Main:_followEyeHeight(dt)
	local target < const > = self._humanoid.transform.translation.y + EYE_OFFSET.y
	local y = self._eyeY
	if y == nil or math.abs(target - y) > EYE_HEIGHT_SNAP then
		y = target
	else
		y = y + (target - y) * (1.0 - math.exp(-EYE_HEIGHT_RATE * dt))
		y = math.max(target - EYE_HEIGHT_MAX_LAG, math.min(target + EYE_HEIGHT_MAX_LAG, y))
	end
	self._eyeY = y
end

function Main:aim(pitchBias)
	return Quaternion.fromEulerAngles(self._heading, self._pitch + (pitchBias or 0.0), 0.0)
end

function Main:aimDirection(pitchBias)
	return self:aim(pitchBias) * Vector4(0.0, 0.0, 1.0, 0.0)
end

-- The player's entity, or nil before resolve has found it -- a weapon is updated from the
-- first frame and has to cope with the world not being up yet.
function Main:player()
	return self._humanoid
end

-- Sprinting while actually moving, and whether a relic is held in the off hand. Both are things
-- a view model answers to: the first drops it to a low ready, the second moves it over to make
-- room. Weapons ask rather than being told, so a weapon that does not care says nothing.
function Main:isRunning()
	return self._running
end

function Main:isCarrying()
	return self._handRelic ~= nil
end

-- The pack (Scripts/Items/Inventory). The weapons read who owns them and how many spare rounds
-- there are out of it; the pickups and the inventory screen go through the calls below.
function Main:inventory()
	return self._inventory
end

-- Has this one already been handed to the rag doll path? Anything that sweeps the horde has
-- to ask, or a corpse takes a second shove and is counted a second time.
function Main:isEnemyDead(enemy)
	return self._deadEnemies[enemy] ~= nil
end

-- What a corpse is shoved with, along `dir`: the knockback, plus the lift that makes it flop
-- back rather than slide. One place, because a round, a ward's flare and the kill-all
-- shortcut all want the same shove and only Config.corpse should have a say in how hard. A
-- blast is the exception and says so itself -- it falls off with distance (Grenades:_explode).
function Main:knockbackImpulse(dir)
	return dir * self._knockback + Vector4(0.0, self._knockbackLift, 0.0, 0.0)
end

-- A shot was heard, here. Published for Scripts/EnemyController: a patrolling zombie near
-- enough walks over to have a look. Mutated rather than replaced, and seq counts up forever
-- -- see _gunshot in :new for why both matter.
function Main:reportGunshot(x, z)
	local shot = self._gunshot
	if shot == nil then
		shot = { seq = 0 }
		self._gunshot = shot
	end
	shot.x = x
	shot.z = z
	shot.seq = shot.seq + 1
end

-- Recoil bloom on the reticle. Called by anything that goes off, hit or miss -- on a miss it
-- is the only answer the player gets.
function Main:kickCrosshair()
	if self._crosshair ~= nil then
		self._crosshair:kick()
	end
end

-- Put one of the player's own effects at a world point -- the dust a round kicks off a wall.
-- Raised on the player's event set with an offset, because that is how this game places an
-- effect at an arbitrary point: SpawnEffectEvent spawns at sender-transform times offset, so
-- the offset is that point taken back into the player's frame. Those events are follow=false,
-- so what is spawned stays where it was put while the player walks on.
function Main:raisePlayerEffect(name, worldPoint)
	if self._bloodEvents == nil or self._humanoid == nil then
		return
	end
	local localPoint < const > = self._humanoid.transform:inverse():transform(worldPoint)
	self._bloodEvents:raise(name, Transform(localPoint, Quaternion.identity))
end

-- ---- What a pickup is given ----
--
-- Everything lying in the world goes into the pack through here (Scripts/Pickup:collect): up
-- to `count` of `kind`, and a keepsake's own `entity` with it. Returns how many went in -- the
-- rest is the pickup's to leave where it lies -- and says so on the feed line.
function Main:giveItem(kind, count, entity)
	local added < const > = self._inventory:add(kind, count, entity)
	if added <= 0 then
		return 0
	end
	local text = self:_feedCounted(kind, added)

	-- Committing to a run is exactly when the night should lean in. What kind of run taking
	-- this item is -- the key's, a relic's -- the item says (Items: `event`), and it is said
	-- here so it counts the same off the ground or out of a chest. The orchestrator ignores an
	-- event it has no tuning for.
	local def < const > = Items[kind]
	if def ~= nil and def.event ~= nil and self._orchestrator ~= nil then
		self._orchestrator:notify(def.event)
	end

	-- Something that has to be equipped before it does anything says how as it arrives -- the
	-- relic above all, which lights nothing from the pack -- and a weapon found while another is
	-- in hand says how to reach it.
	if added < count then
		text = text .. "   THE PACK IS FULL"
	elseif def ~= nil and def.equip ~= nil and not self._inventory:isEquipped(kind) then
		text = text .. ((def.equip == "weapon") and "   SCROLL TO DRAW" or "   TAB TO EQUIP")
	end
	self:_feed(text, kind)
	return added
end

-- A walk-over pickup the pack has no room for. Called once per visit by the pickup itself, so
-- standing on one says it once rather than every frame.
function Main:packFull(kind)
	local def < const > = Items[kind]
	local what < const > = (def ~= nil) and (def.plural or def.name) or "IT"
	self:_feed("NO ROOM IN THE PACK FOR " .. what)
end

-- A pickup has gone for good, all of it into the pack (Pickup:_taken). Booked so the world can
-- be laid out without it if the player leaves for another stage and comes back.
function Main:pickupTaken(entity)
	local key < const > = (self._pickupKeyOf ~= nil) and self._pickupKeyOf[entity] or nil
	if key ~= nil then
		self._pickups[key].taken = true
		self._pickupKeyOf[entity] = nil
	end
	self._dropped[entity] = nil
end

-- ---- The pickups' books ----
--
-- Pickup promises that nothing taken ever comes back, and a world is built afresh every time its
-- stage is loaded -- so a trip into the cave and out again would lay the whole forest out a
-- second time unless the stage remembers what was taken from it. It does that here, keyed by
-- where each pickup was first found: the scene puts every one in the same place every load, so
-- that spot is a name for it that survives the world being rebuilt (and is kept on the component
-- as _home, so a script hot reload that keeps the world finds the same names again).

-- Count every pickup in the world once, and lay out what was saved for it, if anything was.
function Main:_collectPickups(world)
	self._pickups = {}
	self._pickupKeyOf = {}
	local all < const > = world:getEntitiesWithinRange(Vector4(0.0, 0.0, 0.0, 1.0), 1.0e6)
	for i = 0, all.size - 1 do
		local e < const > = all:get(i)
		local sc < const > = e:getComponent(traktor.world.ScriptComponent)
		if sc ~= nil and sc.itemKind ~= nil and sc.collect ~= nil and not self._dropped[e] then
			local key = sc._home
			if key == nil then
				local p < const > = e.transform.translation
				key = string.format("%s@%.2f,%.2f,%.2f", tostring(sc:itemKind()), p.x, p.y, p.z)
				-- Two of a kind on the very same spot would share a name; the second gets a mark.
				while self._pickups[key] ~= nil do
					key = key .. "'"
				end
				sc._home = key
			end
			self._pickups[key] = { entity = e, sc = sc }
			self._pickupKeyOf[e] = key
		end
	end

	if self._pickupState ~= nil or self._droppedState ~= nil then
		self:_restorePickups(world, self._pickupState or {}, self._droppedState or {})
		self._pickupState = nil
		self._droppedState = nil
	end
end

-- Lay the pickups out as the player left them (see _saveWorld): the ones taken taken away, the
-- piles partly taken cut down, every relic back where it was -- in the pack, on the ground or
-- parked on the post it lit -- and the stacks the player put down put back down.
function Main:_restorePickups(world, saved, dropped)
	local carried = {}
	for key, s in pairs(saved) do
		local rec < const > = self._pickups[key]
		if rec ~= nil then
			if s.taken then
				rec.taken = true
				self._pickupKeyOf[rec.entity] = nil
				-- Same pair as Pickup:_taken: removed, then destroyed, or its components linger.
				world:removeEntity(rec.entity)
				rec.entity:destroy()
			elseif s.carried then
				-- In the pack: hidden, and handed back to it below.
				rec.sc:show(false)
				local kind < const > = rec.sc:itemKind()
				carried[kind] = carried[kind] or {}
				table.insert(carried[kind], rec.entity)
			elseif s.at ~= nil then
				rec.entity.transform = s.at
				rec.sc:show(s.visible == true)
			elseif s.count ~= nil then
				rec.sc:setCount(s.count)
			end
		end
	end
	for kind, list in pairs(carried) do
		self._inventory:attachKept(kind, list)
	end
	for _, d in ipairs(dropped) do
		self:_putDownNew(d.kind, d.count, d.at)
	end
end

-- Build a stack of `kind` fresh from its item's entity data and stand it at `transform`, told how
-- many it is (Pickup:asDropped) -- which also keeps it from being walked straight back into the
-- pack. Booked as put down, so it is still lying there if the player leaves and comes back.
function Main:_putDownNew(kind, count, transform)
	local def < const > = Items[kind]
	if def == nil or def.entity == nil then
		return nil
	end
	local e < const > = self.world:createEntity(def.entity)
	if e == nil then
		return nil
	end
	-- The transform first: assigning it is what brings the item's script object into being
	-- (ScriptComponent::setTransform), so it can be told what it is straight after.
	e.transform = transform
	local sc < const > = e:getComponent(traktor.world.ScriptComponent)
	if sc ~= nil and sc.asDropped ~= nil then
		sc:asDropped(count)
	end
	self._dropped[e] = true
	return e
end

-- ---- What the inventory screen is given ----
--
-- Every action Scripts/Views/InventoryView offers, done here because the stage is what owns
-- the consequences: the hands, the health, the world a dropped thing lands in. Each returns
-- whether it did anything; the view redraws from the pack either way.

-- Equip `kind` where it goes: a weapon drawn, a relic into the off hand, armour worn.
function Main:equipItem(kind)
	if not self._inventory:equip(kind) then
		return false
	end
	local def < const > = Items[kind]
	if def ~= nil and def.equip == "hand" then
		self:_feed(def.name .. " IN HAND")
	end
	return true
end

-- Put `kind` back in the pack. Unequipping the weapon leaves the hands empty, on purpose --
-- the loadout only reaches for the next weapon when one is *lost* (Loadout:_inventoryChanged).
function Main:unequipItem(kind)
	local def < const > = Items[kind]
	if def == nil or def.equip == nil or self._inventory:equipped(def.equip) ~= kind then
		return false
	end
	return self._inventory:unequip(def.equip)
end

-- Eat or drink one of `kind`. Refused at full health, so food is never wasted on nothing.
function Main:useItem(kind)
	local def < const > = Items[kind]
	if def == nil or def.heal == nil or self._inventory:count(kind) <= 0 then
		return false
	end
	if self._health >= self._maxHealth then
		self:_feed("NOT HURT")
		return false
	end
	self._inventory:remove(kind, 1)
	local before < const > = self._health
	self._health = math.min(self._maxHealth, self._health + def.heal)
	-- Handed to the bar now rather than at the bottom of update, which does not run while the
	-- pack is open: the bar animates itself above the freeze, so the drink is seen going down.
	self._healthBar:setValue(self._health / self._maxHealth)
	self:_feed("+ " .. tostring(math.floor(self._health - before + 0.5)) .. " HEALTH")
	return true
end

-- Put the whole stack in slot `index` down in front of the player. A keepsake is its own entity
-- and is stood back on the ground (Pickup:putDown); anything else is built fresh from its item's
-- entity data (_putDownNew).
function Main:dropSlot(index)
	local s < const > = self._inventory:slot(index)
	if s == nil or self._humanoid == nil or self.world == nil then
		return false
	end
	local def < const > = Items[s.kind]
	if def == nil or (not def.keep and def.entity == nil) then
		self:_feed("THAT CANNOT BE PUT DOWN")
		return false
	end
	-- A relic carried out of the world it belongs to has no entity here to stand on the ground
	-- (Inventory:keptMissing): it can be put down again once the player is back in that world.
	if self._inventory:keptMissing(index) then
		self:_feed("THAT CANNOT BE PUT DOWN HERE")
		return false
	end

	local stack < const > = self._inventory:removeSlot(index)
	if def.keep then
		for k, e in ipairs(stack.entities or {}) do
			local sc < const > = e:getComponent(traktor.world.ScriptComponent)
			if sc ~= nil and sc.putDown ~= nil then
				sc:putDown(self:_dropTransform(k - 1))
			end
		end
	else
		self:_putDownNew(stack.kind, stack.count, self:_dropTransform(0))
	end
	self:_feed("PUT DOWN " .. Items.describe(stack.kind, stack.count))
	return true
end

-- How much of a bite the worn armour takes, 0..1.
function Main:armor()
	local kind < const > = self._inventory:equipped("body")
	local def < const > = (kind ~= nil) and Items[kind] or nil
	return (def ~= nil and def.armor ~= nil) and def.armor or 0.0
end

-- Where something put down out of the pack lands: Config.inventory.dropAhead in front of the
-- player, stood on the ground and facing the way they are. `k` fans several out side by side --
-- a stack of relics is that many crosses, not one on top of the other.
function Main:_dropTransform(k)
	local heading < const > = Quaternion.fromEulerAngles(self._heading, 0.0, 0.0)
	local side < const > = ((k % 2) == 1) and 1.0 or -1.0
	local across < const > = side * math.floor((k + 1) / 2) * 0.45
	local at < const > = self._humanoid.transform.translation
		+ heading * Vector4(across, 0.0, Config.inventory.dropAhead, 0.0)
	return Transform(self:_groundAt(at), heading)
end

-- Show or hide a keepsake (a relic) through its own component, which knows about the little
-- light hanging off it (Pickup:show).
function Main:_showKept(entity, visible)
	local sc < const > = entity:getComponent(traktor.world.ScriptComponent)
	if sc ~= nil and sc.show ~= nil then
		sc:show(visible)
	else
		entity.visible = visible
	end
end

-- Mark one zombie dead: blood burst at the impact point, hand it over to its
-- EnemyController (which polls _deadEnemies and switches the body to rag doll), queue
-- the knockback for the frame its rag doll controller goes active, and tally the kill.
-- Shared by the weapon and the kill-all shortcut so a zombie only ever dies one way.
-- Returns false if it was already dead, so a second trigger cannot double-count it.
--
-- `whole` picks how the rag doll takes the impulse, and the two are genuinely different
-- forces rather than a stylistic choice. Left false (a round, a ward's flare) it lands on
-- the limb nearest `point`, which gains the spin as well as the speed and drags the rest of
-- the body after it through its joints -- a hit with somewhere it hit. Set true (a blast)
-- it is spread across every limb so the body's momentum changes by exactly `impulse` and
-- nothing tumbles about anything: a pressure wave arrives everywhere at once, and picking a
-- limb for it would tear the corpse apart round whichever one happened to be nearest.
function Main:killEnemy(enemy, point, impulse, whole)
	if enemy == nil or self._deadEnemies[enemy] ~= nil then
		return false
	end
	self:_woundEnemy(enemy, point)
	self._deadEnemies[enemy] = self._corpseLifetime
	self:_queueImpulse(enemy, point, impulse, whole)
	self._kills = self._kills + 1
	return true
end

-- Open a wound where something arrived on a zombie, rather than at the zombie's origin.
--
-- SpawnEffectEvent spawns at sender-transform times offset, so the offset is `point` -- a world
-- position -- taken back into the zombie's own frame, and the two multiply out to exactly the
-- place that was hit. A leg shot opens at the leg and a head shot at the head, which is the
-- whole reason Rifle:attack passes the ray's own hit position down here instead of a guess along
-- the aim. Callers with no ray to speak of pass the middle of the body instead, so a blast or a
-- ward's flare still bursts at the chest.
--
-- Effects/BloodSplat emits about its own origin for this to work: the lift that used to be baked
-- into its emitters could only ever be right for one caller, and putting it here instead is what
-- lets each of them say where their own blood belongs.
--
-- The zombie's event follows the sender, so the wound keeps pouring from the same spot on the
-- body as the corpse ragdolls away, while the emitters being world-space leaves what is already
-- in the air where it was shed. "hit" is the sound of the round arriving, raised on the zombie so
-- it comes from out there where the shot landed rather than from the rifle.
--
-- Raised for a hit on a body that is already a corpse as well (shoveCorpse), which is the point
-- of it being its own function: a round into one is still a round into meat.
function Main:_woundEnemy(enemy, point)
	local hitEvents < const > = enemy:getComponent(traktor.world.EventSetComponent)
	if hitEvents == nil then
		return
	end
	local wound < const > = enemy.transform:inverse():transform(point)
	hitEvents:raise("blood", Transform(wound, Quaternion.identity))
	hitEvents:raise("hit")
end

-- Book an impulse for a zombie's rag doll. It cannot simply be applied: on the frame a zombie
-- dies its rag doll controller is not active yet -- the state graph has to reach the dead state
-- and reset the limbs into the pose -- so this is held until the pass in update finds a
-- controller to hand it to.
--
-- A list per zombie rather than one record, because impulses arrive in bursts and each is a
-- different force in a different place: a second round into a body still blending into its rag
-- doll, a grenade going off over a corpse that went down the same frame. Keeping only the last
-- silently threw the rest away.
function Main:_queueImpulse(enemy, point, impulse, whole)
	local queued = self._pendingImpulse[enemy]
	if queued == nil then
		queued = {}
		self._pendingImpulse[enemy] = queued
	end
	table.insert(queued, { point = point, impulse = impulse, whole = whole })
end

-- Shove a zombie that is already a corpse: the same wound and the same impulse a standing one
-- would have taken, handed to the rag doll it has become, and its despawn countdown wound back
-- to a full lifetime.
--
-- Two things this is for. A body is worth shooting -- a round into one that has just gone down
-- should throw it about, not vanish into the dirt, and a blast should scatter what is lying
-- around it as well as what is standing. And a corpse being hit is the player still spending
-- attention on it, so it should not evaporate mid-magazine: the clock is *reset* rather than
-- extended, so a body that keeps being hit keeps lying there and one left alone still goes on
-- the usual six seconds.
--
-- Refuses anything not already dead, which is what keeps this and killEnemy from overlapping:
-- that one is the one-way door, this is only what happens afterwards. No kill is counted.
function Main:shoveCorpse(enemy, point, impulse, whole)
	if enemy == nil or self._deadEnemies[enemy] == nil then
		return false
	end
	self:_woundEnemy(enemy, point)
	self._deadEnemies[enemy] = self._corpseLifetime
	self:_queueImpulse(enemy, point, impulse, whole)
	return true
end

-- A round that hit the world rather than a zombie. Anything loose enough to move takes the
-- shot's momentum at the point it struck: a door swings, a table skids and turns.
--
-- Static and kinematic bodies are the common case here -- terrain, walls, the character
-- capsules -- and an impulse on those is silently ignored by the backend anyway, so the
-- test is about intent rather than safety. A rag doll limb never reaches this: the weapons
-- route corpses through shoveCorpse before they get here.
function Main:shoveBody(body, point, dir)
	if body == nil or body.static or body.kinematic then
		return false
	end
	body:addImpulse(point, dir * self._bulletImpulse, false)
	return true
end

-- Kill every live zombie in the world at once (K). Each one dies through killEnemy, so
-- they rag doll, spray blood, count as kills and get despawned on the usual corpse timer
-- -- no separate teardown path that could leak them. The impulse points radially away
-- from the player so the pile scatters outward instead of every corpse taking the same
-- shove. Safe to iterate by index: killEnemy only marks, it never removes entities.
function Main:_killAllEnemies()
	local world = self.world.world
	if world == nil or self._humanoid == nil then
		return
	end

	local origin = self:eye()
	local i = 0
	while true do
		local e = world:getEntity("Enemy", i)
		if e == nil then
			break
		end
		i = i + 1
		local chest = e.transform.translation + Vector4(0.0, 1.0, 0.0, 0.0)
		local away = chest - origin
		local len = away.length
		if len > 0.01 then
			away = away / len
		else
			away = Vector4(0.0, 0.0, 1.0, 0.0)   -- standing exactly on the eye; shove forward
		end
		self:killEnemy(e, chest, self:knockbackImpulse(away))
	end
end

-- Set a floating label's text and centre it horizontally at its own y. Skipped
-- when neither the text nor the frame width has changed, so this is cheap enough
-- to call every frame -- which it has to be, since the frame width only settles
-- after the first layout and changes again on every window resize.
function Main:_setLabel(rec, text)
	local p < const > = self._frame:getPlacement()
	if rec.text == text and rec.placedWidth == p.width then
		return
	end
	rec.text = text
	rec.placedWidth = p.width
	rec.widget:setText(text)
	local ts < const > = rec.widget:getPreferredSize()
	rec.widget:place((p.width - ts.width) / 2, rec.y, ts.width, ts.height)
end

-- The closest record in one of the fixture lists that is still eligible, and how far
-- off it is. Measured flat, ignoring height: a ward post or a gate stands on the
-- same ground the player is walking on with its origin at its base, so all a third
-- axis would add is the player's own height on a slope. Pass maxDist to limit it
-- (the E prompt wants arm's reach); omit it for the nearest anywhere on the map,
-- which is what the objective compass asks for.
function Main:_nearestRecord(list, eligible, maxDist)
	if list == nil or self._humanoid == nil then
		return nil, 0.0
	end

	local pp < const > = self._humanoid.transform.translation
	local best, bestD = nil, (maxDist ~= nil) and (maxDist * maxDist) or math.huge
	for _, rec in ipairs(list) do
		if eligible(rec) then
			local dx, dz = rec.x - pp.x, rec.z - pp.z
			local d = dx * dx + dz * dz
			if d < bestD then
				best, bestD = rec, d
			end
		end
	end
	if best == nil then
		return nil, 0.0
	end
	return best, math.sqrt(bestD)
end

local function stillDark(w)
	return not w.lit
end

local function stillLocked(g)
	return not g.unlocked
end

function Main:_nearestUnlitWard(maxDist)
	return self:_nearestRecord(self._wards, stillDark, maxDist)
end

function Main:_nearestLockedGate(maxDist)
	return self:_nearestRecord(self._gates, stillLocked, maxDist)
end

-- The nearest chest E has anything to do with: one still shut, or one opened with something
-- still left in it. A chest emptied is done with, and the prompt stops offering it.
function Main:_nearestChest(maxDist)
	return self:_nearestRecord(self._chests, function(c)
		if not c.opened then
			return true
		end
		local left < const > = self._chestContents[c.index]
		return left ~= nil and #left > 0
	end, maxDist)
end

local function notPulled(l)
	return not l.pulled
end

function Main:_nearestUnpulledLever(maxDist)
	return self:_nearestRecord(self._levers, notPulled, maxDist)
end

-- A lever gate still barring the way: asked of the gate itself, since a lever anywhere
-- may have opened it.
local function leverGateShut(g)
	local sc < const > = g.entity:getComponent(traktor.world.ScriptComponent)
	return sc ~= nil and sc.isLocked ~= nil and sc:isLocked()
end

function Main:_nearestShutLeverGate(maxDist)
	return self:_nearestRecord(self._leverGates, leverGateShut, maxDist)
end

-- The StageExit the player is standing in that offers itself to E (the cave mouth), or nil.
function Main:_exitInReach()
	if self._exits == nil or self._humanoid == nil then
		return nil
	end
	local at < const > = self._humanoid.transform.translation
	for _, sc in ipairs(self._exits) do
		if sc:offers(at) then
			return sc
		end
	end
	return nil
end

-- Pull a lever: the throw and the gate opening are Lever:pull's; kept here is which
-- levers are pulled (for the hot reload) and the line saying what happened -- the
-- lever's own, else the gate's, else a generic one, since the gate may be far away.
function Main:_pullLever(lever)
	lever.pulled = true
	self._pulledLeverIndex[lever.index] = true
	local sc < const > = lever.entity:getComponent(traktor.world.ScriptComponent)
	if sc == nil then
		return
	end
	local gate < const > = sc:pull(false)
	local notice = sc:notice()
	if notice == nil and gate ~= nil then
		local gsc < const > = gate:getComponent(traktor.world.ScriptComponent)
		notice = gsc ~= nil and gsc:notice() or nil
	end
	self:_showNotice(notice or (gate ~= nil and "SOMEWHERE, A GATE GRINDS OPEN" or "THE LEVER CLUNKS OVER"))
	if gate ~= nil then
		self._orchestrator:notify("gateOpened")
	end
end

-- E at a chest. The first time, the lid comes up (Chest:open) and what the level put in the box
-- becomes what is left in it (Chest:contents); every time, the chest window goes up over it --
-- unless there is nothing in it to show, which a line says instead.
function Main:_openChest(chest)
	local sc < const > = chest.entity:getComponent(traktor.world.ScriptComponent)
	if not chest.opened then
		chest.opened = true
		self._openedChestIndex[chest.index] = true
		self._chestContents[chest.index] = (sc ~= nil and sc.contents ~= nil) and sc:contents() or {}
		if sc ~= nil then
			sc:open()
		end
	end
	local left < const > = self._chestContents[chest.index]
	if left == nil or #left == 0 then
		self:_showNotice("THE CHEST IS EMPTY")
		return
	end
	self:_setChestOpen(chest.index, (sc ~= nil and sc.notice ~= nil) and sc:notice() or nil)
end

-- ---- What the chest window is given ----
--
-- Everything Scripts/Views/ChestView offers, done here because the stage owns both ends of it:
-- what is left in the chest, and the pack it goes into.

-- What is still in chest `index`, as { { kind, count }, ... }. Read it, do not change it.
function Main:chestContents(index)
	return self._chestContents[index] or {}
end

-- Take the stack at `slot` out of chest `index` into the pack -- as much of it as fits, the rest
-- staying where it is. Returns how many went, and the kind.
function Main:takeFromChest(index, slot)
	local left < const > = self._chestContents[index]
	local entry < const > = (left ~= nil) and left[slot] or nil
	if entry == nil then
		return 0, nil
	end
	local added < const > = self:giveItem(entry.kind, entry.count)
	entry.count = entry.count - added
	if entry.count <= 0 then
		table.remove(left, slot)
	end
	return added, entry.kind
end

-- Take everything that fits, stack by stack in the order the chest holds them. Returns whether
-- anything went, and whether anything was left behind for want of room.
function Main:takeAllFromChest(index)
	local left < const > = self._chestContents[index]
	if left == nil then
		return false, false
	end
	local any = false
	local slot = 1
	while slot <= #left do
		local before < const > = #left
		local added < const > = self:takeFromChest(index, slot)
		if added > 0 then
			any = true
		end
		-- An emptied stack has been removed, so the next one has moved up into this slot.
		if #left == before then
			slot = slot + 1
		end
	end
	return any, #left > 0
end

-- Flat distance from the player to one ward record, measured the same way.
function Main:_wardDistance(w)
	if w == nil or self._humanoid == nil then
		return math.huge
	end
	local pp < const > = self._humanoid.transform.translation
	local dx < const > = w.x - pp.x
	local dz < const > = w.z - pp.z
	return math.sqrt(dx * dx + dz * dz)
end

-- The closest thing E could take into the pack, scanning TAKE_NAMES in priority order: the
-- first name with a candidate in reach wins outright, so standing where a relic and the key are
-- both in reach, E takes the relic -- the night's objective beats the detour. Returns the entity
-- and its Pickup component. How close is close enough is each item's own (Pickup:reach).
--
-- "Lying here" is _isLying: visible and not in the pack. Measured in all three axes, unlike the
-- fixture scans above: an item can lie on ground the player is not standing on.
function Main:_nearestTakeable()
	local world = self.world.world
	if world == nil or self._humanoid == nil then
		return nil, nil
	end

	local pp < const > = self._humanoid.transform.translation
	for _, name in ipairs(TAKE_NAMES) do
		local best, bestSc, bestD = nil, nil, math.huge
		local i = 0
		while true do
			local e = world:getEntity(name, i)
			if e == nil then
				break
			end
			i = i + 1
			if self:_isLying(e) then
				local sc < const > = e:getComponent(traktor.world.ScriptComponent)
				if sc ~= nil and sc.pressToTake ~= nil and sc:pressToTake() then
					local q < const > = e.transform.translation
					local dx, dy, dz = q.x - pp.x, q.y - pp.y, q.z - pp.z
					local d < const > = dx * dx + dy * dy + dz * dz
					local r < const > = sc:reach()
					if d < r * r and d < bestD then
						best, bestSc, bestD = e, sc, d
					end
				end
			end
		end
		if best ~= nil then
			return best, bestSc
		end
	end
	return nil, nil
end

-- Is this item lying out in the world, there to be taken? A relic spent on a post is hidden
-- (Pickup:show), so visibility rules that one out -- and keeps it from being offered as a ghost
-- with no mesh to walk up to. But a relic in the pack is not always hidden: the one equipped is
-- shown in the off hand, a visible relic within arm's reach of the player, and offering it would
-- put the same relic into the pack a second time. So the pack's own are ruled out by name.
function Main:_isLying(e)
	return e.visible and not self._inventory:holds(e)
end

-- The nearest entity called `name` still lying in the world, anywhere on the map -- what the
-- objective compass points at when there is nothing in the pack to take anywhere.
function Main:_nearestLying(name)
	local world = self.world.world
	if world == nil or self._humanoid == nil then
		return nil
	end
	local pp < const > = self._humanoid.transform.translation
	local best, bestD = nil, math.huge
	local i = 0
	while true do
		local e = world:getEntity(name, i)
		if e == nil then
			break
		end
		i = i + 1
		if self:_isLying(e) then
			local q < const > = e.transform.translation
			local dx, dz = q.x - pp.x, q.z - pp.z
			local d < const > = dx * dx + dz * dz
			if d < bestD then
				best, bestD = e, d
			end
		end
	end
	return best
end

-- Where the compass points while there are relics in the pack: the nearest still-dark post.
-- Only ever a suggestion -- with no altar to return to, where a relic goes is the player's
-- decision, and walking past the needle to a post that covers better ground is the whole point
-- of the mechanic.
--
-- Held on the post it already points at until a rival is clearly nearer (MARKER_SWITCH_MARGIN),
-- and dropped the moment that post is lit, so walking the midline between two dark posts does
-- not flip the needle back and forth -- each flip snaps and flashes it, and reads as an
-- instruction changing rather than as jitter.
function Main:_wardObjective()
	local ward, wd = self:_nearestUnlitWard()
	local held < const > = self._wardHold
	if held ~= nil and not held.lit and ward ~= nil and ward ~= held then
		if self:_wardDistance(held) <= wd + MARKER_SWITCH_MARGIN then
			ward = held
		end
	end
	self._wardHold = ward
	return ward ~= nil and ward.entity or nil
end

-- Light `ward` with a relic out of the pack -- which has to be in the off hand, the caller has
-- checked. One comes out of the pack and the relic itself does the rest (Relic:light): it is
-- parked on the post, the post takes light, and the night answers.
--
-- The relic that comes out is the last one in the pack, so with several carried the one shown
-- in hand stays there until it is the only one left.
function Main:_lightWardWithRelic(ward)
	local removed < const >, out < const > = self._inventory:remove("relic", 1)
	if removed <= 0 then
		return false
	end
	local relic < const > = out[1]
	local sc < const > = (relic ~= nil) and relic:getComponent(traktor.world.ScriptComponent) or nil
	if sc ~= nil and sc.light ~= nil then
		sc:light(self, ward)
	else
		-- A relic with no entity behind it (a pack restored without its keepsakes) still lights
		-- the post it was carried to; there is just nothing to park on it.
		self:_lightWard(ward)
		if self:_wardsDone() then
			self:_breakDawn()
		end
	end
	return true
end

-- Turn a key from the pack in `gate`'s lock. The key is spent for good, and the gate opens
-- itself -- the swing, the grind, and the invisible box that did the actual barring going out of
-- the world are all Gate:unlock's. What is kept here is which gates stand open, as plain data,
-- so it survives a hot reload (resolve re-asserts it).
function Main:_unlockGate(gate)
	if self._inventory:remove("key", 1) <= 0 then
		return false
	end
	gate.unlocked = true
	self._unlockedGateIndex[gate.index] = true
	local gsc < const > = gate.entity:getComponent(traktor.world.ScriptComponent)
	if gsc ~= nil then
		gsc:unlock()
	end
	-- Each gate may say its own line (the cave's do, as a property); the cemetery's is the
	-- default.
	self:_showNotice((gsc ~= nil and gsc.notice ~= nil and gsc:notice()) or "THE CEMETERY GATE GRINDS OPEN")
	-- Ground the night was keeping opens up, and the night notices.
	self._orchestrator:notify("gateOpened")
	return true
end

-- Stand something on whatever is underneath a point, so a relic put down on a
-- slope neither floats nor sinks to the shin. Short trace window, same reasoning
-- as the Spawner's traceGround: reaching further up starts the ray above nearby
-- props and drops the relic onto boulders and table tops instead of the ground.
-- Static world only (0x1), so a passing zombie is never mistaken for floor.
function Main:_groundAt(p)
	local pm < const > = self.environment.physics.physicsManager
	if pm == nil then
		return p
	end
	local hit < const > = pm:queryRay(
		Vector4(p.x, p.y + 1.0, p.z, 1.0),
		Vector4(0.0, -1.0, 0.0, 0.0),
		4.0,
		traktor.physics.QueryFilter(0x00000001),
		true
	)
	if hit == nil then
		return p
	end
	return hit.position
end

-- Consecrating ground clears whatever is standing on it: every zombie inside
-- _purgeRadius of the new post dies where it is.
--
-- This is now the *only* thing a lit ward does to the zombies that are already out there.
-- The other rule -- the Spawner refusing to place anything inside the ward -- only covers
-- the future, and the steering that used to hold the horde off was removed altogether
-- (see the note at the top of Scripts/EnemyController), so without this the flame would
-- catch on ground that simply stays occupied. The flare is what makes lighting a post a
-- thing that happens rather than a thing that is true, and what makes lighting one
-- *while* being chased a real play.
--
-- Measured with the flare's own radius rather than the ward's, which are two different
-- things that only looked like one while they were the same number: the disc is ground
-- the Spawner is barred from for the rest of the night (see _wardRadius); the flare is a
-- single moment and can reach as far as it wants to.
--
-- Flat XZ test, the same way the Spawner reads a ward. They die
-- through killEnemy like everything else -- rag doll, blood, kill tally, the usual
-- corpse timer -- shoved radially out from the post, so the pile scatters off the
-- consecrated ground instead of collapsing onto it. Returns how many were taken.
function Main:_purgeWard(ward)
	local world = self.world.world
	if world == nil or ward == nil then
		return 0
	end

	local r2 < const > = self._purgeRadius * self._purgeRadius
	local killed = 0
	local i = 0
	while true do
		local e = world:getEntity("Enemy", i)
		if e == nil then
			break
		end
		i = i + 1
		local p < const > = e.transform.translation
		local dx < const > = p.x - ward.x
		local dz < const > = p.z - ward.z
		local d2 < const > = dx * dx + dz * dz
		if d2 < r2 then
			local d < const > = math.sqrt(d2)
			local away
			if d > 0.01 then
				away = Vector4(dx / d, 0.0, dz / d, 0.0)
			else
				away = Vector4(0.0, 0.0, 1.0, 0.0)   -- standing on the post itself
			end
			local chest < const > = p + Vector4(0.0, 1.0, 0.0, 0.0)
			if self:killEnemy(e, chest, self:knockbackImpulse(away)) then
				killed = killed + 1
			end
		end
	end
	return killed
end

-- The bill for consecrating ground: the hive nearest the post that just took light
-- opens and sends a brood out into the forest. Which hive is deliberately the
-- *nearest* one rather than the next in some order -- the pressure then rises where
-- the player has just been standing, close enough to be walked back through, so
-- lighting a post is felt as something that happened here and not as a counter going
-- up. A hive that is already open is skipped, so with fewer hives than wards the last
-- wards are simply free.
--
-- The opening and the brood are the hive's own (Scripts/Hive); this only picks which
-- one and remembers it by index so a hot reload can restore it. Returns the hive that
-- answered, or nil when there was none left to answer.
--
-- It does not open it. The hive is *chosen* here and armed to open a beat later (see
-- HIVE_WAKE_DELAY and _openHive), so the ward's own flare -- and the bodies the light
-- just took, which is what `purged` sizes the wait by -- are not cut away from on the
-- frame they happen. Marking it awake is done here rather than at the opening, so a hive
-- counting down can never also be chosen by a second ward.
function Main:_wakeHive(ward, purged)
	if self._hives == nil or ward == nil then
		return nil
	end

	-- Nothing stirs for the ward that closes the circle. There is no night left for a
	-- brood to be sent into, and the alternative is worse than pointless: _interact
	-- lights the ward and then breaks the dawn in the same frame, so the reprisal for
	-- winning would be a cutscene of a hive opening -- shown instead of the sunrise the
	-- whole night was for, and running while the horde it was meant to threaten
	-- collapses off-camera.
	if self:_wardsDone() then
		return nil
	end

	local best, bestD = nil, math.huge
	for _, h in ipairs(self._hives) do
		if not h.awake then
			local dx < const > = h.x - ward.x
			local dz < const > = h.z - ward.z
			local d2 < const > = dx * dx + dz * dz
			if d2 < bestD then
				best, bestD = h, d2
			end
		end
	end
	if best == nil then
		return nil
	end

	best.awake = true
	self._awakeHiveIndex[best.index] = true
	self._pendingHive = {
		hive = best,
		delay = ((purged or 0) > 0) and HIVE_WAKE_DELAY or HIVE_WAKE_DELAY_QUIET
	}
	return best
end

-- The armed hive's moment has come: open it and go and watch. Called from update once
-- _pendingHive has counted down, which is deliberately in the *running* game -- the whole
-- point of the delay is that the frames it spans are played, not frozen.
function Main:_openHive(hive)
	if hive == nil then
		return
	end
	local sc < const > = hive.entity:getComponent(traktor.world.ScriptComponent)
	if sc ~= nil then
		sc:activate()
	end
	self:_beginCutscene(hive)
end

-- Cut to the hive and hold the night still while it opens.
--
-- A hive is the one thing in this game that happens somewhere the player is not, and it
-- is the consequence of the decision they have just made -- so it is worth being shown
-- rather than merely reported by a line of HUD text. The camera goes to the hive, and
-- everything else stops until it is done.
--
-- What "stops" means, precisely, is the existing freeze the pause menu already uses,
-- extended by one flag rather than reimplemented:
--
--   * Main:update returns early, which freezes the player, the rifle, contact damage,
--     pickups and the corpse timers.
--   * Scripts/Spawner returns early, so nothing new rises out in the dark.
--   * Every Scripts/EnemyController returns early *unless it is inside the hive*
--     (CUTSCENE_RADIUS of it), which is what leaves the brood -- and only the brood --
--     moving in the shot. A zombie the player has just shot is exempt as well, since it
--     has to be allowed to finish handing itself to the rag doll; that is the same
--     reason the dawn does not freeze them.
--   * Scripts/Hive deliberately reads none of this, so the hive it is watching keeps
--     playing its act and sending its brood up.
--
-- The published record carries the focus and its squared radius, so a zombie's test is
-- a subtraction and a compare -- there is no list of "cutscene actors" to keep in step
-- with what the hive has actually spawned.
function Main:_beginCutscene(hive)
	if hive == nil or self._cutscene ~= nil then
		return
	end
	self._cutscene = {
		hive = hive,
		time = 0.0,
		x = hive.x,
		z = hive.z,
		r2 = CUTSCENE_RADIUS * CUTSCENE_RADIUS
	}
end

-- Cut back to the player: the world un-freezes on its own, since everything that
-- freezes does so by reading _cutscene, and postUpdate rebuilds the first-person camera
-- from the player's eye every frame so there is no pose to restore.
--
-- Called when the shot ends, and by the two things that end the night out from under it
-- -- dawn breaking and the player dying -- both of which own the camera afterwards. Also
-- drops a hive that was armed but has not opened yet, since every caller that wants the
-- camera back wants that too: a hive is not worth opening into a Game Over menu. It stays
-- marked in _awakeHiveIndex, so nothing else will pick it up either.
function Main:_endCutscene()
	self._cutscene = nil
	self._pendingHive = nil
end

-- Is the hive still opening? Asked of the hive itself (Hive:isOpening covers both its
-- act and its brood) rather than timed against a duration copied out of the act, so
-- re-timing the act in the editor re-times the shot with it. Bounded either way by
-- CUTSCENE_MIN and CUTSCENE_MAX, so a hive that answers wrongly -- or has no script at
-- all -- can neither flicker the camera nor keep it.
function Main:_updateCutscene(dt)
	local cutscene < const > = self._cutscene
	if cutscene == nil then
		return false
	end

	cutscene.time = cutscene.time + dt

	local opening = false
	if cutscene.time < CUTSCENE_MAX then
		local sc < const > = cutscene.hive.entity:getComponent(traktor.world.ScriptComponent)
		opening = sc ~= nil and sc:isOpening()
	end
	if not opening and cutscene.time >= CUTSCENE_MIN then
		self:_endCutscene()
		return false
	end
	return true
end

-- Where the camera stands this frame: eased from the wide pose to the close one across
-- the shot, both read out of the hive's own frame. Smoothstepped rather than linear so
-- it settles into the close pose instead of stopping dead, and clamped so the camera
-- holds still once it arrives rather than drifting on through the boulder if the hive
-- takes longer to open than the push-in takes to finish.
--
-- Driven from postUpdate, with the rest of the camera work, so it is not a frame behind
-- the boulder it is framing.
function Main:_placeCutsceneCamera()
	local cutscene < const > = self._cutscene
	if cutscene == nil or self._camera == nil then
		return
	end

	local tf < const > = cutscene.hive.entity.transform
	local t < const > = math.min(1.0, cutscene.time / CUTSCENE_PUSH_TIME)
	local k < const > = t * t * (3.0 - 2.0 * t)
	local eye < const > = tf * (CUTSCENE_EYE_FROM + (CUTSCENE_EYE_TO - CUTSCENE_EYE_FROM) * k)
	local at < const > = tf * CUTSCENE_LOOK_AT

	-- Keep the eye out of the ground: hives stand on a hillside, so a pose composed
	-- clear of the terrain at one is not guaranteed to clear it at the next.
	--
	-- Traced here rather than through _groundAt, which answers a different question --
	-- it returns the point it was given when it finds nothing, which is the right answer
	-- for "stand this relic on the floor" and the wrong one for a camera several metres
	-- up: taking it at face value would lift the eye by the clearance every single
	-- frame, the whole shot long.
	local y = eye.y
	local pm < const > = self.environment.physics.physicsManager
	if pm ~= nil then
		local hit < const > = pm:queryRay(
			Vector4(eye.x, eye.y + CUTSCENE_GROUND_REACH, eye.z, 1.0),
			Vector4(0.0, -1.0, 0.0, 0.0),
			CUTSCENE_GROUND_REACH * 2.0,
			traktor.physics.QueryFilter(0x00000001),
			true
		)
		if hit ~= nil then
			y = math.max(y, hit.position.y + CUTSCENE_GROUND_CLEAR)
		end
	end

	self._camera.transform = Transform.lookAt(
		Vector4(eye.x, y, eye.z, 1.0),
		Vector4(at.x, at.y, at.z, 1.0),
		Vector4(0.0, 1.0, 0.0, 0.0)
	)
end

-- Light one particular ward -- the one the player just set a relic at: flag it,
-- remember it by index so a hot reload can restore it, tell its Ward component to
-- catch (Scripts/Ward owns the flame itself), republish the safe ground, clear what
-- is standing on it and wake a hive with the bill. Returns false for a ward that is
-- already burning, so a double trigger cannot spend a second relic on it, and
-- otherwise true, the number of zombies the light took, and the hive it woke (nil if
-- every hive is already open, or if this ward closed the circle -- see _wakeHive).
--
-- The hive is woken after the purge, not before, so the brood it sends up inside
-- itself is never caught by the sweep that clears the ward's own ground.
--
-- Not on the hot-reload restore path in resolve, which re-lights wards by calling
-- turnOn() straight on the component: that is restoring state that already
-- happened, not consecrating ground, and should not re-purge the forest or open a
-- second hive.
function Main:_lightWard(ward)
	if ward == nil or ward.lit then
		return false, 0, nil
	end
	ward.lit = true
	self._litWardIndex[ward.index] = true
	self._wardsLit = self._wardsLit + 1
	local sc < const > = ward.entity:getComponent(traktor.world.ScriptComponent)
	if sc ~= nil then
		sc:turnOn()
	end
	-- The low bell of consecration. Raised on the player rather than on the post: the
	-- player is standing at the post when this happens, and a non-positional stinger is
	-- the one that reads as *the night changing* rather than as a nearby object.
	self:_playCue("ward")
	self:_publishWards()
	-- The forest answers. This is the quiet half of what the hive below is the
	-- theatrical half of: the burst around the player worsens while the brood rises
	-- somewhere else, and the two read as one event.
	self._orchestrator:notify("wardLit")
	local purged < const > = self:_purgeWard(ward)
	return true, purged, self:_wakeHive(ward, purged)
end

-- Is the circle closed? The win condition. False in a scene with no wards or no
-- relics (Scene 1 has neither), where the night is not winnable and never ends.
function Main:_wardsDone()
	local need < const > = self._wardsNeeded or 0
	return need > 0 and self._wardsLit >= need
end

-- Hand the world what it needs off the ward state: where consecrated ground is, and how
-- hard the night should push. Rebuilt only when a ward is lit -- wards never move, so
-- there is nothing to do per frame.
--
-- One consumer each, now. _litWards is read by Scripts/Spawner alone, which will not
-- place anything inside a lit ward; every Scripts/EnemyController used to read it too and
-- steer out of one, and that whole rule is gone -- the horde walks over consecrated
-- ground and only the flare that lit it ever touched them (see _purgeWard, and the note
-- at the top of Scripts/EnemyController). _enemyPace is read by the controllers.
--
-- Only r2 is published, since comparing squared distances is all the spawner does. The
-- plain radius went with the steering that needed it: it is _wardRadius, one field away,
-- for anything that wants it back.
function Main:_publishWards()
	local lit = {}
	if self._wards ~= nil then
		for _, w in ipairs(self._wards) do
			if w.lit then
				table.insert(lit, {
					x = w.x,
					z = w.z,
					r2 = self._wardRadius * self._wardRadius
				})
			end
		end
	end
	self._litWards = lit
	self._enemyPace = 1.0 + self._enemyPacePerWard * self._wardsLit
end

-- The night is won. Everything after this is the payoff: the spawner is shut off,
-- the horde drops where it stands, and Main:_updateDawn runs the sunrise.
function Main:_breakDawn()
	if self._nightOver then
		return
	end
	self._nightOver = true
	self._dawn = 0.0

	-- The HUD is done here, not when the victory card finally goes up: what is left
	-- is the sunrise, and a health bar and an ammunition count are the wrong things to
	-- be reading over it. The same moment the minimap already takes itself off screen
	-- (see _updateMinimap), so the corner does not empty out in two steps.
	--
	-- Nothing puts it back: winning ends this stage, and Again builds a new one.
	self:_showHud(false)

	-- ...except the notice, which is the one line of HUD this moment is *for*. It is
	-- part of the HUD the pause menu hides, so it has to be asked back explicitly, and
	-- it takes itself away again when _noticeTimer runs out and _setLabel writes the
	-- empty string over it.
	self._notice.widget:setVisible(true)
	self:_showNotice("DAWN BREAKS")

	-- The bell, and the wind out from under it. The bed is the stage's own "ambience"
	-- AudioLayer, so taking it away is a matter of asking that layer to fade -- which is
	-- kinder than cutting it, and is what makes the last thing the player hears the bell
	-- ringing out over a forest going quiet.
	self:_playCue("dawn")
	local ambience < const > = self:getLayer("ambience")
	if ambience ~= nil then
		ambience:fadeOff()
	end

	-- The sunrise owns the camera from here. _wakeHive already refuses to stir a hive
	-- for the ward that closes the circle, so there should be nothing to cut away from;
	-- this is the guard for any other route to dawn, because a cutscene left running
	-- would hold the camera at a hive through the whole payoff -- and _updateDawn sits
	-- above the freeze, so it would play out over the wrong shot.
	self:_endCutscene()

	-- ...and this is it taking it. The shot is the scene's DAWN_ACT -- a theater act on the
	-- world, flying DAWN_CAMERA out over the forest while it raises the light on the Sky
	-- entity -- so playing it and handing the layer that camera is the whole of it. The act
	-- runs off world time, which the freeze below does not touch, so it plays out over a
	-- frozen night exactly as a hive's opening does.
	--
	-- If there is no act to play, Performance:play has already logged as much and the night
	-- is simply won without ceremony: the camera stays on the player, and _updateDawn -- which
	-- finds nothing playing -- goes straight to the wash and the victory card. Same trade as a
	-- hive whose opening will not play (Hive:activate); a payoff that cannot be shown must
	-- still be reached.
	local world < const > = self.world.world
	local theater = nil
	if world ~= nil then
		theater = world:getComponent(traktor.theater.TheaterWorldComponent)
	end
	if theater ~= nil and self._dawnCamera ~= nil and theater:play(DAWN_ACT) then
		self._dawnPlaying = true
		self.world.camera = self._dawnCamera
	end

	-- The light takes them. Routed through the same rag doll path a shot zombie
	-- takes, so the horde collapses in place rather than being deleted out from
	-- under the player. EnemyController deliberately does *not* freeze on
	-- _nightOver -- it still has to see _deadEnemies and make the switch.
	self:_killAllEnemies()

	-- Hand the mouse back, ready for the victory card.
	self._flash:setVisible(true)
	self.environment.input.inputSystem:setExclusive(false)
	self.environment.render.renderView:showCursor()
end

-- Run the payoff: let the DAWN_ACT shot play itself out, hold a beat in the light it
-- leaves behind, then flood the screen warm and raise the victory card.
--
-- The sunrise is not here any more -- the act carries it -- so what is left is the two
-- beats after it, and both are measured from where the act actually ended rather than from
-- a duration copied out of it. Re-timing the shot in the editor therefore re-times the hold
-- and the wash with it, and nothing here has to be kept in step by hand.
function Main:_updateDawn(dt)
	if not self._nightOver then
		return
	end

	self._dawn = self._dawn + dt

	-- Has the act let go? Asked of the theater component, exactly as the hive cutscene asks
	-- the hive itself (Main:_updateCutscene), and bounded by _dawnMax for the same reason
	-- CUTSCENE_MAX bounds that one: an act that will not end -- or one that was never there
	-- to play -- must not be able to strand the player behind a shot with no way out of it.
	--
	-- _dawnEnd stamps the moment, so the beats below run from the end of the shot. Nil until
	-- then, which is also what holds the wash off through it.
	if self._dawnEnd == nil then
		local playing = false
		if self._dawnPlaying and self._dawn < self._dawnMax then
			local world < const > = self.world.world
			if world ~= nil then
				local theater < const > = world:getComponent(traktor.theater.TheaterWorldComponent)
				playing = theater ~= nil and theater.playing
			end
		end
		if playing then
			return
		end
		-- Cleared before the camera is left alone: postUpdate reads _dawnPlaying to know
		-- the shot owns the view, and from here the first-person camera may move again --
		-- the layer is still rendering through the act's, wherever the act parked it.
		self._dawnEnd = self._dawn
		self._dawnPlaying = false
	end

	-- Wash: holds off through the shot and the hold after it, then floods to opaque for the
	-- card. It is what covers the sky staying night-dark through all of this, SkyComponent
	-- being unscriptable -- by the act as much as by this script.
	local a < const > = math.max(0.0, (self._dawn - self._dawnEnd - self._dawnHold) / self._dawnWashTime)
	local p < const > = self._frame:getPlacement()
	self._flash:place(0, 0, p.width, p.height)
	self._flash:setColor(Color4f(1.0, 0.94, 0.8, math.min(1.0, a * a)))

	if a >= 1.0 and not self._victoryShown then
		self._victoryShown = true
		self._victoryDialog:show()
	end
end

-- Fit the minimap to the scene and give it its markers. Once only, off the world.
--
-- The extent is fitted to the scene's own points of interest -- every relic, every
-- ward post, the landmarks and where the player starts -- rather than to the
-- terrain, which is 512 m square while all of that sits inside about 110 m: fitting
-- the heightfield would draw the entire game in one corner of the plate. Squared
-- off about the centre so nothing is stretched, and padded so no marker is drawn on
-- the bezel. Nothing here moves, so none of it is ever recomputed.
--
-- Returns false in a scene with nothing to map (Scene 1), which leaves the widget
-- hidden and stops _updateMinimap doing anything.
function Main:_buildMinimap(world)
	local minX, maxX = math.huge, -math.huge
	local minZ, maxZ = math.huge, -math.huge
	local function fit(p)
		minX = math.min(minX, p.x)
		maxX = math.max(maxX, p.x)
		minZ = math.min(minZ, p.z)
		maxZ = math.max(maxZ, p.z)
	end

	local relics = 0
	local i = 0
	while true do
		local r = world:getEntity("Relic", i)
		if r == nil then
			break
		end
		i = i + 1
		relics = relics + 1
		fit(r.transform.translation)
	end

	for _, w in ipairs(self._wards) do
		fit({ x = w.x, z = w.z })
	end

	local marks = {}
	for _, l in ipairs(LANDMARKS) do
		local e = world:getEntity(l.entity)
		if e ~= nil then
			local p < const > = e.transform.translation
			table.insert(marks, { x = p.x, z = p.z, glyph = l.glyph })
			fit(p)
		end
	end

	if relics == 0 and #self._wards == 0 and #marks == 0 then
		return false
	end

	-- Where they start, so the arrow is never already off the edge on frame one.
	if self._humanoid ~= nil then
		fit(self._humanoid.transform.translation)
	end

	local span < const > = math.max(maxX - minX, maxZ - minZ, 1.0) * MAP_PAD
	local cx < const > = (minX + maxX) * 0.5
	local cz < const > = (minZ + maxZ) * 0.5

	self._minimap:setExtent(cx - span * 0.5, cz - span * 0.5, span)
	self._minimap:setWardRadius(self._wardRadius)
	self._minimap:build(relics, #self._wards, marks)
	self._minimapRelics = relics
	return true
end

-- Push the map's moving parts. Relics are read off their entities rather than
-- tracked, so carrying one, dropping it in the forest and setting it at a post all
-- show up without any of those paths having to know the map exists.
function Main:_updateMinimap()
	if not self._minimapMapped then
		return
	end

	-- Hidden once the night is decided, so neither the victory card nor the Game
	-- Over menu has a map sitting in the corner behind it -- and while paused, with
	-- the rest of the HUD. Widget:setVisible is already a no-op when the state has
	-- not changed, so this needs no latch.
	--
	-- The pause flag belongs here rather than in _showHud because this runs above the
	-- freeze returns: anything hidden from outside would be shown again by the very
	-- next frame of a paused game.
	local show < const > = not self._gameOver and not self._nightOver and not self._paused
	self._minimap:setVisible(show)
	if not show then
		return
	end

	local world < const > = self.world.world
	if world ~= nil then
		for i = 1, self._minimapRelics do
			local r = world:getEntity("Relic", i - 1)
			if r ~= nil then
				-- Spent is hidden and not in the pack: a relic in the pack is hidden too, but
				-- rides along with the player (postUpdate), so its dot is the player's. A spent
				-- one is parked on its ward (Pickup:spend), which puts its dot on the post.
				local p < const > = r.transform.translation
				self._minimap:setRelic(i, p.x, p.z, not r.visible and not self._inventory:holds(r))
			end
		end
	end

	for i, w in ipairs(self._wards) do
		self._minimap:setWard(i, w.x, w.z, w.lit)
	end

	if self._humanoid ~= nil then
		local p < const > = self._humanoid.transform.translation
		self._minimap:setPlayer(p.x, p.z, self._heading)
	end
end

-- Aim the objective compass at wherever the player should be walking: the nearest
-- still-dark ward while there is a relic in the pack, then a locked gate while there is
-- a key in it, and otherwise the nearest relic -- or failing that key -- still lying out
-- in the forest. Blank once the night is over, either way it ended.
--
-- Nearest is only ever a suggestion. With no altar to return to, where a relic goes is
-- the player's decision -- the needle picks the closest unlit post so it has something to
-- say, and walking past it to a post that covers better ground is the whole point of the
-- mechanic.
function Main:_updateMarker(dt)
	local target = nil
	if not self._gameOver and not self._nightOver and self._humanoid ~= nil then
		local inv < const > = self._inventory
		if inv:count("relic") > 0 then
			target = self:_wardObjective()
		end
		if target == nil and inv:count("key") > 0 then
			local gate < const > = self:_nearestLockedGate()
			target = (gate ~= nil) and gate.entity or nil
		end
		if target == nil then
			-- Nothing in the pack to take anywhere: the nearest thing worth picking up, in
			-- priority order -- the relic run is the objective, the key run the detour.
			target = self:_nearestLying("Relic") or self:_nearestLying("Key")
		end
	end

	-- Changing what it points at snaps and flashes the needle rather than sweeping
	-- it across the dial, so a hand-off reads as a new instruction.
	if target ~= self._markerTarget then
		self._markerTarget = target
		self._marker:retarget()
	end

	if target == nil then
		self._marker:setTarget(nil)
	else
		local p < const > = target.transform.translation
		local pp < const > = self._humanoid.transform.translation
		local dx < const > = p.x - pp.x
		local dz < const > = p.z - pp.z
		-- Relative bearing. Forward is (sin h, 0, cos h), so the world bearing of
		-- (dx, dz) is atan2(dx, dz), and subtracting the player's heading turns it
		-- into "how far round from straight ahead" -- which is what the needle shows.
		self._marker:setTarget(atan2(dx, dz) - self._heading, math.sqrt(dx * dx + dz * dz))
	end

	self._marker:update(dt)
end

-- Place the aiming crosshair at the centre of the screen, and show it only while the
-- player is actually sighting down a weapon: not on the run, not with nothing in hand
-- to aim, and not while the game is paused, lost or won. A relic in the off hand has no
-- say in it -- it used to hide the reticle, and that rule is gone with the rest of the
-- relic's carry penalties. Called from update above its early-returns, so those "not
-- playing" states can hide it.
function Main:_updateCrosshair(dt)
	-- Whether there is an aim worth drawing a reticle for is the drawn weapon's call rather
	-- than this stage's: the rifle hides it while the magazine is empty, because with no round
	-- chambered there is no shot to line up, and an empty grenade pouch answers the same way.
	-- See Weapon:wantsCrosshair.
	local loaded = self._loadout:wantsCrosshair()

	local show = not self._gameOver
		and not self._nightOver
		and not self._paused
		and self._cutscene == nil
		and not self._running
		and loaded
		and self._humanoid ~= nil

	if show ~= self._crosshairShown then
		self._crosshairShown = show
		self._crosshair:setVisible(show)
	end

	-- Ease the firing bloom back even while hidden, so the reticle is at rest the next
	-- time it shows.
	self._crosshair:update(dt)

	if not show then
		return
	end

	-- Centre the widget's box on the middle of the screen -- the same coordinate space
	-- the flash panel fills. The reticle is authored at the centre of its box, so this
	-- lands it exactly on the point of aim.
	local pl < const > = self._frame:getPlacement()
	local sz < const > = self._crosshair:getPreferredSize()
	self._crosshair:place(
		(pl.width - sz.width) * 0.5,
		(pl.height - sz.height) * 0.5,
		sz.width, sz.height
	)
end

-- Flash a line under the objective for a few seconds.
function Main:_showNotice(text)
	self._noticeText = text
	self._noticeTimer = 3.5
end

-- The feed line under it: what just went into the pack, or why it did not. `kind` is the item
-- the line is counting, for _feedCounted; anything else said here starts a fresh count.
function Main:_feed(text, kind)
	self._feedText = text
	self._feedTimer = 2.5
	self._feedKind = kind
end

-- "+ 12 ROUNDS", counted up across pickups of the same kind while the line is still up, so
-- walking through two crates reads as the 24 rounds it was rather than as the last 12.
function Main:_feedCounted(kind, count)
	if self._feedKind == kind and self._feedTimer > 0.0 then
		self._feedCount = self._feedCount + count
	else
		self._feedCount = count
	end
	return "+ " .. Items.describe(kind, self._feedCount)
end

-- What E would do right now, as one answer for both the press (_interact) and the prompt
-- line (_updateHudText), so the promise and the press can never disagree. Returns a verb --
-- "take", "light", "unlock", "chest", "lever", "exit", or one of the refusals "needRelic", "noBudge",
-- "locked" that only explain -- and whatever it would be done to.
--
-- In this order, and each for a reason:
--
--   * Something lying in reach goes into the pack first, so a relic beside a dark post is taken
--     before the one in hand is spent.
--   * A dark ward in reach takes the relic in the off hand. Only one *equipped* lights it: a
--     relic in the pack is something the player has decided to carry, and one in hand is one
--     they have decided to spend -- which is the whole of what equipping it means.
--   * A locked gate takes a key straight out of the pack; keys are never equipped.
--   * Then a chest -- shut, or opened with something left in it -- and the levers.
--   * Then a way out of the stage -- the cave mouth -- whose line is the exit's own prompt.
--   * Last, the lines that only say why nothing happens: a relic carried but not in hand at a
--     dark post, a lever gate no key fits, a locked gate with no key.
function Main:_whatWouldE()
	local e < const >, item < const > = self:_nearestTakeable()
	if item ~= nil then
		return "take", item
	end

	local inv < const > = self._inventory
	local ward < const > = self:_nearestUnlitWard(Config.relic.wardRange)
	if ward ~= nil and inv:equipped("hand") == "relic" then
		return "light", ward
	end

	local gate < const > = self:_nearestLockedGate(self._gateRange)
	if gate ~= nil and inv:count("key") > 0 then
		return "unlock", gate
	end

	local chest < const > = self:_nearestChest(self._chestRange)
	if chest ~= nil then
		return "chest", chest
	end

	local lever < const > = self:_nearestUnpulledLever(self._leverRange)
	if lever ~= nil then
		return "lever", lever
	end

	local exit < const > = self:_exitInReach()
	if exit ~= nil then
		return "exit", exit
	end

	if ward ~= nil and inv:count("relic") > 0 then
		return "needRelic", ward
	end
	if self:_nearestShutLeverGate(self._gateRange) ~= nil then
		return "noBudge", nil
	end
	if gate ~= nil then
		return "locked", gate
	end
	return nil, nil
end

-- E, edge triggered. See _whatWouldE for what it does and in which order; the pack, the
-- wards, the gates, the chests and the levers each own what doing it means.
function Main:_interact()
	local verb < const >, target < const > = self:_whatWouldE()
	if verb == "take" then
		if not target:collect(self) then
			self:packFull(target:itemKind())
		end
	elseif verb == "light" then
		self:_lightWardWithRelic(target)
	elseif verb == "unlock" then
		self:_unlockGate(target)
	elseif verb == "chest" then
		self:_openChest(target)
	elseif verb == "lever" then
		self:_pullLever(target)
	elseif verb == "exit" then
		target:take(self)
	elseif verb == "needRelic" then
		self:_feed("EQUIP A RELIC TO LIGHT THE WARD   TAB")
	end
end

-- Objective line, the contextual prompt for whatever E would do right now, and the
-- transient notice and the feed under them.
function Main:_updateHudText(dt)
	local prompt = ""
	if not self._gameOver and not self._nightOver then
		local verb < const >, target < const > = self:_whatWouldE()
		if verb == "take" then
			prompt = "E   " .. target:promptTake()
		elseif verb == "light" then
			prompt = "E   LIGHT THE WARD"
		elseif verb == "unlock" then
			prompt = "E   UNLOCK THE GATE"
		elseif verb == "chest" then
			-- Shut, or opened before with something left in it.
			prompt = target.opened and "E   SEARCH THE CHEST" or "E   OPEN THE CHEST"
		elseif verb == "lever" then
			prompt = "E   PULL THE LEVER"
		elseif verb == "exit" then
			prompt = "E   " .. target:prompt()
		elseif verb == "needRelic" then
			-- A relic in the pack is not one in hand: the line says how to get it there.
			prompt = "TAB   EQUIP A RELIC TO LIGHT THE WARD"
		elseif verb == "noBudge" then
			-- No key opens it; the line hints that something else does.
			prompt = "THE GATE WON'T BUDGE"
		elseif verb == "locked" then
			-- Not an E: standing at the locked gate with nothing to open it with, the
			-- line says what is missing rather than offering a press.
			prompt = "THE GATE IS LOCKED"
		end
	end
	self:_setLabel(self._prompt, prompt)

	self._noticeTimer = math.max(0.0, self._noticeTimer - dt)
	self:_setLabel(self._notice, self._noticeTimer > 0.0 and self._noticeText or "")

	-- Held while paused, so what the inventory screen did -- a flask drunk, a stack put down --
	-- is still there to read when it closes.
	if not self._paused then
		self._feedTimer = math.max(0.0, self._feedTimer - dt)
	end
	self:_setLabel(self._feedLine, self._feedTimer > 0.0 and self._feedText or "")
end

-- Play one of the player's own cues by name: the stingers and the ambience bed, which
-- hang off the Humanoid's EventSetComponent as non-positional SoundEventData (see
-- Entities/Humanoid). The player entity is where the listener is, so a sound that belongs
-- to the whole night rather than to a place in it belongs there.
--
-- Returns the event instance, which is only of interest to the looping ones -- a bed has
-- to be held onto if it is ever going to be stopped again.
function Main:_playCue(name)
	if self._bloodEvents == nil then
		return nil
	end
	return self._bloodEvents:raise(name)
end

function Main:update(info)
	self:resolve()

	-- Simulation delta, not frame delta: with a physics manager present the engine
	-- calls update() once per fixed simulation step (see Runtime/Impl/Application.cpp),
	-- so ticking timers with frameDeltaTime makes them run slow at high frame rates
	-- and fast at low ones.
	local dt < const > = info.simulationDeltaTime

	-- Drive UiKit's own animation clocks. Nothing else in the engine does -- only the
	-- editor's Scaffolding preview calls these -- so without this a Tween never
	-- advances and an Interval never fires. That is not cosmetic: Slider animates its
	-- knob through a Tween, so the options view's volume slider would track the value
	-- while its knob sat still, and the same view's deferred "apply the volume" waits
	-- on an Interval.
	-- Above every early return below, since the menus that use them are exactly what is
	-- up when this stage is frozen.
	Tween.update(dt)
	Interval.update(dt)

	-- Frame rate. Above the early returns too, so it keeps counting through a pause.
	self._fps:update(dt)

	-- Tick the HUD widgets' animations (health drain, hit flash, heartbeat), the weapons'
	-- own tiles among them -- whichever weapons those happen to be.
	-- Deliberately above every early-return below: the values they show are pushed to
	-- them where they change, and letting the widgets keep animating means a hit taken
	-- on the last frame still finishes its flash once the game is paused or over.
	self._healthBar:update(dt)
	self._loadout:updateHud(dt)
	-- Ticks the compass widget itself, as well as re-aiming it.
	self:_updateMarker(dt)

	-- The map. Also above the early-returns, so it stays correct behind a pause and
	-- can take itself off screen the moment the night is decided.
	self:_updateMinimap()

	-- Objective and prompt. Also above the early-returns, so the banner stays put
	-- and correctly centred through a pause or a window resize.
	self:_updateHudText(dt)

	-- Aiming crosshair. Above the early-returns for the same reason: it has to be able
	-- to hide itself when the game pauses, is lost or is won.
	self:_updateCrosshair(dt)

	-- The inventory screen, while it is up. Above the early-returns, since being up is
	-- exactly what freezes the rest of the frame: it keeps its double-click clock and
	-- redraws itself whenever the pack moves.
	if self._inventoryOpen then
		self._inventoryView:update(dt)
	end
	-- ...and a chest's window, the same.
	if self._chestOpen ~= nil then
		self._chestView:update(dt)
	end

	-- Wards ease up to full in their own Ward components (Scripts/Ward), which run
	-- every frame regardless of this stage's freeze -- so a ward caught on the frame
	-- the player died still finishes catching rather than sticking at its flare.

	-- The sunrise, once the night is won. Must run above the freeze below, since
	-- that freeze is exactly what it is playing over.
	self:_updateDawn(dt)

	-- If an exit-to-startup load is in flight, switch to it the moment it is ready.
	-- Checked before the game-over / paused early-returns below, because Exit is
	-- triggered from the paused menu (where the rest of the frame is frozen).
	if self._loader ~= nil then
		if self._loader.ready then
			if self._loader.succeeded then
				self:gotoStage(self._loader:get())
			end
			self._loader = nil
		end
		return
	end

	-- Night won: freeze the player for the sunrise. Deliberately does not freeze the
	-- enemies -- every one of them was just handed to the rag doll path, and their
	-- controllers have to keep running to make the switch. Their corpses are never
	-- despawned, since the despawn pass is below this return, which is fine: nothing
	-- happens after the victory card but a restart.
	if self._nightOver then
		return
	end

	-- Once dead, freeze gameplay (player control, damage, pickups) and leave the
	-- Game Over banner up. Enemies freeze too (they read context._gameOver).
	if self._gameOver then
		return
	end

	-- Escape toggles pause (edge-triggered). The input mapping keeps updating while
	-- paused, so Escape also resumes. While paused, freeze the rest of the frame;
	-- enemies freeze too (they read context._paused).
	do
		local mapping = self.environment.input.inputMapping
		if mapping ~= nil and mapping:isStatePressed("STATE_PAUSE") then
			-- With the options up, Escape is "back" rather than "resume": it is the
			-- key that got the player into the menu, so it should walk them out of it
			-- a page at a time rather than dropping them into the game from two
			-- dialogs deep. isVisible(false) asks about this dialog alone -- the
			-- recursive default would also be answering for the Frame above it.
			--
			-- With the pack or a chest open it closes that, and goes no further: Escape
			-- out of either is back to the game, not on into the pause menu.
			if self._optionsDialog:isVisible(false) then
				self:_hideOptions()
			elseif self._inventoryOpen then
				self:_setInventoryOpen(false)
			elseif self._chestOpen ~= nil then
				self:_setChestOpen(nil)
			else
				self:_setPaused(not self._paused)
			end
		elseif mapping ~= nil and mapping:isStatePressed("STATE_INVENTORY") then
			-- Tab opens the pack and closes it again. Not from the pause menu, which
			-- _setInventoryOpen refuses on its own. From a chest's window it goes on to
			-- the pack -- the way to make room for what is in the chest.
			if self._chestOpen ~= nil then
				self:_setChestOpen(nil)
				self:_setInventoryOpen(true)
			else
				self:_setInventoryOpen(not self._inventoryOpen)
			end
		elseif mapping ~= nil and self._chestOpen ~= nil and mapping:isStatePressed("STATE_INTERACT") then
			-- E opened the chest's window, and E closes it.
			self:_setChestOpen(nil)
		end
	end
	if self._paused then
		return
	end

	-- A hive has been chosen and is counting down to opening. Ticked here, below the
	-- freeze returns above and *without* returning itself, because these are the frames
	-- the delay exists to let the player play: the ward flaring at their feet and the
	-- bodies the light took going down in front of them (see HIVE_WAKE_DELAY).
	if self._pendingHive ~= nil then
		self._pendingHive.delay = self._pendingHive.delay - dt
		if self._pendingHive.delay <= 0.0 then
			local hive < const > = self._pendingHive.hive
			self._pendingHive = nil
			self:_openHive(hive)
		end
	end

	-- A hive is opening: hold everything but the hive itself and freeze the frame here.
	-- Below the pause return above, so the menu still takes priority over it and the
	-- shot resumes where it left off (the act plays on behind the menu -- the theater
	-- component runs off world time, which a script freeze does not touch -- so pausing
	-- through an opening can cost you the sight of it, which seems a fair trade for the
	-- menu always working).
	--
	-- Deliberately above the cheat keys and the weapon: no shooting, no god mode and no
	-- kill-all while the camera is away from the player. See _beginCutscene.
	if self:_updateCutscene(dt) then
		return
	end

	-- The night's tempo: burn down whatever burst is running and write the verdict
	-- into _spawnDrive. Below every freeze return above on purpose, so a pause or a
	-- cutscene holds a surge where it stood rather than quietly spending it.
	self._orchestrator:update(dt)

	-- Cheat shortcuts: G toggles god mode, H toggles infinite ammunition, K kills every zombie
	-- in the world, and L breaks the dawn on the spot -- the whole payoff, without having to
	-- carry four relics across the forest first, which is what it takes to see it otherwise.
	-- All four are edge-triggered, so holding the key fires once. Deliberately below the
	-- game-over and paused returns above, so none of them does anything while the frame is
	-- frozen. Not tied to the movement block below either, since they work with or without a
	-- character.
	do
		local mapping = self.environment.input.inputMapping
		if mapping ~= nil then
			if mapping:isStatePressed("STATE_GOD_MODE") then
				self._godMode = not self._godMode
				self._biteTimer = 0.0   -- so the next real bite spurts immediately
				self:_updateCheatLabel()
			end
			if mapping:isStatePressed("STATE_INFINITE_AMMO") then
				self._infiniteAmmo = not self._infiniteAmmo
				-- Handed straight down rather than read back per shot: the stage does not
				-- know what is in the player's hands, and it is not about to learn for this.
				-- Switching it on tops every weapon up on the spot, so the tile answers the
				-- keypress rather than waiting for the next trigger pull.
				self._loadout:setInfiniteAmmo(self._infiniteAmmo)
				self:_updateCheatLabel()
			end
			if mapping:isStatePressed("STATE_KILL_ALL") then
				self:_killAllEnemies()
			end
			-- Not guarded on the wards: it is the shot that is being reached for, not the
			-- win. _breakDawn is idempotent, so leaning on the key does it once, and it is
			-- also what the last ward calls -- so what L shows is the real thing rather than
			-- a preview of it. No cheat label: like K, it happens once and is over, and
			-- there is no state left switched on to name.
			if mapping:isStatePressed("STATE_DAWN") then
				self:_breakDawn()
			end
		end
	end

	-- The reload action, edge triggered. Handed to the whole loadout rather than to the drawn
	-- weapon: R is for topping up a rifle left at two rounds during a lull, and it should still
	-- do that with a grenade in hand. Which weapons have anything to reload is their business
	-- (Weapon:beginReload).
	do
		local mapping < const > = self.environment.input.inputMapping
		if mapping ~= nil and mapping:isStatePressed("STATE_RELOAD") then
			self._loadout:reload()
		end
	end

	-- One step of every weapon: shot cadences, a reload in flight, the fuse of anything already
	-- thrown. Above the movement block below, which is guarded on there being a character
	-- controller -- the weapons keep their own time either way, and a grenade in the air has
	-- left regardless of what is in the player's hands now.
	self._loadout:update(dt)

	-- The mouse wheel swaps which weapon the left button is on. Which weapons there are, and
	-- in what order, is the loadout's (Loadout:cycle).
	--
	-- Read as a value rather than as a press because that is what a wheel is: the device
	-- reports the notches turned since it was last polled and then forgets them, and input
	-- is polled once per simulation step (immediately before this runs), so one notch
	-- arrives on exactly one update. Spinning it hard puts several notches in one sample,
	-- which with two slots is still one swap -- correct, and the reason direction is not
	-- looked at.
	do
		local mapping < const > = self.environment.input.inputMapping
		if mapping ~= nil then
			local wheel < const > = mapping:getStateValue("STATE_CYCLE_WEAPON")
			if wheel > 0.5 or wheel < -0.5 then
				self._loadout:cycle(1)
			end
		end
	end

	-- E takes what is lying in reach, lights a ward, turns a key; see _whatWouldE.
	do
		local mapping < const > = self.environment.input.inputMapping
		if mapping ~= nil and mapping:isStatePressed("STATE_INTERACT") then
			self:_interact()
		end
	end

	-- Mouse X turns the character (yaw); W/S (STATE_MOVE_Z) move forward/back and
	-- A/D (STATE_MOVE_X) strafe left/right, both relative to the current facing.
	if self._character ~= nil then
		local mapping = self.environment.input.inputMapping
		if mapping ~= nil then
			local strafe = mapping:getStateValue("STATE_MOVE_X")
			local move = mapping:getStateValue("STATE_MOVE_Z")
			local look = mapping:getStateValue("STATE_LOOK_X")
			local lookY = -mapping:getStateValue("STATE_LOOK_Y")
			-- Hold Shift to sprint. maxVelocity tracks the target speed so the character
			-- controller's clamp doesn't cap the sprint. Nothing carried or held has a
			-- say in either -- a relic in hand used to make it a shuffle, and no longer
			-- does.
			local speed = self._walkSpeed
			local sprinting = false
			if mapping:isStateDown("STATE_SPRINT") then
				speed = self._sprintSpeed
				sprinting = true
			end
			self._character.maxVelocity = speed
			-- "Running" is sprinting while actually moving. It hides the crosshair and
			-- drops the rifle to a low ready (see _updateCrosshair and postUpdate) -- you
			-- still fire, but from the hip. Computed here, where the inputs are to hand.
			local moving = move > 0.1 or move < -0.1 or strafe > 0.1 or strafe < -0.1
			self._running = sprinting and moving
			local lookSensitivity = 0.005   -- radians per pixel of mouse motion
			-- STATE_LOOK_* are per-frame mouse deltas (pixels) -- do NOT scale by dt.
			self._heading = self._heading + look * lookSensitivity
			-- Mouse Y pitches the aim. Screen-Y grows downward, so moving the mouse up
			-- (negative delta) should aim up: subtract. Clamp so you cannot over-rotate.
			local pitchDelta = lookY * lookSensitivity
			if self._invertPitch then pitchDelta = -pitchDelta end
			self._pitch = self._pitch - pitchDelta
			if self._pitch < self._pitchMin then self._pitch = self._pitchMin end
			if self._pitch > self._pitchMax then self._pitch = self._pitchMax end
			self._character.headAngle = self._heading
			local heading = Quaternion.fromEulerAngles(self._heading, 0.0, 0.0)
			local forward = heading * Vector4(0.0, 0.0, 1.0, 0.0)
			local right = heading * Vector4(1.0, 0.0, 0.0, 0.0)

			-- STATE_MOVE_X is A(+1)/D(-1); negate so D strafes right, A strafes left.
			local velocity = forward * (move * speed) + right * (-strafe * speed)
			self._character:move(velocity, false)

			-- Footsteps, paced by distance travelled rather than by a timer, so a walk and
			-- a sprint step at their own rates with no second constant to keep in step with
			-- the speeds. There is no animation to hang them off -- the player is a capsule
			-- with a rifle -- so the ground is measured instead: every STEP_STRIDE metres of
			-- intended movement, one step from the SB - Step bank, which picks between three
			-- at a jittered pitch so walking does not tick like a metronome.
			if moving then
				self._stride = (self._stride or 0.0) + speed * dt
				if self._stride >= STEP_STRIDE then
					self._stride = 0.0
					self:_playCue("step")
				end
			else
				-- Stopped part way through a stride: keep it, so setting off again does not
				-- always cost a full stride before the first footfall lands.
				self._stride = math.min(self._stride or 0.0, STEP_STRIDE * 0.5)
			end

			local jumped = false
			if mapping:isStatePressed("STATE_JUMP") then
				if self._character:jump() then
					jumped = true
				end
			end

			-- The fire button, handed over as both a press and a hold rather than as one or the
			-- other. Which of the two a weapon reads is its own business -- the rifle goes off
			-- once per click, the machine gun runs for as long as the button is down -- and it is
			-- precisely the sort of thing this stage should have no opinion about. See
			-- Weapon:trigger.
			self._loadout:trigger(
				mapping:isStatePressed("STATE_FIRE"),
				mapping:isStateDown("STATE_FIRE")
			)

			-- ...and right mouse takes the alternate, likewise one per click. That is the rifle
			-- butt whatever is drawn, unless the drawn weapon claims the button for itself --
			-- see Loadout:altAttack and Scripts/Weapons/Melee.
			if mapping:isStatePressed("STATE_MELEE") then
				self._loadout:altAttack()
			end

			if self._poseController ~= nil then
				self._poseController:setParameterValue("moving", moving)
				self._poseController:setParameterValue("jump", jumped)
			end
		end
	end

	-- Walk-over pickups collect themselves: each carries a Scripts/Pickup ScriptComponent
	-- that notices the player standing on it and puts what it is -- named in the
	-- component's properties -- into the pack (giveItem).

	-- Enemy contact damage: every enemy within hurt range drains health, and
	-- multiple enemies stack. Reaching zero ends the game and shows the banner.
	-- God mode (G) skips the whole thing -- the scan's only output is the drain, so
	-- there is nothing to compute. Zombies still crowd and still play their bite
	-- animation, which EnemyController drives off context._hurtRange independently.
	if self._humanoid ~= nil and not self._godMode then
		local world = self.world.world
		if world ~= nil then
			local pp = self._humanoid.transform.translation
			local dps = 0.0
			local i = 0
			while true do
				local e = world:getEntity("Enemy", i)
				if e == nil then
					break
				end
				-- Dead (ragdolling) zombies no longer bite.
				if self._deadEnemies[e] == nil then
					local ep = e.transform.translation
					local d = ep - pp
					-- Compare a distance against a distance: _hurtRange is in metres, so
					-- squaring it here would silently scale the bite range by _hurtRange
					-- for any value other than 1. Both operands are translations (w = 1),
					-- so d.w is 0 and length is the plain origin-to-origin distance across
					-- all three axes -- the same measure EnemyController reads back off
					-- context._hurtRange to decide when to play its attack animation.
					if d.length < self._hurtRange then
						dps = dps + self._enemyDps
					end
				end
				i = i + 1
			end
			if dps > 0.0 then
				-- Whatever armour is worn takes its share of every bite (Config.items).
				self._health = self._health - dps * (1.0 - self:armor()) * dt
				-- Spurt blood while being eaten: raise the Humanoid's "blood" event on a
				-- timer, each raise spawning a short blood-splatter effect at the player.
				-- "hurt" rides the same timer -- the player's own voice, and the only
				-- warning that the thing behind you has reached you.
				--
				-- Placed at chest height by hand. Nothing is traced for a bite -- it lands
				-- somewhere on a body the camera is inside -- so this is simply the middle of
				-- the player, and it has to be said here now that the effect no longer carries
				-- a lift of its own (see killEnemy).
				if self._bloodEvents ~= nil then
					self._biteTimer = self._biteTimer - dt
					if self._biteTimer <= 0.0 then
						self._bloodEvents:raise("blood", Transform(Vector4(0.0, 1.05, 0.0, 0.0), Quaternion.identity))
						self._bloodEvents:raise("hurt")
						self._biteTimer = 0.3
					end
				end
				if self._health <= 0.0 then
					self._health = 0.0
					self._gameOver = true
					-- Cut back from any hive being watched, and abandon one still
					-- counting down to open. The armed case is the one that really
					-- matters now the wake is delayed: dying in that window is entirely
					-- possible, since those frames are played rather than frozen, and a
					-- hive must not open into a Game Over menu.
					self:_endCutscene()
					-- Nothing to let go of: what the player carries is in the pack, and
					-- a relic held in hand stays in front of the camera it was posed
					-- against, which is where the Game Over menu is being looked at from.
					--
					-- Take the HUD off screen, as the pause menu does -- the dialogs
					-- are panes now, and a health bar reading zero behind one is not
					-- what the moment is about. One way only: dying ends this stage,
					-- and Restart builds a new one.
					self:_showHud(false)
					-- Show the Game Over menu and free the mouse cursor so its
					-- Restart / Exit buttons are clickable (as the pause menu does).
					self._gameOverDialog:show()
					self.environment.input.inputSystem:setExclusive(false)
					self.environment.render.renderView:showCursor()
				end
			else
				self._biteTimer = 0.0   -- reset so the next bite spurts immediately
			end
		end
	end

	-- Hand out every booked impulse the moment the zombie's rag doll controller becomes active:
	-- the knockback of the shot that killed it, and anything that has hit the body since.
	-- getPoseControllersOf only descends the state graph's *current* state, so the list is
	-- empty for living zombies and during the blend, and becomes non-empty once the "dead"
	-- state is current (after reset). That naturally waits for the right frame; we then
	-- impulse every rag doll controller found and forget the pending entries.
	do
		for e, queued in pairs(self._pendingImpulse) do
			local skeleton = e:getComponent(traktor.animation.SkeletonComponent)
			if skeleton ~= nil then
				local ragdolls = skeleton:getPoseControllersOf(traktor.animation.RagDollPoseController)
				if ragdolls.size > 0 then
					for i = 0, ragdolls.size - 1 do
						local ragdoll < const > = ragdolls:get(i)
						for k = 1, #queued do
							-- A blast pushes the whole body, a round pushes the limb it hit.
							-- See killEnemy for why the two cannot share one call.
							local rec < const > = queued[k]
							if rec.whole then
								ragdoll:addImpulse(rec.impulse)
							else
								ragdoll:addImpulseAt(rec.point, rec.impulse)
							end
						end
					end
					self._pendingImpulse[e] = nil
				end
			end
		end
	end

	-- Despawn ragdoll corpses once their lifetime elapses (also frees their physics bodies).
	--
	-- Except at dawn, where the countdown is held: _breakDawn drops the entire horde
	-- at once and the shot that follows then spends every second of itself, and of the
	-- hold after it, inviting the player to look at them -- which a _corpseLifetime of six
	-- seconds would spend deleting them one by one in plain sight. The bodies are the
	-- payoff, so they stay for it -- the stage is being torn down at the end of this
	-- either way.
	do
		local world = self.world.world
		local remove = {}
		local decay < const > = self._nightOver and 0.0 or dt
		for e, life in pairs(self._deadEnemies) do
			life = life - decay
			if life <= 0.0 then
				table.insert(remove, e)
			else
				self._deadEnemies[e] = life
			end
		end
		for k = 1, #remove do
			local corpse = remove[k]
			self._deadEnemies[corpse] = nil
			self._pendingImpulse[corpse] = nil
			if world ~= nil then
				world:removeEntity(corpse)
				-- removeEntity only detaches the entity from the world; it does NOT tear
				-- down its components. Dynamic physics bodies (the rag doll limbs) keep
				-- simulating until Body::destroy runs, which only happens when the entity
				-- is destroyed. So destroy it explicitly to free the bodies immediately.
				corpse:destroy()
			end
		end
	end

	-- Update HUD. The bar animates itself from here on (see the :update calls at
	-- the top of this function); this only hands it the current health.
	self._healthBar:setValue(self._health / self._maxHealth)
end

-- postUpdate runs after every entity has updated this frame, so the camera follows the
-- player's *post-update* position -- no one-frame lag behind the character.
function Main:postUpdate(info)
	-- The world has updated at least once: every component's script object exists. See resolve.
	self._worldUpdated = true

	if self._gameOver or self._paused then
		return
	end

	-- A hive is opening: the camera is over there, and everything below -- which all
	-- hangs off the player's eye -- would drag it straight back. The rifle and a carried
	-- relic are left exactly where the frame froze them, which is where the player is
	-- standing and out of shot.
	if self._cutscene ~= nil then
		self:_placeCutsceneCamera()
		return
	end

	-- The dawn shot has the camera: the act is flying its own one out over the forest, and
	-- everything below hangs off the player's eye -- a view nobody is looking through. The
	-- rifle and a carried relic are left where the frame froze them, as for a hive above,
	-- which is down at the player and well out of a shot composed twenty metres up.
	if self._dawnPlaying then
		return
	end

	-- First-person: the camera sits at the eye and looks along the aim (heading+pitch).
	-- It rides the player rigidly in the horizontal (already smooth via the character
	-- controller) and eases only its height, so steps and stairs do not jolt the view; see
	-- EYE_HEIGHT_RATE. There is no boom and no view-blocking ray to worry about.
	if self._humanoid ~= nil then
		self:_followEyeHeight(info.simulationDeltaTime)
	end
	if self._camera ~= nil and self._humanoid ~= nil then
		local eye < const > = self:eye()
		local fwd < const > = self:aimDirection()
		self._camera.transform = Transform.lookAt(eye, eye + fwd, Vector4(0.0, 1.0, 0.0, 0.0))
	end

	-- Which relic is in the off hand, settled before the view models are placed, since they
	-- make room for one (Main:isCarrying). The first relic in the pack while one is equipped
	-- there, nothing otherwise; the one it replaces goes back out of sight -- unless it has left
	-- the pack, put down or spent, when whatever left it with has already decided whether it
	-- shows.
	if self._humanoid ~= nil then
		local inv < const > = self._inventory
		local want < const > = (inv:equipped("hand") == "relic") and inv:first("relic") or nil
		if want ~= self._handRelic then
			local old < const > = self._handRelic
			if old ~= nil and inv:holds(old) then
				self:_showKept(old, false)
			end
			self._handRelic = want
			if want ~= nil then
				self:_showKept(want, true)
			end
		end
	end

	-- The view models. Which weapon is in shot, where it sits relative to the eye, and what
	-- it does while reloading or on the run all belong to the weapons themselves -- this only
	-- says "now, from here". Below the camera, so a model welded to the view is not a frame
	-- behind it, and the drawn weapon is placed while every other is put away outright: with
	-- two of them on screen there is no telling at a glance what the left button would do.
	-- See Weapon:place, Weapon:stow and Loadout:place.
	self._loadout:place()

	-- The relics in the pack. The one in hand is held up in the off hand, riding the full aim
	-- exactly like the weapon, so it rises and drops with the view instead of lagging behind it
	-- (Relic:carryTransform); the rest ride along, hidden, wherever the player is -- which is
	-- what keeps their dots on the minimap with the player rather than wherever they were found.
	if self._humanoid ~= nil then
		local at < const > = Transform(self._humanoid.transform.translation, Quaternion.identity)
		self._inventory:eachKept(function(e)
			if e == self._handRelic then
				local sc < const > = e:getComponent(traktor.world.ScriptComponent)
				if sc ~= nil and sc.carryTransform ~= nil then
					e.transform = sc:carryTransform(self)
				end
			else
				e.transform = at
			end
		end)
	end
end

function Main:reload()
	self._humanoid = nil
	self._eyeY = nil
	self._camera = nil
	-- The dawn shot's camera goes with it. resolve() finds it again and, if the shot was
	-- running, re-binds it as the layer's camera -- so reloading mid-payoff does not drop
	-- the player back into a first-person view of a frozen night.
	self._dawnCamera = nil
	-- Every weapon lets go of its own live handles here -- the rifle's entity, event set and
	-- trail, the held grenade, anything thrown and still in the air -- and keeps its plain
	-- numbers, so a reload cannot quietly resupply the player. Which of those a weapon has
	-- is its own business; this only says the world is about to be new. See Weapon:reset.
	self._loadout:reset()
	-- Goes with the humanoid above: it is that entity's event set, and every cue the
	-- player owns is raised through it (_playCue), so a stale one means a silent night.
	self._bloodEvents = nil
	-- Ward records hold live entity handles, so they have to be re-resolved.
	-- resolve() restores which of them burn from _litWardIndex, which survives. The
	-- compass hold is one of those records, so it goes with them.
	self._wards = nil
	self._wardHold = nil
	-- The relic shown in hand is found again from the pack on the next postUpdate. The
	-- pack keeps its relics' entities, exactly as the old off hand kept the one it held.
	self._handRelic = nil
	-- Gate records likewise hold live entity handles, so they are re-resolved too.
	-- resolve() restores which are open from _unlockedGateIndex, which survives, and
	-- Gate:unlock is safe to re-assert on a gate whose bar is already gone.
	self._gates = nil
	-- Chest records too; resolve() restores which stand open from _openedChestIndex, and
	-- Chest:open(true) snaps the lid back up without putting a second item in the box.
	self._chests = nil
	self._levers = nil
	self._leverGates = nil
	self._exits = nil
	-- Hive records likewise; resolve() restores which of them are open from
	-- _awakeHiveIndex, which survives. A cutscene in flight holds one of those records,
	-- so it goes too -- reloading mid-shot cuts back to the player rather than leaving
	-- the camera pointed at a stale entity, and the hive it was watching carries on
	-- opening without it.
	self._hives = nil
	self._cutscene = nil
	-- ...as does a hive still counting down to open, for the same reason: its record is
	-- one of the ones about to be re-resolved. Reloading in that half-second window
	-- therefore costs that one hive its opening -- it stays marked awake and dormant --
	-- which is a fair price for reload never being able to strand a stale entity.
	self._pendingHive = nil
	-- The pickups' books hold live entity handles too, and are counted again from whatever world
	-- comes back (a pickup that survives keeps its name on itself, Pickup _home). What was put
	-- down is forgotten: a stack lying in the world across a hot reload stays where it is, but is
	-- no longer remembered if the player then leaves this stage.
	self._pickups = nil
	self._pickupKeyOf = nil
	self._dropped = {}
end

]]></text>
</object>
