<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{720C0A68-B608-2F40-8EBA-F7E42EB27F61}
#using \{FC4400A2-BDB6-BA45-9A22-12B9676E71FA}
#using \{EDC0B8AE-497C-4963-A2F1-5B3A6937790C}
#using \{100776ED-BB66-4B71-875A-0260C73DEE6C}
#using \{8DF61FC9-C1FD-48B2-B12B-806D60830E91}
#using \{B7E4C1A9-3D62-4F08-9A15-6C2E8B0D4F73}

import(traktor)

-- Main

-- Where the Sky entity's directional light ends up at dawn: a low warm sun, an
-- order of magnitude brighter than the cool moonlight it is authored with. Stored
-- premultiplied, because that is the form LightComponent.color takes.
local DAWN_SUN < const > = Vector4(1.0, 0.86, 0.62, 1.0) * 26.0

-- Two-argument atan; math.atan2 was folded into math.atan.
local atan2 < const > = math.atan2 or math.atan

Main = Main or class("Main", Stage)

function Main:new(params, environment)
	Stage.new(self, params, environment)

	-- Initialize UiKit. Two resource kits: the HUD widgets' own art (UI/Hud,
	-- imported from data/Assets/UI/Hud.svg) and UiKit's own movie, which the
	-- menus and every Static come from. HealthBar/AmmoCounter look their
	-- movie clips up by name across both, so the HUD one has to be listed here
	-- or they cannot build themselves.
	Widget.initialize(
		environment.resource.resourceManager,
		{
			"\{B11AC173-A951-4180-B16B-36F57D2603C8}",
			"\{5ABEAE05-EB26-934F-932F-7F3C7C582383}"
		}
	)

	-- Create UI frame with virtual size of 1280x720. Two rows, both taking half
	-- the height: the status line hangs off the top of the first, the HUD off
	-- the bottom of the second, which puts it along the bottom edge no matter
	-- what aspect the window has.
	local root = self.ui.root
	self._frame = Frame(
		root,
		1280 / 2, 720 / 2,
		TableLayout({ 100 }, { 100 }, 24, 20, 0, 0)
	)

	-- Blank unless god mode is on; the text is set by the toggle rather than each frame.
	self._lblGodMode = Static(self._frame, "")
	self._lblGodMode:setTextColor(Color4f(1.0, 0.85, 0.1, 1.0))
	self._lblGodMode:setTextOutlineColor(Color4f(0.0, 0.0, 0.0, 1.0))
	self._lblGodMode:setHorizontalAlign(Widget.ALIGN_CENTER)
	self._lblGodMode:setVerticalAlign(Widget.ALIGN_TOP)

	-- HUD: one row along the bottom, reading left to right as where to go, how alive
	-- you are, and what you have to shoot with. Ammo sits next to health because those
	-- two are what the player is actually spending. All three are custom widgets
	-- (Scripts/Widgets) whose art comes from the UI/Hud movie, and all three want a
	-- per-frame :update to run their animations.
	self._hud = Container(self._frame, TableLayout({ 0, 0, 0 }, { 0 }, 0, 0, 18, 0))
	self._hud:setHorizontalAlign(Widget.ALIGN_CENTER)
	self._hud:setVerticalAlign(Widget.ALIGN_BOTTOM)
	self._marker = ObjectiveMarker(self._hud)
	self._healthBar = HealthBar(self._hud)
	self._ammo = AmmoCounter(self._hud)

	-- Aiming crosshair: a Crosshair widget (Scripts/Widgets/Crosshair) whose art is the
	-- MC_Crosshair export of the same UI/Hud movie the other HUD widgets use. It is not
	-- part of the HUD row -- it is floated (ILayout.FLOAT) over the centre of the screen
	-- and placed by hand each frame in _updateCrosshair, since the centre moves with the
	-- window size. Parented to the frame after the HUD but before the dialogs and the
	-- dawn wash, so those cover it; it hides itself whenever a relic is carried or the
	-- game is not being played.
	self._crosshair = Crosshair(self._frame)
	self._crosshair.__layout = ILayout.FLOAT
	self._crosshairShown = nil   -- nil so the first _updateCrosshair forces the state

	-- Game Over menu (hidden until death): the "GAME OVER" banner plus Restart / Exit
	-- buttons, as a modal Dialog auto-centered over the HUD (one column: title, then
	-- two buttons). Dialog is ILayout.FLOAT, so it is excluded from the frame's layout
	-- and does not disturb the HUD row.
	--
	-- It MUST be parented to self._frame -- this stage's one and only Frame -- and not
	-- to a second full-screen Frame of its own. Each Frame is a separate widget tree
	-- (Frame is built with parent = nil), but UiKit's "event masks are stale" flag,
	-- Widget._eventMaskDirty, is global: Widget:_dispatchEvent refreshes only
	-- self:getAncestor()'s subtree and then clears that shared flag. With two sibling
	-- Frames the always-visible HUD dispatches first, refreshes itself and clears the
	-- flag, so the other tree's _eventFilter stays at its initial 0x00000000 and every
	-- event fails the mask test -- its buttons silently never receive a click.
	self._gameOverDialog = Dialog(self._frame, TableLayout({ 0 }, { 0, 0, 0 }, 24, 24, 0, 16))
	self._lblGameOver = Static(self._gameOverDialog, "GAME OVER")
	self._lblGameOver:setHorizontalAlign(Widget.ALIGN_CENTER)
	self._lblGameOver:setTextSize(60)
	self._lblGameOver:setTextColor(Color4f(0.9, 0.05, 0.05, 1.0))
	self._lblGameOver:setTextOutlineColor(Color4f(0.0, 0.0, 0.0, 1.0))
	-- Restart: reload this stage from scratch via its "RESTART" self-transition.
	self._restartButton = PushButton(self._gameOverDialog, "Restart")
	self._restartButton:setMinimumWidth(220)
	self._restartButton:setOnClick(function() self:_restart() end)
	-- Exit: back to the Startup menu, via the loading screen (see _exitToStartup).
	self._gameOverExitButton = PushButton(self._gameOverDialog, "Exit")
	self._gameOverExitButton:setMinimumWidth(220)
	self._gameOverExitButton:setOnClick(function() self:_exitToStartup() end)
	-- No explicit hide needed: Dialog starts hidden (Dialog:_initialize ends in
	-- setVisible(false)), exactly as the pause dialog below relies on.

	-- Objective banner and contextual prompt, both centred near the top.
	--
	-- These are ILayout.FLOAT (the same escape hatch Dialog uses), so they sit
	-- outside the frame's two-row layout and leave the god mode label and the HUD
	-- row exactly where they were. They have to be placed by hand anyway: Static
	-- clamps its text bounds to the width it was placed at, so a label whose text
	-- changes -- and the prompt changes constantly -- gets the longer string cut
	-- off unless it is re-placed. See _setLabel.
	self._objective = { widget = Static(self._frame, ""), y = 30 }
	self._objective.widget.__layout = ILayout.FLOAT
	self._objective.widget:setTextSize(26)
	self._objective.widget:setTextColor(Color4f(1.0, 0.82, 0.45, 1.0))
	self._objective.widget:setTextOutlineColor(Color4f(0.0, 0.0, 0.0, 1.0))

	self._prompt = { widget = Static(self._frame, ""), y = 66 }
	self._prompt.widget.__layout = ILayout.FLOAT
	self._prompt.widget:setTextSize(22)
	self._prompt.widget:setTextColor(Color4f(0.92, 0.94, 0.9, 1.0))
	self._prompt.widget:setTextOutlineColor(Color4f(0.0, 0.0, 0.0, 1.0))

	-- Transient line for things that happen rather than things that are true --
	-- currently only a ward catching light.
	self._notice = { widget = Static(self._frame, ""), y = 102 }
	self._notice.widget.__layout = ILayout.FLOAT
	self._notice.widget:setTextSize(24)
	self._notice.widget:setTextColor(Color4f(1.0, 0.72, 0.34, 1.0))
	self._notice.widget:setTextOutlineColor(Color4f(0.0, 0.0, 0.0, 1.0))

	-- Ensure layouts are updated.
	self._frame:update()

	-- Player health / game-over.
	self._health = 100.0
	self._maxHealth = 100.0
	self._gameOver = false
	self._hurtRange = 1.0   -- enemies within this distance (m) deal damage
	self._enemyDps = 20.0   -- health drained per second per touching enemy
	self._biteTimer = 0.0   -- re-trigger countdown for the blood splatter while eaten
	self._godMode = false   -- G: skip contact damage entirely (zombies still bite, visibly)

	-- Movement: WASD to move; hold Shift (STATE_SPRINT) to sprint. maxVelocity is set to
	-- the current speed each frame so the character controller's velocity clamp permits it.
	self._walkSpeed = 3.0
	self._sprintSpeed = 6.0

	-- Shooting: left mouse fires a hitscan that ragdolls the nearest zombie in front.
	self._deadEnemies = {}       -- live set: enemy entity -> remaining corpse lifetime (s)
	self._kills = 0
	self._corpseLifetime = 6.0   -- how long a ragdoll corpse lingers before it despawns
	self._fireRange = 40.0       -- max shot distance (m)
	self._fireRadius = 0.9       -- aim-assist radius around the shot ray (m)

	-- Ammunition. The rifle holds a magazine, the player carries a reserve, and
	-- rounds only move from one to the other on a reload that takes long enough
	-- that *where* you choose to do it matters. With zombies spawning forever and
	-- one shot killing one of them, this is the whole economy: tune these first.
	--
	-- Rounds are spent in _fireWeapon and topped up by "AmmoPickup" crates, which
	-- Terrain (Scene 2) scatters around the landmarks.
	self._magSize = 6            -- rounds the rifle holds
	self._mag = 6                -- rounds in it right now
	self._reserve = 24           -- spare rounds carried
	self._reserveMax = 60        -- most that can be carried at once
	self._reloadTime = 1.9       -- seconds to refill the magazine
	self._fireInterval = 0.4     -- minimum seconds between shots
	self._fireTimer = 0.0        -- counts down to the next shot being allowed
	self._reloadTimer = 0.0      -- counts down to the magazine being refilled
	self._ammo:setAmmo(self._mag, self._reserve)

	-- Relics. The night's objective: consecrated crosses are scattered around the
	-- map's landmarks and have to be carried, one at a time, back to the altar at
	-- the chapel.
	--
	-- Carrying one is the whole point of the mechanic. It fills one hand rather than
	-- both, so the rifle stays up and you can still fire (it just rides a little
	-- further right, out of the relic's way) -- but sprinting is out and you move
	-- slower than a zombie walks. Every relic run is therefore a route you commit to,
	-- and putting it down is no longer the only way to fight back.
	self._carried = nil          -- the Relic entity in the player's hands, or nil
	self._placedRelics = {}      -- delivered relics; skipped when scanning for one to take
	self._relicsPlaced = 0
	self._relicsTotal = nil      -- counted off the world in resolve
	self._reachRange = 2.2       -- how close to a relic you must be to take it (m)
	self._altarRange = 3.5       -- ...and to the altar to place one; it is a 1.8 m monument
	self._carrySpeed = 1.9       -- movement speed while carrying (walking is 3.0)

	-- Wards. Every relic delivered lights one, and a lit ward is ground the Spawner
	-- refuses to place zombies on. They are lit nearest-the-altar first, so the safe
	-- zone grows outward from the cemetery along the routes the player keeps
	-- re-walking -- which is the point: a ward out at a relic site would be
	-- consecrating ground nobody ever visits again.
	--
	-- The trade is that it also winds the rest of the night up (see _publishWards
	-- and Scripts/Spawner): you are buying an island and paying for it with a worse
	-- forest, so the last relic run is the bad one.
	self._wards = nil            -- resolved off the world, ordered by distance from the altar
	self._wardsLit = 0
	self._litWards = {}          -- published to the Spawner
	self._enemyPace = 1.0        -- published to EnemyController
	self._wardRadius = 15.0      -- no-spawn radius of a lit ward (m)
	self._enemyPacePerWard = 0.1 -- zombie speed added per lit ward
	self._noticeText = ""
	self._noticeTimer = 0.0

	-- The night director. There is exactly one way to win -- every relic on the
	-- altar -- and it fires a timed sequence rather than an instant cut, so the
	-- payoff has room to land: the horde drops where it stands, the sun comes up
	-- over several seconds, and the screen floods warm into the victory card.
	--
	-- Only the directional light on the Sky entity carries the sunrise. SkyComponent
	-- has no script bindings at all (nothing in Weather is registered), so its
	-- intensity and horizon colours cannot be animated -- hence the wash, which
	-- covers the sky staying night-dark underneath.
	self._nightOver = false      -- true from the moment the last relic is placed
	self._victoryShown = false
	self._dawn = 0.0             -- seconds into the sunrise
	self._dawnTime = 7.5         -- how long it takes, end to end
	self._sun = nil              -- the Sky entity's directional light
	self._sunNight = nil         -- ...and its authored colour, i.e. the moonlight

	-- Aiming: mouse Y pitches the view/weapon up and down (mouse X yaws, in update).
	self._pitch = 0.0            -- current aim pitch (radians; + = up)
	self._pitchMin = -1.15       -- clamp low (~ -66 deg)
	self._pitchMax = 1.15        -- clamp high (~ +66 deg)
	self._invertPitch = false    -- set true for inverted (flight-style) vertical look

	-- Knockback: impulse imparted to a zombie's rag doll when shot. Distributed across
	-- the limbs by RagDollPoseController:addImpulse, so this is total momentum: with ~11
	-- unit-mass limbs an impulse of 18 is roughly a 1.6 m/s whole-body shove.
	self._knockback = 50.0       -- impulse magnitude along the shot direction
	self._knockbackLift = 10.0    -- extra upward impulse so the corpse flops back, not just slides
	self._pendingImpulse = {}    -- enemy -> impulse to apply once its rag doll turns active

	-- Pause menu: a modal dialog (hidden until Escape) floating centered over the HUD,
	-- holding a "PAUSED" title and a Resume button. Dialog/PushButton come via UiKit.
	self._paused = false
	self._pauseDialog = Dialog(self._frame, TableLayout({ 0 }, { 0, 0, 0 }, 24, 24, 0, 16))
	local pauseTitle = Static(self._pauseDialog, "PAUSED")
	pauseTitle:setTextSize(40)
	pauseTitle:setHorizontalAlign(Widget.ALIGN_CENTER)
	self._resumeButton = PushButton(self._pauseDialog, "Resume")
	self._resumeButton:setOnClick(function() self:_setPaused(false) end)
	-- Exit back to the startup stage, via the loading screen (see _exitToStartup).
	self._exitButton = PushButton(self._pauseDialog, "Exit")
	self._exitButton:setOnClick(function() self:_exitToStartup() end)

	-- Dawn wash: a full-screen warm panel, hidden through the night and flooded up
	-- to opaque once it is won. FLOAT so it stays out of the frame's row layout, and
	-- created after the HUD and the other dialogs so it covers them -- but before the
	-- victory card below, which has to sit on top of it. Hidden rather than merely
	-- transparent: Panel listens for mouse presses and would otherwise swallow clicks
	-- meant for the pause menu.
	self._flash = Panel(self._frame, FloodLayout())
	self._flash.__layout = ILayout.FLOAT
	self._flash:setColor(Color4f(1.0, 0.94, 0.8, 0.0))
	self._flash:setVisible(false)

	-- Victory card, raised at the end of the sunrise.
	self._victoryDialog = Dialog(self._frame, TableLayout({ 0 }, { 0, 0, 0, 0 }, 24, 24, 0, 16))
	local victoryTitle = Static(self._victoryDialog, "DAWN")
	victoryTitle:setTextSize(60)
	victoryTitle:setHorizontalAlign(Widget.ALIGN_CENTER)
	victoryTitle:setTextColor(Color4f(0.85, 0.5, 0.08, 1.0))
	victoryTitle:setTextOutlineColor(Color4f(0.0, 0.0, 0.0, 1.0))
	local victorySub = Static(self._victoryDialog, "THE NIGHT IS OVER")
	victorySub:setTextSize(22)
	victorySub:setHorizontalAlign(Widget.ALIGN_CENTER)
	self._victoryRestart = PushButton(self._victoryDialog, "Again")
	self._victoryRestart:setMinimumWidth(220)
	self._victoryRestart:setOnClick(function() self:_restart() end)
	self._victoryExit = PushButton(self._victoryDialog, "Exit")
	self._victoryExit:setMinimumWidth(220)
	self._victoryExit:setOnClick(function() self:_exitToStartup() end)

	environment.input.inputSystem:setExclusive(true)
	environment.render.renderView:hideCursor()
end

-- Enter/leave pause. Toggles the menu, frees/recaptures the mouse cursor (so it can
-- click the menu, then return to mouse-look), and flips the freeze flag that
-- Main:update and every EnemyController honour.
function Main:_setPaused(paused)
	if self._gameOver or self._nightOver then
		return
	end
	self._paused = paused
	if paused then
		self._pauseDialog:show()
		self.environment.input.inputSystem:setExclusive(false)
		self.environment.render.renderView:showCursor()
	else
		self._pauseDialog:hide()
		self.environment.input.inputSystem:setExclusive(true)
		self.environment.render.renderView:hideCursor()
	end
end

-- Leave the level and go back to the Startup menu. Triggered from the pause and
-- Game Over menus' Exit buttons.
--
-- Routed through the Loading stage rather than straight at Startup: tearing this
-- world down and building the menu takes long enough to look like a hang, so the
-- Loading stage puts its panel up first and does the real load behind it. It is
-- the one named in the params table ("STARTUP", one of Stages/Loading's own
-- transitions); this stage only ever transitions to LOADING.
--
-- The load itself is async and the goto happens in Main:update, which polls the
-- loader before its paused/game-over early-returns.
function Main:_exitToStartup()
	if self._loader ~= nil then
		return
	end
	self._loader = self:loadStageAsync("LOADING", { target = "STARTUP" })
end

-- Restart: reload this gameplay stage from scratch via its "RESTART" self-transition
-- (declared on this Stage's StageData, pointing back at itself). Loaded async and
-- switched to in Main:update, exactly like _exitToStartup -- a brand-new stage/scene/
-- world is created, so all game state (health, kills, enemies, ...) resets.
function Main:_restart()
	if self._loader ~= nil then
		return
	end
	self._loader = self:loadStageAsync("RESTART", nil)
end

function Main:finalize()
	if self._pauseDialog ~= nil then
		self._pauseDialog:remove()
		self._pauseDialog = nil
	end
	if self._gameOverDialog ~= nil then
		self._gameOverDialog:remove()
		self._gameOverDialog = nil
	end
	if self._victoryDialog ~= nil then
		self._victoryDialog:remove()
		self._victoryDialog = nil
	end
	self._frame:remove()
	self._frame = nil
end

-- Resolve (and cache) the humanoid entity, its character controller and the camera.
function Main:resolve()
	if self._heading == nil then
		self._heading = 0.0
	end
	local world = self.world.world
	if world == nil then
		return
	end
	-- Relics stay in the world once delivered (they are stood up around the altar),
	-- so this total is counted once and stays right for the rest of the night.
	if self._relicsTotal == nil then
		self._relicsTotal = world:getEntities("Relic").size
	end
	if self._altar == nil then
		self._altar = world:getEntity("Altar")
	end
	-- The scene's moon: a directional LightComponent riding the Sky entity. Its
	-- authored colour is captured as the night value the sunrise interpolates from.
	if self._sun == nil then
		local sky < const > = world:getEntity("Sky")
		if sky ~= nil then
			self._sun = sky:getComponent(traktor.world.LightComponent)
			if self._sun ~= nil then
				local c < const > = self._sun.color
				self._sunNight = Vector4(c.x, c.y, c.z, c.w)
			end
		end
	end
	-- Collect the wards once and sort them by distance from the altar, so the
	-- lighting order radiates outward. Sorted here rather than authored as an index,
	-- so dragging a ward around in the scene editor cannot put the sequence out of
	-- order. Ends up an empty (non-nil) list in a scene with no wards, which is what
	-- stops this re-running every frame in Scene 1.
	--
	-- Each ward's flame is owned by its own Ward ScriptComponent (Scripts/Ward); this
	-- only tracks where the wards are and which are lit, and lights one by calling
	-- turnOn() on that component. The record therefore holds the entity, not a live
	-- light handle.
	if self._wards == nil and self._altar ~= nil then
		local a < const > = self._altar.transform.translation
		local list = {}
		local i = 0
		while true do
			local e = world:getEntity("Ward", i)
			if e == nil then
				break
			end
			i = i + 1
			local p < const > = e.transform.translation
			list[#list + 1] = {
				entity = e,
				lit = false,
				x = p.x,
				z = p.z,
				d = (p.x - a.x) * (p.x - a.x) + (p.z - a.z) * (p.z - a.z)
			}
		end
		table.sort(list, function (l, r) return l.d < r.d end)
		self._wards = list

		-- _wardsLit survives a script hot reload while these records do not, so the
		-- first _wardsLit of them are re-lit -- instantly, so a mid-game reload does
		-- not replay every flare. A fresh night has _wardsLit == 0 and lights none;
		-- the Ward components start their flames dark on their own.
		for k, w in ipairs(self._wards) do
			if k <= self._wardsLit then
				w.lit = true
				local sc < const > = w.entity:getComponent(traktor.world.ScriptComponent)
				if sc ~= nil then
					sc:turnOn(true)
				end
			end
		end
		self:_publishWards()
	end
	if self._humanoid == nil then
		self._humanoid = world:getEntity("Humanoid")
	end
	if self._camera == nil then
		self._camera = world:getEntity("Camera0")
		-- Bind the WorldLayer's render camera explicitly, rather than relying on the
		-- layer to find "Camera0" by itself. It only does that inside its
		-- m_scene.changed() branch, and a *same-scene* stage transition -- exactly our
		-- Game Over -> Restart, which re-enters Main via the RESTART self-transition --
		-- consumes that flag in WorldLayer::transition to keep the world renderer it
		-- inherits from the outgoing layer. So the fresh layer never resolves a camera:
		-- postUpdate stops sampling one, preSetup stops updating the view, and the
		-- inherited render view stays frozen wherever the old camera died, while this
		-- script still happily moves the Camera0 entity nobody is looking through.
		-- Assigning it here is authoritative and survives any transition.
		if self._camera ~= nil then
			self.world.camera = self._camera
		end
	end
	if self._character == nil and self._humanoid ~= nil then
		self._character = self._humanoid:getComponent(traktor.physics.CharacterComponent)
		if self._character ~= nil then
			self._heading = self._character.headAngle
		end
	end
	if self._poseController == nil and self._humanoid ~= nil then
		local skeleton = self._humanoid:getComponent(traktor.animation.SkeletonComponent)
		if skeleton ~= nil then
			self._poseController = skeleton.poseController
		end
	end
	if self._bloodEvents == nil and self._humanoid ~= nil then
		self._bloodEvents = self._humanoid:getComponent(traktor.world.EventSetComponent)
	end
	-- The gun is a child entity of the player (via GroupComponent). Cache it and its
	-- event set so aiming can orient it and firing can raise its "fire" (muzzle bolt).
	if self._weapon == nil and self._humanoid ~= nil then
		local group = self._humanoid:getComponent(traktor.world.GroupComponent)
		if group ~= nil then
			self._weapon = group:getEntity("Weapon", 0)
			if self._weapon ~= nil then
				self._fireEvents = self._weapon:getComponent(traktor.world.EventSetComponent)
			end
		end
	end
end

-- Mark one zombie dead: blood burst at the impact point, hand it over to its
-- EnemyController (which polls _deadEnemies and switches the body to rag doll), queue
-- the knockback for the frame its rag doll controller goes active, and tally the kill.
-- Shared by the weapon and the kill-all shortcut so a zombie only ever dies one way.
-- Returns false if it was already dead, so a second trigger cannot double-count it.
function Main:_killEnemy(enemy, point, impulse)
	if enemy == nil or self._deadEnemies[enemy] ~= nil then
		return false
	end

	-- The event uses follow=false, so the burst stays where the zombie was hit while its
	-- corpse ragdolls away -- and outlives the corpse when Main despawns it.
	local hitEvents = enemy:getComponent(traktor.world.EventSetComponent)
	if hitEvents ~= nil then
		hitEvents:raise("blood")
	end

	self._deadEnemies[enemy] = self._corpseLifetime
	self._pendingImpulse[enemy] = { point = point, impulse = impulse }
	self._kills = self._kills + 1
	return true
end

-- Kill every live zombie in the world at once (K). Each one dies through _killEnemy, so
-- they rag doll, spray blood, count as kills and get despawned on the usual corpse timer
-- -- no separate teardown path that could leak them. The impulse points radially away
-- from the player so the pile scatters outward instead of every corpse taking the same
-- shove. Safe to iterate by index: _killEnemy only marks, it never removes entities.
function Main:_killAllEnemies()
	local world = self.world.world
	if world == nil or self._humanoid == nil then
		return
	end

	local origin = self._humanoid.transform.translation + Vector4(0.0, 1.6, 0.0, 0.0)
	local i = 0
	while true do
		local e = world:getEntity("Enemy", i)
		if e == nil then
			break
		end
		i = i + 1
		local chest = e.transform.translation + Vector4(0.0, 1.0, 0.0, 0.0)
		local away = chest - origin
		local len = away.length
		if len > 0.01 then
			away = away / len
		else
			away = Vector4(0.0, 0.0, 1.0, 0.0)   -- standing exactly on the eye; shove forward
		end
		self:_killEnemy(e, chest, away * self._knockback + Vector4(0.0, self._knockbackLift, 0.0, 0.0))
	end
end

-- Set a floating label's text and centre it horizontally at its own y. Skipped
-- when neither the text nor the frame width has changed, so this is cheap enough
-- to call every frame -- which it has to be, since the frame width only settles
-- after the first layout and changes again on every window resize.
function Main:_setLabel(rec, text)
	local p < const > = self._frame:getPlacement()
	if rec.text == text and rec.placedWidth == p.width then
		return
	end
	rec.text = text
	rec.placedWidth = p.width
	rec.widget:setText(text)
	local ts < const > = rec.widget:getPreferredSize()
	rec.widget:place((p.width - ts.width) / 2, rec.y, ts.width, ts.height)
end

-- Is a world point close enough to the player to interact with?
function Main:_withinRange(p, range)
	if self._humanoid == nil then
		return false
	end
	local pp < const > = self._humanoid.transform.translation
	local dx < const > = p.x - pp.x
	local dy < const > = p.y - pp.y
	local dz < const > = p.z - pp.z
	return dx * dx + dy * dy + dz * dz < range * range
end

-- The closest relic still up for grabs, and how far off it is. Pass maxDist to
-- limit it (the E prompt wants arm's reach); omit it for the nearest anywhere on
-- the map, which is what the objective compass points at.
--
-- Delivered relics are skipped: they stay in the world standing around the altar,
-- so without the _placedRelics guard the player could pick one straight back up
-- again -- and the compass would send them to the altar they just left.
function Main:_nearestRelic(maxDist)
	local world = self.world.world
	if world == nil or self._humanoid == nil then
		return nil, 0.0
	end

	local pp < const > = self._humanoid.transform.translation
	local best, bestD = nil, (maxDist ~= nil) and (maxDist * maxDist) or math.huge
	local i = 0
	while true do
		local r = world:getEntity("Relic", i)
		if r == nil then
			break
		end
		i = i + 1
		if self._placedRelics[r] == nil and r ~= self._carried then
			local q = r.transform.translation
			local dx, dy, dz = q.x - pp.x, q.y - pp.y, q.z - pp.z
			local d = dx * dx + dy * dy + dz * dz
			if d < bestD then
				best, bestD = r, d
			end
		end
	end
	if best == nil then
		return nil, 0.0
	end
	return best, math.sqrt(bestD)
end

-- Stand something on whatever is underneath a point, so a relic put down on a
-- slope neither floats nor sinks to the shin. Short trace window, same reasoning
-- as the Spawner's traceGround: reaching further up starts the ray above nearby
-- props and drops the relic onto boulders and table tops instead of the ground.
-- Static world only (0x1), so a passing zombie is never mistaken for floor.
function Main:_groundAt(p)
	local pm < const > = self.environment.physics.physicsManager
	if pm == nil then
		return p
	end
	local hit < const > = pm:queryRay(
		Vector4(p.x, p.y + 1.0, p.z, 1.0),
		Vector4(0.0, -1.0, 0.0, 0.0),
		4.0,
		traktor.physics.QueryFilter(0x00000001),
		true
	)
	if hit == nil then
		return p
	end
	return hit.position
end

-- Light the nearest still-dark ward to the altar: flag it, tell its Ward component
-- to catch (Scripts/Ward owns the flame itself), and republish the safe ground.
-- Returns false once they all burn, which is how the last delivery knows it
-- finished the night.
function Main:_lightNextWard()
	if self._wards == nil then
		return false
	end
	for _, w in ipairs(self._wards) do
		if not w.lit then
			w.lit = true
			self._wardsLit = self._wardsLit + 1
			local sc < const > = w.entity:getComponent(traktor.world.ScriptComponent)
			if sc ~= nil then
				sc:turnOn()
			end
			self:_publishWards()
			return true
		end
	end
	return false
end

-- Hand the world what it needs off the ward state: where consecrated ground is,
-- and how hard the night should push. Read by Scripts/Spawner (which will not
-- place anything inside a lit ward) and by every Scripts/EnemyController (which
-- steers out of one). Rebuilt only when a ward is lit -- wards never move, so
-- there is nothing to do per frame.
--
-- Both r and r2 are published: the spawner only ever compares squared distances,
-- but the enemies need the real radius to scale their push, and doing that sqrt
-- once here beats doing it per ward per zombie per frame.
function Main:_publishWards()
	local lit = {}
	if self._wards ~= nil then
		for _, w in ipairs(self._wards) do
			if w.lit then
				lit[#lit + 1] = {
					x = w.x,
					z = w.z,
					r = self._wardRadius,
					r2 = self._wardRadius * self._wardRadius
				}
			end
		end
	end
	self._litWards = lit
	self._enemyPace = 1.0 + self._enemyPacePerWard * self._wardsLit
end

-- The night is won. Everything after this is the payoff: the spawner is shut off,
-- the horde drops where it stands, and Main:_updateDawn runs the sunrise.
function Main:_breakDawn()
	if self._nightOver then
		return
	end
	self._nightOver = true
	self._dawn = 0.0
	self:_showNotice("DAWN BREAKS")

	-- The light takes them. Routed through the same rag doll path a shot zombie
	-- takes, so the horde collapses in place rather than being deleted out from
	-- under the player. EnemyController deliberately does *not* freeze on
	-- _nightOver -- it still has to see _deadEnemies and make the switch.
	self:_killAllEnemies()

	-- Hand the mouse back, ready for the victory card.
	self._flash:setVisible(true)
	self.environment.input.inputSystem:setExclusive(false)
	self.environment.render.renderView:showCursor()
end

-- Run the sunrise: ease the scene's directional light from moonlight to a low warm
-- sun, flood the screen warm on top of it, then raise the victory card.
function Main:_updateDawn(dt)
	if not self._nightOver then
		return
	end

	self._dawn = self._dawn + dt
	local t < const > = math.min(1.0, self._dawn / self._dawnTime)

	-- The two halves of the sequence deliberately do not share a curve. The sun is
	-- done by the halfway mark and the wash only starts just before that, so there
	-- is a stretch in the middle where the player actually sees the forest they
	-- fought through standing in daylight -- ramping both together would have the
	-- screen white by the time the sun arrived, and the whole point of lighting the
	-- world would be lost behind it.
	if self._sun ~= nil and self._sunNight ~= nil then
		local s < const > = math.min(1.0, t / 0.5)
		local e < const > = s * s   -- slow to start, so the first moments still read as night
		self._sun.color = self._sunNight * (1.0 - e) + DAWN_SUN * e
	end

	-- Wash: holds off, then floods to opaque for the card. It is what covers the sky
	-- staying night-dark through all of this, SkyComponent being unscriptable.
	local a < const > = math.max(0.0, (t - 0.6) / 0.4)
	local p < const > = self._frame:getPlacement()
	self._flash:place(0, 0, p.width, p.height)
	self._flash:setColor(Color4f(1.0, 0.94, 0.8, a * a))

	if t >= 1.0 and not self._victoryShown then
		self._victoryShown = true
		self._victoryDialog:show()
	end
end

-- Aim the objective compass at wherever the player should be walking: the altar
-- while carrying, otherwise the nearest relic still out in the forest. Blank once
-- the night is over, either way it ended.
function Main:_updateMarker(dt)
	local target = nil
	if not self._gameOver and not self._nightOver and self._humanoid ~= nil then
		if self._carried ~= nil then
			target = self._altar
		else
			-- Unbounded, unlike the reach test the E prompt uses.
			target = self:_nearestRelic()
		end
	end

	-- Changing what it points at snaps and flashes the needle rather than sweeping
	-- it across the dial, so a hand-off reads as a new instruction.
	if target ~= self._markerTarget then
		self._markerTarget = target
		self._marker:retarget()
	end

	if target == nil then
		self._marker:setTarget(nil)
	else
		local p < const > = target.transform.translation
		local pp < const > = self._humanoid.transform.translation
		local dx < const > = p.x - pp.x
		local dz < const > = p.z - pp.z
		-- Relative bearing. Forward is (sin h, 0, cos h), so the world bearing of
		-- (dx, dz) is atan2(dx, dz), and subtracting the player's heading turns it
		-- into "how far round from straight ahead" -- which is what the needle shows.
		self._marker:setTarget(atan2(dx, dz) - self._heading, math.sqrt(dx * dx + dz * dz))
	end

	self._marker:update(dt)
end

-- Place the aiming crosshair at the centre of the screen, and show it only while the
-- player is actually sighting down the rifle: not while a relic is carried (both the
-- ask and the fiction -- the reticle belongs to the gun, and a hand is off it holding
-- the relic), and not while the game is paused, lost or won. Called from update above
-- its early-returns, so those "not playing" states can hide it.
function Main:_updateCrosshair(dt)
	local show = not self._gameOver
		and not self._nightOver
		and not self._paused
		and self._carried == nil
		and self._humanoid ~= nil

	if show ~= self._crosshairShown then
		self._crosshairShown = show
		self._crosshair:setVisible(show)
	end

	-- Ease the firing bloom back even while hidden, so the reticle is at rest the next
	-- time it shows.
	self._crosshair:update(dt)

	if not show then
		return
	end

	-- Centre the widget's box on the middle of the screen -- the same coordinate space
	-- the flash panel fills. The reticle is authored at the centre of its box, so this
	-- lands it exactly on the point of aim.
	local pl < const > = self._frame:getPlacement()
	local sz < const > = self._crosshair:getPreferredSize()
	self._crosshair:place(
		(pl.width - sz.width) * 0.5,
		(pl.height - sz.height) * 0.5,
		sz.width, sz.height
	)
end

-- Flash a line under the objective for a few seconds.
function Main:_showNotice(text)
	self._noticeText = text
	self._noticeTimer = 3.5
end

-- E, edge triggered. With a relic in hand: deliver it if the altar is in reach,
-- otherwise put it down. With empty hands: take the nearest relic in reach.
--
-- The relic positions itself for either move (Relic:drop / Relic:place on its
-- ScriptComponent); the Stage owns everything around it -- whether a relic is in
-- hand, the running tally, the ward that lights and the dawn that breaks.
function Main:_interact()
	if self._carried ~= nil then
		local relic < const > = self._carried
		local sc < const > = relic:getComponent(traktor.world.ScriptComponent)
		if self._altar ~= nil and self:_withinRange(self._altar.transform.translation, self._altarRange) then
			-- Deliver it. Count it first so the relic stands in the right ring slot;
			-- it is left in the world rather than removed.
			self._carried = nil
			self._placedRelics[relic] = true
			self._relicsPlaced = self._relicsPlaced + 1
			if sc ~= nil then
				sc:place(self)
			end

			-- Consecration flows back out of the altar: one more ward takes light, the
			-- safe ground reaches a landmark further out, and the forest beyond speeds up.
			if self:_lightNextWard() then
				self:_showNotice("A WARD IS LIT")
			end

			-- Every relic home ends the night. Checked last, so its notice replaces the
			-- ward one rather than being overwritten by it.
			if self._relicsTotal ~= nil and self._relicsPlaced >= self._relicsTotal then
				self:_breakDawn()
			end
		else
			-- Not in reach of the altar: just put it down, which buys the rifle back.
			self._carried = nil
			if sc ~= nil then
				sc:drop(self)
			end
		end
		return
	end

	local relic < const > = self:_nearestRelic(self._reachRange)
	if relic ~= nil then
		self._carried = relic
	end
end

-- Objective line, the contextual prompt for whatever E would do right now, and
-- the transient notice under them.
function Main:_updateHudText(dt)
	local total < const > = self._relicsTotal
	local objective = ""
	if total ~= nil and total > 0 then
		if self._relicsPlaced >= total then
			objective = "THE ALTAR IS WHOLE"
		else
			objective = "RELICS  " .. tostring(self._relicsPlaced) .. " / " .. tostring(total)
		end
	end
	self:_setLabel(self._objective, objective)

	local prompt = ""
	if not self._gameOver and not self._nightOver then
		if self._carried ~= nil then
			if self._altar ~= nil and self:_withinRange(self._altar.transform.translation, self._altarRange) then
				prompt = "E   PLACE THE RELIC"
			else
				prompt = "E   PUT DOWN THE RELIC"
			end
		elseif self:_nearestRelic(self._reachRange) ~= nil then
			prompt = "E   TAKE THE RELIC"
		end
	end
	self:_setLabel(self._prompt, prompt)

	self._noticeTimer = math.max(0.0, self._noticeTimer - dt)
	self:_setLabel(self._notice, self._noticeTimer > 0.0 and self._noticeText or "")
end

-- Start refilling the magazine from the reserve. Refuses when one is already in
-- progress, when the magazine is full, or when there is nothing left to load with
-- -- so the caller can fire this at every dry trigger pull without special casing.
-- Returns true when a reload actually began.
function Main:_beginReload()
	if self._reloadTimer > 0.0 then
		return false
	end
	if self._mag >= self._magSize or self._reserve <= 0 then
		return false
	end
	self._reloadTimer = self._reloadTime
	self._ammo:setReload(0.0)
	return true
end

-- Weapon timers and the reload key. Called from Main:update *below* its paused and
-- game over early returns, so the shot cadence and a reload in flight both freeze
-- with the rest of the game rather than ticking away behind the pause menu.
function Main:_updateWeapon(dt)
	if self._fireTimer > 0.0 then
		self._fireTimer = math.max(0.0, self._fireTimer - dt)
	end

	-- R reloads on demand (edge triggered), so the player can top up in a lull
	-- instead of being caught mid magazine.
	do
		local mapping < const > = self.environment.input.inputMapping
		if mapping ~= nil and mapping:isStatePressed("STATE_RELOAD") then
			self:_beginReload()
		end
	end

	if self._reloadTimer > 0.0 then
		self._reloadTimer = math.max(0.0, self._reloadTimer - dt)
		self._ammo:setReload(1.0 - self._reloadTimer / self._reloadTime)
		if self._reloadTimer <= 0.0 then
			-- Whole magazines are not swapped: only as many rounds as are actually
			-- left go in, so the last reload of a run is a short one.
			local take < const > = math.min(self._magSize - self._mag, self._reserve)
			self._mag = self._mag + take
			self._reserve = self._reserve - take
			self._ammo:setReload(nil)
			self._ammo:setAmmo(self._mag, self._reserve)
		end
	end
end

-- Fire the weapon: hitscan a ray out of the player's eye along the current facing,
-- pick the nearest live zombie close to the ray (with clear line of sight) and mark
-- it dead. Its EnemyController switches to rag doll; Main despawns the corpse later.
function Main:_fireWeapon()
	local world = self.world.world
	if self._humanoid == nil or world == nil then
		return
	end

	-- A relic fills only one hand, so the rifle still fires with one carried -- there
	-- is deliberately no early-out here for carrying.

	-- Nothing happens mid reload, and the rifle will not cycle faster than
	-- _fireInterval however fast the trigger is pulled.
	if self._reloadTimer > 0.0 or self._fireTimer > 0.0 then
		return
	end

	-- Dry: no bang and no muzzle flash, just a reload started for the player --
	-- which is what pulling the trigger on an empty rifle meant. If the reserve is
	-- empty too, _beginReload refuses and the red HUD plate is the only answer.
	if self._mag <= 0 then
		self:_beginReload()
		return
	end

	self._mag = self._mag - 1
	self._fireTimer = self._fireInterval
	self._ammo:setAmmo(self._mag, self._reserve)
	self._ammo:spend()

	-- Bloom the crosshair as recoil feedback (it eases back in Crosshair:update). Harmless
	-- while it is hidden mid-relic-carry -- it simply settles before it is shown again.
	if self._crosshair ~= nil then
		self._crosshair:kick()
	end

	-- Muzzle: spawn the projectile particle bolt from the weapon along the current
	-- aim. Raised on every shot (before target selection) so firing always shows the
	-- projectile, hit or miss. The "fire" event lives on the Weapon child entity, whose
	-- transform the aiming code orients by heading+pitch, so the bolt follows the aim.
	if self._fireEvents ~= nil then
		self._fireEvents:raise("fire")
	end

	local origin = self._humanoid.transform.translation + Vector4(0.0, 1.6, 0.0, 0.0)
	local aim = Quaternion.fromEulerAngles(self._heading, self._pitch, 0.0)
	local dir = aim * Vector4(0.0, 0.0, 1.0, 0.0)

	local bestT = self._fireRange
	local bestEnemy = nil
	local i = 0
	while true do
		local e = world:getEntity("Enemy", i)
		if e == nil then
			break
		end
		i = i + 1
		if self._deadEnemies[e] == nil then
			-- Aim at the zombie's chest; project onto the ray and keep the closest one
			-- whose perpendicular distance is within the aim-assist radius.
			local rel = (e.transform.translation + Vector4(0.0, 1.0, 0.0, 0.0)) - origin
			local t = rel.x * dir.x + rel.y * dir.y + rel.z * dir.z
			if t > 0.0 and t < bestT then
				local hx = rel.x - dir.x * t
				local hy = rel.y - dir.y * t
				local hz = rel.z - dir.z * t
				if hx * hx + hy * hy + hz * hz < self._fireRadius * self._fireRadius then
					bestT = t
					bestEnemy = e
				end
			end
		end
	end

	if bestEnemy == nil then
		return
	end
--[[
	-- Reject the shot if geometry blocks the line of sight to the target.
	local pm = self.environment.physics.physicsManager
	if pm ~= nil then
		local to = (bestEnemy.transform.translation + Vector4(0.0, 1.0, 0.0, 0.0)) - origin
		local dist = to.length
		if dist > 0.6 then
			local d = to / dist
			local s = origin + d * 0.5
			local hit = pm:queryRay(s.xyz1, d.xyz0, dist - 0.7, traktor.physics.QueryFilter(), true)
			if hit ~= nil then
				return
			end
		end
	end
]]
	-- Kill it at the shot's impact point (along the aim, at the target's range), knocked
	-- back along the aim with a little lift.
	self:_killEnemy(
		bestEnemy,
		origin + dir * bestT,
		dir * self._knockback + Vector4(0.0, self._knockbackLift, 0.0, 0.0)
	)
end

function Main:update(info)
	self:resolve()

	local dt < const > = info.frameDeltaTime

	-- Tick the HUD widgets' animations (health drain, hit flash, heartbeat).
	-- Deliberately above every early-return below: the values they show are pushed to
	-- them where they change, and letting the widgets keep animating means a hit taken
	-- on the last frame still finishes its flash once the game is paused or over.
	self._healthBar:update(dt)
	self._ammo:update(dt)
	-- Ticks the compass widget itself, as well as re-aiming it.
	self:_updateMarker(dt)

	-- Objective and prompt. Also above the early-returns, so the banner stays put
	-- and correctly centred through a pause or a window resize.
	self:_updateHudText(dt)

	-- Aiming crosshair. Above the early-returns for the same reason: it has to be able
	-- to hide itself when the game pauses, is lost or is won.
	self:_updateCrosshair(dt)

	-- Wards ease up to full in their own Ward components (Scripts/Ward), which run
	-- every frame regardless of this stage's freeze -- so a ward caught on the frame
	-- the player died still finishes catching rather than sticking at its flare.

	-- The sunrise, once the night is won. Must run above the freeze below, since
	-- that freeze is exactly what it is playing over.
	self:_updateDawn(dt)

	-- If an exit-to-startup load is in flight, switch to it the moment it is ready.
	-- Checked before the game-over / paused early-returns below, because Exit is
	-- triggered from the paused menu (where the rest of the frame is frozen).
	if self._loader ~= nil then
		if self._loader.ready then
			if self._loader.succeeded then
				self:gotoStage(self._loader:get())
			end
			self._loader = nil
		end
		return
	end

	-- Night won: freeze the player for the sunrise. Deliberately does not freeze the
	-- enemies -- every one of them was just handed to the rag doll path, and their
	-- controllers have to keep running to make the switch. Their corpses are never
	-- despawned, since the despawn pass is below this return, which is fine: nothing
	-- happens after the victory card but a restart.
	if self._nightOver then
		return
	end

	-- Once dead, freeze gameplay (player control, damage, pickups) and leave the
	-- Game Over banner up. Enemies freeze too (they read context._gameOver).
	if self._gameOver then
		return
	end

	-- Escape toggles pause (edge-triggered). The input mapping keeps updating while
	-- paused, so Escape also resumes. While paused, freeze the rest of the frame;
	-- enemies freeze too (they read context._paused).
	do
		local mapping = self.environment.input.inputMapping
		if mapping ~= nil and mapping:isStatePressed("STATE_PAUSE") then
			self:_setPaused(not self._paused)
		end
	end
	if self._paused then
		return
	end

	-- Cheat shortcuts: G toggles god mode, K kills every zombie in the world. Both are
	-- edge-triggered, so holding the key fires once. Deliberately below the game-over and
	-- paused returns above, so neither does anything while the frame is frozen. Not tied
	-- to the movement block below either, since they work with or without a character.
	do
		local mapping = self.environment.input.inputMapping
		if mapping ~= nil then
			if mapping:isStatePressed("STATE_GOD_MODE") then
				self._godMode = not self._godMode
				self._biteTimer = 0.0   -- so the next real bite spurts immediately
				self._lblGodMode:setText(self._godMode and "GOD MODE" or "")
			end
			if mapping:isStatePressed("STATE_KILL_ALL") then
				self:_killAllEnemies()
			end
		end
	end

	-- Shot cadence and reload. Above the movement block below, which is guarded on
	-- there being a character controller -- the rifle keeps cycling either way.
	self:_updateWeapon(dt)

	-- E takes a relic, puts it down, or places it on the altar.
	do
		local mapping < const > = self.environment.input.inputMapping
		if mapping ~= nil and mapping:isStatePressed("STATE_INTERACT") then
			self:_interact()
		end
	end

	-- Mouse X turns the character (yaw); W/S (STATE_MOVE_Z) move forward/back and
	-- A/D (STATE_MOVE_X) strafe left/right, both relative to the current facing.
	if self._character ~= nil then
		local mapping = self.environment.input.inputMapping
		if mapping ~= nil then
			local strafe = mapping:getStateValue("STATE_MOVE_X")
			local move = mapping:getStateValue("STATE_MOVE_Z")
			local look = mapping:getStateValue("STATE_LOOK_X")
			local lookY = -mapping:getStateValue("STATE_LOOK_Y")
			-- Hold Shift to sprint. maxVelocity tracks the target speed so the character
			-- controller's clamp doesn't cap the sprint. Carrying a relic overrides
			-- both: you shuffle, and no amount of Shift helps.
			local speed = self._walkSpeed
			if self._carried ~= nil then
				speed = self._carrySpeed
			elseif mapping:isStateDown("STATE_SPRINT") then
				speed = self._sprintSpeed
			end
			self._character.maxVelocity = speed
			local lookSensitivity = 0.005   -- radians per pixel of mouse motion
			-- STATE_LOOK_* are per-frame mouse deltas (pixels) -- do NOT scale by dt.
			self._heading = self._heading + look * lookSensitivity
			-- Mouse Y pitches the aim. Screen-Y grows downward, so moving the mouse up
			-- (negative delta) should aim up: subtract. Clamp so you cannot over-rotate.
			local pitchDelta = lookY * lookSensitivity
			if self._invertPitch then pitchDelta = -pitchDelta end
			self._pitch = self._pitch - pitchDelta
			if self._pitch < self._pitchMin then self._pitch = self._pitchMin end
			if self._pitch > self._pitchMax then self._pitch = self._pitchMax end
			self._character.headAngle = self._heading
			local heading = Quaternion.fromEulerAngles(self._heading, 0.0, 0.0)
			local forward = heading * Vector4(0.0, 0.0, 1.0, 0.0)
			local right = heading * Vector4(1.0, 0.0, 0.0, 0.0)

			-- STATE_MOVE_X is A(+1)/D(-1); negate so D strafes right, A strafes left.
			local velocity = forward * (move * speed) + right * (-strafe * speed)
			self._character:move(velocity, false)

			local jumped = false
			if mapping:isStatePressed("STATE_JUMP") then
				if self._character:jump() then
					jumped = true
				end
			end

			-- Left mouse button fires (edge-triggered, one shot per click).
			if mapping:isStatePressed("STATE_FIRE") then
				self:_fireWeapon()
			end

			if self._poseController ~= nil then
				local moving = move > 0.1 or move < -0.1 or strafe > 0.1 or strafe < -0.1
				self._poseController:setParameterValue("moving", moving)
				self._poseController:setParameterValue("jump", jumped)
			end
		end
	end

	-- Health and ammo pickups collect themselves now: each carries a Pickup
	-- ScriptComponent (Scripts/Pickup, subclassed by HealthPickup / AmmoPickup) that
	-- notices the player walking over it and applies its effect straight to this
	-- stage. (Treasure pickups and their HUD counter have been removed.)

	-- Enemy contact damage: every enemy within hurt range drains health, and
	-- multiple enemies stack. Reaching zero ends the game and shows the banner.
	-- God mode (G) skips the whole thing -- the scan's only output is the drain, so
	-- there is nothing to compute. Zombies still crowd and still play their bite
	-- animation, which EnemyController drives off context._hurtRange independently.
	if self._humanoid ~= nil and not self._godMode then
		local world = self.world.world
		if world ~= nil then
			local pp = self._humanoid.transform.translation
			local dps = 0.0
			local i = 0
			while true do
				local e = world:getEntity("Enemy", i)
				if e == nil then
					break
				end
				-- Dead (ragdolling) zombies no longer bite.
				if self._deadEnemies[e] == nil then
					local ep = e.transform.translation
					local d = ep - pp
					-- Compare a distance against a distance: _hurtRange is in metres, so
					-- squaring it here would silently scale the bite range by _hurtRange
					-- for any value other than 1. Both operands are translations (w = 1),
					-- so d.w is 0 and length is the plain origin-to-origin distance across
					-- all three axes -- the same measure EnemyController reads back off
					-- context._hurtRange to decide when to play its attack animation.
					if d.length < self._hurtRange then
						dps = dps + self._enemyDps
					end
				end
				i = i + 1
			end
			if dps > 0.0 then
				self._health = self._health - dps * dt
				-- Spurt blood while being eaten: raise the Humanoid's "blood" event on a
				-- timer, each raise spawning a short blood-splatter effect at the player.
				if self._bloodEvents ~= nil then
					self._biteTimer = self._biteTimer - dt
					if self._biteTimer <= 0.0 then
						self._bloodEvents:raise("blood")
						self._biteTimer = 0.3
					end
				end
				if self._health <= 0.0 then
					self._health = 0.0
					self._gameOver = true
					-- Let go of the relic, or it hangs in the air where the player's
					-- hands were: postUpdate stops running once _gameOver is set. The
					-- relic drops itself (Relic:drop); the stage just lets go of it.
					if self._carried ~= nil then
						local sc < const > = self._carried:getComponent(traktor.world.ScriptComponent)
						if sc ~= nil then
							sc:drop(self)
						end
						self._carried = nil
					end
					-- Show the Game Over menu and free the mouse cursor so its
					-- Restart / Exit buttons are clickable (as the pause menu does).
					self._gameOverDialog:show()
					self.environment.input.inputSystem:setExclusive(false)
					self.environment.render.renderView:showCursor()
				end
			else
				self._biteTimer = 0.0   -- reset so the next bite spurts immediately
			end
		end
	end

	-- Apply each fresh kill's knockback the moment its rag doll controller becomes active.
	-- getPoseControllersOf only descends the state graph's *current* state, so the list is
	-- empty for living zombies and during the blend, and becomes non-empty once the "dead"
	-- state is current (after reset). That naturally waits for the right frame; we then
	-- impulse every rag doll controller found and forget the pending entry.
	do
		for e, rec in pairs(self._pendingImpulse) do
			local skeleton = e:getComponent(traktor.animation.SkeletonComponent)
			if skeleton ~= nil then
				local ragdolls = skeleton:getPoseControllersOf(traktor.animation.RagDollPoseController)
				if ragdolls.size > 0 then
					for i = 0, ragdolls.size - 1 do
						ragdolls:get(i):addImpulseAt(rec.point, rec.impulse)
					end
					self._pendingImpulse[e] = nil
				end
			end
		end
	end

	-- Despawn ragdoll corpses once their lifetime elapses (also frees their physics bodies).
	do
		local world = self.world.world
		local remove = {}
		for e, life in pairs(self._deadEnemies) do
			life = life - dt
			if life <= 0.0 then
				remove[#remove + 1] = e
			else
				self._deadEnemies[e] = life
			end
		end
		for k = 1, #remove do
			local corpse = remove[k]
			self._deadEnemies[corpse] = nil
			self._pendingImpulse[corpse] = nil
			if world ~= nil then
				world:removeEntity(corpse)
				-- removeEntity only detaches the entity from the world; it does NOT tear
				-- down its components. Dynamic physics bodies (the rag doll limbs) keep
				-- simulating until Body::destroy runs, which only happens when the entity
				-- is destroyed. So destroy it explicitly to free the bodies immediately.
				corpse:destroy()
			end
		end
	end

	-- Update HUD. The bar animates itself from here on (see the :update calls at
	-- the top of this function); this only hands it the current health.
	self._healthBar:setValue(self._health / self._maxHealth)
end

-- postUpdate runs after every entity has updated this frame, so the camera follows the
-- player's *post-update* position -- no one-frame lag behind the character.
function Main:postUpdate(info)
	if self._gameOver or self._paused then
		return
	end

	-- First-person: the camera sits at the eye and looks along the aim (heading+pitch).
	-- It rides the player rigidly (position is already smooth via the character controller)
	-- so there is no boom, no follow smoothing and no view-blocking ray to worry about.
	if self._camera ~= nil and self._humanoid ~= nil then
		local eye = self._humanoid.transform.translation + Vector4(0.0, 1.6, 0.0, 0.0)
		local aim = Quaternion.fromEulerAngles(self._heading, self._pitch, 0.0)
		local fwd = aim * Vector4(0.0, 0.0, 1.0, 0.0)
		self._camera.transform = Transform.lookAt(eye, eye + fwd, Vector4(0.0, 1.0, 0.0, 0.0))
	end

	-- First-person view-model: hold the weapon just in front of the eye, offset to
	-- the lower right, rotated by the full aim (heading+pitch) so it (and its muzzle
	-- bolt) track exactly where the camera looks.
	if self._weapon ~= nil then
		local aim = Quaternion.fromEulerAngles(self._heading, self._pitch, 0.0)
		local eye = self._humanoid.transform.translation + Vector4(0.0, 1.6, 0.0, 0.0)
		local offset = Vector4(0.18, -0.22, 0.35, 0.0)

		-- Carrying a relic no longer stows the rifle -- the player can still shoot. The
		-- off hand is full holding the relic on the left, so the rifle just rides a
		-- little further right to make room for it.
		if self._carried ~= nil then
			offset = offset + Vector4(0.12, 0.0, 0.0, 0.0)
		end

		-- Drop the rifle out of the sightline and roll it over while reloading: it eases
		-- all the way down and back up across _reloadTime. It is the tell that costs the
		-- player -- it is obvious the gun cannot be fired, and roughly how much longer
		-- that lasts. Still plays with a relic in the off hand.
		local dip = 0.0
		if self._reloadTimer > 0.0 then
			dip = math.sin((1.0 - self._reloadTimer / self._reloadTime) * math.pi)
		end
		if dip > 0.0 then
			offset = offset + Vector4(0.06, -0.3, -0.14, 0.0) * dip
			aim = aim * Quaternion.fromEulerAngles(0.0, -0.9 * dip, 0.6 * dip)
		end

		self._weapon.transform = Transform(eye + aim * offset, aim)
	end

	-- Carried relic: held up in the player's left hand, off to the left so it clears
	-- both the rifle on the right and the aim straight down the middle. Its pitch is
	-- damped so looking around does not swing it through the camera.
	if self._carried ~= nil and self._humanoid ~= nil then
		local aim < const > = Quaternion.fromEulerAngles(self._heading, self._pitch * 0.35, 0.0)
		local eye < const > = self._humanoid.transform.translation + Vector4(0.0, 1.6, 0.0, 0.0)
		self._carried.transform = Transform(eye + aim * Vector4(-0.38, -0.5, 0.62, 0.0), aim)
	end
end

function Main:reload()
	self._humanoid = nil
	self._camera = nil
	self._weapon = nil
	self._fireEvents = nil
	self._altar = nil
	-- Ward records hold live entity handles, so they have to be re-resolved.
	-- resolve() restores which of them burn from _wardsLit, which survives.
	self._wards = nil
end

]]></text>
</object>
