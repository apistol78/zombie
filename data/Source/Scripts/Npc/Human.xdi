<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{6E9AD100-0000-4000-8000-000000000010}
#using \{4E9C0000-0000-4000-8000-000000000001}

import(traktor)

-- Human: a living character placed in the scene -- the wanderer, the merchant and the worker
-- of Scripts/Npc/Npc. Three states:
--
--   * ROUTINE -- what it does when the night leaves it alone, by class:
--       wanderer  walks its `route` (Scripts/Npc/Route), or with none ambles about the spot
--                 it was placed on, never more than Config.npc.strayRadius from it.
--       merchant  stands where it was placed, facing the way it was placed. Selling is to come;
--                 for now E talks to it.
--       worker    the same, at its work (the graph's "work" state) -- the smith at the anvil,
--                 the woodcutter at the block.
--     Talked to (:talk), any of them stops and faces the player for a few seconds.
--
--   * FIGHT -- goes for a character it hates (Config.npc.factions), one that has hurt it, or the
--     player once the player has made an enemy of it (`hostility`). Chases at a run and swings
--     at it in reach (:_swing, the graph's Attack clip).
--
--   * FLEE -- runs from whatever frightens it: too hurt for its courage, or more of them than
--     its courage will stand. Leg by leg away from the threat, until it has gone a few seconds
--     without seeing it. A shot heard nearby frightens it too, and the timid run from that alone.
--
-- Which of fight and flee is decided afresh every perception sample, so a villager that
-- squares up to one zombie runs when the second arrives, and turns back once it is hurt less
-- than it is angry. Back in ROUTINE it walks back to its post or route on its own.
--
-- Attach to an entity named "Npc" with an AiCharacterComponent and an animated mesh whose
-- graph takes "moving", "running", "attack", "hit", "dead" and "work" (Entities/NPC/AG - Villager,
-- Entities/NPC/Hunter Female/AG - Hunter Female). A graph may leave any of them out: setting a
-- parameter it does not have does nothing.

Human = Human or class("Human", Npc)

-- A vector's components, free for any position this step's crowd has read (Npc:_crowd).
local xyz < const > = Npc.xyz

-- Handed out one after another as characters are made, so the ones thinking less far off
-- (Human:_coast) spread their thinking over the updates rather than all doing it on the same one.
local lodPhase = 0

local NPC < const > = Config.npc
local ATTACK < const > = NPC.attack
local CLOSE_QUARTERS < const > = Config.enemy.closeQuarters

-- Awareness dot (see the debug block in update), as the horde's: white going about its day,
-- cyan talking to the player, red fighting, yellow running.
local DEBUG_DOT_HEIGHT < const > = 2.1
local DEBUG_DOT_SIZE < const > = 5.0
local DEBUG_C_ROUTINE < const > = Color4f(0.85, 0.85, 0.85, 1.0)
local DEBUG_C_ATTEND < const > = Color4f(0.20, 0.80, 0.90, 1.0)
local DEBUG_C_FIGHT < const > = Color4f(1.0, 0.12, 0.06, 1.0)
local DEBUG_C_FLEE < const > = Color4f(1.0, 0.90, 0.10, 1.0)

-- The timid run from a shot alone; braver ones only take fright at it.
local SHOT_FLEE_COURAGE < const > = 0.35

-- How square the player has to be looking at a character to count as noticing them (see
-- _lookedAt): the cosine of the half-angle of that cone, so 0.75 is about 41 degrees either
-- side -- closer to "actually looking at them" than "somewhere in front of the player". Was
-- 0.4 (a touch over 60 degrees either side), which caught anyone merely facing their general
-- direction.
local NOTICE_FOV < const > = 0.75

function Human:new()
	Npc.new(self)
	self._class = "wanderer"
	self._usesWork = true       -- the graph has a "work" state (see Npc:_stagger)

	-- The Hunters' graphs have no hit reaction, so a hard blow only stops them for a moment
	-- rather than for the length of the horde's Hit animation (Npc:flinch), and they stand it
	-- out in Idle (Npc:_stagger).
	self._flinchTime = 0.5
	self._reelPose = "idle"

	self._state = "routine"     -- "routine" | "fight" | "flee"
	self._target = nil          -- what FIGHT is after (an entity; may be the player)
	self._swinging = false      -- the blow being swung, while one is (see _swing)
	self._turn = false          -- the turn clip being played, while one is (see _turnOnTheSpot)
	self._seenTimer = 0.0       -- FIGHT gives up this long after last seeing it (s)
	self._fleeFrom = nil        -- where the threat FLEE is running from was last seen (Vector4)
	self._calmTimer = 0.0       -- FLEE ends once this has run out well clear of the threat (s)
	self._attend = 0.0          -- facing the player after being talked to (s)
	self._noticeTimer = 0.0     -- how long _noticing has held so far (s); see _routine
	self._noticeTired = false   -- noticeTime ran out; ignored again until the player backs off
	self._heardShot = nil       -- the last shot's sequence number, as the horde keeps it
	self._wanderWait = 0.0      -- an aimless wanderer's pause between legs (s)
	self._wanderTarget = nil

	-- Thinking less far off (see _coast).
	lodPhase = lodPhase + 1
	self._lodPhase = lodPhase
	self._lodCount = 0          -- updates seen
	self._lodOwed = 0.0         -- time coasted through since it last thought (s)
	self._lodSteps = 0          -- ...and in how many updates
end

-- ---- What the Stage asks ----

-- Whether E may talk to it: standing, not in the middle of a fight or a flight, and not set
-- against the player.
function Human:canTalk(context)
	return not self._dead and self._state == "routine" and not self:hatesPlayer()
end

-- Talked to: stop to face the player for a while. What it says is its actor's dialog's.
--
-- Stood still for it at once. The conversation holds the world (Main:_holdForPanel) and this
-- brain with it, so whatever the graph is showing now is shown until it ends -- a walker caught
-- mid-stride stood frozen in it throughout. A turn or a swing already under way plays out, and
-- then it turns to face the player for the conversation (:_hold).
function Human:talk(context)
	self._attend = NPC.attendTime
	self:_dropPath()
	-- The body stops dead with nothing driving it, so it is no longer walking, whatever the gait
	-- last measured -- which would keep :_turnOnTheSpot from starting.
	self._gaitSpeed = 0.0
	self._gaitMoving = false
	if not self._turn and not self._swinging and self._pose ~= nil then
		self:_poseState("idle")
		self:_poseWork(false)
	end
end

function Human:state()
	return self._state
end

-- ---- Deciding ----

-- Fight or flee from `foe`, at `dist`, with `count` hostiles about. See the top of the file.
-- A fight is only started inside engageRange, unless `provoked` (it has just hurt us) or it is
-- already the one being fought; further out a foe can frighten but not draw a charge.
function Human:_face(foe, dist, threat, context, provoked)
	-- The one being faced counts whatever its distance: `threat` is only the ones close by, and
	-- a timid pedlar does not square up to a bandit because he is still twenty metres off.
	threat = math.max(threat, self:_threatOf(foe, context))
	local hurt < const > = self:healthFraction() < (1.0 - self._courage) * NPC.fleeHealth
	if hurt or threat > self._courage then
		if self._state ~= "flee" then
			self:_setMood("scared")
			self._repathTimer = 0.0
			self:_dropPath()
		end
		self._state = "flee"
		self._target = nil
		self._fleeFrom = self:_positionOf(foe)
		self._calmTimer = NPC.calmTime
	else
		local fighting < const > = self._state == "fight" and self._target == foe
		if not fighting and not provoked and dist > NPC.engageRange then
			return
		end
		if not fighting then
			self:_setMood("angry")
			self._repathTimer = 0.0
		end
		self._state = "fight"
		self._target = foe
		self._seenTimer = NPC.forgetTime
	end
	self._attend = 0.0
end

-- One perception sample: who is about that it hates, can it see them, and what does it do
-- about it. A few times a second, as the horde samples, since it costs rays.
function Human:_perceive(context, pos, playerPos, pdist)
	local range < const > = NPC.sightRange

	-- Whoever just hurt it is seen, whatever the rays would say: nobody takes a blow and
	-- wonders where it came from.
	local provoked < const > = self._provoked or nil
	self._provoked = false

	local foe, foeDist, threat = self:_nearestHated(context, pos, range, nil, NPC.threatRange)
	if foe ~= nil and not self:_sees(context, pos, self:_positionOf(foe)) then
		foe, foeDist = nil, math.huge
	end
	if self:hatesPlayer() and pdist < range and pdist < (foeDist or math.huge) and self:_sees(context, pos, playerPos) then
		foe, foeDist = self._player, pdist
		threat = threat + self:_threatOf(self._player, context)
	end
	if provoked ~= nil and self:_standing(context, provoked) then
		foe = provoked
		foeDist = (self:_positionOf(provoked) - pos).length
	end

	if foe ~= nil then
		self:_face(foe, foeDist, threat, context, foe == provoked)
	end
	if self._state == "fight" and self._target ~= nil and self._target ~= foe
		and self:_sees(context, pos, self:_positionOf(self._target)) then
		-- Nothing new it went for, but the one it is already after is still in view.
		self._seenTimer = NPC.forgetTime
	end

	-- A shot nearby: frightening, if it is not already busy with something worse. The timid
	-- run from it; the rest only take fright.
	local shot < const > = context._gunshot
	if shot ~= nil and shot.seq ~= self._heardShot then
		self._heardShot = shot.seq
		local px < const >, py < const >, pz < const > = xyz(pos)
		local hx < const > = shot.x - px
		local hz < const > = shot.z - pz
		if self._state == "routine" and hx * hx + hz * hz < NPC.hearRange * NPC.hearRange then
			if self._mood ~= "angry" then
				self:_setMood("scared")
			end
			if self._courage < SHOT_FLEE_COURAGE then
				self._state = "flee"
				self._fleeFrom = Vector4(shot.x, py, shot.z, 1.0)
				self._calmTimer = NPC.calmTime
				self._attend = 0.0
				self._repathTimer = 0.0
					self:_dropPath()
			end
		end
	end
end

-- ---- Each state's destination ----

-- Whether the player is roughly facing this character, as opposed to merely close to them.
-- Proximity alone used to be the whole of noticeRange's test, which caught a player who was
-- simply standing nearby without looking -- routine right after the two of them have just
-- fought off the same zombie together, with the player's back turned looting the body -- and
-- held a wanderer frozen facing them instead of getting back to its route. Pure distance has
-- no way to tell "being looked at" from "merely standing near", so this is read alongside it.
function Human:_lookedAt(context, pos, pdist)
	if pdist < 0.0001 then
		return true
	end
	local px < const >, _, pz < const > = xyz(pos)
	local qx < const >, _, qz < const > = xyz(self:_positionOf(self._player))
	local aim < const > = context:aimDirection()
	return (px - qx) * aim.x + (pz - qz) * aim.z > pdist * NOTICE_FOV
end

-- Where ROUTINE is walking to this frame, or nil to stand. Issues path queries as it goes.
--
-- Someone who has just been spoken to, or who has the player standing close by and looking at
-- them, stops whatever they were doing and faces them (see update). Only in ROUTINE: a villager
-- running from a zombie does not stop to look at anyone, and one fighting is already facing
-- what it is fighting.
-- Entered at noticeRange and let go a little further out, so a player standing on the line
-- does not have them stopping and starting.
function Human:_routine(context, pos, pdist, deltaTime)
	local near < const > = NPC.noticeRange + (self._noticing and NPC.noticeSlack or 0.0)
	local inRange < const > = pdist < near and self:_lookedAt(context, pos, pdist)
	if not inRange then
		-- Actually stepped back out, not just timed out while still standing there: forget
		-- the stand, so coming close again later is a fresh notice rather than an instant
		-- re-trigger of one noticeTime just ended.
		self._noticeTimer = 0.0
		self._noticeTired = false
	end
	self._noticing = inRange and not self._noticeTired and not self:hatesPlayer()
	if self._noticing then
		-- Capped, or a player who simply stays put nearby -- routine right after the two of
		-- them have just fought off the same thing together -- held this frozen off its route
		-- for good: distance alone never stopped being true. _noticeTired latches until the
		-- player actually backs out past the slack above, so holding ground does not start
		-- the glance over again the very next frame.
		self._noticeTimer = self._noticeTimer + deltaTime
		if self._noticeTimer >= NPC.noticeTime then
			self._noticeTired = true
			self._noticing = false
		end
	end
	if self._attend > 0.0 or self._noticing then
		self._attend = math.max(0.0, self._attend - deltaTime)
		self:_dropPath()
		return nil
	end

	if self._class == "wanderer" then
		if self:_route(context) ~= nil then
			local point < const >, waiting < const > = self:_routeStep(pos, deltaTime)
			if waiting then
				self:_dropPath()
				return nil
			end
			return point
		end

		-- No route: amble about the spot it was placed on, a short leg at a time.
		if self._wanderWait > 0.0 then
			self._wanderWait = self._wanderWait - deltaTime
			return nil
		end
		local px < const >, _, pz < const > = xyz(pos)
		local goal = self._wanderTarget
		if goal ~= nil then
			local dx < const > = self._wanderX - px
			local dz < const > = self._wanderZ - pz
			if dx * dx + dz * dz < NPC.arrive * NPC.arrive then
				goal = nil
				self._wanderWait = 2.0 + math.random() * 4.0
				self:_dropPath()
			end
		end
		if goal == nil and self._wanderWait <= 0.0 then
			goal = self:_randomPoint(self._post.x, self._post.y, self._post.z, NPC.strayRadius)
			self._repathTimer = 0.0
			if goal ~= nil then
				self._wanderX, self._wanderZ = goal.x, goal.z   -- read the once, for the arrival test above
			end
		end
		self._wanderTarget = goal
		return goal
	end

	-- Merchant, worker: back to the post, then stand at it.
	local px < const >, _, pz < const > = xyz(pos)
	local dx < const > = self._postX - px
	local dz < const > = self._postZ - pz
	if dx * dx + dz * dz > NPC.arrive * NPC.arrive then
		return self._post
	end
	self:_dropPath()
	return nil
end

-- Where FLEE is running to: a leg of up to fleeLeg metres away from the threat, re-drawn on
-- arrival or every couple of seconds, so a pursuer that comes round is run from again.
--
-- Straight away from the threat is often straight into a wall, a fence or the edge of the mesh,
-- and running at it pinned a frightened villager in a corner to be eaten. So the leg is chosen
-- rather than aimed: seven headings fanned out from "away" (straight, then 45, 90 and 135
-- degrees either side), each walked out along the mesh surface (the same constrain query
-- :_onMesh probes with, only fleeLeg long), and the one whose reachable end lies furthest from
-- the threat wins. A heading that is blocked within a couple of metres hardly counts at all,
-- so a fence is run along rather than into. With no route yet to ask through, it falls back on
-- straight away.
local FLEE_FAN < const > = { 0.0, 0.785, -0.785, 1.571, -1.571, 2.356, -2.356 }

function Human:_fleeGoal(pos)
	local from < const > = self._fleeFrom
	local px < const >, py < const >, pz < const > = xyz(pos)
	local fx < const >, _, fz < const > = xyz(from)
	local ax = px - fx
	local az = pz - fz
	local al < const > = math.sqrt(ax * ax + az * az)
	if al < 0.001 then
		ax, az = math.sin(self._heading), math.cos(self._heading)
	else
		ax, az = ax / al, az / al
	end

	local query < const > = self._pathQuery
	if query ~= nil then
		local away < const > = (math.atan2 or math.atan)(ax, az)
		local best, bestScore = nil, -math.huge
		for _, turn in ipairs(FLEE_FAN) do
			local h < const > = away + turn
			local want < const > = Vector4(px + math.sin(h) * NPC.fleeLeg, py, pz + math.cos(h) * NPC.fleeLeg, 1.0)
			local reached < const > = query:constrain(pos, want)
			if reached ~= nil then
				local rx < const >, rz < const > = reached.x, reached.z
				local mx < const >, mz < const > = rx - px, rz - pz
				local tx < const >, tz < const > = rx - fx, rz - fz
				local score = math.sqrt(tx * tx + tz * tz)
				if mx * mx + mz * mz < 4.0 then
					score = score - 100.0
				end
				if score > bestScore then
					best, bestScore = reached, score
				end
			end
		end
		if best ~= nil then
			return best
		end
	end

	local x < const > = px + ax * NPC.fleeLeg
	local z < const > = pz + az * NPC.fleeLeg
	return self:_randomPoint(x, py, z, 3.0) or self:_ground(x, z, py)
end

-- Into -pi..pi.
local function wrap(a)
	return (a + math.pi) % (math.pi * 2.0) - math.pi
end

-- A character standing still that has to face a long way round steps round with one of the
-- turn clips rather than pivoting on its heels (Config.npc turnMin, turn180At, turns). Only in
-- ROUTINE, standing (no `goal`) with something to face within `faceRange` -- the player who has
-- come close or spoken to it, the way its post faces -- and only once it has actually stopped;
-- anything smaller is left to Npc:_drive's turn rate, which reads fine for a small correction.
--
-- The clip's own turn and step are taken out of it on import and handed back as root motion
-- (Npc:_applyRootMotion, every frame), so the heading turns exactly as the clip turns, when it
-- turns, and the feet stay where it plants them -- this only picks the clip and holds it. It ends
-- facing about where it had to (the clips turn ~90/~175 degrees, not exactly the gap), and the
-- little that is left over is Npc:_drive's to finish. Nothing else is done while it runs -- no
-- steering, no crowd -- and anything more pressing (a fight, a flight, somewhere to go) drops it.
-- Returns whether a turn is running, in which case the frame is the turn's.
function Human:_turnOnTheSpot(pos, goal, face, faceRange, deltaTime)
	if self._turn and (self._state ~= "routine" or goal ~= nil) then
		self._turn = false
	end

	if not self._turn then
		if self._state ~= "routine" or goal ~= nil or face == nil or self._gaitMoving then
			return false
		end
		local px < const >, py < const >, pz < const > = xyz(pos)
		local fx < const >, fy < const >, fz < const > = xyz(face)
		local dx < const >, dy < const >, dz < const > = fx - px, fy - py, fz - pz
		if dx * dx + dy * dy + dz * dz >= faceRange * faceRange then
			return false
		end
		local desired < const > = (math.atan2 or math.atan)(dx, dz)
		local delta < const > = wrap(desired - self._heading)
		if math.abs(delta) < NPC.turnMin then
			return false
		end
		-- Heading grows to the right (facing is sin/cos of it, x right and z ahead).
		local clip < const > = (delta < 0.0 and "turnLeft" or "turnRight") .. (math.abs(delta) >= NPC.turn180At and "180" or "90")
		self._turn = { flag = clip, t = 0.0, duration = NPC.turns[clip], release = NPC.turnRelease }
	end

	if self:_playClip(self._turn, pos, deltaTime) then
		self._turn = false
	end
	return true
end

-- Turn toward `face` on the spot at the face turn rate: what is left after a turn clip, or a gap
-- too small for one -- what Npc:_drive does for the same, where it is not running (:_hold).
function Human:_turnTowards(face, pos, deltaTime)
	local px < const >, _, pz < const > = xyz(pos)
	local fx < const >, _, fz < const > = xyz(face)
	local delta < const > = wrap((math.atan2 or math.atan)(fx - px, fz - pz) - self._heading)
	local step < const > = self._faceTurnRate * deltaTime
	self._heading = self._heading + math.max(-step, math.min(step, delta))
	self._character.headAngle = self._heading
end

-- One frame of a one-shot clip -- a turn, a swing -- being played out. `clip` is { flag, t,
-- duration, release }: its flag is held until `release` before the end and then let go to Idle,
-- so the graph blends back rather than starting the clip over -- a one-shot clip whose flag is
-- still up when it ends simply plays again. The clip's own root motion is all the movement there
-- is (Npc:_applyRootMotion), and that is not walking: the gait is held at a standstill
-- throughout, or it reads the step as a pace and Walk flashes in as the clip ends. Returns
-- whether the clip has ended.
function Human:_playClip(clip, pos, deltaTime)
	clip.t = clip.t + deltaTime
	self._gaitPos = pos
	self._gaitSpeed = 0.0
	self._gaitMoving = false
	if self._pose ~= nil then
		self:_poseState((clip.t < clip.duration - clip.release) and clip.flag or "idle")
		self:_poseWork(false)
	end
	return clip.t >= clip.duration
end

-- A blow is a swing of the graph's Attack clip -- the hook, Config.npc.attack -- played out the
-- way a turn clip is (:_playClip). In reach of what it is fighting one is started every
-- strikeInterval, and nothing else is done while it runs -- no steering, no crowd -- so the lunge
-- the clip carries (its root motion, Npc:_applyRootMotion) is the whole of the movement. The blow
-- itself lands at `hitAt`, where the fist is out, on whatever was swung at: not measured again,
-- since the swing was aimed when that was in reach, only checked to still be standing
-- (Npc:_blow). The player is drained as the horde drains them (Npc:_strike), every frame in
-- reach, so against the player the swing is only the look of it. A shove drops a swing (see
-- update). Returns whether a swing is running, in which case the frame is the swing's.
--
-- A swing is only started at something within NPC.strikeArc of the facing; until then the timer
-- waits and the frame is left to Npc:_drive, which turns to the target up close. The swing then
-- keeps turning to it (:_turnTowards), or a target that moved during the clip was punched past.
function Human:_swing(context, pos, target, tpos, deltaTime)
	local px < const >, py < const >, pz < const > = xyz(pos)
	local tx, ty, tz = 0.0, 0.0, 0.0
	if tpos ~= nil then
		tx, ty, tz = xyz(tpos)
	end
	if self._state == "fight" and tpos ~= nil
		and (tx - px) * (tx - px) + (ty - py) * (ty - py) + (tz - pz) * (tz - pz) < self._reach * self._reach then
		if target == self._player then
			context:hurtPlayer(self._strikeDamage / self._strikeInterval * deltaTime)
		end
		self._strikeTimer = self._strikeTimer - deltaTime
		local aim < const > = wrap((math.atan2 or math.atan)(tx - px, tz - pz) - self._heading)
		if self._strikeTimer <= 0.0 and not self._swinging and math.abs(aim) < NPC.strikeArc then
			self._strikeTimer = self._strikeInterval
			self._swinging = {
				flag = "attack", t = 0.0, duration = ATTACK.duration, release = ATTACK.release,
				target = target, landed = false
			}
		end
	end

	local swing < const > = self._swinging
	if not swing then
		return false
	end
	local ended < const > = self:_playClip(swing, pos, deltaTime)
	if tpos ~= nil and swing.target == target then
		self:_turnTowards(tpos, pos, deltaTime)
	end

	if not swing.landed and swing.t >= ATTACK.hitAt then
		swing.landed = true
		if swing.target ~= self._player and self:_standing(context, swing.target) then
			self:_blow(context, swing.target)
		end
	end

	if ended then
		self._swinging = false
	end
	return true
end

-- A frame of the world held still -- the pause menu, a window, a conversation, a hive cutscene --
-- which stops this brain but not the world: the animation graph plays on with whatever it was
-- last asked for. So a turn or a swing caught by it is played out here, back to Idle, or its flag
-- stayed up and the clip played again and again for as long as the world was held -- stepping or
-- punching on the spot -- and the root motion is taken as it is played. Left in the skeleton, the
-- root motion of every one of those plays was handed over on the first frame after, in one step:
-- a Hunter talked to mid-swing lunged off fifteen metres when a ten second conversation ended. No
-- blow is struck while the world is held; the swing is only played out.
--
-- One talked to (:talk) then turns to face the player for the conversation, as it would going
-- about its day: a turn clip for the long way round (:_turnOnTheSpot), and the rest of the way
-- on the spot (:_turnTowards). Whatever distance the player is standing at.
function Human:_hold(deltaTime)
	if self._dead or self._heading == nil then
		return
	end
	self:_applyRootMotion(deltaTime)
	local pos < const > = self.owner.transform.translation
	if self._swinging then
		self._swinging.landed = true
		if self:_playClip(self._swinging, pos, deltaTime) then
			self._swinging = false
		end
	elseif self._attend > 0.0 and self._state == "routine" and self._player ~= nil then
		local face < const > = self._player.transform.translation
		if not self:_turnOnTheSpot(pos, nil, face, math.huge, deltaTime) then
			self:_turnTowards(face, pos, deltaTime)
		end
	elseif self._turn then
		if self:_playClip(self._turn, pos, deltaTime) then
			self._turn = false
		end
	end
end

-- Far from the player and simply going about its day, a character does not need to think every
-- update: past Config.npc.lodNear it thinks every second one, past lodFar every fourth -- the
-- engine already evaluates its animation about as seldom out there -- and spends the ones in
-- between walking on with the step it last took (Npc:_drive's), which costs one call. Doing
-- nothing at all is not an option: the Hunters' controllers damp all of their velocity away on
-- any update without a step, so a character left alone for one stops dead.
--
-- Whatever it skipped is made up when it next thinks (see update): every timer runs on the time
-- coasted through as well, its gait is measured over all of it, and its chance of noticing
-- something is that of every update it skipped. Anything that matters right away -- a fight, a
-- flight, a blow, a word from the player, a turn or swing being played -- keeps it thinking every
-- update, and a death is caught before this is ever asked. Each character thinks on its own
-- phase of the period (lodPhase), so a village far off does not all think on the same update.
-- Returns whether this update was coasted through.
function Human:_coast(pdist, deltaTime)
	local period = 1
	if pdist > NPC.lodNear and self._state == "routine" and self._attend <= 0.0 and not self._noticing
		and not self._turn and not self._swinging and self._hitTimer <= 0.0 and not self._provoked then
		period = pdist > NPC.lodFar and 4 or 2
	end
	self._lodCount = self._lodCount + 1
	if period == 1 or (self._lodCount + self._lodPhase) % period == 0 then
		return false
	end
	self._lodOwed = self._lodOwed + deltaTime
	self._lodSteps = self._lodSteps + 1
	local step < const > = self._coastStep
	if step then
		self._character:move(step, false)
	end
	return true
end

function Human:update(context, totalTime, deltaTime)
	local me < const > = self._entity or self.owner
	if context == nil or me == nil or (self._world or self.world) == nil then
		return
	end
	self._now = totalTime   -- which step this is, for what is shared between characters (Npc:_crowd)
	if context._gameOver or context._paused then
		self:_hold(deltaTime)
		return
	end
	if self:_checkDead(context) then
		return
	end
	-- A hive cutscene freezes everything outside the hive (EnemyController says why); the
	-- village is never inside one.
	if context._cutscene ~= nil then
		self:_hold(deltaTime)
		return
	end

	self:_stats()
	if not self:_resolve(context) then
		return
	end

	-- Where it stands, and where the player does, as this step's crowd has them (Npc:_where,
	-- Npc:_crowd): vectors whose numbers cost nothing more to read.
	local pos < const >, px < const >, py < const >, pz < const > = self:_where()
	if self._post == nil then
		-- Where it was placed, and facing which way: what a merchant and a worker go back to,
		-- and what an aimless wanderer strays about. Its ground position as plain numbers too,
		-- and the facing as a step ahead, since both are wanted every step -- the point it
		-- faces at its post is worked out in a table of its own (_postFace) rather than by
		-- having the engine add two vectors.
		self._post = pos
		self._postX, self._postZ = px, pz
		self._postHeading = self._heading
		self._aheadX, self._aheadZ = math.sin(self._heading), math.cos(self._heading)
		self._postFace = { x = 0.0, y = 0.0, z = 0.0 }
	end
	local playerPos < const > = self:_positionOf(self._player)
	local qx < const >, qy < const >, qz < const > = xyz(playerPos)
	local pdist < const > = math.sqrt((qx - px) * (qx - px) + (qy - py) * (qy - py) + (qz - pz) * (qz - pz))

	-- Far off with nothing going on: walk on, and think later (see _coast). When it does think,
	-- it is over every update coasted through since it last did.
	if self:_coast(pdist, deltaTime) then
		return
	end
	local stepTime < const > = deltaTime   -- this one update's, for what is delivered within it
	deltaTime = deltaTime + self._lodOwed
	local steps < const > = self._lodSteps + 1
	self._lodOwed, self._lodSteps = 0.0, 0
	self._coastStep = false   -- until Npc:_drive walks a step this update

	self:_tickMood(deltaTime)

	-- Whatever the animation has turned and stepped since the last frame (the turn clips). Over this
	-- update alone, even after coasting through some (see _coast): the clips' travel since the last
	-- think is all handed over now, and the controller keeps none of it for the next update.
	self:_applyRootMotion(stepTime)
	self:_tickRegen(deltaTime)

	if self._target ~= nil and not self:_standing(context, self._target) then
		self._target = nil
	end

	-- A quarter of updates, as the horde samples -- or, over several coasted through, the chance
	-- that any of them would have.
	if math.random() < (steps == 1 and 0.25 or 1.0 - 0.75 ^ steps) then
		self:_perceive(context, pos, playerPos, pdist)
	end

	-- ---- Leaving FIGHT and FLEE ----
	--
	-- A fight ends when the target is down, out of sight long enough to be forgotten, or has
	-- been chased too far from home: a villager sees a bandit off, it does not follow him across
	-- the map -- which, with a bandit that runs and a village that is braver than he is, is
	-- exactly what used to happen.
	--
	-- A flight ends once the character has gone calmTime without seeing anything to run from
	-- (every sighting while still afraid winds it back, see :_face). Not on distance: a
	-- villager cornered somewhere it could not run further from the threat, the threat long
	-- gone, stayed frightened for good.
	if self._state == "fight" then
		self._seenTimer = self._seenTimer - deltaTime
		local strayed = false
		if self._target ~= nil then
			local tx < const >, _, tz < const > = xyz(self:_positionOf(self._target))
			local hx < const >, hz < const > = tx - self._postX, tz - self._postZ
			strayed = hx * hx + hz * hz > NPC.chaseLeash * NPC.chaseLeash
		end
		if self._target == nil or self._seenTimer <= 0.0 or strayed then
			self._state = "routine"
			self._target = nil
			self._repathTimer = 0.0
			self:_dropPath()
		end
	elseif self._state == "flee" then
		self._calmTimer = self._calmTimer - deltaTime
		if self._calmTimer <= 0.0 then
			self._state = "routine"
			self._fleeFrom = nil
			self._repathTimer = 0.0
			self:_dropPath()
		end
	end

	-- ---- Where it looks ----
	--
	-- At whatever it is fighting; nowhere in particular while running for its life (the run's
	-- own head carriage); otherwise it keeps an eye on the player. Not at all from too far off
	-- for the head to be turned anyway (Npc:_lookAtEntity).
	if self._state == "flee" then
		self:_lookAtEntity(context, nil, pdist)
	elseif self._state == "fight" and self._target ~= nil then
		self:_lookAtEntity(context, self._target, pdist)
	else
		self:_lookAtEntity(context, self._player, pdist)
	end

	-- ---- Debug: what is this one doing? ----
	local dbg < const > = context.debug
	local colour < const > = (self._state == "fight" and DEBUG_C_FIGHT)
		or (self._state == "flee" and DEBUG_C_FLEE)
		or (self._attend > 0.0 and DEBUG_C_ATTEND)
		or DEBUG_C_ROUTINE
	if dbg ~= nil then
		dbg:point(pos + Vector4(0.0, DEBUG_DOT_HEIGHT, 0.0, 0.0), DEBUG_DOT_SIZE, colour)
	end

	-- Shoved or flinching: the reel replaces everything below (Npc:_stagger), a turn or a swing
	-- included.
	if self._hitTimer > 0.0 then
		self._turn = false
		self._swinging = false
		self:_stagger(deltaTime)
		return
	end

	-- ---- Where to, and how fast ----
	self:_collectPath()
	self._repathTimer = self._repathTimer - deltaTime

	local speed = self._walkSpeed
	local goal = nil
	local face = nil
	local faceRange = CLOSE_QUARTERS
	local target < const > = self._target
	local tpos < const > = target ~= nil and self:_positionOf(target) or nil

	if self._state == "fight" then
		speed = self._runSpeed
		goal = tpos
		face = tpos
		if self._repathTimer <= 0.0 and self:_canPath() then
			self._repathTimer = 0.5
			local tx < const >, _, tz < const > = xyz(tpos)
			self:_requestPath(pos, self:_ground(tx, tz, py))
		end
	elseif self._state == "flee" then
		speed = self._runSpeed
		if (self._repathTimer <= 0.0 or self._pathQuery == nil) and self:_canPath() then
			self._repathTimer = 2.0
			self:_requestPath(pos, self:_fleeGoal(pos))
		end
		goal = true
	else
		goal = self:_routine(context, pos, pdist, deltaTime)
		if goal ~= nil and self._repathTimer <= 0.0 and self:_canPath() then
			self._repathTimer = 1.5
			local gx < const >, _, gz < const > = xyz(goal)
			self:_requestPath(pos, self:_ground(gx, gz, py))
		end
		if self._attend > 0.0 or self._noticing then
			-- Facing the player who spoke to it, or who has come close.
			face = playerPos
			faceRange = NPC.talkRange * 2.0
		elseif goal == nil and self._class ~= "wanderer" then
			-- At its post: facing the way it was placed (a point just ahead along that heading).
			local f < const > = self._postFace
			f.x, f.y, f.z = px + self._aheadX, py, pz + self._aheadZ
			face = f
			faceRange = 2.0
		end
	end

	-- ---- Striking ----
	if self:_swing(context, pos, target, tpos, deltaTime) then
		return
	end

	-- ---- Turning on the spot ----
	if self:_turnOnTheSpot(pos, goal, face, faceRange, deltaTime) then
		return
	end

	local targetX, targetZ = 0.0, 0.0
	if goal ~= nil then
		targetX, targetZ = self:_steer(pos)
	end
	if dbg ~= nil then
		self:_drawPath(dbg, pos, colour)
	end

	-- The clamp the character controller holds its speed to: this frame's pace, so a stroll is
	-- a stroll and a run is a run (Npc:_drive raises it itself for a push out of the player).
	self:_setMaxVelocity(speed)

	local driving < const > = self:_drive(pos, playerPos, targetX, targetZ, speed, face, faceRange, target ~= self._player and target or nil, deltaTime)

	if self._pose ~= nil then
		-- Walking as the graph sees it is how fast the body is really going (Npc:_gait), not
		-- whether this frame's step happened to clear a threshold.
		local walking < const > = self:_gait(pos, deltaTime, driving)
		self:_poseState(walking and (speed > self._walkSpeed and "running" or "walk") or "idle")
		self:_poseWork(self._class == "worker" and self._state == "routine" and not walking
			and self._attend <= 0.0 and not self._noticing)
	end
end
]]></text>
</object>
