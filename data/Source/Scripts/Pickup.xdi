<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
import(traktor)

-- Pickup
--
-- Base ScriptComponent for anything the player walks over to collect. The base
-- owns the one behaviour every pickup shares -- notice the player is standing on
-- it, and once it is actually taken pop its sparkle, take it out of the world and
-- book its return -- and defers the decisions that differ per kind to the subclass:
--
--   * Pickup:canTake(context) -> bool   whether it may be taken right now
--                                       (default true; override to gate on a
--                                       resource already being full, so a crate
--                                       left on the ground is still there when it
--                                       is finally worth something)
--   * Pickup:take(context)              apply the effect; called only once, and
--                                       only when canTake returned true
--   * Pickup:respawnDelay() -> seconds  how long until it comes back; 0 for a
--                                       pickup that is gone for good
--
-- context is the Stage -- the Main instance -- exactly as in every other
-- update() here, so a subclass reads and writes the player's health or ammo
-- straight off it.
--
-- Attach a *subclass* (never this base) to an entity that has a mesh. A
-- "sparkle" EventSetComponent is optional: the base raises it only if present,
-- so a pickup with no sparkle simply vanishes.

Pickup = Pickup or class("Pickup", traktor.world.ScriptComponent)

-- How close the player's origin must come to the pickup's to count as walked
-- over. This is the radius the Stage used back when the scan lived there.
local TAKE_RANGE < const > = 1.2

function Pickup:canTake(context)
	return true
end

function Pickup:take(context)
end

-- Seconds before a collected pickup is put back where it stood. Zero -- the default
-- -- means it is not: a pickup only returns if its kind says so, which keeps the
-- one-shot ones one-shot without them having to say anything.
function Pickup:respawnDelay()
	return 0.0
end

-- Which entity data a returning pickup is rebuilt from. Its own, in other words -- the
-- guid the scene instances it by. nil (the default) is the other way of saying that this
-- kind does not come back.
--
-- A collected pickup is destroyed rather than kept aside and re-added, so its return is
-- built from scratch like anything else this game spawns; see Main:_respawnLater for the
-- lifetime trap that makes this the safer of the two.
function Pickup:entityData()
	return nil
end

function Pickup:update(context, totalTime, deltaTime)
	if context == nil then
		return
	end

	-- Freeze with the rest of the game: nothing is collected through the pause
	-- menu, after death, or once the night is already won.
	if context._gameOver or context._paused or context._nightOver then
		return
	end

	local player < const > = context._humanoid
	if player == nil then
		return
	end

	-- Within reach? Origin to origin, all three axes, same measure the Stage used.
	local pp < const > = player.transform.translation
	local q < const > = self.owner.transform.translation
	local dx < const > = q.x - pp.x
	local dy < const > = q.y - pp.y
	local dz < const > = q.z - pp.z
	if dx * dx + dy * dy + dz * dz >= TAKE_RANGE * TAKE_RANGE then
		return
	end

	-- Standing on it, but the subclass may still refuse it (health already full,
	-- reserve already capped), in which case leave it to be collected later.
	if not self:canTake(context) then
		return
	end

	self:take(context)

	-- Taken. Pop the sparkle where it stood -- follow=false on the event, so the
	-- burst lingers after the entity is gone -- then remove it. removeEntity while
	-- the world is updating is deferred, so taking itself out mid-update is safe.
	local fx < const > = self.owner:getComponent(traktor.world.EventSetComponent)
	if fx ~= nil then
		fx:raise("sparkle")
	end
	-- Book the return *before* going, since it needs this one's transform: the Stage is the
	-- only thing that can put a pickup back, because an entity outside the world is not
	-- updated and so cannot time its own way back, and nothing can hide one in place
	-- instead (Entity::setState is not scripted, so leaving the world is the only way to
	-- disappear). See Main:_respawnLater, which also gates the return on the player not
	-- standing over the spot.
	context:_respawnLater(self:entityData(), self.owner.transform, self:respawnDelay())

	-- Then go, and go properly. removeEntity while the world is updating is deferred, so
	-- taking itself out mid-update is safe -- and it clears the entity's world pointer
	-- immediately, which is what lets destroy() run here (Entity::destroy refuses to run on
	-- an entity still in a world). Same pair the Spawner uses to despawn a zombie: without
	-- the destroy the components are never torn down, and with a queue holding the entity
	-- instead there was nothing to guarantee it was ever torn down at all.
	self.world:removeEntity(self.owner)
	self.owner:destroy()
end
]]></text>
</object>
