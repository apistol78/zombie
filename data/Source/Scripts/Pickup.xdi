<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using {6E9AD100-0000-4000-8000-000000000010}
#using \{17E40000-0000-4000-8000-000000000001}
import(traktor)

-- Pickup
--
-- Base ScriptComponent for anything lying in the world that goes into the player's pack: a
-- bundle of arrows, a flask, a grenade, a pile of coins, a weapon, a helmet, a key, a relic.
-- What each one *is* comes from Scripts/Items/Items; this owns only how it gets from the ground
-- into the pack (a zombie.Inventory), and back out again.
--
-- Two ways of being taken:
--
--   * Walked over (the default) -- the small things: arrows, food, grenades, coins. Noticed
--     here, every frame, and taken the moment the player stands on one -- but only while the
--     pack has room for it. A full pack leaves it lying there for the trip back, and a nearly
--     full one takes what fits and leaves the rest of the pile.
--   * Taken with E (pressToTake) -- the things worth a decision: a weapon, armour, a key, a
--     relic. These carry a zombie.InteractableComponentData, which says how near the player
--     must be and how it ranks against whatever else E could do there (Main:_whatWouldE); E
--     calls :interact, which takes it through :collect exactly as a walk-over one is taken, so
--     there is one way into the pack.
--
-- Most pickups are this script and nothing else: the entity's ScriptComponentData names it as the
-- class, and a zombie.ItemPickupComponentData beside it says what the pickup is -- the
-- arrow bundle is 12 arrows. A subclass is only for a pickup with behaviour of its own
-- (Scripts/Relic). Either way, this is what is asked, and where each answer comes from:
--
--   itemKind()      the pickup component's item, as its key (Scripts/Items/Items)
--   itemCount()     the pickup component's count
--   pressToTake()   whether the entity is interactable; one that is not is walked over
--
-- What taking one is called to the SpawnOrchestrator -- a key run, a relic run -- is the item's
-- (Items: `event`), and Main:giveItem sends it, so a key taken out of a chest counts exactly as
-- one picked up off the ground does.
--
-- A keepsake (Items: `keep` -- the relic) is never destroyed. Taken, it is hidden and goes into
-- the pack as itself; dropped, the same entity is stood back on the ground (:putDown); spent, it
-- is parked on whatever it was spent on, still hidden (:spend). Invisible is what marks one out
-- of play, and Inventory:holds is what tells the pack's from the spent ones.
--
-- Nothing taken ever comes back. Every pickup is in the world exactly once -- as the scene
-- placed it, or as the player put it down -- so what the night has to offer is what is lying
-- out there and what is shut in the chests, and a crate walked over is a crate spent.
--
-- context is the Stage -- the Main instance -- exactly as in every other update() here.
--
-- A "sparkle" EventSetComponent is optional: raised as one is taken, if it is there.

Pickup = Pickup or class("Pickup", traktor.world.ScriptComponent)

-- How close the player's origin must come to a walk-over one to count as standing on it.
local TAKE_RANGE < const > = Config.pickup.takeRange

-- ---- What it is ----

-- What the entity's ItemPickupComponent says, read once and kept: the books still ask a pickup
-- what it was after it has been taken and its entity is gone (Main:_saveWorld).
function Pickup:_read()
	if self._kind == nil then
		local pickup < const > = (self.owner ~= nil) and self.owner:getComponent(zombie.ItemPickupComponent) or nil
		self._kind = (pickup ~= nil) and Items.keyOf(pickup.item) or false
		self._placed = (pickup ~= nil) and pickup.count or 1
	end
end

-- The item, as its key (Scripts/Items/Items), or nil for a pickup that names no item.
function Pickup:itemKind()
	self:_read()
	return self._kind or nil
end

-- A count set on this one in particular -- what is left of a pile, or a dropped stack -- beats
-- what the scene put there.
function Pickup:itemCount()
	if self._count ~= nil then
		return self._count
	end
	self:_read()
	return self._placed
end

function Pickup:pressToTake()
	return self.owner:getComponent(zombie.InteractableComponent) ~= nil
end

-- E's line for an E one: "TAKE THE BOW", "TAKE 12 ARROWS". Said again whenever the count
-- changes.
function Pickup:_updatePrompt()
	local interactable < const > = self.owner:getComponent(zombie.InteractableComponent)
	if interactable == nil or self:itemKind() == nil then
		return
	end
	local count < const > = self:itemCount()
	if count == 1 then
		interactable.prompt = "TAKE THE " .. Items.describe(self:itemKind(), 1)
	else
		interactable.prompt = "TAKE " .. Items.describe(self:itemKind(), count)
	end
end

function Pickup:isKeepsake()
	local def < const > = Items.get(self:itemKind())
	return def ~= nil and def.keep == true
end

-- ---- Where it came from ----

-- Dropped out of the pack: `count` of it, and not to be walked straight back into the pack --
-- the player is standing next to where it lands, so it waits until they have stepped clear of it
-- once before it can be collected again.
function Pickup:asDropped(count)
	self._count = count
	self._waitClear = true
	self:_updatePrompt()
end

-- What is left of this pile, put back by the stage when the player returns to a world, or a part
-- of one, they had already taken some of (Main:pickupAppeared).
function Pickup:setCount(count)
	self._count = count
	self:_updatePrompt()
end

-- ---- Into the pack ----

-- Put as much of this as fits into the pack. True when anything went; whatever did not fit
-- stays here, as a smaller pile. Used by both ways of taking one -- the walk-over below, and
-- Main's E for the rest -- so there is one way into the pack.
--
-- A hidden one is not there to be taken: a keepsake already in the pack or spent, or a quest
-- item whose quest has not asked for it yet (the scene's zombie.StoryWorldComponent hides it).
function Pickup:collect(context)
	if not self.owner.visible then
		return false
	end
	local kind < const > = self:itemKind()
	if kind == nil or Items.get(kind) == nil then
		return false
	end
	local count < const > = self:itemCount()
	local added < const > = context:giveItem(kind, count, self:isKeepsake() and self.owner or nil)
	if added <= 0 then
		return false
	end
	if added < count then
		self._count = count - added
		self:_updatePrompt()
		-- Booked by the stage too, since this pile forgets it once streamed out (Main:pickupLeft).
		if context.pickupLeft ~= nil then
			context:pickupLeft(self.owner, self._count)
		end
		return true
	end
	self:_taken(context)
	return true
end

-- E at an E one (Main:_interact): into the pack, or a line saying it does not fit.
function Pickup:interact(context)
	if not self:collect(context) then
		context:packFull(self:itemKind())
	end
end

-- All of it is in the pack. Pop the sparkle where it stood -- follow=false on the event, so the
-- burst lingers after the entity is gone -- and then go.
function Pickup:_taken(context)
	local fx < const > = self.owner:getComponent(traktor.world.EventSetComponent)
	if fx ~= nil then
		fx:raise("sparkle")
	end

	-- A keepsake goes into the pack as itself: hidden, and left in the world. See the note at
	-- the top.
	if self:isKeepsake() then
		self:show(false)
		return
	end

	-- The stage keeps the books on what has been taken, so a world left for another stage and
	-- come back to does not lay it out a second time (Main:pickupTaken).
	if context.pickupTaken ~= nil then
		context:pickupTaken(self.owner)
	end

	-- Then go, for good, and go properly. removeEntity while the world is updating is deferred, so
	-- taking itself out mid-update is safe -- and it clears the entity's world pointer
	-- immediately, which is what lets destroy() run here (Entity::destroy refuses to run on an
	-- entity still in a world). Same pair the Spawner uses to despawn a zombie: without the
	-- destroy the components are never torn down.
	self.world:removeEntity(self.owner)
	self.owner:destroy()
end

-- ---- Out of the pack: keepsakes only ----

-- Stand a keepsake back on the ground, at `transform`. Everything else that is dropped is built
-- fresh from its entity data (Main:dropSlot), since only a keepsake is still in the world while
-- it is carried.
function Pickup:putDown(transform)
	self.owner.transform = transform
	self:show(true)
end

-- Spend a keepsake on `target` (an entity): park it there, out of sight. Parked rather than left
-- wherever the player's pack happened to be, because it is still the entity anything positional
-- reads the item off -- a spent relic belongs on the post it bought. Nothing moves it after
-- this: it is no longer in the pack, and only the pack's are carried along.
function Pickup:spend(context, target)
	self.owner.transform = target.transform
	self:show(false)
end

-- Show or hide the item and everything hanging off it. Entity visibility does not carry to the
-- children a GroupComponent holds -- each one is an entity of the world in its own right -- so an
-- item's own little light has to be switched by hand, or a hidden relic leaves its glow burning
-- with nothing to come from.
function Pickup:show(visible)
	self.owner.visible = visible
	local group < const > = self.owner:getComponent(traktor.world.GroupComponent)
	if group == nil then
		return
	end
	local children < const > = group.entities
	for i = 0, children.size - 1 do
		local child = children:get(i)
		child.visible = visible
	end
end

-- ---- Walking over one ----

function Pickup:update(context, totalTime, deltaTime)
	if context == nil then
		return
	end

	-- The first update since this came into being -- placed by the scene, streamed back into the
	-- world or rebuilt by a hot reload: the stage lays it out as its books say, which may be gone
	-- for good (Main:pickupAppeared).
	if not self._appeared then
		self._appeared = true
		if context.pickupAppeared ~= nil and not context:pickupAppeared(self) then
			return
		end
		self:_updatePrompt()
	end

	-- Freeze with the rest of the game: nothing is collected through the pause menu, the
	-- inventory or a chest's window, or after death.
	if context._gameOver or context._paused then
		return
	end

	-- E items wait for the press, and a hidden keepsake is in the pack or spent -- either way,
	-- not something lying here to be walked over.
	if self:pressToTake() or not self.owner.visible then
		return
	end

	local player < const > = context._humanoid
	if player == nil then
		return
	end

	-- Within reach? Origin to origin, all three axes.
	local pp < const > = player.transform.translation
	local q < const > = self.owner.transform.translation
	local dx < const > = q.x - pp.x
	local dy < const > = q.y - pp.y
	local dz < const > = q.z - pp.z
	if dx * dx + dy * dy + dz * dz >= TAKE_RANGE * TAKE_RANGE then
		-- Stepped off it: a dropped one may be collected from here on, and a full pack is
		-- worth saying so about again the next time one is stood on.
		self._waitClear = nil
		self._refused = nil
		return
	end

	if self._waitClear then
		return
	end

	-- Standing on it. A pack with no room for it leaves it here, and says so once per visit
	-- rather than every frame the player stands over it.
	if not self:collect(context) and not self._refused then
		self._refused = true
		context:packFull(self:itemKind())
	end
end
]]></text>
</object>
