<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using {6E9AD100-0000-4000-8000-000000000010}
#using \{8ED12B6C-86D0-4AD1-AC4A-7B5B60AB4AF0}
import(traktor)

-- Relic
--
-- A consecrated cross. Taken with E into the pack, where relics stack, and equipped from there
-- into the off hand -- which is what lets the player light a ward with one: E at a still-dark
-- post with a relic in hand spends it there (Main:_lightWardWithRelic calls :light).
--
-- A Pickup (see Scripts/Pickup), and the one keepsake among them (Items: `keep`): its entity is
-- never destroyed. In the pack it is hidden and rides along with the player, so anything reading
-- its position finds it on them; equipped, the first one in the pack is shown in the off hand (Main
-- poses it from :carryTransform every frame); spent, it is parked on the post it lit.
--
-- What it no longer does is cost the player anything to hold. A relic in hand used to slow the
-- walk, bar the sprint and take the crosshair away; none of that survives -- equipped or not, the
-- player moves and aims exactly as they always do.
--
-- Everything around the item stays with the Stage, which owns it: which wards burn, and the dawn
-- that breaks.

Relic = Relic or class("Relic", Pickup)

local REACH < const > = Config.relic.reachRange   -- how close to a relic to take it (m)

function Relic:itemKind()
	return Items.keyOf(Names.RELIC)
end

function Relic:itemCount()
	return 1
end

function Relic:pressToTake()
	return true
end

function Relic:reach()
	return REACH
end

function Relic:promptTake()
	return "TAKE THE RELIC"
end

-- Light `ward` (one of Main's ward records) with this relic: park it on the post, out of sight,
-- and let the post take light. Safe ground opens up around wherever the player chose to spend
-- this one, whatever was standing on it dies, the forest beyond it speeds up -- and a hive opens
-- somewhere out in that forest. All three read out on the one notice line rather than replacing
-- each other, because they are one event: this is what the relic bought and what it cost.
--
-- The post takes the relic over: it brings up one of its own as it lights (see Scripts/Ward),
-- so which ground has been bought stays legible out in the dark -- which is why this one is put
-- out of sight rather than stood on the ground beside the post's.
--
-- The caller has already taken it out of the pack.
function Relic:light(context, ward)
	self:spend(context, ward.entity)

	local lit < const >, purged < const >, hive < const > = context:_lightWard(ward)
	if lit then
		local notice = "A WARD IS LIT"
		if purged > 0 then
			notice = notice .. "   " .. tostring(purged) .. " TAKEN BY THE LIGHT"
		end
		if hive ~= nil then
			notice = notice .. "   A HIVE STIRS"
		end
		context:_showNotice(notice)
	end

	-- Closing the circle: in the forest that ends the night, in the cave it only clears the cave
	-- (Main:_circleClosed). Checked after the ward, so its notice is replaced by that one rather
	-- than overwriting it.
	if context:_wardsDone() then
		context:_circleClosed()
	end
end

-- Where it rides while equipped, in aim space: the off hand is the left one, so it sits clear of
-- the weapon on the right and of the aim straight down the middle.
function Relic:carryOffset()
	return Vector4(-0.38, -0.5, 0.62, 0.0)
end

function Relic:carryRotation()
	return Quaternion.identity
end

-- The held pose, composed from the two above. It takes the full aim, so the relic rises and
-- drops with the view instead of lagging behind it.
function Relic:carryTransform(context)
	local aim < const > = context:aim()
	return Transform(context:eye() + aim * self:carryOffset(), aim * self:carryRotation())
end
]]></text>
</object>
