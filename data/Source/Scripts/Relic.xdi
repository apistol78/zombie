<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using {6E9AD100-0000-4000-8000-000000000010}
#using \{8ED12B6C-86D0-4AD1-AC4A-7B5B60AB4AF0}
import(traktor)

-- Relic
--
-- A consecrated cross. Taken with E into the pack, where relics stack, and equipped from there
-- into the off hand -- which is what lets the player light a ward with one: E at a still-dark
-- post with a relic in hand spends it there (Ward:interact).
--
-- A Pickup (see Scripts/Pickup), and the one keepsake among them (Items: `keep`): its entity is
-- never destroyed. In the pack it is hidden and rides along with the player, so anything reading
-- its position finds it on them; equipped, the first one in the pack is shown in the off hand (Main
-- poses it from :carryTransform every frame); spent, it is parked on the post it lit.
--
-- What it no longer does is cost the player anything to hold. A relic in hand used to slow the
-- walk, bar the sprint and take the crosshair away; none of that survives -- equipped or not, the
-- player moves and aims exactly as they always do.

Relic = Relic or class("Relic", Pickup)

function Relic:itemCount()
	return 1
end

-- Never walked over, interactable or not: a relic is taken with E or not at all. (The one a lit
-- post shows, Entities/Ward's "SpentRelic", is only a mesh: no pickup, no script.)
function Relic:pressToTake()
	return true
end

-- Where it rides while equipped, in aim space: the off hand is the left one, so it sits clear of
-- the weapon on the right and of the aim straight down the middle.
function Relic:carryOffset()
	return Vector4(-0.38, -0.5, 0.62, 0.0)
end

function Relic:carryRotation()
	return Quaternion.identity
end

-- The held pose, composed from the two above. It takes the full aim, so the relic rises and
-- drops with the view instead of lagging behind it.
function Relic:carryTransform(context)
	local aim < const > = context:aim()
	return Transform(context:eye() + aim * self:carryOffset(), aim * self:carryRotation())
end
]]></text>
</object>
