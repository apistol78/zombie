<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using {6E9AD100-0000-4000-8000-000000000010}
import(traktor)

-- Relic
--
-- A consecrated cross the player carries, one at a time, to whichever ward post they
-- decide to light with it. This component owns only where the relic ends up when it
-- leaves the player's hands:
--
--   * Relic:drop(context)         put it down on the ground in front of the player
--   * Relic:place(context, ward)  hand it over to that ward post, which shows its own
--
-- Both are called by Main -- via entity:getComponent(world.ScriptComponent) -- in
-- place of the old Main:_dropRelic / Main:_placeRelic. context is the Stage (the
-- Main instance), so a dropped relic reads the player straight off it and grounds
-- itself with the Stage's own ground query; ward is one of the Stage's ward records
-- (see Main:resolve), which is what carries the entity to hand it over to.
--
-- Everything around the move stays with the Stage, which owns it: whether a relic
-- is in hand, which wards burn, and the dawn that breaks. Carrying is likewise
-- driven by Main:postUpdate; this only handles letting go.

Relic = Relic or class("Relic", traktor.world.ScriptComponent)

local DROP_AHEAD < const > = Config.relic.dropAhead     -- how far in front of the player a dropped relic lands (m)

-- Put the relic down in front of the player, standing on the ground and facing
-- the way they are. This is the move that buys the rifle back.
function Relic:drop(context)
	local player < const > = context._humanoid
	if player == nil then
		return
	end
	local heading < const > = Quaternion.fromEulerAngles(context._heading, 0.0, 0.0)
	local at < const > = player.transform.translation + heading * Vector4(0.0, 0.0, DROP_AHEAD, 0.0)
	self.owner.transform = Transform(context:_groundAt(at), heading)
end

-- Spend the relic on a ward: hand it over to the post. The ward has a relic of its
-- own standing at the pillar, held dark behind its facade with the flame and brought
-- up the moment it is lit (see Scripts/Ward), so this one is put out of sight rather
-- than stood on the ground -- otherwise the player would be looking at two.
--
-- Parked on the post it bought before it goes: it is still the entity the Stage reads
-- a relic's position off (the minimap dot, the objective compass), so leaving it lying
-- wherever the player's hands happened to be would put that dot beside the post rather
-- than on it. Nothing else moves it afterwards -- carrying is what drives a relic's
-- transform, and this one is no longer carried.
function Relic:place(context, ward)
	if ward == nil then
		return
	end
	self.owner.transform = ward.entity.transform
	self:_setVisible(false)
end

-- Show or hide the relic and everything hanging off it. Entity visibility does not
-- carry to the children a GroupComponent holds -- each one is an entity of the world
-- in its own right -- so the relic's own little light has to be switched by hand, or
-- a hidden relic leaves its glow burning at the post with nothing to come from.
function Relic:_setVisible(visible)
	self.owner.visible = visible
	local group < const > = self.owner:getComponent(traktor.world.GroupComponent)
	if group == nil then
		return
	end
	local children < const > = group.entities
	for i = 0, children.size - 1 do
		local child = children:get(i)
		child.visible = visible
	end
end
]]></text>
</object>
