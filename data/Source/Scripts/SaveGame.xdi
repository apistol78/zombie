<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
import(traktor)

-- SaveGame
--
-- The one saved night, kept through the online session manager's save data
-- (environment.online.sessionManager.saveData) -- with the Local provider the game ships
-- with, a row in a small SQLite database in the user's writable folder.
--
-- What is saved is the same table a stage switch already carries (Main:_carry): the player,
-- the books of every world visited, and which stage they were in. This module knows nothing
-- of what is in it; it only turns a plain Lua table into something the save data can store and
-- back again.
--
-- The save data stores any ISerializable, and the one a script can build is PropertyGroup, so
-- a table becomes a group: each entry is a pair of properties, "k<i>" for the key and "v<i>" for
-- the value, with "n" saying how many there are -- a PropertyGroup cannot list its own names, so
-- the keys have to be written down as values. Keys may be strings or numbers; values strings,
-- numbers, booleans or tables, which nest as groups of their own. Anything else -- an entity,
-- a Transform, a function -- is left out with a warning, so the table handed in must already
-- be plain data. Numbers keep their kind: an integer is stored as a PropertyInteger (32 bits)
-- and anything else as a PropertyFloat (32-bit float), which is plenty for positions and
-- health but not for anything that needs a double.
--
-- Every call guards against the session manager not being there at all (a target without the
-- online module); `available` tells the menus whether to offer saving and continuing.

SaveGame = SaveGame or {}

-- The id of the save in the save data, and the version of what is written under it. A save
-- written by a different version is ignored rather than fed to a game it no longer fits.
local SAVE_ID < const > = "night"
local VERSION < const > = 1

local function saveData(environment)
	if environment == nil then
		return nil
	end
	local online < const > = environment.online
	if online == nil then
		return nil
	end
	local sessionManager < const > = online.sessionManager
	if sessionManager == nil then
		return nil
	end
	return sessionManager.saveData
end

local function encode(value, path)
	local group < const > = PropertyGroup()
	local n = 0
	for k, v in pairs(value) do
		local kt < const > = type(k)
		local vt < const > = type(v)
		if kt ~= "string" and kt ~= "number" then
			print("SaveGame: key of type " .. kt .. " under " .. path .. " left out")
		elseif vt == "table" then
			n = n + 1
			group:setProperty("k" .. n, k)
			group:setProperty("v" .. n, encode(v, path .. "." .. tostring(k)))
		elseif vt == "string" or vt == "number" or vt == "boolean" then
			n = n + 1
			group:setProperty("k" .. n, k)
			group:setProperty("v" .. n, v)
		else
			print("SaveGame: " .. vt .. " at " .. path .. "." .. tostring(k) .. " left out")
		end
	end
	group:setProperty("n", n)
	return group
end

local function decode(group)
	local out = {}
	local n < const > = group:getProperty("n") or 0
	for i = 1, n do
		local k < const > = group:getProperty("k" .. i)
		local v = group:getProperty("v" .. i)
		-- A nested group comes back as the object itself; everything else as its value.
		if type(v) == "table" and v.getProperty ~= nil then
			v = decode(v)
		end
		if k ~= nil then
			out[k] = v
		end
	end
	return out
end

-- Can this target save at all?
function SaveGame.available(environment)
	return saveData(environment) ~= nil
end

-- Is there a night to continue? Asked of the store itself rather than of its enumeration,
-- which is only taken once, when the session manager starts.
function SaveGame.exists(environment)
	local sd < const > = saveData(environment)
	return sd ~= nil and sd:getNow(SAVE_ID) ~= nil
end

-- Write `state` (a plain table), replacing whatever was saved before. Returns whether it went.
function SaveGame.write(environment, state)
	local sd < const > = saveData(environment)
	if sd == nil or state == nil then
		return false
	end
	local ok < const >, result < const > = pcall(function()
		local root < const > = encode({ version = VERSION, state = state }, "save")
		return sd:setNow(SAVE_ID, "No Rest Before Dawn", "The night so far", root, true)
	end)
	if not ok then
		print("SaveGame: write failed; " .. tostring(result))
		return false
	end
	return result == true
end

-- The saved state, or nil if there is none, it cannot be read, or it is from another version.
function SaveGame.read(environment)
	local sd < const > = saveData(environment)
	if sd == nil then
		return nil
	end
	local ok < const >, result < const > = pcall(function()
		local root < const > = sd:getNow(SAVE_ID)
		if root == nil then
			return nil
		end
		return decode(root)
	end)
	if not ok then
		print("SaveGame: read failed; " .. tostring(result))
		return nil
	end
	if result == nil or result.version ~= VERSION or result.state == nil then
		return nil
	end
	return result.state
end

-- Forget the saved night.
function SaveGame.clear(environment)
	local sd < const > = saveData(environment)
	if sd ~= nil then
		sd:remove(SAVE_ID)
	end
end
]]></text>
</object>
