<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{6E9AD100-0000-4000-8000-000000000010}
#using \{17E40000-0000-4000-8000-000000000001}

import(traktor)

-- StageStub
--
-- Scripts/Main as far as Scripts/Views/InventoryView, Scripts/Views/ChestView,
-- Scripts/Views/DialogView and Scripts/Views/JournalView can see it:
-- the `context` both are built with, for their test pages. The story is a real
-- zombie.Story over the page's resource manager (GameScaffolding) -- the game's own,
-- Story/Story, its pack filled with a sample kit -- so the views are tested against the data they
-- read in game, and the talks are the real ones. Only the stage's side of each call is stood in
-- for -- health is a number, a chest is a list kept here, and what Main would put on its feed line
-- or the notice line is printed to the log.
--
-- Mirrors Main's inventory, armor, equipItem, unequipItem, useItem, dropSlot, giveItem,
-- chestContents, takeFromChest and takeAllFromChest, and Scripts/Quests/Questing's story and
-- questLog; keep them in step if those change what they answer. Dropping puts nothing in a world
-- -- there is none -- it only takes the stack out of the pack.

StageStub = StageStub or class("StageStub")

-- The game's story, as Scripts/Quests/Questing has it.
local STORY < const > = Guid("\{D1A20000-0000-4000-8000-000000000001}")

-- The pack's stack in slot `i`, counted from 1 as the cells are (the pack itself counts from 0),
-- as { kind, count } with the item as its key (Scripts/Items/Items), or nil for an empty slot.
local function slotOf(inv, i)
	local s < const > = inv:getSlot(i - 1)
	if s == nil then
		return nil
	end
	return { kind = Items.keyOf(s.item), count = s.count }
end

function StageStub:new(resourceManager)
	self._resourceManager = resourceManager
	self._maxHealth = Config.player.maxHealth
	self._health = self._maxHealth
	self._chests = {}
	self:emptyPack()
end

-- A pack with something in it to preview against: a weapon, its rounds and a grenade. The
-- night itself starts empty-handed (Config.inventory.start), which would leave nothing to look at.
local SAMPLE_KIT < const > = {
	{ Items.RIFLE, 1 },
	{ Items.ROUNDS, 24 },
	{ Items.GRENADE, 1 }
}

-- Start the story again, the pack holding the sample kit and no quest given. A new Story rather
-- than a cleared one, so a view that reads context:inventory() afresh each time (ChestView) sees a
-- pack with no history, while one that kept the old pack (InventoryView keeps its own) is not
-- disturbed.
function StageStub:emptyPack()
	self._story = zombie.Story.create(self._resourceManager, STORY, Config.inventory.slots)
	self._story:setEventHandler(function(what, a, b)
		self:_feed("story " .. what .. ": " .. tostring(a) .. ((b ~= nil) and (" " .. tostring(b.text or b)) or ""))
	end)
	self._inventory = self._story.inventory
	for _, entry in ipairs(SAMPLE_KIT) do
		self._inventory:add(entry[1], entry[2])
	end
	return self._inventory
end

-- Fill every free slot but `free` with full stacks of `kind`, to test what happens when the
-- pack runs out of room.
function StageStub:crowdPack(kind, free)
	local inv < const > = self._inventory
	local slots < const > = inv.capacity - inv.used - (free or 0)
	if slots > 0 then
		inv:add(kind, Items.get(kind).stack * slots)
	end
	return inv
end

function StageStub:setHealth(fraction)
	self._health = self._maxHealth * fraction
	return self
end

-- Put `contents` -- { { kind = , count = }, ... } -- in chest `index`. Copied, since taking
-- from a chest spends the list.
function StageStub:setChest(index, contents)
	local list = {}
	for _, entry in ipairs(contents) do
		table.insert(list, { kind = Items.keyOf(entry.kind), count = entry.count })
	end
	self._chests[index] = list
	return self
end

-- ---- What the views call ----

function StageStub:inventory()
	return self._inventory
end

function StageStub:story()
	return self._story
end

function StageStub:questLog()
	return self._story.questLog
end

function StageStub:armor()
	local def < const > = Items.get(self._inventory:getEquipped(Items.BODY))
	return (def ~= nil and def.armor ~= nil) and def.armor or 0.0
end

function StageStub:equipItem(kind)
	if not self._inventory:equip(kind) then
		return false
	end
	local def < const > = Items.get(kind)
	if def ~= nil and def.equip == Items.HAND then
		self:_feed(def.name .. " IN HAND")
	end
	return true
end

function StageStub:unequipItem(kind)
	local def < const > = Items.get(kind)
	if def == nil or def.equip == nil or Items.keyOf(self._inventory:getEquipped(def.equip)) ~= kind then
		return false
	end
	return self._inventory:unequip(def.equip)
end

function StageStub:useItem(kind)
	local def < const > = Items.get(kind)
	if def == nil or def.heal == nil or self._inventory:count(kind) <= 0 then
		return false
	end
	if self._health >= self._maxHealth then
		self:_feed("NOT HURT")
		return false
	end
	self._inventory:remove(kind, 1)
	local before < const > = self._health
	self._health = math.min(self._maxHealth, self._health + def.heal)
	self:_feed("+ " .. tostring(math.floor(self._health - before + 0.5)) .. " HEALTH")
	return true
end

function StageStub:dropSlot(index)
	local s < const > = slotOf(self._inventory, index)
	if s == nil then
		return false
	end
	local def < const > = Items.get(s.kind)
	if def == nil or (not def.keep and def.drop == nil) then
		self:_feed("THAT CANNOT BE PUT DOWN")
		return false
	end
	local stack < const > = self._inventory:removeSlot(index - 1)
	self:_feed("PUT DOWN " .. Items.describe(stack.item, stack.count))
	return true
end

function StageStub:giveItem(kind, count, entity)
	local added < const > = (entity ~= nil) and self._inventory:add(kind, count, entity) or self._inventory:add(kind, count)
	if added <= 0 then
		return 0
	end
	local text = "+ " .. Items.describe(kind, added)
	if added < count then
		text = text .. "   THE PACK IS FULL"
	end
	self:_feed(text)
	return added
end

function StageStub:chestContents(index)
	return self._chests[index] or {}
end

function StageStub:takeFromChest(index, slot)
	local left < const > = self._chests[index]
	local entry < const > = (left ~= nil) and left[slot] or nil
	if entry == nil then
		return 0, nil
	end
	local added < const > = self:giveItem(entry.kind, entry.count)
	entry.count = entry.count - added
	if entry.count <= 0 then
		table.remove(left, slot)
	end
	return added, entry.kind
end

function StageStub:takeAllFromChest(index)
	local left < const > = self._chests[index]
	if left == nil then
		return false, false
	end
	local any = false
	local slot = 1
	while slot <= #left do
		local before < const > = #left
		local added < const > = self:takeFromChest(index, slot)
		if added > 0 then
			any = true
		end
		if #left == before then
			slot = slot + 1
		end
	end
	return any, #left > 0
end

-- Private

function StageStub:_feed(text)
	print("Stage: " .. text)
end
]]></text>
</object>
