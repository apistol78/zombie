<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{1456EC45-179D-412E-8992-CF569E4DC4C3}
#using \{5E1A4C77-2B90-4D36-9F41-7C8A2D0E6B15}

import(traktor)

-- MinimapScaffolding
--
-- Test page for Scripts/Widgets/Minimap, built the way Main:_buildMinimap builds it -- build()
-- once with the landmarks -- over a made-up 100 m square: one landmark of each kind, plus one
-- with no drawing of its own (the plain surveyor's mark). The map reaches RADIUS metres from
-- the player, less than the square, so things go off its edge.
--
-- Then it is driven the way Main:_updateMinimap drives it, every frame: the player walks a
-- figure of eight, the map moving under the arrow, so markers come and go at the edge and the
-- quest pin (fixed in the square's middle) waits at the edge when it is out of reach.

MinimapScaffolding = MinimapScaffolding or class("MinimapScaffolding", GameScaffolding)

local RADIUS < const > = 35.0
local QUEST < const > = { 50, 50 }

local LANDMARKS < const > = {
	{ x = 50, z = 88, glyph = "chapel" },
	{ x = 88, z = 45, glyph = "tower" },
	{ x = 40, z = 40, glyph = "altar" },
	{ x = 12, z = 52, glyph = nil }
}

function MinimapScaffolding:build(parent)
	self:note(parent, "MINIMAP   The player walks off both sides.")

	self._map = Minimap(self:row(parent, "map"))
	self._map:setRadius(RADIUS)
	self._map:build(LANDMARKS)
end

function MinimapScaffolding:step(dt)
	local t < const > = self:time()

	-- A figure of eight, wider than the map.
	local w < const > = 0.25
	local x < const > = 50.0 + 60.0 * math.sin(t * w)
	local z < const > = 50.0 + 35.0 * math.sin(t * w * 2.0)
	local dx < const > = 60.0 * w * math.cos(t * w)
	local dz < const > = 35.0 * w * 2.0 * math.cos(t * w * 2.0)
	self._map:setView(x, z, math.atan(dx, dz))

	self._map:setQuest(QUEST[1], QUEST[2])
end
]]></text>
</object>
