<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{1456EC45-179D-412E-8992-CF569E4DC4C3}
#using \{9B4E27DA-6C81-4F35-A70E-1D5C83B2F604}

import(traktor)

-- TitleScaffolding
--
-- Test page for Scripts/Widgets/Title, the logo on the Startup menu, in a Dialog as it is
-- there, with the dawn flare's flicker running. Its art is a movie of its own, UI/Title, so
-- this page lists it ahead of the game's other kits -- the same order Scripts/Startup uses.

TitleScaffolding = TitleScaffolding or class("TitleScaffolding", GameScaffolding)

function TitleScaffolding:getResourceKits()
	local kits < const > = GameScaffolding.getResourceKits(self)
	table.insert(kits, 1, "\{2C9F5B10-4E73-4A18-B6D2-9A0F31E4C8B7}")
	return kits
end

function TitleScaffolding:build(parent, frame)
	self:note(parent, "TITLE   The Startup menu's logo, flare flickering.")

	self._dialog = Dialog(frame, TableLayout({ 0 }, { 0 }, 24, 24, 0, 16))
	self:tick(Title(self._dialog))
end

function TitleScaffolding:show()
	self._dialog:show()
end
]]></text>
</object>
