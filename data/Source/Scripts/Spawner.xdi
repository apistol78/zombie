<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[#using \{6E9AD100-0000-4000-8000-000000000010}

import(traktor)

local ENEMY < const > = Guid("\{25DFC254-D44A-4F97-8A57-72A212B74C8D}")

Spawner = Spawner or class("Spawner", traktor.world.ScriptComponent)

-- Tuning.
local MAX_ENEMIES < const > = Config.spawner.maxEnemies      -- keep at most this many spawned alive
local SPAWN_MIN < const > = Config.spawner.spawnMin       -- nearest a spawn may appear to the player (m)
local SPAWN_MAX < const > = Config.spawner.spawnMax      -- farthest a spawn may appear (m)
local DESPAWN_DIST < const > = Config.spawner.despawnDist   -- remove spawned enemies past this distance (m)
local SPAWN_INTERVAL < const > = Config.spawner.spawnInterval  -- seconds between spawn attempts
local CANDIDATES < const > = Config.spawner.candidates       -- spawn-point tries per attempt

-- Putting the horde where the player is going rather than where it has been.
--
-- The old rule was "keep the first hidden candidate, upgrade to an in-front one if
-- one turns up", sampling a ring centred on the player. In practice that still fed
-- them in from behind, for three compounding reasons: half a ring centred on the
-- player is behind them; whichever hidden point came out of the sampler first was
-- taken; and -- the real culprit -- the line-of-sight ray used a default
-- QueryFilter, whose includeGroup is ~0, so *other zombies counted as cover*. Every
-- zombie already trailing the player made the ground behind them read as "hidden",
-- which fed the next spawn in behind as well. It compounded itself.
--
-- So: sample a ring pushed AHEAD_BIAS metres up the player's forward, score every
-- candidate on how far round from forward it sits and take the best rather than the
-- first, and trace cover against the static world only.
local AHEAD_BIAS < const > = Config.spawner.aheadBias      -- how far ahead of the player the ring is centred (m)
local COVER_MIN < const > = Config.spawner.coverMin       -- cover must be at least this far from the eye, so
                                      -- standing in a bush cannot make everywhere "hidden"

-- Taking them back off again once the player has left them behind. Without this the
-- population sits in the trail at up to DESPAWN_DIST, eating the slots that the rule
-- above wants to spend in front -- the two halves are the same mechanism.
local BEHIND_DIST < const > = Config.spawner.behindDist    -- ...at which a zombie left behind may be removed (m)
local BEHIND_DOT < const > = Config.spawner.behindDot    -- how far round from forward counts as behind (~105 deg)
local RECEDE_MIN < const > = Config.spawner.recedeMin      -- and how fast the player has to be leaving it (m/s)
local BEHIND_INTERVAL < const > = Config.spawner.behindInterval -- seconds between removals, so the trail thins at a
                                      -- deliberate rate; one a frame would empty it in half
                                      -- a second and read as the forest going quiet
local VEL_SMOOTH < const > = Config.spawner.velSmooth      -- player velocity easing (1/s); raw frame deltas jitter

local EYE < const > = 1.6             -- eye height, and the height a zombie is sighted at (m)

-- Ground trace. The window is deliberately short: it has to cover the nav mesh drifting
-- off the terrain, not search for a floor several metres away. Tracing far upward would
-- start the ray above nearby props and drop zombies onto table tops and boulders instead
-- of the ground the nav point meant.
local GROUND_UP < const > = 1.0        -- begin the trace this far above the nav point (m)
local GROUND_DOWN < const > = 3.0      -- ...and look this far below it (m)
local GROUND_MIN_NORMAL_Y < const > = Config.spawner.groundMinNormalY   -- reject ground steeper than ~45 degrees

-- Static world only (terrain, boulders, logs, props). The player and the zombies are in
-- the Interactable group, so this keeps them from being mistaken for ground - without it
-- a zombie could spawn standing on another zombie's head.
local COLLISION_DEFAULT < const > = 0x00000001

-- Consecrated ground: nothing rises inside a lit ward. The Stage publishes the
-- list as context._litWards ({ x, z, r2 } per lit ward) and only rebuilds it when
-- one is lit, so this is a short table walk -- at most one entry per relic.
local function inLitWard(wards, p)
	if wards == nil then
		return false
	end
	for _, w in ipairs(wards) do
		local dx < const > = p.x - w.x
		local dz < const > = p.z - w.z
		if dx * dx + dz * dz < w.r2 then
			return true
		end
	end
	return false
end

-- Drop a nav-mesh point onto the surface actually underneath it.
--
-- The nav mesh is a voxelised stand-in for the world, not the world: its polygons are
-- flat where the terrain rolls, and the walkable surface it produces sits slightly off
-- the heightfield it was baked from. Spawning straight onto a nav point therefore leaves
-- zombies hovering above a dip or buried to the shin in a rise until the character
-- controller's step-down pulls them in - which happens over the frames the stand-up
-- animation is playing, i.e. exactly when the player is most likely to be looking.
--
-- Returns the contact point and its normal, or nil when nothing was hit.
local function traceGround(pm, p)
	local hit < const > = pm:queryRay(
		Vector4(p.x, p.y + GROUND_UP, p.z, 1.0),
		Vector4(0.0, -1.0, 0.0, 0.0),
		GROUND_UP + GROUND_DOWN,
		physics.QueryFilter(COLLISION_DEFAULT),
		true
	)
	if hit == nil then
		return nil, nil
	end
	return hit.position, hit.normal
end

-- Is a point hidden from the player, and by cover that is actually out at the far
-- end rather than under their nose? Returns whether the sight line is blocked and
-- how far along it the blocker sits.
--
-- Static world only (0x1), exactly as traceGround: without that mask the *other
-- zombies* count as cover, and a horde trailing the player turns the ground behind
-- them into the only place that ever reads as hidden.
local function sightLine(pm, eye, p)
	local r < const > = p + Vector4(0.0, EYE, 0.0, 0.0) - eye
	local rl < const > = r.length
	if rl <= 0.5 then
		return false, 0.0
	end
	local hit < const > = pm:queryRay(eye, r / rl, rl - 0.5, physics.QueryFilter(COLLISION_DEFAULT), true)
	if hit == nil then
		return false, rl
	end
	return true, (hit.position - eye).length
end

-- The nav mesh point under (x, z), or nil when there is no walkable ground there.
--
-- Probed from far below so a stacked spot resolves to the terrain rather than a roof
-- above it, and because findClosestPointXZ ignores height. It returns its search
-- point *verbatim* when it finds nothing, so a y still down at the probe depth is
-- how the miss is detected -- without that check an off-mesh probe silently returns
-- a point 1000 m underground and poisons the whole attempt.
local function groundNavPoint(navMesh, x, y, z)
	local p < const > = navMesh:findClosestPointXZ(Vector4(x, y - 1000.0, z, 1.0), 8.0)
	if p.y <= y - 900.0 then
		return nil
	end
	return p
end

function Spawner:new()
	self._spawned = {}   -- enemies this spawner created (its managed population)
	self._timer = 0.0
	self._velX, self._velZ = 0.0, 0.0   -- smoothed player velocity, XZ
	self._lastPX, self._lastPZ = nil, nil
	self._behindTimer = 0.0
end

function Spawner:update(context, totalTime, deltaTime)
	if context == nil then
		return
	end

	-- Freeze together with the rest of the game (the Stage owns these flags).
	-- _nightOver is the win: nothing new rises into the dawn, and _cutscene is a hive
	-- opening -- the camera is over there and the only thing that may move is that
	-- hive's own brood (see Main:_beginCutscene).
	if context._gameOver or context._paused or context._nightOver or context._cutscene ~= nil then
		return
	end

	local environment < const > = context.environment

	if self._player == nil then
		self._player = self.world:getEntity("Humanoid")
	end
	if self._player == nil then
		return
	end

	-- Resolve (once) the nav mesh and the world layer used to spawn entities.
	if self._navMesh == nil then
		local navComponent = self.world:getComponent(traktor.ai.NavMeshComponent)
		if navComponent ~= nil then
			self._navMesh = navComponent:get()
		end
	end
	if self._navMesh == nil then
		return
	end

	local pm < const > = environment.physics.physicsManager
	local playerPos < const > = self._player.transform.translation

	-- Which way the player is looking, and which way they are actually travelling.
	-- Both are needed below: facing decides what counts as in front of them, and
	-- velocity decides whether a zombie behind them is being left behind or is still
	-- being backed towards. Velocity is eased because a raw per-frame delta jitters
	-- enough to flicker the receding test on and off.
	local heading = 0.0
	local character < const > = self._player:getComponent(traktor.physics.CharacterComponent)
	if character ~= nil then
		heading = character.headAngle
	end
	local forward < const > = traktor.Quaternion.fromEulerAngles(heading, 0.0, 0.0) * traktor.Vector4(0.0, 0.0, 1.0, 0.0)

	if self._lastPX ~= nil and deltaTime > 0.0 then
		local k < const > = math.min(1.0, deltaTime * VEL_SMOOTH)
		self._velX = self._velX + ((playerPos.x - self._lastPX) / deltaTime - self._velX) * k
		self._velZ = self._velZ + ((playerPos.z - self._lastPZ) / deltaTime - self._velZ) * k
	end
	self._lastPX, self._lastPZ = playerPos.x, playerPos.z

	local eye < const > = playerPos.xyz1 + Vector4(0.0, EYE, 0.0)

	-- 1) Prune the managed population, then unspawn enemies that have wandered too far
	-- from the player.
	--
	-- The list has to shed entries whose entity has left the world, or it grows for as
	-- long as the game runs: nothing else here ever hears about a zombie the player shot,
	-- so once Main has rag dolled it and destroyed the corpse the entry would sit here
	-- forever, pinning a dead entity in memory *and* burning one of the MAX_ENEMIES slots.
	-- That is what eventually starves spawning near a spot you have been fighting in.
	--
	-- A zombie Main has taken over but not yet destroyed (still counting down its corpse
	-- lifetime) deliberately keeps its slot: it is still an entity in the world holding a
	-- full set of physics bodies, so counting it against the cap is what keeps the live
	-- population -- and the body count -- bounded.
	--
	-- A zombie the player has walked away from is also removed, well short of
	-- DESPAWN_DIST: past BEHIND_DIST, more than BEHIND_DOT round from where they are
	-- looking, with the player measurably receding from it, and out of sight so it is
	-- never seen to vanish. That is not only tidying -- those trailing followers are
	-- holding MAX_ENEMIES slots, and freeing one is what lets the spawn rule below
	-- put a zombie in front instead. Only the furthest such zombie goes per update,
	-- which bounds this to a single extra ray per frame and thins the trail out from
	-- the back rather than deleting it wholesale.
	local dead < const > = context._deadEnemies
	local kept = {}
	local strayEnemy, strayDist2 = nil, BEHIND_DIST * BEHIND_DIST
	for _, e in ipairs(self._spawned) do
		if e.world == nil then
			-- Gone: Main destroyed the corpse. Drop the entry (do not keep it).
		elseif dead ~= nil and dead[e] ~= nil then
			-- Dying, but still an entity in the world: keep the slot occupied.
			table.insert(kept, e)
		else
			local ep = e.transform.translation
			local dx, dy, dz = ep.x - playerPos.x, ep.y - playerPos.y, ep.z - playerPos.z
			if dx * dx + dy * dy + dz * dz > DESPAWN_DIST * DESPAWN_DIST then
				self.world:removeEntity(e)
				-- removeEntity only detaches the entity from the world; it does NOT tear
				-- down its components, and the physics manager keeps owning their bodies
				-- until it does. A zombie carries thirteen of them -- the character
				-- controller's two capsules plus the eleven rag doll limbs, which are
				-- built when the animation graph is instanced rather than on death --
				-- and every one keeps being simulated and keeps blocking line-of-sight
				-- rays. They outlive the stage too, because the physics manager is
				-- global, so not even a restart clears them. Destroy it explicitly.
				e:destroy()
			else
				table.insert(kept, e)
				-- Kept, so it is a live follower: is it one the player has finished
				-- with? Selected here rather than alongside the distance test above so
				-- a zombie already being despawned can never also be picked as the
				-- stray. Furthest wins, so the trail is eaten from the back.
				local flat2 < const > = dx * dx + dz * dz
				if flat2 > strayDist2 then
					local d < const > = math.sqrt(flat2)
					if (dx * forward.x + dz * forward.z) / d < BEHIND_DOT
						and (self._velX * dx + self._velZ * dz) / d < -RECEDE_MIN then
						strayEnemy, strayDist2 = e, flat2
					end
				end
			end
		end
	end
	self._spawned = kept

	-- Take the stray, if it really cannot be seen going. The sight test is out here so
	-- it costs one ray per update whatever the headcount, and it is on its own timer so
	-- a sprinting player thins the trail rather than deleting it.
	self._behindTimer = self._behindTimer - deltaTime
	if strayEnemy ~= nil and self._behindTimer <= 0.0 then
		if sightLine(pm, eye, strayEnemy.transform.translation) then
			self._behindTimer = BEHIND_INTERVAL
			for i, e in ipairs(self._spawned) do
				if e == strayEnemy then
					table.remove(self._spawned, i)
					break
				end
			end
			self.world:removeEntity(strayEnemy)
			strayEnemy:destroy()   -- as above: removeEntity alone leaks thirteen bodies
		end
	end

	-- Ward pressure. Every ward the player lights buys a patch of safe ground and
	-- pays for it by making everywhere else worse: spawns come faster and closer.
	--
	-- Headcount is deliberately NOT scaled. MAX_ENEMIES is a performance ceiling
	-- (each zombie carries thirteen physics bodies), not a difficulty knob -- the
	-- escalation is speed and proximity, here and in EnemyController's pace.
	local lit < const > = context._wardsLit or 0
	local wards < const > = context._litWards
	local spawnMin < const > = math.max(SPAWN_MIN - 0.8 * lit, 4.0)
	local interval < const > = SPAWN_INTERVAL * math.max(1.0 - 0.1 * lit, 0.5)

	-- 3) Only spawn while under the cap, and throttle attempts.
	self._timer = self._timer - deltaTime
	if #self._spawned >= MAX_ENEMIES or self._timer > 0.0 then
		return
	end
	self._timer = interval

	-- 2) + 8) Pick a spawn point: a random nav-mesh point in the spawn ring, dropped onto
	-- the real ground beneath it, standing on a surface flat enough to stand on, and
	-- hidden from the player behind something with some substance to it.
	--
	-- The ring is centred AHEAD_BIAS metres up the player's forward rather than on the
	-- player, which is what actually moves the horde in front of them: the sampler then
	-- draws mostly from the ground they are walking into, and only reaches back past
	-- them at the near edge. Centred on the ground *beneath* that point, not at eye
	-- level -- when the player is up the tower, seeding off a rooftop polygon would
	-- scatter the horde across the roof. Falls back to the player's own ground, and
	-- then to the player, so a forward that points off the mesh (a cliff edge, the
	-- map border) costs nothing.
	local aheadX < const > = playerPos.x + forward.x * AHEAD_BIAS
	local aheadZ < const > = playerPos.z + forward.z * AHEAD_BIAS
	local spawnCenter < const > =
		groundNavPoint(self._navMesh, aheadX, playerPos.y, aheadZ) or
		groundNavPoint(self._navMesh, playerPos.x, playerPos.y, playerPos.z) or
		playerPos

	-- Every candidate that survives the filters is scored on how far round from
	-- forward it sits, and the best one wins -- rather than the old "take the first
	-- hidden one", which threw away the whole point of sampling more than one. A
	-- behind-the-player point can still win, but only when nothing ahead qualified,
	-- so the horde keeps coming even in a corner where there is no cover in front.
	local best, bestScore = nil, -math.huge
	for _ = 1, CANDIDATES do
		local p = self._navMesh:findRandomPoint(spawnCenter, SPAWN_MAX)   -- (0,0,0,0) on failure
		if p.x ~= 0.0 or p.y ~= 0.0 or p.z ~= 0.0 then
			local dx, dz = p.x - playerPos.x, p.z - playerPos.z
			local flat2 < const > = dx * dx + dz * dz
			if flat2 >= spawnMin * spawnMin and flat2 <= SPAWN_MAX * SPAWN_MAX then
				-- Settle onto the actual surface, and take the ground's own verdict on
				-- whether this is a place to stand: a near-vertical hit means the nav
				-- point landed on a cliff face or the side of a boulder, where a zombie
				-- would spawn half inside the rock and immediately slide. Rejecting the
				-- candidate costs nothing - there are CANDIDATES-1 more, and failing the
				-- whole attempt just retries in SPAWN_INTERVAL seconds.
				-- ...and reject it outright if it lands on consecrated ground, which
				-- is what makes a lit ward mean something rather than just look warm.
				local g, gn = traceGround(pm, p)
				if g ~= nil and gn.y >= GROUND_MIN_NORMAL_Y and not inLitWard(wards, g) then
					-- Hidden, and hidden by something out there rather than by whatever
					-- the player happens to be standing in: cover a hand's breadth from
					-- the eye would otherwise make every direction qualify at once.
					local hidden < const >, coverDist < const > = sightLine(pm, eye, g)
					if hidden and coverDist >= COVER_MIN then
						local score < const > = (dx * forward.x + dz * forward.z) / math.sqrt(flat2)
						if score > bestScore then
							best, bestScore = g, score
						end
					end
				end
			end
		end
	end
	if best == nil then
		return   -- nowhere hidden and standable this attempt; try again next interval
	end

	-- 4) + 5) + 7) Spawn the enemy. WorldLayer:createEntity builds it from the entity
	-- data AND adds it to the world (via the entity builder), so no explicit addEntity is
	-- needed. Stand it on the traced ground contact - the entity origin is at the feet,
	-- since AiCharacterComponent keeps its capsule half a height above the owner - facing
	-- the player.
	--
	-- Only yaw: the body stays upright rather than tipping into the slope. Pitching it to
	-- match the ground normal would not survive anyway, because the controller rebuilds
	-- the rotation from headAngle alone on its first update.
	local enemy = context.world:createEntity(ENEMY)
	if enemy == nil then
		return
	end
	local yaw < const > = (math.atan2 or math.atan)(playerPos.x - best.x, playerPos.z - best.z)
	enemy.transform = traktor.Transform(traktor.Vector4(best.x, best.y, best.z, 1.0), traktor.Quaternion.fromEulerAngles(yaw, 0.0, 0.0))

	-- Send it after the player rather than leaving it to notice them.
	--
	-- Placing it in cover is only half the job: cover hides the player from *it* too,
	-- so on its own it would fail perception, stay on patrol, and shuffle about within
	-- two metres of where it rose until the player had walked past and the sight line
	-- opened from behind. EnemyController:alertTo puts it straight into its chase state
	-- so it walks out of that cover towards them instead. Spawning in front of the
	-- player is worth nothing without this.
	--
	-- MUST come after the transform assignment above: ScriptComponent builds its Lua
	-- object lazily in validate(), which runs on the first setTransform or update, so
	-- calling this on a freshly created entity would find nothing to call.
	local sc < const > = enemy:getComponent(traktor.world.ScriptComponent)
	if sc ~= nil then
		sc:alertTo()
	end

	table.insert(self._spawned, enemy)
end
]]></text>
</object>
