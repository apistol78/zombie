<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[import(traktor)

local ENEMY < const > = Guid("\{25DFC254-D44A-4F97-8A57-72A212B74C8D}")

Spawner = Spawner or class("Spawner", traktor.world.ScriptComponent)

-- Tuning.
local MAX_ENEMIES < const > = 30      -- keep at most this many spawned alive
local SPAWN_MIN < const > = 8.0       -- nearest a spawn may appear to the player (m)
local SPAWN_MAX < const > = 20.0      -- farthest a spawn may appear (m)
local DESPAWN_DIST < const > = 60.0   -- remove spawned enemies past this distance (m)
local SPAWN_INTERVAL < const > = 0.5  -- seconds between spawn attempts
local CANDIDATES < const > = 8        -- spawn-point tries per attempt

-- Ground trace. The window is deliberately short: it has to cover the nav mesh drifting
-- off the terrain, not search for a floor several metres away. Tracing far upward would
-- start the ray above nearby props and drop zombies onto table tops and boulders instead
-- of the ground the nav point meant.
local GROUND_UP < const > = 1.0        -- begin the trace this far above the nav point (m)
local GROUND_DOWN < const > = 3.0      -- ...and look this far below it (m)
local GROUND_MIN_NORMAL_Y < const > = 0.7   -- reject ground steeper than ~45 degrees

-- Static world only (terrain, boulders, logs, props). The player and the zombies are in
-- the Interactable group, so this keeps them from being mistaken for ground - without it
-- a zombie could spawn standing on another zombie's head.
local COLLISION_DEFAULT < const > = 0x00000001

-- Consecrated ground: nothing rises inside a lit ward. The Stage publishes the
-- list as context._litWards ({ x, z, r, r2 } per lit ward) and only rebuilds it when
-- one is lit, so this is a short table walk -- at most one entry per relic.
local function inLitWard(wards, p)
	if wards == nil then
		return false
	end
	for _, w in ipairs(wards) do
		local dx < const > = p.x - w.x
		local dz < const > = p.z - w.z
		if dx * dx + dz * dz < w.r2 then
			return true
		end
	end
	return false
end

-- Drop a nav-mesh point onto the surface actually underneath it.
--
-- The nav mesh is a voxelised stand-in for the world, not the world: its polygons are
-- flat where the terrain rolls, and the walkable surface it produces sits slightly off
-- the heightfield it was baked from. Spawning straight onto a nav point therefore leaves
-- zombies hovering above a dip or buried to the shin in a rise until the character
-- controller's step-down pulls them in - which happens over the frames the stand-up
-- animation is playing, i.e. exactly when the player is most likely to be looking.
--
-- Returns the contact point and its normal, or nil when nothing was hit.
local function traceGround(pm, p)
	local hit < const > = pm:queryRay(
		Vector4(p.x, p.y + GROUND_UP, p.z, 1.0),
		Vector4(0.0, -1.0, 0.0, 0.0),
		GROUND_UP + GROUND_DOWN,
		physics.QueryFilter(COLLISION_DEFAULT),
		true
	)
	if hit == nil then
		return nil, nil
	end
	return hit.position, hit.normal
end

function Spawner:new()
	self._spawned = {}   -- enemies this spawner created (its managed population)
	self._timer = 0.0
end

function Spawner:update(context, totalTime, deltaTime)
	if context == nil then
		return
	end

	-- Freeze together with the rest of the game (the Stage owns these flags).
	-- _nightOver is the win: nothing new rises into the dawn.
	if context._gameOver or context._paused or context._nightOver then
		return
	end

	local environment < const > = context.environment

	if self._player == nil then
		self._player = self.world:getEntity("Humanoid")
	end
	if self._player == nil then
		return
	end

	-- Resolve (once) the nav mesh and the world layer used to spawn entities.
	if self._navMesh == nil then
		local navComponent = self.world:getComponent(traktor.ai.NavMeshComponent)
		if navComponent ~= nil then
			self._navMesh = navComponent:get()
		end
	end
	if self._navMesh == nil then
		return
	end

	local pm < const > = environment.physics.physicsManager
	local playerPos < const > = self._player.transform.translation

	-- 1) Prune the managed population, then unspawn enemies that have wandered too far
	-- from the player.
	--
	-- The list has to shed entries whose entity has left the world, or it grows for as
	-- long as the game runs: nothing else here ever hears about a zombie the player shot,
	-- so once Main has rag dolled it and destroyed the corpse the entry would sit here
	-- forever, pinning a dead entity in memory *and* burning one of the MAX_ENEMIES slots.
	-- That is what eventually starves spawning near a spot you have been fighting in.
	--
	-- A zombie Main has taken over but not yet destroyed (still counting down its corpse
	-- lifetime) deliberately keeps its slot: it is still an entity in the world holding a
	-- full set of physics bodies, so counting it against the cap is what keeps the live
	-- population -- and the body count -- bounded.
	local dead < const > = context._deadEnemies
	local kept = {}
	for _, e in ipairs(self._spawned) do
		if e.world == nil then
			-- Gone: Main destroyed the corpse. Drop the entry (do not keep it).
		elseif dead ~= nil and dead[e] ~= nil then
			-- Dying, but still an entity in the world: keep the slot occupied.
			table.insert(kept, e)
		else
			local ep = e.transform.translation
			local dx, dy, dz = ep.x - playerPos.x, ep.y - playerPos.y, ep.z - playerPos.z
			if dx * dx + dy * dy + dz * dz > DESPAWN_DIST * DESPAWN_DIST then
				self.world:removeEntity(e)
				-- removeEntity only detaches the entity from the world; it does NOT tear
				-- down its components, and the physics manager keeps owning their bodies
				-- until it does. A zombie carries thirteen of them -- the character
				-- controller's two capsules plus the eleven rag doll limbs, which are
				-- built when the animation graph is instanced rather than on death --
				-- and every one keeps being simulated and keeps blocking line-of-sight
				-- rays. They outlive the stage too, because the physics manager is
				-- global, so not even a restart clears them. Destroy it explicitly.
				e:destroy()
			else
				table.insert(kept, e)
			end
		end
	end
	self._spawned = kept

	-- Ward pressure. Every ward the player lights buys a patch of safe ground and
	-- pays for it by making everywhere else worse: spawns come faster and closer.
	--
	-- Headcount is deliberately NOT scaled. MAX_ENEMIES is a performance ceiling
	-- (each zombie carries thirteen physics bodies), not a difficulty knob -- the
	-- escalation is speed and proximity, here and in EnemyController's pace.
	local lit < const > = context._wardsLit or 0
	local wards < const > = context._litWards
	local spawnMin < const > = math.max(SPAWN_MIN - 0.8 * lit, 4.0)
	local interval < const > = SPAWN_INTERVAL * math.max(1.0 - 0.1 * lit, 0.5)

	-- 3) Only spawn while under the cap, and throttle attempts.
	self._timer = self._timer - deltaTime
	if #self._spawned >= MAX_ENEMIES or self._timer > 0.0 then
		return
	end
	self._timer = interval

	-- Player facing, so we can prefer spawning in front of the player.
	local heading = 0.0
	local character = self._player:getComponent(traktor.physics.CharacterComponent)
	if character ~= nil then
		heading = character.headAngle
	end
	local forward < const > = traktor.Quaternion.fromEulerAngles(heading, 0.0, 0.0) * traktor.Vector4(0.0, 0.0, 1.0, 0.0)

	-- 2) + 8) Pick a spawn point: a random nav-mesh point in the spawn ring, dropped onto
	-- the real ground beneath it, standing on a surface flat enough to stand on, hidden
	-- from the player (a physics ray from the player's eye is blocked by terrain before
	-- reaching it), preferring points in front.
	-- Centre the spawn ring on the ground *beneath* the player, not the player's own
	-- position: when they are up a tower or on a roof, findRandomPoint(playerPos) would
	-- seed off a rooftop polygon and scatter the horde across it. findClosestPointXZ
	-- ignores height, and probing from far below biases a stacked spot to the terrain
	-- rather than a roof above it. Falls back to the player's position if nothing is found.
	local spawnCenter < const > = self._navMesh:findClosestPointXZ(Vector4(playerPos.x, playerPos.y - 1000.0, playerPos.z, 1.0), 8.0)
	local best, bestInFront = nil, false
	for _ = 1, CANDIDATES do
		local p = self._navMesh:findRandomPoint(spawnCenter, SPAWN_MAX)   -- (0,0,0,0) on failure
		if p.x ~= 0.0 or p.y ~= 0.0 or p.z ~= 0.0 then
			local dx, dz = p.x - playerPos.x, p.z - playerPos.z
			if dx * dx + dz * dz >= spawnMin * spawnMin then
				-- Settle onto the actual surface, and take the ground's own verdict on
				-- whether this is a place to stand: a near-vertical hit means the nav
				-- point landed on a cliff face or the side of a boulder, where a zombie
				-- would spawn half inside the rock and immediately slide. Rejecting the
				-- candidate costs nothing - there are CANDIDATES-1 more, and failing the
				-- whole attempt just retries in SPAWN_INTERVAL seconds.
				-- ...and reject it outright if it lands on consecrated ground, which
				-- is what makes a lit ward mean something rather than just look warm.
				local g, gn = traceGround(pm, p)
				if g ~= nil and gn.y >= GROUND_MIN_NORMAL_Y and not inLitWard(wards, g) then
					local eye < const > = playerPos.xyz1 + Vector4(0.0, 1.6, 0.0)
					local r < const > = g + Vector4(0.0, 1.6, 0.0) - eye
					local rl < const > = r.length
					if rl > 0.5 then
						local hit < const > = pm:queryRay(eye, r / rl, rl - 0.5, physics.QueryFilter(), true)
						if hit ~= nil then
							-- Occluded => hidden. Keep the first hidden point; upgrade to
							-- an in-front one as soon as we find it.
							local inFront = (r.x * forward.x + r.z * forward.z) > 0.0
							if best == nil or (inFront and not bestInFront) then
								best, bestInFront = g, inFront
								if inFront then
									break
								end
							end
						end
					end
				end
			end
		end
	end
	if best == nil then
		return   -- nowhere hidden and standable this attempt; try again next interval
	end

	-- 4) + 5) + 7) Spawn the enemy. WorldLayer:createEntity builds it from the entity
	-- data AND adds it to the world (via the entity builder), so no explicit addEntity is
	-- needed. Stand it on the traced ground contact - the entity origin is at the feet,
	-- since AiCharacterComponent keeps its capsule half a height above the owner - facing
	-- the player.
	--
	-- Only yaw: the body stays upright rather than tipping into the slope. Pitching it to
	-- match the ground normal would not survive anyway, because the controller rebuilds
	-- the rotation from headAngle alone on its first update.
	local enemy = context.world:createEntity(ENEMY)
	if enemy == nil then
		return
	end
	local yaw < const > = (math.atan2 or math.atan)(playerPos.x - best.x, playerPos.z - best.z)
	enemy.transform = traktor.Transform(traktor.Vector4(best.x, best.y, best.z, 1.0), traktor.Quaternion.fromEulerAngles(yaw, 0.0, 0.0))
	table.insert(self._spawned, enemy)
end
]]></text>
</object>
