<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[#using \{17E40000-0000-4000-8000-000000000001}
#using \{7EA9C000-0000-4000-8000-000000000011}

import(traktor)

-- Spellbook
--
-- The spells the player knows, and which of them the right mouse button casts. Kept by the
-- Scripts/Weapons/Loadout, which hands it the button (Loadout:cast) and its frames.
--
-- Like the weapons, which spells there are is the pack's: knowing one is having its item, and
-- readying it is equipping that item in the spell slot (Items.SPELL) -- from the inventory screen,
-- like anything else. A spell that arrives while none is readied is readied, which is how the
-- night's first, carried from the start (the story's start kit), is in hand at once.
--
-- Adding a spell is a Scripts/Spells/Spell subclass, one entry in the list below naming its item,
-- and the item (with an EquipTrait on the spell slot) in the story's list.

Spellbook = Spellbook or class("Spellbook")

-- The item each spell is (data/Source/Story/Items).
local FIREBALL < const > = Guid("\{D1A10000-0000-4000-8000-00000000020F}")

function Spellbook:new(context)
	self._context = context
	self._spells = {
		Fireball(context, FIREBALL)
	}
	self._owned = {}
	self._readied = nil

	context:inventory():listen(function() self:_inventoryChanged() end)
	self:_inventoryChanged()
end

-- The readied spell, or nil.
function Spellbook:current()
	local kind < const > = Items.keyOf(self._context:inventory():getEquipped(Items.SPELL))
	if kind == nil then
		return nil
	end
	for _, s in ipairs(self._spells) do
		if s:item() == kind then
			return s
		end
	end
	return nil
end

-- The pack changed; see Loadout:_inventoryChanged, which this follows.
function Spellbook:_inventoryChanged()
	local inv < const > = self._context:inventory()
	local gained = nil
	for _, s in ipairs(self._spells) do
		local owned < const > = inv:count(s:item()) > 0
		if owned ~= (self._owned[s] == true) then
			self._owned[s] = owned
			if owned then
				gained = gained or s
			end
		end
	end

	if gained ~= nil and Items.keyOf(inv:getEquipped(Items.SPELL)) == nil then
		inv:equip(gained:item())
		return
	end

	local cur < const > = self:current()
	if cur ~= self._readied then
		self._readied = cur
		for _, s in ipairs(self._spells) do
			s:readiedChanged(s == cur)
		end
	end
end

-- Is there a readied spell that could be cast right now?
function Spellbook:ready()
	local s < const > = self:current()
	return s ~= nil and s:ready()
end

-- Right button: the readied spell, or nothing.
function Spellbook:cast()
	local s < const > = self:current()
	return s ~= nil and s:cast()
end

function Spellbook:update(dt)
	for _, s in ipairs(self._spells) do
		s:update(dt)
	end
end

function Spellbook:resolve()
	for _, s in ipairs(self._spells) do
		s:resolve()
	end
end

function Spellbook:reset()
	for _, s in ipairs(self._spells) do
		s:reset()
	end
end

function Spellbook:place()
	local cur < const > = self:current()
	for _, s in ipairs(self._spells) do
		if s == cur then
			s:place()
		else
			s:stow()
		end
	end
end
]]></text>
</object>
