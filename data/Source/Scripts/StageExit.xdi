<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
import(traktor)

-- StageExit
--
-- A way out of the stage. When the player walks into this entity's VolumeComponent the
-- stage is asked to leave for where its zombie.StageExitComponentData leads, through the
-- loading screen (Main:leaveStage):
--
--   target     one of the Loading stage's own transitions -- TERRAIN, CAVE or STARTUP -- and
--              anything else lands on STARTUP, since Loading falls back to it.
--   arrival    the place (Story/Places) to stand the player on in the destination's world --
--              facing the way the entity there faces -- or none, to arrive wherever that scene
--              puts its Humanoid. The cave's exit leads to Scene 2's CAVE RETURN, in front of
--              the cave mouth.
--
-- Placed per scene as an ExternalEntityData of Entities/Cave/Stage Exit, whose wrapper
-- carries its own VolumeComponentData (the size of the trigger) and StageExitComponentData:
-- ResolveExternal swaps both in for the referenced entity's, so one asset serves every
-- exit. The cave's sits on the ledge outside Cave_Entrance (tools/gen_cave_layout.py).
--
-- An exit whose wrapper also carries a zombie.InteractableComponentData is offered rather
-- than taken: near enough, "E   <prompt>" goes on the prompt line like any other
-- interaction, and only pressing E leaves (interact). Its notice is the line shown on the
-- way out. Scene 2's cave mouths offer ("ENTER THE CAVE"); the ways out of the caves do
-- not, they are walked through.
--
-- Whatever the player carries goes with them, and the world they leave is remembered for
-- when they come back: see Main:leaveStage.

StageExit = StageExit or class("StageExit", traktor.world.ScriptComponent)

-- Leave through this exit. Returns whether the trip started.
function StageExit:take(context)
	local exit < const > = self.owner:getComponent(zombie.StageExitComponent)
	local interactable < const > = self.owner:getComponent(zombie.InteractableComponent)
	local notice < const > = (interactable ~= nil and interactable.notice ~= "") and interactable.notice or nil
	local target < const > = (exit ~= nil and exit.target ~= "") and exit.target or "TERRAIN"
	local arrival < const > = (exit ~= nil and exit.arrival ~= nil) and string.upper(exit.arrival:format()) or nil
	return context:leaveStage(target, notice, arrival)
end

-- E at an exit that offers itself (Main:_interact).
function StageExit:interact(context)
	self:take(context)
end

function StageExit:_volume()
	if self._volumeComponent == nil then
		self._volumeComponent = self.owner:getComponent(traktor.world.VolumeComponent)
	end
	return self._volumeComponent
end

function StageExit:update(context, totalTime, deltaTime)
	-- One that offers waits for E (Main:_interact); only a walked-through one acts on its own.
	if context == nil or self._left or self.owner:getComponent(zombie.InteractableComponent) ~= nil then
		return
	end
	-- Not while the game is frozen or already over: a body sliding into the trigger
	-- behind a Game Over screen must not whisk the stage away from under its menu.
	if context._gameOver or context._paused or context._cutscene ~= nil then
		return
	end
	-- Nor before the stage has found the player. Until then the Humanoid is still where the
	-- scene put it -- not yet stood on the spot it arrived at from another stage (Main:resolve)
	-- -- and an exit near that spot would see it standing inside and send it straight back.
	if context._humanoid == nil then
		return
	end
	local volume < const > = self:_volume()
	if volume == nil or not volume:inside(context._humanoid.transform.translation) then
		return
	end
	-- Asked once. leaveStage refuses while another load is in flight (a restart, the
	-- pause menu's exit), in which case this simply asks again next frame.
	if self:take(context) then
		self._left = true
	end
end
]]></text>
</object>
