<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{720C0A68-B608-2F40-8EBA-F7E42EB27F61}
#using \{FC4400A2-BDB6-BA45-9A22-12B9676E71FA}
#using \{9B4E27DA-6C81-4F35-A70E-1D5C83B2F604}
#using \{A47C0E92-3B15-4D68-9E24-5F80C6B1D739}
#using \{355F68E1-93F8-3A48-BA4D-90185A04F57C}
#using \{6D2B8F41-A7C3-4E95-B01D-3F8E5A9C2D67}
#using \{3E8A5D21-6C47-4B9F-8E12-A47D0C93F5B6}

-- Scripts/SaveGame: whether there is a night to continue, and what it was.
#using \{5EDB4A29-67A6-5A46-ADBA-88BC29BB7363}

import(traktor)

-- Startup
--
-- A worldless stage: no scene, just a UiKit menu that lets the player pick
-- which gameplay stage to enter. Each button hands the chosen stage over to the
-- Loading stage, which shows a loading panel while it streams the world in.
--
-- Options live in a second Dialog on the same Frame, shown in place of this one
-- rather than over it: two modal dialogs at once is one setModal too many, and
-- there is nothing behind the menu worth seeing anyway. What is *in* that dialog
-- is Scripts/Views/OptionsView, the same view the pause menu puts up mid-game.

Startup = Startup or class("Startup", Stage)

-- Motion. The menu comes in as a block, rising into place, and its buttons follow
-- one after another; swapping to the options and back fades the outgoing page up
-- and away before the incoming one rises in. Every button is a MenuButton, which
-- does its own hover and press.
local INTRO_TIME < const > = 0.55
local INTRO_RISE < const > = 18
local STAGGER_START < const > = 0.20   -- first button's delay behind the dialog
local STAGGER_STEP < const > = 0.07    -- ...and each one after it
local PAGE_OUT_TIME < const > = 0.14
local PAGE_OUT_RISE < const > = -10    -- negative: drifts up as it goes
local PAGE_IN_TIME < const > = 0.30
local PAGE_IN_RISE < const > = 14
local LEAVE_TIME < const > = 0.20

-- Fade a dialog's clip between two alphas while it drifts vertically, `rise` px
-- below its place when transparent. A dialog is only ever driven by one of these:
-- starting another stops the first, so a page closed half way in does not have two
-- tweens fighting over it. The drift is re-read from the placement each step, so a
-- resize mid-fade still lands where the layout puts it.
local function fadeDialog(dialog, from, to, rise, duration, easeFn, doneFn)
	if dialog._fadeTween ~= nil then
		dialog._fadeTween:stop()
	end
	local mc < const > = dialog._mc
	dialog._fadeTween = Tween(0, 1, duration, function(k, done)
		local a < const > = from + (to - from) * (done and 1 or easeFn(k))
		mc.alpha = a
		mc.Y = dialog:getPlacement().y + rise * (1 - a)
		if done then
			dialog._fadeTween = nil
			-- Chains the next fade from inside this callback, which relies on the
			-- engine's Tween.update fix: before it, a tween created here was lost
			-- and the next page sat invisible at alpha 0.
			if doneFn ~= nil then doneFn() end
		end
	end)
end

function Startup:new(params, environment)
	Stage.new(self, params, environment)

	-- Initialize UiKit. Three kits: the title logo's own movie (UI/Title), the HUD's
	-- (UI/Hud) and UiKit's, which every Static and PushButton comes from.
	-- Scripts/Widgets/Title looks its export up across all of them, so UI/Title has to
	-- be listed here or it cannot build itself.
	--
	-- UI/Hud is here for one export and not for any HUD: it carries this game's own
	-- MC_Dialog, and Widget._createResource takes the first kit that has the name asked
	-- for -- so listing it *before* UiKit is what gives this stage's menus the same
	-- plain pane the in-game ones have instead of UiKit's grey panel. Nothing else on
	-- this stage reads from it; the cost is the movie being resident on the menu.
	Widget.initialize(
		environment.resource.resourceManager,
		{
			"\{2C9F5B10-4E73-4A18-B6D2-9A0F31E4C8B7}",
			"\{B11AC173-A951-4180-B16B-36F57D2603C8}",
			"\{6FC8E464-F249-674E-8FA9-1CD2547A0494}",
			"\{B45977D0-3D89-4FA7-BE4C-FAA9ED63A942}"
		}
	)

	setupUiKitStyles()

	-- Full-screen frame (virtual 640x360) hosting a centered menu dialog.
	local root = self.ui.root
	self._frame = Frame(root, 640, 360, TableLayout({ 100 }, { 100 }, 0, 0, 0, 0))

	-- Menu: the logo over one button per selectable stage, then Options and Exit.
	-- The Dialog auto-centers on its parent Frame; one column, one auto-height row each.
	--
	-- The logo goes *inside* the dialog rather than being floated over the frame
	-- above it. A Dialog centres itself on its Frame and offers no way to be placed,
	-- so a separately floated logo and a centred dialog would have had to be kept
	-- from overlapping by hand at every window size; as a row it is laid out with
	-- the buttons and the whole menu centres as one block. It replaces the old
	-- "SELECT STAGE" heading, which the logo now says better.
	--
	-- Continue heads the column when there is a saved night to go back to (Scripts/SaveGame),
	-- and is not there at all otherwise -- so the rows are counted rather than fixed.
	local canContinue < const > = SaveGame.exists(environment)
	local rows = { 0, 0, 0, 0 }   -- the logo, New Game, Options, Exit
	if canContinue then
		table.insert(rows, 0)
	end
	self._dialog = Dialog(self._frame, TableLayout({ 0 }, rows, 24, 24, 0, 16))

	self._title = Title(self._dialog)

	-- Every button is explicitly centred. A Widget with no horizontal alignment set
	-- falls through Widget:place to "take the whole cell", and PushButton:place then
	-- stretches its background to match -- so against a 520 px logo they would each
	-- have become 520 px wide instead of the 220 asked for here.
	local buttonContinue = nil
	if canContinue then
		buttonContinue = MenuButton(self._dialog, "CONTINUE")
		buttonContinue:setMinimumWidth(220)
		buttonContinue:setHorizontalAlign(Widget.ALIGN_CENTER)
		buttonContinue:setOnClick(function() self:_continue() end)
	end

	-- New Game starts the night afresh. The saved one is kept until the new night saves over it
	-- -- through the pause menu, or at the cave mouth -- so a New Game abandoned in the first
	-- minute costs nothing.
	local buttonTerrain = MenuButton(self._dialog, "NEW GAME")
	buttonTerrain:setMinimumWidth(220)
	buttonTerrain:setHorizontalAlign(Widget.ALIGN_CENTER)
	buttonTerrain:setOnClick(function() self:_select("TERRAIN") end)

	-- No button for the caves: they are reached from the forest, through the cave mouth in
	-- Scene 2, with whatever the player is carrying (see Scripts/StageExit).

	-- Options: graphics quality, which is the whole of it for now.
	local buttonOptions = MenuButton(self._dialog, "OPTIONS")
	buttonOptions:setMinimumWidth(220)
	buttonOptions:setHorizontalAlign(Widget.ALIGN_CENTER)
	buttonOptions:setOnClick(function() self:_showOptions() end)

	-- Exit: quit the application.
	local buttonExit = MenuButton(self._dialog, "EXIT")
	buttonExit:setMinimumWidth(220)
	buttonExit:setHorizontalAlign(Widget.ALIGN_CENTER)
	buttonExit:setOnClick(function() self:_leave(function() self:terminate() end) end)

	self._buttons = { buttonTerrain, buttonOptions, buttonExit }
	if buttonContinue ~= nil then
		table.insert(self._buttons, 1, buttonContinue)
	end

	-- The options dialog, built here and kept hidden: the view brings the rows, this
	-- stage brings the box they sit in. Parented to the same Frame as the menu, which
	-- is not a detail -- a Dialog on a Frame of its own would never receive a click
	-- (see the one-Frame rule in Scripts/Main).
	self._optionsDialog = Dialog(self._frame, TableLayout({ 0 }, { 0 }, 24, 24, 0, 0))
	self._options = OptionsView(self._optionsDialog, environment)
	self._options:setOnClose(function() self:_hideOptions() end)

	-- Frame rate, top right. Last on the Frame so neither dialog covers it.
	self._fps = FpsCounter(self._frame, environment)

	self._frame:update()
	self._dialog:show()

	-- Bring the menu in. Placed by show() above, so the drift has a place to settle to.
	fadeDialog(self._dialog, 0, 1, INTRO_RISE, INTRO_TIME, Ease.outCubic)
	for i, button in ipairs(self._buttons) do
		button:reveal(STAGGER_START + STAGGER_STEP * (i - 1))
	end

	-- Release the mouse cursor so the menu buttons are clickable.
	environment.input.inputSystem:setExclusive(false)
end

-- Enter the Loading stage, which is what actually streams in the gameplay stage
-- named by "target" (one of Stages/Loading's own transitions) and shows a loading
-- panel while it does. This stage's only transition is LOADING; the Loading stage
-- itself is cheap, so this load returns almost immediately.
--
-- Guard so a second click while a load is already in flight is ignored. The load
-- starts at once, alongside the menu fading out; update() holds the switch until
-- both are done, so the fade never costs any loading time.
function Startup:_select(target)
	if self._loader ~= nil or self._leaving or self._paging then
		return
	end
	self._loader = self:loadStageAsync("LOADING", { target = target })
	self:_leave(nil)
end

-- Continue the saved night: read it back and hand it to the Loading stage exactly as a trip
-- between stages hands over what the player carries (Scripts/Main leaveStage) -- the stage it
-- was saved in, and everything about the player and the worlds -- with where the player stood
-- riding along in it. Guarded like _select. A save that cannot be read is said so in the log and
-- leaves the menu where it is.
function Startup:_continue()
	if self._loader ~= nil or self._leaving or self._paging then
		return
	end
	local save < const > = SaveGame.read(self.environment)
	if save == nil or save.target == nil then
		print("Startup: the saved night could not be read")
		return
	end
	self._loader = self:loadStageAsync("LOADING", { target = save.target, carry = save.carry })
	self:_leave(nil)
end

-- Fade the menu out, then call doneFn. Sets _leaving for the duration, which both
-- blocks the other buttons and is what update() waits on before switching stage.
function Startup:_leave(doneFn)
	if self._leaving or self._paging then
		return
	end
	self._leaving = true
	fadeDialog(self._dialog, 1, 0, PAGE_OUT_RISE, LEAVE_TIME, Ease.inQuad, function()
		self._left = true
		if doneFn ~= nil then doneFn() end
	end)
end

-- Fade one page of the menu out and the other in. _paging blocks further clicks
-- until the outgoing page has gone -- it is still modal and clickable while it
-- fades. Hide first and show second, for the modal (see below).
function Startup:_page(from, to, beforeShow)
	if self._paging or self._leaving then
		return
	end
	self._paging = true
	fadeDialog(from, 1, 0, PAGE_OUT_RISE, PAGE_OUT_TIME, Ease.inQuad, function()
		from:hide()
		if beforeShow ~= nil then beforeShow() end
		to:show()
		fadeDialog(to, 0, 1, PAGE_IN_RISE, PAGE_IN_TIME, Ease.outCubic)
		self._paging = false
	end)
end

-- Swap the menu for the options. Hidden first and shown second, in both directions:
-- Dialog:show takes the modal, Dialog:hide releases it, and doing it the other way
-- round would leave the one being put away holding it.
function Startup:_showOptions()
	self:_page(self._dialog, self._optionsDialog, function() self._options:refresh() end)
end

function Startup:_hideOptions()
	self:_page(self._optionsDialog, self._dialog, nil)
end

function Startup:finalize()
	-- A fade still running would carry on into the next stage (tweens outlive stages)
	-- against dialogs removed just below.
	for _, dialog in ipairs({ self._dialog, self._optionsDialog }) do
		if dialog ~= nil and dialog._fadeTween ~= nil then
			dialog._fadeTween:stop()
			dialog._fadeTween = nil
		end
	end

	if self._optionsDialog ~= nil then
		self._optionsDialog:remove()
		self._optionsDialog = nil
		self._options = nil
	end
	if self._dialog ~= nil then
		self._dialog:remove()
		self._dialog = nil
	end
	if self._frame ~= nil then
		self._frame:remove()
		self._frame = nil
	end
end

function Startup:update(info)
	-- Drive UiKit's own animation clocks. Nothing else in the engine does -- only the
	-- editor's Scaffolding preview calls these -- so without this a Tween never
	-- advances and an Interval never fires. That is not cosmetic: Slider animates its
	-- knob through a Tween, so the options view's volume slider would track the value
	-- while its knob sat still, and the same view's deferred "apply the volume" waits
	-- on an Interval.
	Tween.update(info.simulationDeltaTime)
	Interval.update(info.simulationDeltaTime)

	self._fps:update(info.simulationDeltaTime)

	-- Keep the logo's flame alive. Above the loader poll, so it carries on burning
	-- through the moment between clicking a stage and the loading screen appearing.
	if self._title ~= nil then
		-- simulationDeltaTime, not frameDeltaTime: update() runs once per fixed
		-- simulation step, so the frame delta would make the flame frame-rate dependent.
		self._title:update(info.simulationDeltaTime)
	end

	-- Poll the async loader; once the loading stage is ready, switch to it.
	if self._loader ~= nil then
		if self._loader.ready and self._left then
			if self._loader.succeeded then
				self:gotoStage(self._loader:get())
			end
			self._loader = nil
		end
	end
end
]]></text>
</object>
