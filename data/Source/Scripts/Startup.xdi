<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{720C0A68-B608-2F40-8EBA-F7E42EB27F61}
#using \{FC4400A2-BDB6-BA45-9A22-12B9676E71FA}
#using \{9B4E27DA-6C81-4F35-A70E-1D5C83B2F604}

import(traktor)

-- Startup
--
-- A worldless stage: no scene, just a UiKit menu that lets the player pick
-- which gameplay stage to enter. Each button hands the chosen stage over to the
-- Loading stage, which shows a loading panel while it streams the world in.

Startup = Startup or class("Startup", Stage)

function Startup:new(params, environment)
	Stage.new(self, params, environment)

	-- Initialize UiKit. Two kits: the title logo's own movie (UI/Title) and UiKit's,
	-- which every Static and PushButton comes from. Scripts/Widgets/Title looks its
	-- export up across both, so UI/Title has to be listed here or it cannot build
	-- itself. Deliberately not the HUD movie -- nothing on this stage is HUD.
	Widget.initialize(
		environment.resource.resourceManager,
		{
			"\{2C9F5B10-4E73-4A18-B6D2-9A0F31E4C8B7}",
			"\{5ABEAE05-EB26-934F-932F-7F3C7C582383}"
		}
	)

	-- Full-screen frame (virtual 640x360) hosting a centered menu dialog.
	local root = self.ui.root
	self._frame = Frame(root, 640, 360, TableLayout({ 100 }, { 100 }, 0, 0, 0, 0))

	-- Menu: the logo over one button per selectable stage, then Exit. The Dialog
	-- auto-centers on its parent Frame; one column, three auto-height rows.
	--
	-- The logo goes *inside* the dialog rather than being floated over the frame
	-- above it. A Dialog centres itself on its Frame and offers no way to be placed,
	-- so a separately floated logo and a centred dialog would have had to be kept
	-- from overlapping by hand at every window size; as a row it is laid out with
	-- the buttons and the whole menu centres as one block. It replaces the old
	-- "SELECT STAGE" heading, which the logo now says better.
	self._dialog = Dialog(self._frame, TableLayout({ 0 }, { 0, 0, 0 }, 24, 24, 0, 16))

	self._title = Title(self._dialog)

	-- Both buttons are explicitly centred. A Widget with no horizontal alignment set
	-- falls through Widget:place to "take the whole cell", and PushButton:place then
	-- stretches its background to match -- so against a 520 px logo they would each
	-- have become 520 px wide instead of the 220 asked for here.
	local buttonTerrain = PushButton(self._dialog, "New Game")
	buttonTerrain:setMinimumWidth(220)
	buttonTerrain:setHorizontalAlign(Widget.ALIGN_CENTER)
	buttonTerrain:setOnClick(function() self:_select("TERRAIN") end)

	-- Exit: quit the application.
	local buttonExit = PushButton(self._dialog, "Exit")
	buttonExit:setMinimumWidth(220)
	buttonExit:setHorizontalAlign(Widget.ALIGN_CENTER)
	buttonExit:setOnClick(function() self:terminate() end)

	self._frame:update()
	self._dialog:show()

	-- Release the mouse cursor so the menu buttons are clickable.
	environment.input.inputSystem:setExclusive(false)
end

-- Enter the Loading stage, which is what actually streams in the gameplay stage
-- named by "target" (one of Stages/Loading's own transitions) and shows a loading
-- panel while it does. This stage's only transition is LOADING; the Loading stage
-- itself is cheap, so this load returns almost immediately.
--
-- Guard so a second click while a load is already in flight is ignored.
function Startup:_select(target)
	if self._loader ~= nil then
		return
	end
	self._loader = self:loadStageAsync("LOADING", { target = target })
end

function Startup:finalize()
	if self._dialog ~= nil then
		self._dialog:remove()
		self._dialog = nil
	end
	if self._frame ~= nil then
		self._frame:remove()
		self._frame = nil
	end
end

function Startup:update(info)
	-- Keep the logo's flame alive. Above the loader poll, so it carries on burning
	-- through the moment between clicking a stage and the loading screen appearing.
	if self._title ~= nil then
		-- simulationDeltaTime, not frameDeltaTime: update() runs once per fixed
		-- simulation step, so the frame delta would make the flame frame-rate dependent.
		self._title:update(info.simulationDeltaTime)
	end

	-- Poll the async loader; once the loading stage is ready, switch to it.
	if self._loader ~= nil then
		if self._loader.ready then
			if self._loader.succeeded then
				self:gotoStage(self._loader:get())
			end
			self._loader = nil
		end
	end
end
]]></text>
</object>
