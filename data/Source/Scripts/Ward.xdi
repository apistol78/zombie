<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using {6E9AD100-0000-4000-8000-000000000010}
import(traktor)

-- Ward
--
-- A consecration ward: a stone pillar that stands bare and dark until the player
-- carries a relic to this post and spends it here, at which point Main calls
-- turnOn() on this component. What E does at the post, and that it takes a relic in
-- the off hand, is the entity's zombie.InteractableComponentData and LockComponentData;
-- E calls interact() with the relic the lock took (Main:_interact).
--
-- Everything a lit ward *shows* hangs off a "Switch" child entity: the relic set at
-- the post ("SpentRelic") and the flame above it ("Flame", a point LightComponent),
-- held by that child's own GroupComponent and fronted by a FacadeComponent whose
-- authored show list is empty -- so the engine hides the lot as the ward is built.
-- Lighting the ward brings them up; the flame then eases to full with a flare and
-- holds. The relic the player carried is not left on the ground for this: it is put
-- out of sight and the post shows its own (see Scripts/Relic).
--
-- The Stage owns *which* ward lights and the no-spawn ground each one buys (see
-- Main:_publishWards); this component owns only what the post looks like. The flame
-- light's authored colour -- stored premultiplied by intensity -- is the lit target,
-- and the component blacks it out until turnOn.
--
-- Attach to an entity whose GroupComponent holds a child named "Switch" carrying a
-- FacadeComponent and a GroupComponent, that group holding "Flame" and "SpentRelic".

Ward = Ward or class("Ward", traktor.world.ScriptComponent)

local IGNITE_RATE < const > = Config.ward.igniteRate   -- how fast the flame catches once lit (1/s)

-- Light it. Idempotent: turning on an already-lit ward does nothing. Pass instant=true to
-- snap straight to full (the restore path, below); omit it for the flare-up a fresh
-- consecration earns. Lit is kept by the world (the entity's zombie.FixtureComponent), so a
-- post the player comes back to, or a hot reload, finds it burning.
function Ward:turnOn(instant)
	if self._lit then
		return
	end
	self._lit = true
	self._ignite = instant and 1.0 or 0.0
	self._flare = not instant

	local fixture < const > = self.owner:getComponent(zombie.FixtureComponent)
	if fixture ~= nil then
		fixture.done = true
	end

	-- A lit post takes no more relics.
	local interactable < const > = self.owner:getComponent(zombie.InteractableComponent)
	if interactable ~= nil then
		interactable.enabled = false
	end
end

function Ward:isOn()
	return self._lit == true
end

-- E at the dark post, with `relic` out of the pack: the stage lights it (Main:_consecrate).
function Ward:interact(context, relic)
	context:_consecrate(self.owner, relic)
end

-- Find (once) and cache the "Switch" child: the entity whose facade holds everything
-- a lit ward shows.
function Ward:_resolveSwitch()
	if self._switch ~= nil then
		return self._switch
	end
	local group = self.owner:getComponent(traktor.world.GroupComponent)
	if group == nil then
		return nil
	end
	self._switch = group:getEntity("Switch", 0)
	return self._switch
end

-- Find (once) and cache the flame's LightComponent off the "Flame" entity behind
-- the switch.
function Ward:_resolveLight()
	if self._light ~= nil then
		return self._light
	end
	local sw = self:_resolveSwitch()
	if sw == nil then
		return nil
	end
	local group = sw:getComponent(traktor.world.GroupComponent)
	if group == nil then
		return nil
	end
	local flame = group:getEntity("Flame", 0)
	if flame == nil then
		return nil
	end
	self._light = flame:getComponent(traktor.world.LightComponent)
	return self._light
end

-- Bring up everything the lit ward shows: whatever the switch is authored with, in
-- one call, so adding to the post in the editor needs nothing in here.
--
-- Driven from update rather than done in turnOn so it cannot be missed: turnOn is
-- also called from Main:resolve, while the world is still being put together, and a
-- reveal dropped there would leave a lit ward standing dark for the rest of the night.
function Ward:_reveal()
	if not self._lit or self._revealed then
		return
	end
	local sw < const > = self:_resolveSwitch()
	if sw == nil then
		return
	end
	local facade < const > = sw:getComponent(traktor.world.FacadeComponent)
	if facade == nil then
		return
	end
	facade:showAll()
	self._revealed = true

	-- The relic catching as the post takes it, raised on the relic that just came up
	-- rather than on the one the player was holding -- that one is already out of
	-- sight. Skipped on the reload-restore path, which is putting a ward that already
	-- burns back the way it was rather than consecrating anything.
	if self._flare then
		local group < const > = sw:getComponent(traktor.world.GroupComponent)
		local relic < const > = group ~= nil and group:getEntity("SpentRelic", 0) or nil
		if relic ~= nil then
			local fx < const > = relic:getComponent(traktor.world.EventSetComponent)
			if fx ~= nil then
				fx:raise("sparkle")
			end
		end
	end
end

function Ward:update(context, totalTime, deltaTime)
	-- Lit already as far as the world is concerned: light it again, without the flare.
	if not self._lit then
		local fixture < const > = self.owner:getComponent(zombie.FixtureComponent)
		if fixture ~= nil and fixture.done then
			self:turnOn(true)
		end
	end

	self:_reveal()

	local light = self:_resolveLight()
	if light == nil then
		return
	end

	-- First sight of the light: capture its authored (premultiplied) colour as the
	-- lit target, then apply the current state. Done on the first update rather than
	-- in :new() because the child light is not resolvable until the entity is built
	-- and grouped -- and doing it here, before anything is drawn, means the ward
	-- never flashes lit for a frame before going dark.
	if self._full == nil then
		local c < const > = light.color
		self._full = Vector4(c.x, c.y, c.z, c.w)
		if not self._lit then
			light.color = Vector4(0.0, 0.0, 0.0, 0.0)
			return
		end
	end

	if not self._lit then
		return
	end

	-- Ease up to full once lit, overshooting and settling so it catches with a
	-- flare rather than fading up like a dimmer. A fully-caught ward is left alone.
	if self._ignite < 1.0 then
		self._ignite = math.min(1.0, self._ignite + deltaTime * IGNITE_RATE)
		local t < const > = self._ignite
		local k
		if t < 0.35 then
			k = (t / 0.35) * 1.7
		else
			k = 1.7 - 0.7 * ((t - 0.35) / 0.65)
		end
		light.color = self._full * k
	else
		light.color = self._full
	end
end
]]></text>
</object>
