<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[#using \{7EA9C000-0000-4000-8000-000000000002}
#using \{7EA9C000-0000-4000-8000-000000000003}
#using \{7EA9C000-0000-4000-8000-000000000008}
#using \{7EA9C000-0000-4000-8000-000000000012}
#using \{3C7F91A6-5D24-4E8B-9A03-7B61E2D4C085}

import(traktor)

-- Loadout
--
-- What the player has in their hands, and the only thing the Stage talks to about it. Main
-- hands it buttons and frames -- trigger, cast, reload, cycle, update, place -- and it
-- routes them at whichever Scripts/Weapons/Weapon is drawn, and the right button at the
-- readied spell (Scripts/Spells/Spellbook).
--
-- Which weapons the player *has* is not decided here any more. It is the pack's
-- (a zombie.Inventory, reached as context:inventory()): owning a weapon is having its item
-- in the pack, and drawing it is equipping that item. So every weapon below exists from the
-- start of the night whether or not it has been found, and what this file does is read the pack
-- and keep the hands in step with it:
--
--   * The drawn weapon is whatever the pack has equipped as its "weapon", or nothing. The mouse
--     wheel (cycle) and the inventory screen both change it the same way -- by equipping.
--   * A weapon that leaves the pack -- dropped, or the last grenade thrown -- is told so (lost),
--     and if it was the one in hand the trigger is handed to the next weapon owned.
--   * A weapon that arrives while the hands are empty is drawn.
--
-- Adding a weapon is a Weapon subclass, one entry in the list below naming its item (with a
-- WeaponTrait saying what it loads), and the item in the story's list: it gets a place in the
-- wheel, a HUD seat, its frames ticked and its view model placed and stowed, with nothing to
-- change in Main or the HUD layout.
--
-- Two rules here are deliberate and worth keeping:
--
--   * Every weapon is updated and resolved, owned or not. An arrow in flight and a grenade
--     already in the air are nobody's weapon at all -- including after the last one in the pack
--     has gone.
--   * The right mouse button casts the readied spell rather than belonging to a weapon, so it
--     answers whatever is drawn -- or with nothing in hand at all. See Scripts/Spells/Spellbook.

Loadout = Loadout or class("Loadout")

-- The item each weapon is (data/Source/Story/Items).
local BOW < const > = Guid("\{D1A10000-0000-4000-8000-000000000200}")
local STAFF < const > = Guid("\{D1A10000-0000-4000-8000-000000000210}")
local GRENADE < const > = Guid("\{D1A10000-0000-4000-8000-000000000202}")

function Loadout:new(context)
	self._context = context

	-- The wheel's order, and the order the seats stand on the HUD's carousel. The bow first
	-- because it is the night's own weapon, the staff for what is already too close, then the
	-- thing that answers a crowd rather than a target. Only the ones in the pack are on the wheel.
	self._weapons = {
		Bow(context, BOW),
		Staff(context, STAFF),
		Grenades(context, GRENADE)
	}

	-- Not a weapon: what the right button always reaches, whatever is drawn.
	self._spellbook = Spellbook(context)
	self._casting = false   -- the right button is waiting for the weapon in hand to go down

	-- What the pack said last time it changed: which weapons were in it, and which was drawn.
	-- Kept so a change can be told apart from the state it changed to -- "the bow has just
	-- gone" rather than "there is no bow" -- which is what the hand-off below runs on.
	self._owned = {}
	self._drawn = nil

	context:inventory():listen(function() self:_inventoryChanged() end)
	self:_inventoryChanged()
end

-- The drawn weapon, or nil with empty hands.
function Loadout:current()
	local kind < const > = Items.keyOf(self._context:inventory():getEquipped(Items.WEAPON))
	if kind == nil then
		return nil
	end
	return self:find(kind)
end

-- The weapon that is this item (Weapon:item), or nil.
function Loadout:find(item)
	for _, w in ipairs(self._weapons) do
		if w:item() == item then
			return w
		end
	end
	return nil
end

function Loadout:owns(w)
	return self._owned[w] == true
end

-- Draw the next weapon in the pack. Bound to the mouse wheel; `step` is how many places to move
-- and wraps either way. With empty hands it draws the first owned (or, backwards, the last).
--
-- Done by equipping, which is the one way the drawn weapon ever changes -- so the wheel and the
-- inventory screen cannot disagree about what is in hand.
function Loadout:cycle(step)
	local owned = {}
	local at = 0
	local cur < const > = self:current()
	for _, w in ipairs(self._weapons) do
		if self:owns(w) then
			table.insert(owned, w)
			if w == cur then
				at = #owned
			end
		end
	end
	local n < const > = #owned
	if n == 0 or (n == 1 and at == 1) then
		return
	end
	local s < const > = step or 1
	local i
	if at == 0 then
		i = (s > 0) and 1 or n
	else
		i = ((at - 1 + s) % n) + 1
	end
	self._context:inventory():equip(owned[i]:item())
end

-- The pack changed. Called by the pack itself, after every change, with the change complete;
-- an equip made from in here is announced again once this has returned, so this can simply
-- return after making one (zombie.Inventory announces a change made by a listener once
-- the listeners have all heard the one before).
function Loadout:_inventoryChanged()
	local inv < const > = self._context:inventory()

	local lostAt = nil
	local gained = nil
	for i, w in ipairs(self._weapons) do
		local owned < const > = inv:count(w:item()) > 0
		if owned ~= self:owns(w) then
			self._owned[w] = owned
			if owned then
				gained = gained or w
			else
				w:lost()
				if w == self._drawn then
					lostAt = i
				end
			end
		end
	end

	-- Hand the trigger on. The weapon in hand has gone -- thrown away, or thrown -- so the next
	-- one owned along the wheel is drawn, the way a hand reaches for whatever is left. A weapon
	-- arriving while nothing is drawn is drawn, so the first one found is in hand at once.
	--
	-- Neither happens when the hands were emptied on purpose (Main:unequipItem): nothing was
	-- *lost* then, and the next weapon is the player's to reach for.
	if Items.keyOf(inv:getEquipped(Items.WEAPON)) == nil then
		if lostAt ~= nil then
			local n < const > = #self._weapons
			for k = 1, n - 1 do
				local w < const > = self._weapons[((lostAt - 1 + k) % n) + 1]
				if self:owns(w) then
					inv:equip(w:item())
					return
				end
			end
		elseif gained ~= nil and self._drawn == nil then
			inv:equip(gained:item())
			return
		end
	end

	self:_announce()

	-- Every seat's count, whatever changed: it is cheap, and a weapon's count is whatever the
	-- pack holds of what it loads.
	for _, w in ipairs(self._weapons) do
		w:_pushHud()
	end
end

-- Tell the weapons which of them now has the trigger, and turn the carousel to it. The
-- weapons are only told on a change; the carousel is told everything every time, which costs
-- it nothing when nothing moved.
function Loadout:_announce()
	local cur < const > = self:current()
	if cur ~= self._drawn then
		self._drawn = cur
		for _, w in ipairs(self._weapons) do
			w:selectionChanged(w == cur)
		end
	end
	if self._carousel ~= nil then
		local seat = nil
		for i, w in ipairs(self._weapons) do
			local s < const > = self._hudSlot[i]
			if s ~= nil then
				self._carousel:setPresent(s, self:owns(w))
				if w == cur then
					seat = s
				end
			end
		end
		self._carousel:setSelected(seat)
	end
end

-- Build that tile: one carousel, one seat per weapon that shows itself, in wheel order -- so
-- the ring turns the same way the wheel does. Each weapon is handed its seat index and pushes
-- its own state in from there; which seats are on the ring at all is the pack's, and _announce
-- keeps it so.
--
-- _hudSlot maps a place in the loadout to a seat on the ring, which are not the same list the
-- moment one weapon does not show itself.
function Loadout:createHud(parent)
	self._carousel = WeaponCarousel(parent)
	self._hudSlot = {}
	for i, w in ipairs(self._weapons) do
		if w:hasHud() then
			self._hudSlot[i] = self._carousel:addSlot(w:slot(), w:hudName())
			w:attachHud(self._carousel, self._hudSlot[i])
		end
	end
	self:_announce()
end

-- Above Main's freeze returns: the tile's own animations keep running while the game does not,
-- so a magazine spent on the last frame before a pause still finishes counting down.
function Loadout:updateHud(dt)
	if self._carousel ~= nil then
		self._carousel:update(dt)
	end
end

function Loadout:resolve()
	for _, w in ipairs(self._weapons) do
		w:resolve()
	end
	self._spellbook:resolve()
end

function Loadout:reset()
	for _, w in ipairs(self._weapons) do
		w:reset()
	end
	self._spellbook:reset()
	self._casting = false
end

-- What every weapon holds of its own, keyed by its item, for the trip to another stage (see
-- Weapon:saveState). Plain data; the pack carries the rest.
function Loadout:snapshot()
	local out = {}
	for _, w in ipairs(self._weapons) do
		out[w:item()] = w:saveState()
	end
	return out
end

-- ...and handed back on arrival, with every seat's count redrawn from it.
function Loadout:restore(states)
	if states == nil then
		return
	end
	for _, w in ipairs(self._weapons) do
		w:restoreState(states[w:item()])
		w:_pushHud()
	end
end

-- Below Main's freeze returns: cadences, arrows, fuses and spells all stop with the game.
function Loadout:update(dt)
	for _, w in ipairs(self._weapons) do
		w:update(dt)
	end
	self._spellbook:update(dt)

	-- A cast waiting on the weapon in hand goes the moment it is down. Asked again each step, so a
	-- weapon drawn or taken up meanwhile is put down too.
	if self._casting then
		local w < const > = self:current()
		if w == nil or w:isLowered() then
			self._casting = false
			self._spellbook:cast()
		else
			w:lower()
		end
	end
end

-- Left button, handed over as both a press and a hold: the drawn weapon decides which of the
-- two it reads (Weapon:trigger). Nothing happens with empty hands.
function Loadout:trigger(pressed, held)
	local w < const > = self:current()
	if w == nil then
		return false
	end
	return w:trigger(pressed, held)
end

-- Right button: the readied spell, whatever is in hand -- which is lowered first, the spell
-- leaving once it is down (see :update). Nothing is lowered for a spell that could not go.
function Loadout:cast()
	if self._casting or not self._spellbook:ready() then
		return false
	end
	local w < const > = self:current()
	if w ~= nil and not w:isLowered() then
		w:lower()
		self._casting = true
		return true
	end
	return self._spellbook:cast()
end

-- R. Offered to every weapon owned, the drawn one first, for any that loads from the pack;
-- neither the bow nor the grenades do, so today it answers nothing.
function Loadout:reload()
	local cur < const > = self:current()
	local any = false
	if cur ~= nil and cur:beginReload() then
		any = true
	end
	for _, w in ipairs(self._weapons) do
		if w ~= cur and self:owns(w) and w:beginReload() then
			any = true
		end
	end
	return any
end

-- H. The infinite ammunition cheat, handed to every weapon rather than only the drawn one --
-- a cheat that refilled whatever happened to be in hand and nothing else would be a strange
-- thing to explain. What "full" means is each weapon's own business (Weapon:setInfiniteAmmo).
function Loadout:setInfiniteAmmo(on)
	for _, w in ipairs(self._weapons) do
		w:setInfiniteAmmo(on)
	end
end

-- Nothing in hand has nothing to aim.
function Loadout:wantsCrosshair()
	local w < const > = self:current()
	return w ~= nil and w:wantsCrosshair()
end

-- The view models: the drawn weapon placed at the eye, every other one put away -- owned or
-- not. Stowing outright rather than lowering is deliberate: with two weapons on screen there
-- is no telling at a glance what the left button would do. The readied spell shows in the
-- left hand.
function Loadout:place()
	local cur < const > = self:current()
	for _, w in ipairs(self._weapons) do
		if w == cur then
			w:place()
		else
			w:stow()
		end
	end
	self._spellbook:place()
end
]]></text>
</object>
