<object type="traktor.script.Script" version="2">
	<text><![CDATA[#using \{6E9AD100-0000-4000-8000-000000000010}
#using \{17E40000-0000-4000-8000-000000000001}

import(traktor)

-- Weapon
--
-- Base class for anything the player carries and uses. It exists so that the Stage does
-- not have to know what is in the player's hands: Main routes buttons and frames at a
-- Scripts/Weapons/Loadout, the loadout routes them at whichever Weapon is drawn, and what
-- a trigger pull actually *does* lives in the subclass -- Scripts/Weapons/Bow,
-- Scripts/Weapons/Grenades.
--
-- Adding a weapon is therefore a subclass, one line in the Loadout and an entry for its item
-- in Scripts/Items/Items, with nothing to change in Main. Which weapons the player actually
-- has is the pack's business, not this file's: a weapon exists from the start of the night,
-- and owning it is having its item in the inventory. What is below is the whole of what the stage promises to call, and every
-- method has a default here, so a subclass writes only the ones it has an opinion about.
--
-- `context` is the Stage -- the Main instance -- exactly as in Scripts/Pickup, and it is
-- the only thing a weapon is handed. What it may ask of it (see "what a weapon is given"
-- in Main, which is where these are defined):
--
--   context:eye()                  where a shot, a swing or a throw starts from
--   context:aim()                  ...the rotation it goes out along, and
--   context:aimDirection()         the same thing as a direction
--   context:player()               the Humanoid entity, or nil before it is resolved
--   context:isRunning()            sprinting, so a view model can drop to a low ready
--   context:isCarrying()           a relic is held in the off hand, so a view model moves over
--   context:inventory()            the pack (a zombie.Inventory): owning a weapon is having
--                                  its item in it, and its ammunition is the item its
--                                  WeaponTrait names -- the "arrows" for the bow
--   context:killEnemy(e, p, i, w)  the one way anything in this game dies
--   context:isEnemyDead(e)         ...and whether it already has
--   context:shoveCorpse(...)       ...and what hitting one that already has does
--   context:knockbackImpulse(dir)  what a corpse is shoved with
--   context:reportGunshot(x, z)    published to the horde, which comes to look
--   context:kickCrosshair()        recoil bloom on the reticle
--   context:raisePlayerEffect(...) a puff of dust where a round landed
--   context.world                  the WorldLayer, for building and removing entities
--   context.environment            physics, input and resources
--
-- Everything a weapon needs about where the player is looking comes through those first
-- three rather than off the fields behind them, which is what keeps this from being a
-- second copy of the aiming code: change how the player aims and every weapon follows.
--
-- Cadence is the one piece of behaviour the base owns outright, because every weapon has
-- it and no two agree on the number: set _interval in the constructor, ask self:ready()
-- before acting, and set self._cooldown = self._interval when you do.

Weapon = Weapon or class("Weapon")

-- How fast a weapon that lowers goes down out of shot, or back up (1/s), and how far down
-- counts as down; see :lower.
local LOWER_RATE < const > = 10.0
local LOWERED < const > = 0.9

function Weapon:new(context, item)
	self._context = context
	self._item = Items.keyOf(item)   -- the item in the pack that is this weapon; see :item
	self._interval = 0.0   -- minimum seconds between uses; the subclass sets it
	self._cooldown = 0.0   -- ...and counts down to the next one being allowed
	self._infiniteAmmo = false   -- the H cheat; see :setInfiniteAmmo
	self._drawn = false    -- whether the trigger is on this one; see :selectionChanged

	-- Being put down out of the way; see :lower. A subclass that lowers sets _lowers and
	-- _lowerAfter, ticks :_tickLowering and places its view model by _lower.
	self._lowers = false
	self._lowerAfter = 0.0  -- seconds in hand and unused before it goes down by itself
	self._lowered = false   -- put down, until it is next used
	self._lower = 0.0       -- ...and the view model on its way there, 0..1
	self._idle = 0.0        -- seconds in hand and not used
end

-- What this weapon is called on the HUD: the carousel seat it sits in is "seat_" .. this
-- (Scripts/Widgets/WeaponCarousel), so keep it stable.
function Weapon:slot()
	return "weapon"
end

-- Which item in the pack *is* this weapon, as its key: the one the loadout made it with
-- (Scripts/Weapons/Loadout). Having one in the pack is owning the weapon, and equipping it is
-- drawing it -- the loadout asks nothing else. One that is not an item at all answers nil.
function Weapon:item()
	return self._item
end

-- The item this weapon loads from the pack -- arrows for the bow, as its item's WeaponTrait says --
-- or nil for one that carries nothing spare. Only read by :reserve and :_takeFromPack below.
function Weapon:ammoItem()
	local def < const > = Items.get(self._item)
	return (def ~= nil) and def.ammo or nil
end

-- How much of this weapon's ammunition is in the pack: what the HUD writes, and the most a
-- reload can load.
function Weapon:reserve()
	local kind < const > = self:ammoItem()
	if kind == nil then
		return 0
	end
	return self._context:inventory():count(kind)
end

-- Take up to `n` of this weapon's ammunition out of the pack; returns how many came out.
function Weapon:_takeFromPack(n)
	local kind < const > = self:ammoItem()
	if kind == nil or n <= 0 then
		return 0
	end
	local taken < const > = self._context:inventory():remove(kind, n)
	return taken
end

-- This weapon's item has left the pack -- dropped, or the last grenade thrown. Anything it had
-- in flight that would take from the pack later (a reload, with its rounds still to load) is
-- put down here, so a weapon nobody owns never touches the pack again. What it has *loaded*
-- stays with it, so a rifle dropped with four in the magazine is picked back up with four.
function Weapon:lost()
end

-- Live handles off the world: a view model entity, its event set, its trail. Called every
-- frame from Loadout:resolve, exactly as Main:resolve is called from Main:update -- so it
-- has to be cheap once it has what it wants, and it has to cope with a world that is not
-- there yet.
function Weapon:resolve()
end

-- Let go of every live entity handle, for a script hot reload: the world comes back new
-- and anything held here belongs to the old one. Plain numbers -- rounds carried,
-- grenades in the pouch -- deliberately stay, which is the point of the split: a reload
-- must not quietly resupply the player. See Main:reload.
function Weapon:reset()
end

-- What this weapon holds that the pack does not -- the rounds loaded in it -- as plain data, or
-- nil for one that holds nothing of its own. Taken when the player leaves for another stage and
-- handed back to the same weapon in the stage they arrive in (Loadout:snapshot / :restore), so a
-- rifle carried into the cave with four in the magazine comes out of the loading screen with
-- four. Anything in flight -- a reload half done, a grenade in the air -- is left behind.
function Weapon:saveState()
	return nil
end

function Weapon:restoreState(state)
end

-- Does this weapon take a seat on the HUD's weapon carousel? Asked as the carousel is built
-- -- see Loadout:createHud.
--
-- A weapon that says yes also needs a seat authored for it in data/Assets/UI/Hud.svg, under
-- its own slot name; see Scripts/Widgets/WeaponCarousel, which refuses one it has no art for
-- rather than turning past a gap.
function Weapon:hasHud()
	return false
end

-- What is written beside the ring while this weapon is the one in hand. Short: the space is
-- the width of a word, and the icon in the socket has already said which weapon it is.
function Weapon:hudName()
	return string.upper(self:slot())
end

-- Which seat of the carousel is this weapon's. Handed over once, from Loadout:createHud, and
-- kept so everything below can push into it -- nothing about the HUD is ever polled.
--
-- The nil check every push carries is not defensive noise: a weapon may be carried in a stage
-- that never built a HUD at all, and both of the game's scenes are allowed to be that stage.
function Weapon:attachHud(hud, index)
	self._hud = hud
	self._hudSlot = index
	self:_pushHud()
end

-- Write what this weapon has left into its seat. Overridden by anything that carries a count;
-- called on attach, and thereafter from wherever that count changes.
function Weapon:_pushHud()
end

-- The drawn weapon changed. The carousel is told separately, by the loadout; this is for the
-- weapon's own sake. The base keeps the answer in _drawn, which is what the firearms' empty
-- magazine rule reads -- only the weapon in hand reloads itself unasked, since a stowed one doing
-- it would quietly spend the pack's rounds on a gun nobody is holding.
function Weapon:selectionChanged(selected)
	self._drawn = selected
	if selected then
		self:_used()
	end
end

-- One simulation step of the weapon itself -- below Main's freeze returns, so a reload in
-- flight and a grenade in the air both stop with the rest of the game.
--
-- Every weapon in the loadout is ticked, not only the drawn one: a reload continues while
-- the other weapon is in hand, and a thrown grenade has left regardless of what is being
-- held afterwards.
function Weapon:update(dt)
	if self._cooldown > 0.0 then
		self._cooldown = math.max(0.0, self._cooldown - dt)
	end

	-- The cheat, applied here rather than at the trigger: a weapon spends its ammunition
	-- exactly as it always did -- the shot still costs a round, and the HUD still counts it
	-- down and flashes -- and the count is simply back at the top before the next one. That is
	-- the whole reason it is done this way: no attack path grows an `if cheating`, and
	-- everything hung off a count (the auto-reload, the crosshair, the red plate) keeps
	-- working untouched, on numbers that never reach zero.
	--
	-- Main ticks the loadout before it hands it the trigger, so a weapon is topped up on the
	-- frame it is fired rather than on the one after.
	if self._infiniteAmmo then
		self:_topUp()
	end
end

function Weapon:ready()
	return self._cooldown <= 0.0
end

-- The trigger, as the stage sees it: `pressed` is the one frame the button went down, `held`
-- is every frame it is down, that first one included. A weapon reads whichever of the two it
-- wants, and that is the whole of what makes a weapon automatic or not -- which is why there is
-- no flag for it anywhere in Main.
--
-- Overriding this is the escape hatch for a trigger that is neither: a burst that fires three
-- and stops, something that winds up while held and lets go on release.
function Weapon:trigger(pressed, held)
	if self:automatic() then
		if held then
			return self:attack()
		end
	elseif pressed then
		return self:attack()
	end
	return false
end

-- Does the trigger keep firing while it is held, or go off once per press? Read only by
-- :trigger above.
function Weapon:automatic()
	return false
end

-- What actually goes off. Called by :trigger once the button state says so, so nothing here has
-- to think about how the button was read -- an automatic weapon's rate is its own cadence
-- (:ready), never the frame rate of the press. Returns true when something happened.
function Weapon:attack()
	return false
end

-- The reload action (R). Offered to every weapon the player owns, the drawn one first,
-- because topping up a half-empty magazine with a grenade in hand is exactly the lull the key
-- exists for -- and first, because weapons may share what they load and the one in
-- hand is the one that should get them. Returns true when a reload began.
function Weapon:beginReload()
	return false
end

-- Infinite ammunition (H), set from Main through the loadout and offered to every weapon
-- rather than only the drawn one -- a cheat that only refilled whatever happened to be in
-- hand would be a strange thing to explain.
--
-- Kept as a plain field here so a weapon never has to ask the stage anything, and it
-- deliberately survives Weapon:reset for the same reason the ammunition counts do: a script
-- hot reload is not a way to turn a cheat off.
function Weapon:setInfiniteAmmo(on)
	self._infiniteAmmo = on
	if on then
		self:_topUp()
	end
end

-- Fill whatever this weapon carries back to the top, in its own units. Called on the frame the
-- cheat goes on and from :update while it is on, so it is written to cost nothing when there is
-- nothing missing -- an early-out on the counts, not a HUD push a frame.
--
-- A weapon with nothing to count leaves it alone, which is why there is a default here at
-- all: the loadout offers the cheat to everything it carries without asking first which of
-- them has anything to fill.
function Weapon:_topUp()
end

-- Is there an aim worth drawing a reticle for? Asked of the drawn weapon only, so the
-- crosshair follows what is in hand rather than being wired to the rifle's magazine.
function Weapon:wantsCrosshair()
	return true
end

-- Where the view model goes while this weapon is the one in hand, and what becomes of it
-- while it is not. Called from Main:postUpdate after the camera has been placed from the
-- same eye and aim, so a model is welded to the view rather than trailing a frame behind
-- it.
function Weapon:place()
end

function Weapon:stow()
end

-- Put the weapon down out of the way until it is next used. The right button asks this of the
-- drawn weapon before a spell leaves the left hand, and casts once :isLowered says it is down
-- (Loadout:cast). A weapon that never lowers is always down.
function Weapon:lower()
	if self._lowers then
		self._lowered = true
	end
end

function Weapon:isLowered()
	return not self._lowers or (self._lowered and self._lower >= LOWERED)
end

-- In use: brought back up, and the clock that puts it down by itself started over.
function Weapon:_used()
	self._lowered = false
	self._idle = 0.0
end

-- Left in hand for _lowerAfter without being used it goes down by itself; `busy` is it being
-- used right now. Eases _lower towards where it is going.
function Weapon:_tickLowering(dt, busy)
	if not self._lowers then
		return
	end
	if self._drawn and not busy and not self._lowered then
		self._idle = self._idle + dt
		if self._idle >= self._lowerAfter then
			self._lowered = true
		end
	end
	local target < const > = self._lowered and 1.0 or 0.0
	self._lower = self._lower + (target - self._lower) * math.min(1.0, dt * LOWER_RATE)
end
]]></text>
</object>
