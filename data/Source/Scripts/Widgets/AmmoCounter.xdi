<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{FC4400A2-BDB6-BA45-9A22-12B9676E71FA}

import(traktor)

-- AmmoCounter
--
-- HUD counter for the rifle: a brass cartridge on a plate with "magazine /
-- reserve" beside it. The art is the "MC_AmmoCounter" export of the UI/Hud
-- movie, authored in data/Assets/UI/Hud.svg; it deliberately reuses the
-- treasure counter's plate so the two right hand tiles read as a matched pair.
--
-- Layers in the SVG, back to front, and how each is driven:
--
--   shadow       static
--   warn         red rim proud of the plate; alpha pulses while the mag is dry
--   plate        steel plate; static
--   reloadtrack  channel the reload sweep runs in; shown only while reloading
--   reload       the sweep itself; scaled horizontally by reload progress
--   round        the cartridge; scales up on each shot
--   casing       spent case; arcs away and fades on each shot
--   glow         white overlay; alpha kicked when a magazine comes back up
--
-- Fixed size, so the row never shifts as the count changes, and the text is
-- re-placed by hand on every change (as in TreasureCounter -- a Widget lays
-- out no children).
--
-- GOTCHA: the SVG importer bakes every shape at absolute movie coordinates, so
-- a child sprite's origin is the movie's origin, not the art's. Scaling *or
-- rotating* one swings it away from that origin, hence the helpers below,
-- which translate back so a chosen pivot stays put.

AmmoCounter = AmmoCounter or class("AmmoCounter", Widget)

AmmoCounter:setStyle("resource", "MC_AmmoCounter")

-- All of these must match data/Assets/UI/Hud.svg (see tools/gen_hud_svg.py).
local W < const > = 180
local H < const > = 56
local ROUND_X < const > = 28
local ROUND_Y < const > = 28
local RELOAD_X < const > = 50
local TEXT_X < const > = 50
local TEXT_W < const > = 120

local C_TEXT < const > = Color4f(1.0, 0.9, 0.68, 1.0)
local C_TEXT_EMPTY < const > = Color4f(1.0, 0.42, 0.34, 1.0)
local C_OUTLINE < const > = Color4f(0.0, 0.0, 0.0, 1.0)

-- Uniform scale about the point (px, py).
local function scaleAbout(mc, px, py, s)
	mc.scale = Vector2(s * 100, s * 100)
	mc.X = px * (1 - s)
	mc.Y = py * (1 - s)
end

-- Horizontal scale about the vertical line x = px.
local function scaleX(mc, px, s)
	mc.xScale = s * 100
	mc.X = px * (1 - s)
end

-- Rotate about (px, py) and then shift by (dx, dy). setRotation takes degrees
-- and rotates about the sprite origin, so the first two terms of X/Y undo the
-- swing that puts (px, py) back where the art was authored.
local function spinAbout(mc, px, py, deg, dx, dy)
	local r < const > = math.rad(deg)
	local c < const > = math.cos(r)
	local s < const > = math.sin(r)
	mc.rotation = deg
	mc.X = px - (px * c - py * s) + dx
	mc.Y = py - (px * s + py * c) + dy
end

function AmmoCounter:new(parent, skin)
	local mc < const > = Widget._createResource(parent, skin or self:getStyle().resource)
	assert(mc ~= nil, "AmmoCounter; no such movie resource, is UI/Hud in the resource kits?")
	self:_initialize(parent, mc)
end

function AmmoCounter:getPreferredSize()
	return { width = W, height = H }
end

function AmmoCounter:place(x, y, width, height)
	Widget.place(self, x, y, width, height)
	self:_layoutText()
end

-- Rounds in the magazine and in reserve. An empty magazine recolours the count
-- and lights the warning rim, which then pulses until it is refilled.
function AmmoCounter:setAmmo(mag, reserve)
	self._text:setText(tostring(mag) .. " / " .. tostring(reserve))
	self:_layoutText()

	local empty < const > = (mag <= 0)
	if empty ~= self._empty then
		self._empty = empty
		self._warn_mc.visible = empty
		self._text:setTextColor(empty and C_TEXT_EMPTY or C_TEXT)
		if not empty then
			self._warn_mc.alpha = 0.0
		end
	end
	return self
end

-- Kick the fire animation: the cartridge jumps and a case is flung clear.
function AmmoCounter:spend()
	self._kick = 1.0
	self._eject = 1.0
	return self
end

-- Reload progress in 0..1, or nil for "not reloading". Going from a progress
-- back to nil is what flashes the plate, so call it once the mag is refilled.
function AmmoCounter:setReload(t)
	if t == nil then
		if self._reload ~= nil then
			self._reload = nil
			self._track_mc.visible = false
			self._bar_mc.visible = false
			self._flash = 1.0
		end
		return self
	end

	if self._reload == nil then
		self._track_mc.visible = true
		self._bar_mc.visible = true
	end
	self._reload = math.max(0.0, math.min(1.0, t))
	return self
end

function AmmoCounter:update(dt)
	-- Shot: the round jumps...
	if self._kick > 0.0 then
		self._kick = math.max(0.0, self._kick - dt * 4.5)
		scaleAbout(self._round_mc, ROUND_X, ROUND_Y, 1.0 + 0.3 * math.sin(self._kick * math.pi))
	end

	-- ...and the spent case tumbles out to the right, arcing up then falling.
	if self._eject > 0.0 then
		self._eject = math.max(0.0, self._eject - dt * 1.7)
		local t < const > = 1.0 - self._eject
		spinAbout(
			self._casing_mc, ROUND_X, ROUND_Y, t * 540.0,
			t * 34.0,
			-24.0 * math.sin(t * math.pi * 0.85) + 30.0 * t * t
		)
		self._casing_mc.alpha = 1.0 - t * t
		self._casing_mc.visible = (self._eject > 0.0)
	end

	-- Reload sweep. Never scaled to exactly zero; the bar is hidden instead.
	if self._reload ~= nil then
		scaleX(self._bar_mc, RELOAD_X, math.max(0.02, self._reload))
	end

	-- Magazine back up.
	if self._flash > 0.0 then
		self._flash = math.max(0.0, self._flash - dt * 2.2)
		self._glow_mc.alpha = math.sin(self._flash * math.pi) * 0.35
	end

	-- Dry: pulse the rim until there is something to shoot with again.
	if self._empty then
		self._pulse = (self._pulse + dt * 1.8) % 1.0
		self._warn_mc.alpha = 0.35 + 0.45 * math.abs(math.sin(self._pulse * math.pi))
	end
end

-- Private

function AmmoCounter:_initialize(parent, mc)
	Widget._initialize(self, parent, mc)

	-- Rasterized once into the sprite atlas and thereafter drawn as a single quad.
	-- Every animation in update is behind a condition -- kick, eject, reload, flash,
	-- dry pulse -- so a counter which isn't being shot holds its cache.
	mc.cacheAsBitmap = true

	self._halign = Widget.ALIGN_CENTER
	self._valign = Widget.ALIGN_CENTER

	self._kick = 0.0
	self._eject = 0.0
	self._flash = 0.0
	self._pulse = 0.0
	self._reload = nil
	self._empty = false

	self._warn_mc = mc:getMember("warn")
	self._track_mc = mc:getMember("reloadtrack")
	self._bar_mc = mc:getMember("reload")
	self._round_mc = mc:getMember("round")
	self._casing_mc = mc:getMember("casing")
	self._glow_mc = mc:getMember("glow")
	assert(self._round_mc ~= nil, "AmmoCounter; movie resource is missing its parts")

	self._warn_mc.visible = false
	self._track_mc.visible = false
	self._bar_mc.visible = false
	self._casing_mc.visible = false
	self._glow_mc.alpha = 0.0

	-- Created after the art so it ends up on top of it.
	self._text = Static(self, "0 / 0")
	self._text:setTextSize(22)
	self._text:setTextColor(C_TEXT)
	self._text:setTextOutlineColor(C_OUTLINE)
	self._text:setHorizontalAlign(Widget.ALIGN_CENTER)
	self:_layoutText()
end

-- Centre the count in the space the art leaves beside the cartridge.
function AmmoCounter:_layoutText()
	local ts < const > = self._text:getPreferredSize()
	self._text:place(TEXT_X, (H - ts.height) / 2, TEXT_W, ts.height)
end
]]></text>
</object>
