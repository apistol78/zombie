<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{FC4400A2-BDB6-BA45-9A22-12B9676E71FA}

import(traktor)

-- Crosshair
--
-- The aiming reticle at the centre of the screen. Unlike the other HUD widgets it
-- does not ride the bottom plate: Main floats it (ILayout.FLOAT) over the middle of
-- the view and hides it whenever a relic is carried -- the reticle belongs to the
-- rifle, and a hand comes off the rifle to hold the relic.
--
-- The art is the "MC_Crosshair" export of the UI/Hud movie (data/Assets/UI/Hud.svg,
-- generated by tools/gen_hud_svg.py): four ticks around a centre dot, each tick a
-- named child sprite ("up"/"down"/"left"/"right") so a shot can spring them outward
-- and let them ease back -- the same self-animating shape the other HUD widgets use
-- (AmmoCounter's kicked round, HealthBar's flash).
--
-- Authored centred in a square box (CH_W in the generator); Main places the box so
-- its centre lands on the screen centre, which is exactly where the shot ray goes,
-- so dead centre marks the point of aim.

Crosshair = Crosshair or class("Crosshair", Widget)

Crosshair:setStyle("resource", "MC_Crosshair")

-- Must match the CH_* box in tools/gen_hud_svg.py.
local W < const > = 40
local H < const > = 40

local KICK_OUT < const > = 5.0     -- how far each tick springs out on a shot (px)
local KICK_DECAY < const > = 9.0   -- kick easing (1/s)

function Crosshair:new(parent, skin)
	local mc < const > = Widget._createResource(parent, skin or self:getStyle().resource)
	assert(mc ~= nil, "Crosshair; no such movie resource, is UI/Hud in the resource kits?")
	self:_initialize(parent, mc)
end

function Crosshair:getPreferredSize()
	return { width = W, height = H }
end

-- Recoil bloom: spring the four ticks outward from the centre. Eased back to rest in
-- update, so a burst keeps it open and a lull lets it settle. Called by Main on each
-- shot that actually fires.
function Crosshair:kick()
	self._kick = 1.0
	return self
end

function Crosshair:update(dt)
	if self._kick > 0.0 then
		self._kick = math.max(0.0, self._kick - dt * KICK_DECAY)
		local d < const > = self._kick * KICK_OUT
		self._up_mc.Y = -d
		self._down_mc.Y = d
		self._left_mc.X = -d
		self._right_mc.X = d
	end
end

-- Private

function Crosshair:_initialize(parent, mc)
	Widget._initialize(self, parent, mc)

	-- Rasterized once into the sprite atlas and thereafter drawn as a single quad.
	-- Rests between shots -- the ticks are only written while the kick decays -- so
	-- the cache holds for most frames.
	mc.cacheAsBitmap = true

	self._halign = Widget.ALIGN_CENTER
	self._valign = Widget.ALIGN_CENTER

	self._kick = 0.0

	self._up_mc = mc:getMember("up")
	self._down_mc = mc:getMember("down")
	self._left_mc = mc:getMember("left")
	self._right_mc = mc:getMember("right")
	assert(self._up_mc ~= nil, "Crosshair; movie resource is missing its parts")
end
]]></text>
</object>
