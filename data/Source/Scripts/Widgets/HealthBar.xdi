<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{FC4400A2-BDB6-BA45-9A22-12B9676E71FA}

import(traktor)

-- HealthBar
--
-- In game health bar, Skyrim's: a long thin red bar in a pointed silver frame,
-- bottom centre, that drains from both ends towards the middle and fades away
-- altogether once the player has been at full health for a while. Its art is
-- authored in data/Assets/UI/Hud.svg and imported as a Spark movie (UI/Hud); this
-- widget instantiates that movie's "MC_HealthBar" export and animates the named
-- sprites inside it. The movie has to be listed in the Widget.initialize resource
-- kits of whoever uses the widget (see Scripts/Main and
-- Scripts/Scaffolding/GameScaffolding).
--
-- Layers in the SVG, back to front, and how each is driven:
--
--   shadow  smoke behind the frame; static
--   warn    red glow round the frame; alpha pulses when health is critical
--   plate   the silver frame and its finials; static
--   track   the empty channel the fill runs in; static
--   ghost   damage lag bar; scaled horizontally about the centre
--   fill    the health fill, drawn greyscale; scaled about the centre and tinted
--   flash   white overlay; alpha kicked on every hit
--
-- GOTCHA: the SVG importer bakes every shape at absolute movie coordinates, so
-- a child sprite's origin is the movie's origin, not the art's. Scaling one
-- pushes it away from that origin -- hence scaleX below, which translates back
-- so the centre of the track stays put.

HealthBar = HealthBar or class("HealthBar", Widget)

HealthBar:setStyle("resource", "MC_HealthBar")

-- All of these must match data/Assets/UI/Hud.svg (see tools/gen_hud_svg.py).
local W < const > = 360
local H < const > = 40
local CENTRE_X < const > = 180    -- middle of the track, which the bar drains towards

local NO_SHIFT < const > = Color4f(0.0, 0.0, 0.0, 0.0)

-- Skyrim's red, whatever the health. The fill art is greyscale so this one
-- colour transform shades the whole bar.
local TINT < const > = { 0.92, 0.17, 0.13 }

-- Full health and nothing happening: after this long the bar fades out, and it
-- comes straight back on any change.
local IDLE_HIDE < const > = 3.0     -- seconds at full health before fading
local FADE_OUT < const > = 1.2      -- how fast it goes (1/s)
local FADE_IN < const > = 6.0       -- ...and comes back

-- Horizontal scale about the vertical line x = px.
local function scaleX(mc, px, s)
	mc.xScale = s * 100
	mc.X = px * (1 - s)
end

function HealthBar:new(parent, skin)
	local mc < const > = Widget._createResource(parent, skin or self:getStyle().resource)
	assert(mc ~= nil, "HealthBar; no such movie resource, is UI/Hud in the resource kits?")
	self:_initialize(parent, mc)
end

function HealthBar:getPreferredSize()
	return { width = W, height = H }
end

-- Set health as a 0..1 fraction. Losing health kicks the hit flash and leaves
-- the ghost bar behind to drain; gaining it pulls the ghost straight up, so no
-- lag bar is ever shown for healing.
function HealthBar:setValue(value)
	value = math.max(math.min(value, 1.0), 0.0)
	if value < self._value then
		self._flash = 1.0
		self._hold = 0.4
	elseif value > self._value then
		self._ghost = value
	end
	if value ~= self._value then
		self._idle = 0.0
	end
	self._value = value
	return self
end

function HealthBar:getValue()
	return self._value
end

-- Keep the bar up regardless of health, or let it fade at full health again.
-- For screens that are about the bar itself, such as the scaffolding.
function HealthBar:setAlwaysShown(always)
	self._alwaysShown = always == true
	return self
end

-- Tick the animations; call once per frame. Safe to keep calling while the
-- game is paused or over, nothing in here touches gameplay.
function HealthBar:update(dt)
	-- Damage lag: hold for a moment after the hit, then drain to the real value.
	if self._ghost > self._value then
		if self._hold > 0.0 then
			self._hold = self._hold - dt
		else
			self._ghost = math.max(self._value, self._ghost - dt * 0.45)
		end
	else
		self._ghost = self._value
	end

	-- Hit flash.
	if self._flash > 0.0 then
		self._flash = math.max(0.0, self._flash - dt * 3.5)
		self._flash_mc.alpha = self._flash * 0.45
	end

	-- Critical glow, pulsing, fading in over the last quarter of health.
	local critical < const > = 1.0 - math.min(self._value / 0.25, 1.0)
	self._pulse = (self._pulse + dt * 2.2) % 1.0
	self._warn_mc.alpha = critical * (0.3 + 0.7 * (0.5 + 0.5 * math.sin(self._pulse * math.pi * 2)))

	-- Tint the greyscale fill, washed brighter for as long as a hit flash lasts.
	local k < const > = 1.0 + self._flash * 0.35
	self._fill_mc.colorTransform = traktor.spark.ColorTransform(
		Color4f(TINT[1] * k, TINT[2] * k, TINT[3] * k, 1.0),
		NO_SHIFT
	)

	-- Lengths. A zero scale would leave a degenerate transform behind, so the
	-- bars are hidden rather than scaled to nothing.
	self:_setLength(self._fill_mc, self._value)
	self:_setLength(self._ghost_mc, self._ghost)

	-- Skyrim's bar is only there while it has something to say: full and unchanged
	-- for a few seconds and it fades away.
	local settled < const > = (self._value >= 1.0) and (self._ghost >= 1.0) and not self._alwaysShown
	if settled then
		self._idle = self._idle + dt
	else
		self._idle = 0.0
	end
	local target < const > = (settled and self._idle >= IDLE_HIDE) and 0.0 or 1.0
	if self._shown < target then
		self._shown = math.min(target, self._shown + dt * FADE_IN)
	elseif self._shown > target then
		self._shown = math.max(target, self._shown - dt * FADE_OUT)
	end
	self._mc.alpha = self._shown
end

-- Private

function HealthBar:_initialize(parent, mc)
	Widget._initialize(self, parent, mc)

	-- Rasterized once into the sprite atlas and thereafter drawn as a single quad.
	-- Nothing in here moves at rest -- the glow only pulses below a quarter health --
	-- so the cache holds while the player is not being hurt.
	mc.cacheAsBitmap = true

	-- Fixed size art, so never let a layout stretch the placement past it. Bottom
	-- centre of whatever it is placed in, as Skyrim has it.
	self._halign = Widget.ALIGN_CENTER
	self._valign = Widget.ALIGN_BOTTOM

	self._value = 1.0
	self._ghost = 1.0
	self._hold = 0.0
	self._flash = 0.0
	self._pulse = 0.0
	self._idle = 0.0
	self._shown = 1.0
	self._alwaysShown = false

	self._ghost_mc = mc:getMember("ghost")
	self._fill_mc = mc:getMember("fill")
	self._flash_mc = mc:getMember("flash")
	self._warn_mc = mc:getMember("warn")
	assert(self._fill_mc ~= nil, "HealthBar; movie resource is missing its parts")

	self._flash_mc.alpha = 0.0
	self._warn_mc.alpha = 0.0

	self:update(0.0)
end

function HealthBar:_setLength(mc, value)
	if value > 0.002 then
		mc.visible = true
		scaleX(mc, CENTRE_X, value)
	else
		mc.visible = false
	end
end
]]></text>
</object>
