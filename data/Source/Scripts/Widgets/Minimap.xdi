<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{FC4400A2-BDB6-BA45-9A22-12B9676E71FA}

import(traktor)

-- Minimap
--
-- The map in the top left corner: the ground around the player, north up, out to
-- RADIUS metres either side, with the player's arrow fixed in the middle and the
-- world moving under it -- a handful of landmarks, and the followed quest's waypoint.
--
-- What lies beyond the edge is not drawn, except the quest waypoint, which waits at
-- the edge in its direction so the map still says which way to go. There is no
-- clipping a sprite to the face, so a landmark is let go before it reaches the bezel.
--
-- Art: the "MC_Minimap" export of the UI/Hud movie (data/Assets/UI/Hud.svg,
-- generated by tools/gen_hud_svg.py) is the sheet -- smoke inside a double silver
-- rule with diamond corners, a faint quarter graticule and a north mark, in the
-- Skyrim style of the rest of the HUD -- and never changes. Everything on it is one of the small MC_Map* exports,
-- instantiated by :build() and moved around every frame (:setView and the setters
-- after it), which is the only way
-- to draw dynamically here: the dynamic canvas (SpriteInstance:createCanvas) is not
-- to be trusted.
--
-- Depth order comes from creation order, which is why :build() creates in exactly
-- this sequence and the per-frame setters never create anything:
--
--   landmarks     a pictogram of the building, with its name lettered under it
--   quest         the followed quest's waypoint (Scripts/Quests), when it has one here
--   player        on top, so it is never lost under a marker
--
-- GOTCHA: the SVG importer bakes every shape at absolute movie coordinates, so a
-- clip's origin is the *movie's* origin, not the art's. Every marker is therefore
-- authored centred on (BLIP_C, BLIP_C) and pulled back by that when placed -- see
-- placeBlip, which is the translation analogue of ObjectiveMarker's spinAbout.

Minimap = Minimap or class("Minimap", Widget)

Minimap:setStyle("resource", "MC_Minimap")

-- All of these must match tools/gen_hud_svg.py.
local W < const > = 200
local H < const > = 200
local BEZEL < const > = 11           -- MM_NEAT_IN; the inner border line, where the map face starts
local FACE < const > = W - BEZEL * 2
local BLIP_C < const > = 40          -- authored centre of every MC_Map* marker

-- Landmark drawings, the child sprites of MC_MapLandmark: each is a pictogram with
-- the place's name lettered under it, so the names live in the generator
-- (LANDMARK_NAMES), not here. Main's LANDMARKS table picks one per landmark;
-- anything else gets the plain surveyor's mark, which has no name.
local GLYPHS < const > = { "chapel", "tower", "altar", "mark" }
local GLYPH_DEFAULT < const > = "mark"

local EDGE_INSET < const > = 3       -- how far inside the bezel a clamped quest pin sits

-- How far the map reaches from the player, to each edge of the face (m). Twice this
-- across, so 60 shows the village and a little of the forest round it.
local RADIUS < const > = 60.0

-- How far inside the bezel a landmark's centre has to be to be drawn at all (px): it is a
-- pictogram with its name under it, and is let go a little early rather than drawn half
-- over the frame.
local LANDMARK_INSET < const > = 14

-- The sheet's own parts (tools/gen_hud_svg.py, minimap()), which never move.
local SHEET < const > = { "shadow", "paper", "graticule", "border", "rose" }

-- Place a marker so its authored centre lands on (px, py) in widget space. The offset
-- is about the movie origin, hence the BLIP_C.
local function placeBlip(mc, px, py)
	mc.X = px - BLIP_C
	mc.Y = py - BLIP_C
end

function Minimap:new(parent, skin)
	local mc < const > = Widget._createResource(parent, skin or self:getStyle().resource)
	assert(mc ~= nil, "Minimap; no such movie resource, is UI/Hud in the resource kits?")
	self:_initialize(parent, mc)
end

function Minimap:getPreferredSize()
	return { width = W, height = H }
end

-- How far the map reaches from the player (m), if not RADIUS.
function Minimap:setRadius(r)
	self._radius = math.max(r, 1.0)
	self._scale = FACE * 0.5 / self._radius
	return self
end

-- Instantiate every marker the scene needs, once, in the depth order documented
-- above. landmarks is a list of { x = , z = , glyph = }; they never move in the
-- world, but the map moves under them, so :setView places them every frame.
function Minimap:build(landmarks)
	for _, l in ipairs(landmarks or {}) do
		local mc < const > = self:_create("MC_MapLandmark")
		mc.visible = false

		local glyph = l.glyph
		if glyph == nil or mc:getMember(glyph) == nil then
			glyph = GLYPH_DEFAULT
		end
		for _, name in ipairs(GLYPHS) do
			local glyph_mc < const > = mc:getMember(name)
			if glyph_mc ~= nil then
				glyph_mc.visible = (name == glyph)
			end
		end

		table.insert(self._landmarks, { mc = mc, x = l.x, z = l.z })
	end

	-- Not asserted, unlike the rest: art from before there were quests simply has no pin.
	self._quest = Widget._createResource(self, "MC_MapQuest")
	if self._quest ~= nil then
		self._quest.visible = false
	end

	self._player = self:_create("MC_MapPlayer")
	self._player.visible = false

	return self
end

-- Where the player is and which way they are facing (heading in radians, as
-- Main:_heading): the middle of the map, and what everything else is drawn around.
-- First thing every frame, before the setters below, which place what they are
-- given relative to this. Also moves the landmarks, which nobody else tells about.
function Minimap:setView(x, z, heading)
	self._cx = x
	self._cz = z

	for _, l in ipairs(self._landmarks) do
		local lx, ly = self:_project(l.x, l.z)
		local inside < const > = self:_inside(lx, ly, LANDMARK_INSET)
		l.mc.visible = inside
		if inside then
			placeBlip(l.mc, lx, ly)
		end
	end

	if self._player == nil then
		return self
	end
	local px < const > = W * 0.5
	local py < const > = H * 0.5

	-- The map is north up and Spark turns clockwise from up, which is exactly how
	-- the heading is measured: forward is (sin h, 0, cos h), so h = 0 faces +Z,
	-- and +Z is up here. The arrow therefore takes the heading unmodified.
	local deg < const > = math.deg(heading or 0.0)
	local r < const > = math.rad(deg)
	local c < const > = math.cos(r)
	local s < const > = math.sin(r)
	self._player.rotation = deg
	self._player.X = px - (BLIP_C * c - BLIP_C * s)
	self._player.Y = py - (BLIP_C * s + BLIP_C * c)
	self._player.visible = true
	return self
end

-- The followed quest's waypoint, or nil to hide it. Clamped to the face, so a place
-- beyond the edge of the map still shows which way it lies.
function Minimap:setQuest(x, z)
	if self._quest == nil then
		return self
	end
	if x == nil then
		self._quest.visible = false
		return self
	end
	local px, py = self:_project(x, z)
	px = math.max(BEZEL + EDGE_INSET, math.min(W - BEZEL - EDGE_INSET, px))
	py = math.max(BEZEL + EDGE_INSET, math.min(H - BEZEL - EDGE_INSET, py))
	placeBlip(self._quest, px, py)
	self._quest.visible = true
	return self
end

-- Private

function Minimap:_initialize(parent, mc)
	Widget._initialize(self, parent, mc)

	-- Everything on the face moves whenever the player does, so only the sheet itself
	-- is cached, as the compass caches its plate.
	for _, name in ipairs(SHEET) do
		local part < const > = mc:getMember(name)
		if part ~= nil then
			part.cacheAsBitmap = true
		end
	end

	self._halign = Widget.ALIGN_LEFT
	self._valign = Widget.ALIGN_TOP

	self._landmarks = {}
	self._quest = nil
	self._player = nil
	self._cx = 0.0
	self._cz = 0.0
	self:setRadius(RADIUS)
end

function Minimap:_create(resource)
	local mc < const > = Widget._createResource(self, resource)
	assert(mc ~= nil, "Minimap; no such movie resource (" .. resource .. "), is UI/Hud in the resource kits?")
	return mc
end

-- World metres to widget pixels, about the player in the middle. North is up, so +Z
-- counts *up* the screen from there -- which is what makes the player arrow's heading
-- readable without any further correction (see setView).
function Minimap:_project(x, z)
	local s < const > = self._scale
	return W * 0.5 + (x - self._cx) * s, H * 0.5 - (z - self._cz) * s
end

-- Whether a marker centred at (px, py) and reaching `inset` pixels round it lies wholly on
-- the face.
function Minimap:_inside(px, py, inset)
	return px - inset >= BEZEL and px + inset <= W - BEZEL and py - inset >= BEZEL and py + inset <= H - BEZEL
end
]]></text>
</object>
