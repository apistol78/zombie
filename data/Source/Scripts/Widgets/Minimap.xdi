<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{FC4400A2-BDB6-BA45-9A22-12B9676E71FA}

import(traktor)

-- Minimap
--
-- The map in the top left corner: the whole play area at once, north up, with a
-- marker for every relic, every ward post and a handful of landmarks, and the
-- player's arrow moving over it.
--
-- Deliberately a *map* and not a radar. Since the player now decides which ward
-- each relic lights (see Scripts/Main), the question the HUD has to answer is
-- "which post is worth walking to", and that cannot be answered by a view that
-- only shows what is nearby -- you have to see the posts you are not standing
-- near, the ground they would consecrate, and how much of it overlaps ground that
-- is already lit. The compass tile handles "which way is that from here"; this
-- handles "where is everything".
--
-- Art: the "MC_Minimap" export of the UI/Hud movie (data/Assets/UI/Hud.svg,
-- generated by tools/gen_hud_svg.py) is the plate -- frame, ground, quarter grid
-- and the north tick -- and never changes. Everything on it is one of the small
-- MC_Map* exports, instantiated by :build() and moved around by the setters, which
-- is the only way to draw dynamically here: the dynamic canvas
-- (SpriteInstance:createCanvas) is not to be trusted.
--
-- Depth order comes from creation order, which is why :build() creates in exactly
-- this sequence and the per-frame setters never create anything:
--
--   ward areas    the consecrated discs, under everything
--   landmarks     and their labels
--   ward posts
--   relics
--   player        on top, so it is never lost under a marker
--
-- GOTCHA: the SVG importer bakes every shape at absolute movie coordinates, so a
-- clip's origin is the *movie's* origin, not the art's. Every marker is therefore
-- authored centred on (BLIP_C, BLIP_C) and pulled back by that when placed -- see
-- placeBlip, which is the translation analogue of ObjectiveMarker's spinAbout.

Minimap = Minimap or class("Minimap", Widget)

Minimap:setStyle("resource", "MC_Minimap")

-- All of these must match tools/gen_hud_svg.py.
local W < const > = 200
local H < const > = 200
local BEZEL < const > = 6            -- MM_BEZEL + 1; where the map face starts
local FACE < const > = W - BEZEL * 2
local BLIP_C < const > = 40          -- authored centre of every MC_Map* marker
local WARD_AREA_R < const > = 36     -- ...and the authored radius of the ward disc

local C_LABEL < const > = Color4f(0.62, 0.69, 0.77, 1.0)
local C_OUTLINE < const > = Color4f(0.0, 0.0, 0.0, 1.0)
local LABEL_SIZE < const > = 12
local LABEL_H < const > = 14         -- room for one line of it
local LABEL_W < const > = 72         -- wide enough for the longest landmark name
local LABEL_DY < const > = 5         -- gap between the landmark square and its name

local SPENT_ALPHA < const > = 0.3    -- a relic already spent stays on, faded back
local EDGE_INSET < const > = 3       -- how far inside the bezel a clamped arrow sits

-- Place a marker so its authored centre lands on (px, py) in widget space, with an
-- optional scale about that same centre. Both the offset and the scale are about
-- the movie origin, hence the BLIP_C * s.
local function placeBlip(mc, px, py, s)
	if s ~= nil then
		mc.xScale = s * 100.0
		mc.yScale = s * 100.0
		mc.X = px - BLIP_C * s
		mc.Y = py - BLIP_C * s
	else
		mc.X = px - BLIP_C
		mc.Y = py - BLIP_C
	end
end

function Minimap:new(parent, skin)
	local mc < const > = Widget._createResource(parent, skin or self:getStyle().resource)
	assert(mc ~= nil, "Minimap; no such movie resource, is UI/Hud in the resource kits?")
	self:_initialize(parent, mc)
end

function Minimap:getPreferredSize()
	return { width = W, height = H }
end

-- The world square the face covers, in metres: its lower corner and its side. Set
-- before :build(), which projects the landmarks once. Main fits this to the scene's
-- own points of interest rather than to the terrain (see Main:_buildMinimap).
function Minimap:setExtent(minX, minZ, span)
	self._minX = minX
	self._minZ = minZ
	self._span = math.max(span, 1.0)
	self._maxZ = minZ + self._span
	return self
end

-- The no-spawn radius of a lit ward, in metres. Drives the size of the discs, so
-- the map keeps telling the truth if Main's _wardRadius is retuned.
function Minimap:setWardRadius(r)
	self._wardScale = (r / self._span * FACE) / WARD_AREA_R
	return self
end

-- Instantiate every marker the scene needs, once, in the depth order documented
-- above. landmarks is a list of { x = , z = , label = }; they never move, so this
-- is where they are projected and labelled.
function Minimap:build(relicCount, wardCount, landmarks)
	assert(self._span ~= nil, "Minimap; setExtent before build")

	for i = 1, wardCount do
		self._wardAreas[i] = self:_create("MC_MapWardArea")
		self._wardAreas[i].visible = false
	end

	for _, l in ipairs(landmarks or {}) do
		local mc < const > = self:_create("MC_MapLandmark")
		local px, py = self:_project(l.x, l.z)
		placeBlip(mc, px, py)

		local text < const > = Static(self, l.label or "")
		text:setTextSize(LABEL_SIZE)
		text:setTextColor(C_LABEL)
		text:setTextOutlineColor(C_OUTLINE)
		text:setHorizontalAlign(Widget.ALIGN_CENTER)
		text:place(px - LABEL_W / 2, py + LABEL_DY, LABEL_W, LABEL_H)

		table.insert(self._landmarks, { mc = mc, text = text })
	end

	for i = 1, wardCount do
		self._wards[i] = self:_create("MC_MapWard")
	end

	for i = 1, relicCount do
		self._relics[i] = self:_create("MC_MapRelic")
	end

	self._player = self:_create("MC_MapPlayer")
	self._player.visible = false

	return self
end

-- Where the player is and which way they are facing (heading in radians, as
-- Main:_heading). Clamped to the face rather than hidden when they walk off the
-- fitted extent, so the arrow still says which way out of the map they went. Pass
-- nil to park it.
function Minimap:setPlayer(x, z, heading)
	if self._player == nil then
		return self
	end
	if x == nil then
		self._player.visible = false
		return self
	end

	local px, py = self:_project(x, z)
	px = math.max(BEZEL + EDGE_INSET, math.min(W - BEZEL - EDGE_INSET, px))
	py = math.max(BEZEL + EDGE_INSET, math.min(H - BEZEL - EDGE_INSET, py))

	-- The map is north up and Spark turns clockwise from up, which is exactly how
	-- the heading is measured: forward is (sin h, 0, cos h), so h = 0 faces +Z,
	-- and +Z is up here. The arrow therefore takes the heading unmodified.
	local deg < const > = math.deg(heading or 0.0)
	local r < const > = math.rad(deg)
	local c < const > = math.cos(r)
	local s < const > = math.sin(r)
	self._player.rotation = deg
	self._player.X = px - (BLIP_C * c - BLIP_C * s)
	self._player.Y = py - (BLIP_C * s + BLIP_C * c)
	self._player.visible = true
	return self
end

-- One relic, by index. Relics move -- they are carried and then set down at a post
-- -- so this is pushed every frame rather than fixed at build time. A spent one
-- stays on the map, faded, because where the relics went *is* the record of which
-- ground was bought.
function Minimap:setRelic(i, x, z, spent)
	local mc < const > = self._relics[i]
	if mc == nil then
		return self
	end
	local px, py = self:_project(x, z)
	placeBlip(mc, px, py)
	mc.alpha = spent and SPENT_ALPHA or 1.0
	return self
end

-- One ward post, by index: the ring switches from hollow to filled when it lights,
-- and its consecrated disc appears underneath at the same moment.
function Minimap:setWard(i, x, z, lit)
	local mc < const > = self._wards[i]
	if mc == nil then
		return self
	end

	local px, py = self:_project(x, z)
	placeBlip(mc, px, py)

	local dark_mc < const > = mc:getMember("dark")
	local lit_mc < const > = mc:getMember("lit")
	if dark_mc ~= nil then
		dark_mc.visible = not lit
	end
	if lit_mc ~= nil then
		lit_mc.visible = lit
	end

	local area < const > = self._wardAreas[i]
	if area ~= nil then
		area.visible = lit
		if lit then
			placeBlip(area, px, py, self._wardScale)
		end
	end
	return self
end

-- Private

function Minimap:_initialize(parent, mc)
	Widget._initialize(self, parent, mc)

	-- Rasterized once into the sprite atlas and thereafter drawn as a single quad.
	-- NOTE setPlayer writes the blip's rotation and position every frame the player
	-- moves, so this only pays off while standing still. The static half -- bezel,
	-- landmarks and their labels, built once -- would be the better thing to cache,
	-- which means splitting it into its own child sprite first.
	mc.cacheAsBitmap = true

	self._halign = Widget.ALIGN_LEFT
	self._valign = Widget.ALIGN_TOP

	self._relics = {}
	self._wards = {}
	self._wardAreas = {}
	self._landmarks = {}
	self._player = nil
	self._wardScale = 1.0
end

function Minimap:_create(resource)
	local mc < const > = Widget._createResource(self, resource)
	assert(mc ~= nil, "Minimap; no such movie resource (" .. resource .. "), is UI/Hud in the resource kits?")
	return mc
end

-- World metres to widget pixels. North is up, so +Z counts *down* the screen from
-- the top of the face -- which is what makes the player arrow's heading readable
-- without any further correction (see setPlayer).
function Minimap:_project(x, z)
	local s < const > = FACE / self._span
	return BEZEL + (x - self._minX) * s, BEZEL + (self._maxZ - z) * s
end
]]></text>
</object>
