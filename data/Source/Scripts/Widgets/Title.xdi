<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
#using \{FC4400A2-BDB6-BA45-9A22-12B9676E71FA}

import(traktor)

-- Title
--
-- The game's logo, "VIGIL", on the Startup menu. The art is the "MC_Title" export
-- of the UI/Title movie (data/Assets/UI/Title.svg, generated by
-- tools/gen_title_svg.py) -- a separate movie from UI/Hud, since none of it is
-- HUD and the menu stage has no reason to load the HUD's art.
--
-- The letters are drawn as polygons rather than text, so no font has to be listed
-- in the MovieAsset, and the flame above them is the same amber as the ward
-- flames, the compass needle and the relic markers on the map.
--
-- The only thing that moves is the flame's brightness. Two sine waves at unrelated
-- rates multiplied together give a wander that never visibly repeats, which is
-- enough to stop the logo reading as a flat image without asking for a real
-- flicker curve. The glow swings harder than the flame so the pulse is carried by
-- the halo rather than by the shape, which would look like it was blinking.

Title = Title or class("Title", Widget)

Title:setStyle("resource", "MC_Title")

-- Must match the document in tools/gen_title_svg.py.
local W < const > = 520
local H < const > = 226

local GLOW_LOW < const > = 0.55    -- how far down the halo dips
local FLAME_LOW < const > = 0.88   -- ...and the flame itself, which barely moves

function Title:new(parent, skin)
	local mc < const > = Widget._createResource(parent, skin or self:getStyle().resource)
	assert(mc ~= nil, "Title; no such movie resource, is UI/Title in the resource kits?")
	self:_initialize(parent, mc)
end

function Title:getPreferredSize()
	return { width = W, height = H }
end

function Title:update(dt)
	self._t = self._t + dt

	-- Two incommensurate rates, so the product never settles into a beat.
	local f < const > = math.sin(self._t * 3.1) * math.sin(self._t * 7.7)
	local k < const > = 0.5 + 0.5 * f   -- 0 .. 1

	if self._glow_mc ~= nil then
		self._glow_mc.alpha = GLOW_LOW + (1.0 - GLOW_LOW) * k
	end
	if self._flame_mc ~= nil then
		self._flame_mc.alpha = FLAME_LOW + (1.0 - FLAME_LOW) * k
	end
end

-- Private

function Title:_initialize(parent, mc)
	Widget._initialize(self, parent, mc)

	self._halign = Widget.ALIGN_CENTER
	self._valign = Widget.ALIGN_CENTER

	self._t = 0.0
	self._glow_mc = mc:getMember("glow")
	self._flame_mc = mc:getMember("flame")
	assert(self._flame_mc ~= nil, "Title; movie resource is missing its parts")
end
]]></text>
</object>
