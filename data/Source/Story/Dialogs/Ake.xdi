		<item type="traktor.story.DialogNodeAsset" version="1">
			<id>{EB852977-20B1-4663-B71A-86C66C0C21A8}</id>
			<name>villinge</name>
			<text><![CDATA[NAILS. HINGES. NOTHING WORTH THE NAME. MY GRANDFATHER FORGED THE SWORD OF VILLINGE, AND IT WAS LOST IN THE CAVE UNDER THE RIDGE WHEN THE DEAD FIRST CAME.]]></text>
			<onEnter/>
			<responses>
				<item type="traktor.story.DialogResponseAsset" version="2">
					<id>{3645EFA2-3644-483F-8331-F5B9F6B27538}</id>
					<text>I WILL BRING IT BACK.</text>
					<target>{7C076143-DCB4-464D-A4F8-A78F5442B110}</target>
