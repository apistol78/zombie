		<item type="traktor.story.DialogNodeAsset" version="1">
			<id>{10B72A45-CDDE-4A7D-B44B-AB960AB102AA}</id>
			<name>sword</name>
			<text><![CDATA[IT IS... STILL SHARP. HE WOULD HAVE WANTED YOU TO HAVE SOMETHING FOR IT. TAKE THIS HELMET, I MADE IT FOR A MAN WHO NEVER CAME BACK.]]></text>
