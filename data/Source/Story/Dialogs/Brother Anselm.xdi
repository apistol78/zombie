					<condition type="zombie.QuestCondition" version="1">
						<quest>{D1A20000-0000-4000-8000-000000000100}</quest>
						<state>NotStarted</state>
						<step>{00000000-0000-0000-0000-000000000000}</step>
					</condition>
					<actions/>
					<once>false</once>
				</item>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{6367466E-8889-404E-83F2-0BF6495A7048}</id>
					<text>I HAVE YOUR LEDGER.</text>
					<target>{9F07EDC7-4255-4439-B7E8-A27756AEC6C7}</target>
