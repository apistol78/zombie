				<item type="zombie.DialogResponseAsset" version="2">
					<id>{94DD76E5-2BD5-4745-83C7-4209DB922183}</id>
					<text>WHERE ARE THE BANDITS?</text>
					<target>{938FEBCF-6AF6-46E9-988F-D11445F27E63}</target>
					<condition type="zombie.QuestCondition" version="1">
						<quest>{D1A20000-0000-4000-8000-000000000100}</quest>
						<state>AtStep</state>
						<step>{02B1CB0D-A001-4CF3-B1E9-37E5AFCBB945}</step>
					</condition>
					<actions/>
					<once>false</once>
				</item>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{FBE98A79-AA33-4904-B0E0-EE129807C3C6}</id>
					<text><![CDATA[WHAT ARE THE DARK POSTS PAST THE CHURCHYARD?]]></text>
					<target>{8D6281BE-F64F-48E4-BB13-C30D4DBA6CCA}</target>
					<condition type="zombie.QuestCondition" version="1">
						<quest>{D1A20000-0000-4000-8000-000000000105}</quest>
						<state>NotStarted</state>
						<step>{00000000-0000-0000-0000-000000000000}</step>
					</condition>
					<actions/>
					<once>false</once>
				</item>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{D556CC4E-724C-42F0-B2F9-68FAAF3ED2E9}</id>
					<text><![CDATA[THE WARDS ARE LIT. EVERY ONE OF THEM.]]></text>
					<target>{91466E19-822F-4510-9154-DDB5D58C60BF}</target>
					<condition type="zombie.QuestCondition" version="1">
						<quest>{D1A20000-0000-4000-8000-000000000105}</quest>
