		<item type="zombie.DialogNodeAsset" version="1">
			<id>{9F07EDC7-4255-4439-B7E8-A27756AEC6C7}</id>
			<name>thanks</name>
			<text><![CDATA[GOD BE THANKED. ONE THING MORE: SAY A PRAYER AT THE ALTAR FOR THE NAMELESS. PERHAPS THE NIGHT WILL BE KINDER TO US.]]></text>
			<onEnter/>
			<responses/>
			<position>720, 0</position>
		</item>
		<item type="zombie.DialogNodeAsset" version="1">
			<id>{938FEBCF-6AF6-46E9-988F-D11445F27E63}</id>
			<name>where</name>
			<text><![CDATA[A WOMAN CALLED BELLA LEADS THEM. THEY CAMP ON THE RIDGE TO THE WEST. SHE WILL NOT GIVE IT UP FOR KIND WORDS.]]></text>
			<onEnter/>
			<responses>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{CEF57FFD-3747-4E05-8FAF-29EC381C633B}</id>
					<text>I HAD ANOTHER QUESTION.</text>
					<target>{E0741AB5-5910-4A2E-859F-57D29FBB0811}</target>
					<condition/>
					<actions/>
					<once>false</once>
				</item>
			</responses>
			<position>720, 70</position>
		</item>
		<item type="zombie.DialogNodeAsset" version="1">
			<id>{631C6BCA-C15A-4046-BD08-A4F2A7CE849E}</id>
			<name>why</name>
			<text><![CDATA[BANDITS BROKE INTO THE CHAPEL AND TOOK THE BURIAL LEDGER. WITHOUT IT I CANNOT NAME THE DEAD, AND THE NAMELESS DO NOT SLEEP.]]></text>
			<onEnter/>
			<responses>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{B5C499F6-EB0D-4A8B-9BD3-9C6A83CC95DC}</id>
					<text>I WILL GET IT BACK.</text>
					<target>{938FEBCF-6AF6-46E9-988F-D11445F27E63}</target>
					<condition/>
					<actions>
						<item type="zombie.StartQuestAction">
							<quest>{D1A20000-0000-4000-8000-000000000100}</quest>
						</item>
					</actions>
					<once>false</once>
				</item>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{A7879947-A482-4B66-B107-F3DF5C3F2550}</id>
					<text>THAT IS NOT MY CONCERN.</text>
					<target>{E0741AB5-5910-4A2E-859F-57D29FBB0811}</target>
					<condition/>
					<actions/>
					<once>false</once>
				</item>
			</responses>
