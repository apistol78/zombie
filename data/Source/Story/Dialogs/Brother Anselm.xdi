							</item>
							<item type="zombie.QuestCondition" version="1">
								<quest>{D1A20000-0000-4000-8000-000000000105}</quest>
								<state>AtStep</state>
								<step>{A3F5EDEB-E252-4808-B2E8-F5719EAE274D}</step>
							</item>
						</conditions>
					</condition>
					<actions/>
