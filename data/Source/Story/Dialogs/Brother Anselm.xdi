		<item type="zombie.DialogNodeAsset" version="1">
			<id>{9F07EDC7-4255-4439-B7E8-A27756AEC6C7}</id>
			<name>thanks</name>
			<text><![CDATA[GOD BE THANKED. ONE THING MORE: SAY A PRAYER AT THE ALTAR FOR THE NAMELESS. PERHAPS THE NIGHT WILL BE KINDER TO US.]]></text>
			<onEnter/>
			<responses/>
			<position>720, 0</position>
		</item>
		<item type="zombie.DialogNodeAsset" version="1">
			<id>{938FEBCF-6AF6-46E9-988F-D11445F27E63}</id>
			<name>where</name>
			<text><![CDATA[A WOMAN CALLED BELLA LEADS THEM. THEY CAMP ON THE RIDGE TO THE WEST. SHE WILL NOT GIVE IT UP FOR KIND WORDS.]]></text>
			<onEnter/>
			<responses>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{CEF57FFD-3747-4E05-8FAF-29EC381C633B}</id>
					<text>I HAD ANOTHER QUESTION.</text>
					<target>{E0741AB5-5910-4A2E-859F-57D29FBB0811}</target>
					<condition/>
					<actions/>
					<once>false</once>
				</item>
			</responses>
			<position>720, 70</position>
		</item>
		<item type="zombie.DialogNodeAsset" version="1">
			<id>{631C6BCA-C15A-4046-BD08-A4F2A7CE849E}</id>
			<name>why</name>
			<text><![CDATA[BANDITS BROKE INTO THE CHAPEL AND TOOK THE BURIAL LEDGER. WITHOUT IT I CANNOT NAME THE DEAD, AND THE NAMELESS DO NOT SLEEP.]]></text>
			<onEnter/>
			<responses>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{B5C499F6-EB0D-4A8B-9BD3-9C6A83CC95DC}</id>
					<text>I WILL GET IT BACK.</text>
					<target>{938FEBCF-6AF6-46E9-988F-D11445F27E63}</target>
					<condition/>
					<actions>
						<item type="zombie.StartQuestAction">
							<quest>{D1A20000-0000-4000-8000-000000000100}</quest>
						</item>
					</actions>
					<once>false</once>
				</item>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{A7879947-A482-4B66-B107-F3DF5C3F2550}</id>
					<text>THAT IS NOT MY CONCERN.</text>
					<target>{E0741AB5-5910-4A2E-859F-57D29FBB0811}</target>
					<condition/>
					<actions/>
					<once>false</once>
				</item>
			</responses>
			<position>720, 162</position>
		</item>
		<item type="zombie.DialogNodeAsset" version="1">
			<id>{8D6281BE-F64F-48E4-BB13-C30D4DBA6CCA}</id>
			<name>wards</name>
			<text><![CDATA[WARDS. ELEVEN POSTS IN A RING, RAISED BY THE FIRST BROTHERS AGAINST THE NIGHT, EACH ONE LIT BY A RELIC OF THIS CHAPEL. WHEN THE CHAPEL FELL WE HID THE RELICS IN THE FOREST AND THE CAVES, AND THE POSTS WENT DARK.]]></text>
			<onEnter/>
			<responses>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{F918AB69-72EC-4E06-9185-CAAB54E42A85}</id>
					<text><![CDATA[I WILL FIND THEM AND LIGHT THE CIRCLE.]]></text>
					<target>{FC1C7C32-EAD9-4B6B-B029-18608DFB26F5}</target>
					<condition/>
					<actions>
						<item type="zombie.StartQuestAction">
							<quest>{D1A20000-0000-4000-8000-000000000105}</quest>
						</item>
					</actions>
					<once>false</once>
				</item>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{3DC7BCF0-66F0-49EE-8E28-451E5D0AFB16}</id>
					<text><![CDATA[NOT TONIGHT.]]></text>
					<target>{E0741AB5-5910-4A2E-859F-57D29FBB0811}</target>
					<condition/>
					<actions/>
					<once>false</once>
				</item>
			</responses>
			<position>720, 260</position>
		</item>
		<item type="zombie.DialogNodeAsset" version="1">
			<id>{FC1C7C32-EAD9-4B6B-B029-18608DFB26F5}</id>
			<name>howto</name>
			<text><![CDATA[TAKE A RELIC IN HAND AND HOLD IT TO A DARK POST. ONE RELIC TO EACH WARD. WHEN ALL ELEVEN BURN, COME BACK AND TELL ME.]]></text>
			<onEnter/>
			<responses>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{1BC15D5A-9176-451C-AD85-9C41E4B85BBD}</id>
					<text><![CDATA[I HAD ANOTHER QUESTION.]]></text>
					<target>{E0741AB5-5910-4A2E-859F-57D29FBB0811}</target>
					<condition/>
					<actions/>
					<once>false</once>
				</item>
			</responses>
			<position>1080, 260</position>
		</item>
		<item type="zombie.DialogNodeAsset" version="1">
			<id>{91466E19-822F-4510-9154-DDB5D58C60BF}</id>
			<name>blessed</name>
			<text><![CDATA[I SAW THE RING CATCH FROM THE CHAPEL DOOR. ELEVEN FLAMES, AFTER ALL THESE YEARS. TAKE WHAT THE CHAPEL CAN SPARE, AND MY BLESSING WITH IT.]]></text>
			<onEnter/>
			<responses/>
			<position>720, 360</position>
		</item>
