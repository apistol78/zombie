	<nodes>
		<item type="zombie.DialogNodeAsset" version="1">
			<id>{E0741AB5-5910-4A2E-859F-57D29FBB0811}</id>
			<name>hello</name>
			<text>THE DEAD DO NOT REST HERE ANY MORE. PRAY ANYWAY.</text>
			<onEnter/>
			<responses>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{D3E9DB7D-19AD-4398-8D9F-41DC2EDF03A6}</id>
					<text>WHY DON&apos;T THE DEAD REST?</text>
