						<step>{C8026CF4-A249-4EA5-B33F-90292A363538}</step>
					</condition>
					<actions/>
					<once>false</once>
				</item>
				<item type="zombie.DialogResponseAsset" version="2">
					<id>{D4DE91A1-51C5-4D66-89F2-012C92A1FBD1}</id>
					<text><![CDATA[HOW ARE THE WARDS LIT?]]></text>
					<target>{FC1C7C32-EAD9-4B6B-B029-18608DFB26F5}</target>
