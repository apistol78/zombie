<?xml version="1.0" encoding="utf-8"?>
<object type="zombie.QuestData">
	<title>THE BRIDAL CROWN</title>
	<info><![CDATA[ELSA WAS TO BE MARRIED IN THE PARISH BRIDAL CROWN. THE NIGHT THE DEAD ROSE, SOMEONE TOOK IT FROM THE CHAPEL AND CARRIED IT INTO THE SECOND CAVE, EAST OF THE VILLAGE.]]></info>
	<steps>
		<item type="zombie.FindItemStep" version="3">
			<id>{7FDE444D-960D-40D5-90EC-685B0655163A}</id>
			<name>find</name>
			<text><![CDATA[FIND THE BRIDAL CROWN DEEP IN THE SECOND CAVE, EAST OF THE VILLAGE]]></text>
			<waypoint type="zombie.FirstOfWaypoint">
				<candidates>
					<item type="zombie.ItemWaypoint">
						<item>{D1A10000-0000-4000-8000-00000000020E}</item>
					</item>
					<item type="zombie.PlaceWaypoint">
						<place>{D1A20000-0000-4000-8000-000000000403}</place>
					</item>
					<item type="zombie.PlaceWaypoint">
						<place>{D1A20000-0000-4000-8000-000000000401}</place>
					</item>
				</candidates>
			</waypoint>
			<failWhen/>
			<onComplete/>
			<item>{D1A10000-0000-4000-8000-00000000020E}</item>
			<holdBack>true</holdBack>
		</item>
		<item type="zombie.TalkStep" version="2">
			<id>{71B70B35-4BAE-4343-804C-850080FB5862}</id>
			<name>return</name>
			<text><![CDATA[BRING THE BRIDAL CROWN BACK TO ELSA]]></text>
			<waypoint type="zombie.FirstOfWaypoint">
				<candidates>
					<item type="zombie.ActorWaypoint">
						<actor>{D1A20000-0000-4000-8000-000000000305}</actor>
					</item>
					<item type="zombie.PlaceWaypoint">
						<place>{D1A20000-0000-4000-8000-000000000404}</place>
					</item>
					<item type="zombie.PlaceWaypoint">
						<place>{D1A20000-0000-4000-8000-000000000401}</place>
					</item>
				</candidates>
			</waypoint>
			<failWhen/>
			<onComplete/>
			<actor>{D1A20000-0000-4000-8000-000000000305}</actor>
			<line>{F7CB2ADF-D799-4F51-8AB9-D549E4CA8B92}</line>
		</item>
	</steps>
	<reward>
